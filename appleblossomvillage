    def spouse_morning(self):
        vid = self.st["spouse"]
        if not vid or random.random() < 0.4:
            return
        v = VILLAGERS[vid]["short"]
        r = random.random()
        if r < 0.4 and self.st["soil"] and self.st["weather"] == "sun":
            for s in self.st["soil"].values():
                s[0] = 1
            self.say("%s watered all the crops before you woke up." % v,
