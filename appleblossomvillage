def all_tiles(season=0):
    """name -> pixel rows, for every tile and animation frame."""
    tiles = {}
    for name in TERRAIN:
        tiles[name] = draw_terrain(name, 0, season)
        if name in ANIMATED_TERRAIN:
            tiles[name + "@1"] = draw_terrain(name, 1, season)
    sprites = {}
    for name, (pal, rows) in ART.items():
        sprites[name] = art_pixels(pal, rows)
    for m in MACHINES:
        k = "m_" + m.replace(" ", "_")
        sprites[k + "_r"] = ready_art(sprites[k])
    for s in FORAGE.values():
        for item, shape, col, _ in s:
            pal = {"a": col, "A": shade(col, 1.3), "s": "#4a8a3a",
                   "S": shade(col, 0.7)}
            sprites["fg_" + item] = art_pixels(pal, FORAGE_SHAPES[shape])
    for c in CROPS:
        for st in range(4):
            sprites["c_%s_%d" % (c, st)] = crop_art(c, st)
    sprites["c_dead"] = dead_crop()
    for vid, v in VILLAGERS.items():
        sprites["v_" + vid] = art_pixels(*person_art(v["look"]))
        sprites["s_" + vid] = golden(sprites["v_" + vid])
        sprites["vx_" + vid] = art_pixels(*person_art(swap_look(v["look"])))
        sprites["sx_" + vid] = golden(sprites["vx_" + vid])
        sprites["vm_" + vid] = art_pixels(*person_art(maid_look(v["look"])))
        sprites["tv_" + vid] = tree_art(v["look"], season)
        sprites["lh_" + vid] = loo_art(v["look"], season)
        sprites["sm_" + vid] = golden(sprites["vm_" + vid])
    for k in MONSTERS:                   # monsters the wand has changed
        col = list(ART["mon_" + k][0].values())[0]
        sprites["smon_" + k] = golden(sprites["mon_" + k])
        sprites["mmaid_" + k] = art_pixels(*person_art(monster_maid_look(k)))
        sprites["mtree_" + k] = tree_art({"hair": col, "shirt": col},
                                         season)
        sprites["mloo_" + k] = loo_art({"shirt": col}, season)
    for colour in HEN_COLOURS:
        sprites["hen_" + colour] = hen_art(colour)
    sprites["egg"] = egg_art()
    for colour in HEN_COLOURS:
        sprites["shen_" + colour] = golden(sprites["hen_" + colour])
    for colour in COW_COLOURS:
        sprites["cow_" + colour] = cow_art(colour)
        sprites["scow_" + colour] = golden(sprites["cow_" + colour])
    for kind in FRUIT_TREES:
        for stage in "symf":
            sprites["ft_%s_%s" % (kind, stage)] = fruit_tree_art(
                kind, stage, season)
    for colour in CAT_COLOURS:
        sprites["cat_" + colour] = cat_art(colour)
        sprites["scat_" + colour] = golden(sprites["cat_" + colour])
    for colour in DOG_COLOURS:
        sprites["dog_" + colour] = dog_art(colour)
        sprites["sdog_" + colour] = golden(sprites["dog_" + colour])
    for colour in SHEEP_COLOURS:
        sprites["sheep_" + colour] = sheep_art(colour, False)
        sprites["sheepf_" + colour] = sheep_art(colour, True)
        sprites["ssheep_" + colour] = golden(sprites["sheepf_" + colour])
    for name, px in sprites.items():
        tiles[name] = px
        SPRITES.add(name)
        if name.startswith(("v_", "vx_", "vm_", "hen_", "cow_", "sheep",
                            "cat_", "dog_")):
            tiles[name + "@1"] = px[1:] + [[None] * 16]   # a bob
    return tiles


