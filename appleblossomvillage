                     "jumper. %s's far too young to be anybody's maid, and "
                     "has homework besides." % (name, name), "info")
            self.end_turn(TOOL_COST)
            return
        if self.chicken(vid):
            self.say("The spell bounces off the hen. There's no apron in "
                     "the world small enough.", "info")
            self.end_turn(TOOL_COST)
            return
        self.portraits = {}
        if self.statue(vid):
            if self.maid(vid):
                del st["maids"][vid]
            else:
