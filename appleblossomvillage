        elif style in ("messy", "spiky", "curly"):
            for x in range(10, 22, 2):
                prect(g, x, line, x, line + 1 + (x // 2) % 2, hair)
        elif style in ("long", "ponytail", "bun"):
            # a side parting
            prect(g, 9, line, 14, line + 1, hair)
            g[line + 2][9] = g[line + 2][10] = hair
            prect(g, 18, line, 22, line, hair)
        else:
            prect(g, 9, line, 22, line, hair)
            prect(g, 9, line, 12, line + 1, hair)
        # shine
        for x in range(10, 15):
            if g[top + 2][x] == hair:
                g[top + 2][x] = hl
        if g[top + 1][13] == hair:
            g[top + 1][13] = hl
        if style == "braid":
            for y in range(fy + 2, 30, 2):
                pdisc(g, cx + frx + 1, y, 1.6, 1.2, hair)
                g[y][round(cx + frx + 1)] = hd
    if "hat" in extras:
        hc = look.get("hatc", "#a07040")
        prect(g, 5, top + 2, 26, top + 3, shade(hc, 0.85))
        pdisc(g, cx, top + 1, 7, 4, hc, lambda x, y: y <= top + 2)
        prect(g, 9, top + 1, 22, top + 1, look.get("band", "#c04040"))
    if "tricorn" in extras:
        hc = look.get("hatc", "#1e1a1e")
        prect(g, 4, top + 2, 27, top + 3, hc)              # the brim
        pdisc(g, cx, top + 1, 7, 4, hc, lambda x, y: y <= top + 2)
        for side in (-1, 1):                                # cocked up
            pdisc(g, cx + side * 10, top, 2.2, 2.6, hc)
        prect(g, 4, top + 3, 27, top + 3, "#c8a040")       # gold trim
        for x, y in ((15, top - 1), (16, top - 1), (15, top), (16, top)):
            g[y][x] = "#f4f0e6"                            # a little skull
    if "bandana" in extras:
        bc = look.get("bandc", "#c04040")
        prect(g, 8, top + 3, 23, top + 4, bc)
        g[top + 5][23] = g[top + 6][24] = bc
    if "flower" in extras:
        fc = look.get("flowerc", "#f8a8c8")
        fx, fy2 = 21, top + 3
        for (dx, dy) in ((0, -1), (-1, 0), (1, 0), (0, 1)):
            g[fy2 + dy][fx + dx] = fc
        g[fy2][fx] = "#f0e040"
    if "headband" in extras:
        prect(g, 9, top + 3, 22, top + 3, look.get("bandc", "#e04080"))
    if "hairbow" in extras:
        cc = look.get("clipc", "#90dcc8")
        bx, by = 7, top + 4
        prect(g, bx - 3, by - 1, bx - 1, by + 1, cc)
        prect(g, bx + 1, by - 1, bx + 3, by + 1, cc)
        g[by][bx] = shade(cc, 0.7)
        g[by - 1][bx - 3] = g[by + 1][bx + 3] = shade(cc, 1.15)
    if "maidcap" in extras:
        lace, lace_d = "#fbf8f2", "#d8d0c8"
        prect(g, 8, top + 1, 23, top + 2, lace)
        for x in range(8, 24, 2):
            g[top][x] = lace
            g[top + 3][x + 1] = lace_d
        prect(g, 8, top + 3, 23, top + 3, lace_d)
        for x in range(9, 23, 4):
            g[top + 1][x + 1] = lace_d
    if "bow" in extras:
        bc = look.get("bowc", "#c03050")
        prect(g, 13, 25, 14, 26, bc)
        prect(g, 17, 25, 18, 26, bc)
        g[25][15] = g[25][16] = shade(bc, 0.75)
        g[26][15] = g[26][16] = shade(bc, 0.75)
    if "sailor" in extras:
        sc = look.get("sailorc", "#2a3460")
        for y in range(25, PW):
            for x in range(PW):
                d = abs(x - cx)
                if 4.5 + (y - 25) * 0.4 < d < 7.5 + (y - 24) * 1.6 and \
                        g[y][x] in (shirt, shade(shirt, 0.8)):
                    g[y][x] = sc
                if abs(d - (6.5 + (y - 25) * 1.05)) < 0.5 and y > 25:
                    g[y][x] = "#f4f2ec"                     # the stripe
        kc = look.get("kerchief", "#d03040")
        prect(g, 14, 27, 17, 28, kc)                        # neckerchief
        for y in range(29, PW):
            g[y][15] = g[y][16] = shade(kc, 0.85)
        g[29][14] = g[29][17] = kc
    if "eyepatch" in extras:
        prect(g, 10, fy - 1, 14, fy + 1, "#141414")
        for x in range(4, 11):
            g[fy - 1 - (10 - x) // 2][x] = "#141414"
        for x in range(15, 27):
            g[fy - 1 - (x - 15) // 3][x] = "#141414"
    return g

