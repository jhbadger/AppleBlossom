def put_building(g, labels, key):
    """Draw a building into the valley, with a path from its door down to
    the nearest path."""
    x0, y0, w, h, rf, wall, name = BUILDINGS[key]
    for y in range(y0, y0 + h):
        for x in range(x0, x0 + w):
            if y < y0 + h - 2:
                t = ("eave_" if y == y0 + h - 3 else "roof_") + rf
            else:
                t = ("win_" if (x - x0) % 3 == 1 and key not in ON_ORDER
                     else "wall_") + wall
            g[y][x] = t
    if key not in ON_ORDER:
        g[y0][x0 + w - 2] = "chimney"
    dx, dy = door_of(key)
    g[dy][dx] = "door_" + wall
    labels[(dx, dy)] = name
    y = dy + 1
    while 0 < y < VH and g[y][dx] not in ("path", "cobble", "bridge"):
        g[y][dx] = "path"
        y += 1


def make_valley(seed, built=()):
    """The valley's terrain and the labels on its doors.  built names
    the buildings on order (ON_ORDER) that have been put up."""
    rng = random.Random(7)              # the valley is always the same
    g = [["grass"] * VW for _ in range(VH)]
    fx0, fy0, fx1, fy1 = FARM

    def put(x, y, t):
        if 0 <= x < VW and 0 <= y < VH:
            g[y][x] = t

    def fill(x0, y0, x1, y1, t):
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                put(x, y, t)
    # the wild edges: forest all round, woods to the north and east
    for y in range(VH):
        for x in range(VW):
            if y < 2 or x < 1 or x > VW - 3:
                g[y][x] = "forest"
            elif y < 9 and x > 47:
                r = rng.random()
                g[y][x] = ("pine" if r < 0.13 else "tree" if r < 0.22 else
                           "bush" if r < 0.26 else "tallgrass" if r < 0.5
                           else "meadow")
            elif 94 < x < 99 and y < BEACH_Y:
                r = rng.random()
                g[y][x] = "pine" if r < 0.3 else "tree" if r < 0.45 \
                    else "meadow"
            elif x >= 99 and y < BEACH_Y:       # the east quarter
                r = rng.random()
                g[y][x] = ("tree" if r < 0.04 else "pine" if r < 0.07 else
                           "meadow" if r < 0.25 else "flowers" if r < 0.28
                           else "grass")
            elif rng.random() < 0.05:
                g[y][x] = "meadow"
    # the lake, the beach, the river
    fill(1, BEACH_Y, VW - 2, LAKE_Y - 1, "sand")
    fill(0, LAKE_Y, VW - 1, VH - 1, "water")
    fill(RIVER[0], 0, RIVER[1], LAKE_Y - 1, "river")
    # the farm, inside its fence
    fill(fx0 + 1, fy0 + 1, fx1 - 1, fy1 - 1, "grass")
    for x in range(fx0, fx1 + 1):
        put(x, fy0, "fence")
        put(x, fy1, "fence")
    for y in range(fy0 + 1, fy1):
        put(fx0, y, "fence_v")
        put(fx1, y, "fence_v")
    # roads
    fill(9, 26, fx1 - 1, 26, "path")
    fill(fx1, 26, fx1, 27, "path")
    fill(fx1 + 1, 26, SQUARE[0] - 1, 27, "path")
    fill(SQUARE[0], SQUARE[1], SQUARE[2], SQUARE[3], "cobble")
    fill(75, 6, 76, SQUARE[1] - 1, "path")
    fill(SQUARE[2] + 1, 26, VW - 3, 27, "path")
    fill(48, 38, VW - 3, 39, "path")
    fill(75, SQUARE[3] + 1, 76, 49, "path")
    fill(20, 50, VW - 3, 51, "path")
    fill(20, fy1, 20, 49, "path")
    for (x0, x1, y0, y1) in ((RIVER[0], RIVER[1], 26, 27),
                             (RIVER[0], RIVER[1], 50, 51)):
        fill(x0, y0, x1, y1, "bridge")
    fill(80, BEACH_Y + 2, 81, LAKE_Y + 3, "dock")
    # the blossom orchard by Rose's cottage
    for x in range(49, 65, 3):
        for y in (29, 31):
            put(x, y, "blossomtree")
    # buildings, with a path from each door
    labels = {}
    for key in BUILDINGS:
        if key not in ON_ORDER or key in built:
            put_building(g, labels, key)
    # the square: paving round the fountain, flowers, trees at the corners
    for y in range(SQUARE[1] + 2, SQUARE[3] - 1):
        for x in range(SQUARE[0] + 2, SQUARE[2] - 1):
            if abs(x - 75) + abs(y - 25.5) <= 6.5:
                put(x, y, "plaza")
    for (x, y) in ((74, 24), (76, 24), (74, 26), (76, 26)):
        put(x, y, "flowerbed")
    for (x, y) in ((68, 32), (82, 32), (82, 19), (68, 23), (82, 23)):
        put(x, y, "blossomtree")
    put(75, 25, "fountain")
    labels[(75, 25)] = "the fountain"
    put(69, 19, "board")
    labels[(69, 19)] = "the notice board"
    for (x, y) in ((72, 30), (78, 30)):
        put(x, y, "bench")
    for x in (70, 71, 79, 80):
        put(x, 21, "flowerbed")
    for (x, y) in ((67, 18), (83, 18), (67, 33), (83, 33), (47, 25),
                   (65, 25), (85, 25), (74, 37), (77, 49), (74, 49)):
        put(x, y, "lamp")
    # your farm's furniture
    put(11, 25, "bin")
    labels[(11, 25)] = "the shipping bin"
    put(7, 25, "mailbox")
    labels[(7, 25)] = "your mailbox"
    put(15, 23, "well")
    labels[(15, 23)] = "the well"
    for x in (5, 8, 11, 14):
        put(x, 17, "appletree")
    for y in range(fy0 + 1, fy1):
        for x in range(fx0 + 1, fx1):
            if ((x - 34) / 3.4) ** 2 + ((y - 42) / 2.4) ** 2 <= 1:
                put(x, y, "pond")
    for (x, y) in ((5, 5), (37, 5), (38, 9), (5, 45), (37, 46), (24, 4)):
        put(x, y, "tree")
    # trees about the village, clear of paths, doors and meeting places
    keep = set(OUT_SPOTS.values())
    for spots in FEST_SPOTS.values():
        keep.update(spots)
    for y in range(VH):
        for x in range(VW):
            if (x, y) in keep and g[y][x] not in ("path", "cobble", "dock", "plaza",
                                                   "sand", "bridge"):
                g[y][x] = "grass"
    for _ in range(140):
        x, y = rng.randrange(41, 95), rng.randrange(9, BEACH_Y - 1)
        if g[y][x] not in ("grass", "meadow") or any(
                (x + dx, y + dy) in keep for dx in (-1, 0, 1)
                for dy in (-1, 0, 1)):
            continue
        if any(g[y + dy][x + dx] in ("path", "cobble") or
               g[y + dy][x + dx].startswith(("door", "wall", "win"))
               for dx in (-1, 0, 1) for dy in (-1, 0, 1)):
            continue
        put(x, y, rng.choice(("tree", "tree", "pine", "bush", "flowers")))
    labels[(80, BEACH_Y + 2)] = "the dock"
    labels[(RIVER[0] + 1, 26)] = "the bridge"
    return g, labels


