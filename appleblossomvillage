def selftest():
    """Build everything and check the people, places and tunes fit
    together; then run a season of days without a window."""
    problems = []
    for season in range(4):
        tiles = all_tiles(season)
        for name, px in tiles.items():
            if len(px) != 16 or any(len(r) != 16 for r in px):
                problems.append("tile %s is not 16x16" % name)
    for vid, v in VILLAGERS.items():
        if vid not in SWAP_LINES or vid not in UNSTATUE or \
                vid not in CHICKEN_BACK or vid not in TREE_BACK or \
                vid not in TREE_CHOPPED or vid not in CAT_BACK or \
                vid not in DOG_BACK or (
                    (vid not in MAID_LINES or vid not in LOO_BACK or
                     vid not in COW_BACK or vid not in SHEEP_BACK) and
                    v["look"].get("age") != "child"):
            problems.append("%s lacks spell reactions" % vid)
        for expr in EXPRESSIONS:
            px = portrait(swap_look(v["look"]), expr)
            if len(px) != PW or any(len(r) != PW for r in px):
                problems.append("swapped portrait %s/%s" % (vid, expr))
            px = portrait(v["look"], expr)
            if len(px) != PW or any(len(r) != PW for r in px):
                problems.append("portrait %s/%s" % (vid, expr))
    grid, labels = make_valley(1)
    if len(grid) != VH or any(len(r) != VW for r in grid):
        problems.append("valley size")
    for key, (x0, y0, w, h, *_) in BUILDINGS.items():
        if key in ON_ORDER:
            continue
        for y in range(y0, y0 + h):
            for x in range(x0, x0 + w):
                if not grid[y][x].startswith(("wall_", "win_", "roof_",
                                              "eave_", "door_", "chimney")):
                    problems.append("%s is built over at %d,%d" % (key, x,
                                                                  y))
    rooms = {}
    for key in EXTRA_ROOMS:
        g, spots, entry, ex = make_room(key)
        if g[entry[1]][entry[0]] not in WALKABLE or ex is None:
            problems.append("room %s has no way in and out" % key)
    for key, (floor, wall, rows) in ROOMS.items():
        if len({len(r) for r in rows}) != 1:
            problems.append("room %s rows differ" % key)
            continue
        g, spots, entry, ex = make_room(key)
        rooms[key] = (g, spots, entry)
        if g[entry[1]][entry[0]] not in WALKABLE:
            problems.append("room %s entry blocked" % key)
        # every spot reachable from the entry
        seen = {entry}
        q = deque([entry])
        while q:
            x, y = q.popleft()
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if 0 <= n[1] < len(g) and 0 <= n[0] < len(g[0]) and \
                        n not in seen and g[n[1]][n[0]] in WALKABLE:
                    seen.add(n)
                    q.append(n)
        for ch, pos in spots.items():
            if pos not in seen:
                problems.append("room %s spot %s unreachable" % (key, ch))
    grid, labels = make_valley(1, built=ON_ORDER)
    for key in BUILDINGS:
        dx, dy = door_of(key)
        if grid[dy + 1][dx] not in WALKABLE:
            problems.append("door of %s blocked" % key)
    mx, my = MINE_DOOR
    if grid[my][mx] != "cave" or grid[my + 1][mx] not in WALKABLE:
        problems.append("the mine's mouth")
    tile_names = set(all_tiles(0))
    for seed in (1, 2, 3):
        for f in list(range(1, MINE_FLOORS + 1)) + list(range(
                TOWER + 1, TOWER_TOP + 1)):
            g, up, down, mobs, chests = make_mine_floor(seed, f)
            start = (up[0], up[1] + 1)
            seen, q = {start}, deque([start])
            while q:
                x, y = q.popleft()
                for dx, dy in DIRS:
                    n = (x + dx, y + dy)
                    if n not in seen and g[n[1]][n[0]] in WALKABLE:
                        seen.add(n)
                        q.append(n)
            for x, y in [p for p in (down,) if p] + [
                    (x, y) for _, x, y in mobs] + chests:
                if not any((x + dx, y + dy) in seen for dx, dy in DIRS):
                    problems.append("mine %d floor %d: %d,%d unreachable"
                                    % (seed, f, x, y))
            if (down is None) != (f in (MINE_FLOORS, TOWER_TOP)) or g[
                    start[1]][start[0]] not in WALKABLE:
                problems.append("mine floor %d ladders" % f)
            keys = [(x, y) for y, r in enumerate(g) for x, t in enumerate(r)
                    if t == "pedestal_key"]
            if (len(keys) == 1) != (f == MINE_FLOORS) or keys and not any(
                    (keys[0][0] + dx, keys[0][1] + dy) in seen
                    for dx, dy in DIRS):
                problems.append("floor %d: the winged key" % f)
            bosses = [k for k, _, _ in mobs if "boss" in MONSTERS[k].traits]
            if bosses != (["king"] if f == KING_FLOOR else ["archangel"]
                          if f == TOWER_TOP else []):
                problems.append("floor %d bosses %s" % (f, bosses))
            for row in g:
                for t in row:
                    if t not in tile_names:
                        problems.append("mine tile %s undrawn" % t)
            for kind, x, y in mobs:
                if "mon_" + kind not in tile_names:
                    problems.append("monster %s undrawn" % kind)
    for name, (x, y) in OUT_SPOTS.items():
        if grid[y][x] not in WALKABLE:
            problems.append("spot %s on %s" % (name, grid[y][x]))
    for vid, v in VILLAGERS.items():
        for kind in ("loves", "likes", "dislikes", "hates"):
            for item in v[kind]:
                if not item.startswith("kind:") and item not in ITEMS:
                    problems.append("%s %s unknown %s" % (vid, kind, item))
        for sname, sched in v["sched"].items():
            for t, spot in sched:
                area, mark = spot.split(".")
                if area == "out":
                    if mark not in OUT_SPOTS:
                        problems.append("%s: no out.%s" % (vid, mark))
                elif area not in rooms or mark not in rooms[area][1]:
                    problems.append("%s: no %s" % (vid, spot))
        for level, steps in v["scenes"].items():
            for s in steps:
                if isinstance(s, tuple) and (s[0] != "?" or
                                             len(s[2]) < 2):
                    problems.append("%s scene %d choice" % (vid, level))
        if v["romance"]:
            for k in ("date", "dating", "spouse"):
                if not v.get(k):
                    problems.append("%s has no %s" % (vid, k))
            if vid not in ACCEPT or vid not in PROPOSAL or vid not in VOWS:
                problems.append("%s lacks romance lines" % vid)
        if v["shop"] and v["shop"][1] not in SHOP_STOCK:
            problems.append("%s shop" % vid)
    for kind, stock in SHOP_STOCK.items():
        for entry in stock:
            if entry != "seeds" and entry[0] not in ITEMS and entry[0] not \
                    in ("checkup", "cabin extension",
                        "chicken", "chicken coop", "leash", "barn",
                        "greenhouse",
                        "cow", "milk pail", "sheep", "shears", "cat", "dog",
                        "fishing rod", "sprinkler", "short sword",
                        "broadsword"):
                problems.append("shop %s sells unknown %s" % (kind, entry))
    for t in (MAID_ACCEPT, MAID_PROPOSAL, MAID_VOWS, MAID_COURTING,
              MAID_WIFE, MAID_WIFE_GREET):
        if len(t) != 2 or not all(t):
            problems.append("maid romance lines")
    for m, recipes in MACHINES.items():
        if "m_" + m.replace(" ", "_") not in ART or m not in MACHINE_SOLD \
                or m not in MACHINE_PLACED or m not in MACHINE_TAKES:
            problems.append("machine %s lacks art or words" % m)
        for need, n, made, mins in recipes:
            if need not in ("jam", "pickle") and (
                    need not in ITEMS or made not in ITEMS):
                problems.append("machine %s: %s -> %s" % (m, need, made))
    for kind in OUTFITS:
        if kind not in OUTFIT_LINES or not all(OUTFIT_LINES[kind]):
            problems.append("outfit %s lacks lines" % kind)
        for c in OUTFITS[kind][1]:
            if c not in COLOUR_NAMES:
                problems.append("outfit colour %s unnamed" % c)
    for dish, (need, who) in RECIPES.items():
        if dish not in ITEMS or ITEMS[dish][2] != "food" or (
                who and not who.startswith("mm:") and (
                    who not in VILLAGERS or who not in RECIPE_LETTERS)):
            problems.append("recipe %s" % dish)
        for spec in need:
            if not spec.startswith("any ") and spec not in ITEMS:
                problems.append("recipe %s needs unknown %s" % (dish, spec))
    tx, ty = TOWER_DOOR
    if grid[ty][tx] != "towerdoor" or grid[ty + 1][tx] not in WALKABLE:
        problems.append("the tower's door")
    ax, ay = AURIEL_SPOT
    if grid[ay][ax] not in WALKABLE or (ax, ay) in OUT_SPOTS.values():
        problems.append("Auriel's spot")
    for kind in MONSTER_MAIDS:
        sc = MM_SCENES.get(kind, {})
        if sorted(sc) != [4, 8] or any(
                not any(isinstance(st_, tuple) and len(st_[2]) >= 2
                        for st_ in steps) for steps in sc.values()):
            problems.append("monster maid %s heart scenes" % kind)
        if kind not in KID_TRAITS or kind not in MM_RECIPES or (
                kind not in MM_GOSSIP and kind not in ("angel", "poop")):
            problems.append("monster maid %s lacks kids, recipe or "
                            "gossip" % kind)
        r = MONSTER_ROMANCE.get(kind)
        if not r or any(not r.get(k) for k in (
                "loves", "likes", "hates", "kiss", "notyet", "accept",
                "proposal", "vows", "wife", "morning")):
            problems.append("monster maid %s lacks romance" % kind)
            continue
        for item in r["loves"] + r["likes"] + r["hates"]:
            if item not in ITEMS:
                problems.append("monster maid %s: unknown %s" % (kind, item))
    for q, right, wrong in RIDDLES:
        if right in wrong or len(wrong) != 2:
            problems.append("riddle %s" % q)
    for kind in FRUIT_TREES:
        if kind not in ITEMS or kind + " sapling" not in ITEMS:
            problems.append("fruit tree %s" % kind)
    for c in JAM_FRUIT + PICKLE_VEG:
        if c not in ITEMS:
            problems.append("preserves: no %s" % c)
    for name, tune in MUSIC.items():
        try:
            render_tune(tune)
        except (ValueError, KeyError) as e:
            problems.append("tune %s: %s" % (name, e))
    for line in problems:
        print("PROBLEM:", line)
    print("selftest: %d tiles a season, %d rooms, %d villagers, %d tunes; "
          "%s" % (len(tiles), len(rooms), len(VILLAGERS), len(MUSIC),
                  "all good" if not problems else "%d problems" %
                  len(problems)))
    return not problems


# ── The icon ─────────────────────────────────────────────────────────────────

ICON_NAME = "appleblossomvillage"


def icon_mix(a, b, t):
    t = min(max(t, 0.0), 1.0)
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def icon_art(x, y):
    """An apple blossom, five pink petals and a gold heart, on spring
    sky."""
    sky = icon_mix((168, 216, 240), (250, 228, 236), y)
    if y > 0.82:
        sky = icon_mix((120, 190, 90), (90, 160, 70), (y - 0.82) / 0.18)
    cx, cy = 0.5, 0.47
    dx, dy = x - cx, y - cy
    r = math.hypot(dx, dy)
    a = math.atan2(dy, dx)
    petal = 0.22 + 0.13 * abs(math.cos(2.5 * (a + math.pi / 2)))
    if r < 0.08:
        if math.hypot(dx + 0.02, dy + 0.02) < 0.03:
            return (255, 240, 170)
        return (240, 200, 60)
    for k in range(5):                              # the stamens
        aa = -math.pi / 2 + (k + 0.5) * 2 * math.pi / 5
        if math.hypot(x - (cx + 0.12 * math.cos(aa)),
                      y - (cy + 0.12 * math.sin(aa))) < 0.022:
            return (230, 170, 40)
    if r < petal:
        t = r / petal
        edge = abs(math.cos(2.5 * (a + math.pi / 2)))
        base = icon_mix((255, 255, 255), (242, 140, 180), t * 0.9)
        if edge < 0.12 and r > 0.12:
            return icon_mix(base, (210, 100, 140), 0.5)
        return base
    return sky
def icon_rr(x, y, x0, y0, x1, y1, r):
    """True inside the rounded rectangle (x0,y0)-(x1,y1) with corner radius r."""
    cx = min(max(x, x0 + r), x1 - r)
    cy = min(max(y, y0 + r), y1 - r)
    return math.hypot(x - cx, y - cy) <= r


def icon_sample(x, y):
    """RGB of the icon at (x, y) in the unit square, or None (transparent)."""
    if not icon_rr(x, y, 0.0, 0.0, 1.0, 1.0, 0.2):
        return None
    return icon_art(x, y)


def icon_render_png(size):
    n = 4 if size <= 256 else 2
    rows = []
    for py in range(size):
        row = bytearray([0])                     # PNG filter type 0
        for px in range(size):
            ra = ga = ba = aa = 0
            for sy in range(n):
                for sx in range(n):
                    c = icon_sample((px + (sx + 0.5) / n) / size,
                                    (py + (sy + 0.5) / n) / size)
                    if c:
                        ra += c[0]
                        ga += c[1]
                        ba += c[2]
                        aa += 1
            if aa:
                row += bytes((ra // aa, ga // aa, ba // aa,
                              255 * aa // (n * n)))
            else:
                row += b"\0\0\0\0"
        rows.append(bytes(row))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    return (b"\x89PNG\r\n\x1a\n" +
            chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(b"".join(rows), 9)) +
            chunk(b"IEND", b""))


# ICNS entry types holding PNG data, with the pixel size of each
ICON_ICNS_TYPES = [(b"icp4", 16), (b"icp5", 32), (b"ic11", 32), (b"ic12", 64),
                   (b"ic07", 128), (b"ic13", 256), (b"ic08", 256),
                   (b"ic14", 512), (b"ic09", 512)]


def icon_make_icns():
    """An .icns file written directly (no iconutil needed)."""
    pngs = {}
    body = b""
    for tag, size in ICON_ICNS_TYPES:
        if size not in pngs:
            pngs[size] = icon_render_png(size)
        body += tag + struct.pack(">I", len(pngs[size]) + 8) + pngs[size]
    return b"icns" + struct.pack(">I", len(body) + 8) + body


def icon_build_app(dest):
    """Build a macOS <name>.app bundle (with icon) in dest."""
    app = os.path.join(dest, ICON_NAME + ".app")
    if os.path.exists(app):
        shutil.rmtree(app)
    macos = os.path.join(app, "Contents", "MacOS")
    res = os.path.join(app, "Contents", "Resources")
    os.makedirs(macos)
    os.makedirs(res)
    shutil.copy(os.path.abspath(__file__), os.path.join(res, ICON_NAME + ".py"))
    launcher = os.path.join(macos, ICON_NAME)
    with open(launcher, "w") as fh:
        fh.write('#!/bin/sh\nexec "%s" "$(dirname "$0")/../Resources/%s.py" '
                 '"$@"\n' % (sys.executable, ICON_NAME))
    os.chmod(launcher, 0o755)
    with open(os.path.join(res, ICON_NAME + ".icns"), "wb") as fh:
        fh.write(icon_make_icns())
    info = {
        "CFBundleName": ICON_NAME,
        "CFBundleDisplayName": ICON_NAME,
        "CFBundleIdentifier": "org.badgerjh." + ICON_NAME,
        "CFBundleExecutable": ICON_NAME,
        "CFBundleIconFile": ICON_NAME,
        "CFBundlePackageType": "APPL",
        "CFBundleShortVersionString": "1.0",
        "NSHighResolutionCapable": True,
    }
    with open(os.path.join(app, "Contents", "Info.plist"), "wb") as fh:
        plistlib.dump(info, fh)
    return app


def icon_args(args):
    """Handle --build-app [DIR] and --icon-png SIZE [OUT]; True if handled."""
    if args[:1] == ["--build-app"]:
        print(icon_build_app(args[1] if len(args) > 1 else
                             os.path.dirname(os.path.abspath(__file__))))
        return True
    if args[:1] == ["--icon-png"] and len(args) >= 2:
        with open(args[2] if len(args) > 2 else ICON_NAME + ".png", "wb") as fh:
            fh.write(icon_render_png(int(args[1])))
        return True
    return False


def set_window_icon(root):
    try:
        data = base64.b64encode(icon_render_png(64)).decode()
        root._icon = tk.PhotoImage(data=data)
        root.iconphoto(True, root._icon)
    except tk.TclError:
        pass


def main():
    if icon_args(sys.argv[1:]):
        return
    if "--selftest" in sys.argv:
        sys.exit(0 if selftest() else 1)
    root = tk.Tk()
    set_window_icon(root)
    Game(root)
    root.mainloop()


if __name__ == "__main__":
    main()
