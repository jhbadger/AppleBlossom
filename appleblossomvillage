        self.speak(vid, LOO_BACK[vid][0 if likes else 1])
        if pts:
            self.befriend(vid, pts)
            self.say("(%s %s.)" % (name, "likes you more for it" if pts > 0
                                   else "is upset with you"),
                     "heart" if pts > 0 else "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    def loo_room(self, n):
        """Is there room for an outhouse where somebody stands: out of
        doors, off any doorstep, with clear ground in front for the
        door?"""
        if not self.area.outdoor or n.where != "valley":
            return False
        x, y = n.x, n.y + 1
        if (n.x, n.y) in self.door_at or (x, y) in self.door_at:
            return False
        if not self.can_stand(x, y):
            return False
        o = self.npc_at(x, y)
        return o is None or not self.rooted(o.vid)

    def outside_door(self):
        """The square outside the room you're in."""
        key = self.area.key
        if key == "mine" and self.mine and self.mine["floor"] > TOWER:
            return TOWER_DOOR
        if key == "mine" or self.st.get("mine_loo"):
            return MINE_DOOR
        if key == "loo":
            vid = self.st.get("loo_in")
            if vid in self.st["loos"]:
                x, y = self.loo_door(vid)
                return x, y - 1
            key = "cabin"
        return door_of(key)

    def loo_state(self, vid):
        """An outhouse's pit, grime, decorations, and whether it's on its
        side."""
        return self.st.setdefault("loo_state", {}).setdefault(
            vid, {"pit": 0, "grime": 0, "decor": [], "tipped": False})

    def loo_tile(self, vid):
        ls = self.st.get("loo_state", {}).get(vid)
        sig = (ls["grime"] >= LOO_FILTHY, tuple(sorted(ls["decor"])),
               ls["tipped"]) if ls else (False, (), False)
        if sig == (False, (), False) or not hasattr(self, "base"):
            return "lh_" + vid
        painted = getattr(self, "loo_painted", None)
        if painted is None:
            painted = self.loo_painted = {}
        if painted.get(vid) != sig:
            self.paint_sprite("lhs_" + vid, loo_special_art(
                VILLAGERS[vid]["look"], self.season(), *sig))
            painted[vid] = sig
        return "lhs_" + vid

    def use_loo(self, vid):
        """Somebody's been: a little more in the pit, a little less
        clean."""
        ls = self.loo_state(vid)
        ls["pit"] += 1
        ls["grime"] += 1

    def loo_door(self, vid):
        n = self.npcs[vid]
        return n.x, n.y + 1

    def loo_bump(self, n):
        """Walking into an outhouse: in by the door, a knock anywhere
        else."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        inside = [o for o in self.npcs.values()
                  if o.visit and o.visit["loo"] == vid and o.hidden]
        ls = self.loo_state(vid)
        if ls["tipped"] or tuple(self.pos()) != self.loo_door(vid):
            self.walking = None
            done = self.friend(vid).get("cleaned") == self.st["day"]
            grime = ls["grime"]
            items = []
            if ls["tipped"]:
                items.append(("Set it upright",
                              lambda: self.right_loo(vid)))
            items.append(("Clean it%s" % (
                " (done today)" if done else " (filthy!)" if grime >=
                LOO_FILTHY else " (grubby)" if grime >= LOO_GRUBBY else ""),
                lambda: self.clean_loo(vid)))
            if ls["pit"] >= PIT_PER_FERT:
                items.append(("Empty the pit (%d fertilizer)" % (
                    ls["pit"] // PIT_PER_FERT),
                    lambda: self.empty_pit(vid)))
            if self.decor_choices(vid):
                items.append(("Decorate it", lambda: self.decorate_menu(
                    vid)))
            items += [("Knock", lambda: self.knock_loo(vid)),
                      ("Leave it be", lambda: None)]
            self.open_menu("The outhouse that is %s%s" % (
                name, ", lying on its side" if ls["tipped"] else ""), items)
            return
        if inside:
            self.say("You rattle the door. \"Occupied!\" calls %s from "
                     "inside." % inside[0].name, "info")
            self.end_turn(1)
            return
        self.st["loo_in"] = vid
        a = self.areas["loo"]
        self.sound.play("door")
        self.area = a
        self.st["pos"] = list(a.entry)
        self.face(0, -1)
        self.say("You step into the outhouse that is %s and latch the "
                 "door. %s" % (name, random.choice(
                     LOO_IN_LIKE if self.likes_change(vid, "looify") else
                     LOO_IN_HATE)), "info")
        self.walking = None
        self.layout()
        self.end_turn(WALK_COST)

    def loo_inside(self):
        """What's to be seen inside the outhouse you're in."""
        vid = self.st.get("loo_in")
        if not vid:
            return {}
        ls = self.loo_state(vid)
        out = {}
        if "flowers" in ls["decor"]:
            out[(1, 1)] = "decor_flowers"
        if "curtains" in ls["decor"]:
            out[(3, 0)] = "decor_curtains"
        if "wreath" in ls["decor"]:
            out[(3, 3)] = "decor_wreath"
        if ls["grime"] >= LOO_FILTHY:
            out[(2, 2)] = "flies"
            out[(5, 2)] = "flies"
        return out

    def empty_pit(self, vid):
        """Dig out the pit from round the back: fertilizer, one sack for
        every few visits."""
        ls = self.loo_state(vid)
        sacks = ls["pit"] // PIT_PER_FERT
        if not sacks or not self.spend("hoe"):
            return
        ls["pit"] -= sacks * PIT_PER_FERT
        self.give("fertilizer", sacks)
        self.sound.play("chop")
        name = VILLAGERS[vid]["short"]
        self.say("Holding your breath, you dig out the pit behind %s and "
                 "bag it up. (+%d fertilizer)" % (name, sacks), "good")
        self.say(random.choice(
            LOO_PIT_LIKE if self.likes_change(vid, "looify") else
            LOO_PIT_HATE).replace("{who}", name), "talk")
        self.end_turn(TOOL_COST)

    def right_loo(self, vid):
        """Set an outhouse the pranksters tipped over back on its feet."""
        ls = self.loo_state(vid)
        if not ls["tipped"]:
            return
        if not self.spend("hoe"):
            return
        ls["tipped"] = False
        name = VILLAGERS[vid]["short"]
        self.sound.play("door")
        n = self.npcs[vid]
        self.flash(n.x, n.y, "heart")
        self.say("You heave the outhouse that is %s upright again." % name,
                 "good")
        self.say(random.choice(
            LOO_RIGHT_LIKE if self.likes_change(vid, "looify") else
            LOO_RIGHT_HATE).replace("{who}", name), "talk")
        self.befriend(vid, 60)
        self.end_turn(TOOL_COST)

    def decor_choices(self, vid):
        """What you could put up in this outhouse: (decoration, item)."""
        ls = self.loo_state(vid)
        have = self.p["items"]
        out = []
        if "flowers" not in ls["decor"]:
            for f in LOO_FLOWERS:
                if have.get(f):
                    out.append(("flowers", f))
                    break
        if "wreath" not in ls["decor"] and have.get("holly"):
            out.append(("wreath", "holly"))
        if "curtains" not in ls["decor"] and have.get("cloth"):
            out.append(("curtains", "cloth"))
        return out

    def decorate_menu(self, vid):
        self.open_menu("Put up what?", [
            ("%s (1 %s)" % (cap(LOO_DECOR[d]), item),
             lambda d=d, item=item: self.decorate_loo(vid, d, item))
            for d, item in self.decor_choices(vid)] +
            [("Nothing", lambda: None)])

    def decorate_loo(self, vid, d, item):
        ls = self.loo_state(vid)
        if d in ls["decor"] or not self.take(item):
            return
        ls["decor"].append(d)
        name = VILLAGERS[vid]["short"]
        n = self.npcs[vid]
        self.flash(n.x, n.y, "sparkle")
        self.sound.play("pick")
        self.say("You put up %s in the outhouse that is %s." % (
            LOO_DECOR[d], name), "good")
        if self.likes_change(vid, "looify"):
            self.say(random.choice(LOO_DECOR_LIKE).replace("{who}", name),
                     "talk")
            self.befriend(vid, GIFT_POINTS["like"])
        else:
            self.say(random.choice(LOO_DECOR_HATE).replace("{who}", name),
                     "talk")
            self.befriend(vid, GIFT_POINTS["neutral"])
        self.end_turn(TOOL_COST)

    def read_almanac(self):
        """Tomorrow's weather, and a tip for the season, or a joke."""
        st = self.st
        if random.random() < 0.25:
            self.say(random.choice(LOO_ALMANAC), "info")
        else:
