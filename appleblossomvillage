            for x in range(1, 15, 3):
                c = rng.choice(("#e04040", "#40a040", "#f0d040", "#e0e0e0",
                                "#a060c0", "#e08030", "#80c0f0"))
                rect(g, x, sh + 1, x + 1, sh + 3, c)
                g[sh + 1][x] = shade(c, 1.3)
            rect(g, 0, sh + 4, 15, sh + 4, "#3a2414")
