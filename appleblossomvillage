        rect(g, 5, 3, 6, 14, "#d0d8e0")
        rect(g, 3, 2, 12, 3, "#788088")
        rect(g, 4, 8, 11, 8, "#788088")
        rect(g, 6, 0, 9, 1, "#788088")
