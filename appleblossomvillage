def style_hair(rows, style, sex):
    """A sprite's hair done one of HAIRSTYLES."""
    def put(cells, ch="h"):
        for y, x in cells:
            if 0 <= y < 16 and 0 <= x < 16 and rows[y][x] in ".":
                rows[y][x] = ch
    if style == "bald":
        for y in range(1, 4):
            for x in range(16):
                if rows[y][x] == "h":
                    rows[y][x] = "k" if y < 3 else rows[y][x]
        return
    if style in ("long", "braid", "curly", "bangs") and sex != "C":
        put([(y, x) for y in range(4, 10) for x in (3, 12)])
    if style == "bangs":
        y = 4 if sex != "C" else 6
        for x in range(16):
            if rows[y][x] == "k":
                rows[y][x] = "h"
    if style == "curly":
        put(((0, 6), (0, 9), (1, 4), (1, 11), (2, 3), (2, 12)))
    if style == "spiky":
        put(((0, 5), (0, 7), (0, 9), (0, 11), (1, 4), (1, 11)))
    if style == "messy":
        put(((0, 7), (0, 9), (1, 5), (2, 4), (2, 12)))
    if style == "ponytail":
        put(((2, 12), (3, 13), (4, 13), (5, 13), (6, 13), (7, 12)))
    if style == "bun":
        put(((0, 7), (0, 8), (0, 6), (0, 9)))
    if style == "pigtails":
