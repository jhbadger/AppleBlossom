    def tapped(self, ev):
        if time.time() < getattr(self, "tap_guard", 0) or not self.area:
            return
        self.on_tap(ev)

    def open_dialog(self):
        dlg = getattr(self, "dialog", None)
        try:
            if dlg is not None and dlg.winfo_exists():
                dlg.lift()
                return False
        except tk.TclError:
            pass
        return True

    def close_dialog(self, dlg=None):
        dlg = dlg or getattr(self, "dialog", None)
        if dlg is not None:
            try:
                dlg.destroy()
            except tk.TclError:
                pass
        if dlg is getattr(self, "dialog", None):
            self.dialog = None
        self.tap_guard = time.time() + 0.6

    def grab(self, dlg):
        try:
            dlg.grab_set()
        except tk.TclError:
            pass

