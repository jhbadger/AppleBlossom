class Mob:
    """A monster in the mine."""

    def __init__(self, idx, kind, x, y):
        self.idx, self.kind, self.x, self.y = idx, kind, x, y
        self.m = MONSTERS[kind]
        self.hp = self.m.hp
        self.aware = False
        self.stun = 0               # turns it stands about, baffled
        self.tile = "mon_" + kind


# ── Areas and people ─────────────────────────────────────────────────────────


class Area:
    """A map: the valley, or a room."""

    def __init__(self, key, grid, name):
        self.key, self.grid, self.name = key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.labels = {}
        self.spots = {}
        self.entry = None           # where you stand coming in
        self.exit = None            # the doormat that takes you out
        self.outdoor = key == "valley"

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h


class Villager:
    """Somebody in the village: where they are and where they're going."""

    def __init__(self, vid):
        self.vid = vid
        self.data = VILLAGERS[vid]
        self.name = self.data["short"]
        self.tile = "v_" + vid
        self.where = None           # the area they're in
        self.x = self.y = 0
        self.goal = None            # (area, x, y) they're heading for
        self.path = []
        self.stuck = 0
        self.visit = None           # off to (or in) an outhouse
        self.hidden = False         # inside one, out of sight


def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def parse_line(line):
    """'(happy)Hello' -> ('happy', 'Hello')."""
    m = re.match(r"\((\w+)\)", line)
    if m and m.group(1) in EXPRESSIONS:
        return m.group(1), line[m.end():]
    return "neutral", line


def gift_taste(vid, item):
    item = base_item(item)
    v = VILLAGERS[vid]
    kind = "kind:" + ITEMS.get(item, (0, 0, "?"))[2]
    for taste in ("loves", "hates", "dislikes", "likes"):
        if item in v[taste] or kind in v[taste]:
            return {"loves": "love", "likes": "like", "dislikes": "dislike",
                    "hates": "hate"}[taste]
    k = ITEMS.get(item, (0, 0, "?"))[2]
    if k in ("food", "fruit"):
        return "like"
    if k == "material":
        return "dislike"
    return "neutral"


