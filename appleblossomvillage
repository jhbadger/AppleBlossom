            prect(g, x0, ey - 2, x0, ey + 1, gc)
            prect(g, x0 + eye_w + 1, ey - 2, x0 + eye_w + 1, ey + 1, gc)
        g[ey - 1][15] = g[ey - 1][16] = gc
    ny = fy + 3
    g[ny][15] = skd
    g[ny + 1][15] = skdd
    g[ny + 1][16] = skd
    if "nosering" in extras:
        g[ny + 2][15] = g[ny + 2][16] = "#d4d4dc"
