        rect(g, 2, 4, 13, 5, "#5a3a20")
        return g
    if name == "forge":
        g = stone_blocks(rng, "#5a5050", "#3a3030", 5, 4)
        rect(g, 3, 5, 12, 13, "#2a1810")
        disc(g, 7.5, 10, 4, "#f08020" if frame else "#e04010")
