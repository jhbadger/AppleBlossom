                continue
            if 3 <= x <= 18 and 16 <= y <= 30:          # the yard
                continue
            if 13 <= x <= 22 and 27 <= y <= 33:         # a plot to start
                continue
            r = rng.random()
            kind = ("weed" if r < 0.16 else "stone" if r < 0.21 else
                    "branch" if r < 0.26 else "stump" if r < 0.27 else None)
            if kind:
                debris[(x, y)] = kind
    return debris


def on_farm(x, y):
    fx0, fy0, fx1, fy1 = FARM
    return fx0 < x < fx1 and fy0 < y < fy1


def forage_spots(grid):
    """Where the wild things grow: in the woods, in the fields, on the
    beach."""
    spots = {"wood": [], "field": [], "beach": []}
    for y in range(VH):
        for x in range(VW):
            t = grid[y][x]
            if on_farm(x, y):
                continue
            if t in ("grass", "meadow", "tallgrass"):
                if y < 9 or x > 94:
                    spots["wood"].append((x, y))
                elif x > RIVER[1] or y > 48:
                    spots["field"].append((x, y))
            elif t == "sand" and y < LAKE_Y:
                spots["beach"].append((x, y))
    return spots


