def golden(px):
    """A sprite turned to gold: each pixel's brightness, in gold."""
    out = []
    for row in px:
        line = []
        for c in row:
            if c is None:
                line.append(None)
                continue
            r, g, b = (int(c[i:i + 2], 16) for i in (1, 3, 5))
            lum = (0.3 * r + 0.59 * g + 0.11 * b) / 255
            lum = 0.25 + 0.75 * lum
            line.append(mix("#6a4808", "#e8b830", lum * 1.4) if lum < 0.7
                        else mix("#e8b830", "#fff4b0", (lum - 0.7) / 0.3))
        out.append(line)
    for (x, y) in ((5, 2), (6, 3), (10, 8)):        # a glint or two
        if out[y][x]:
            out[y][x] = "#ffffff"
    return out


