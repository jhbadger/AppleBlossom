def mine_theme(floor):
    """Earth, stone, crystal, fire, the abyss; and the tower's marble."""
    return 5 if floor > TOWER else min(4, (floor - 1) // 3)


def make_mine_floor(seed, floor):
    """One floor of the old mine, the same every time: (grid, the up
    ladder, the down ladder or None, the first monsters [(kind, x, y)],
    the chests)."""
    rng = random.Random("mine:%s:%d" % (seed, floor))
    W, H = 36, 24
    th = mine_theme(floor)
    wall, ground = "mwall_%d" % th, "mfloor_%d" % th
    while True:
        g = blank(W, H, wall)
        rooms = []
        for _ in range(400):
            if len(rooms) >= 7:
                break
            w, h = rng.randint(4, 8), rng.randint(3, 6)
            x, y = rng.randint(1, W - w - 1), rng.randint(1, H - h - 1)
            if any(x <= r[2] + 2 and r[0] <= x + w + 1 and
                   y <= r[3] + 2 and r[1] <= y + h + 1 for r in rooms):
                continue
            rooms.append((x, y, x + w - 1, y + h - 1))
        if len(rooms) >= 5:
            break
    rooms.sort(key=lambda r: r[0] + r[2] + rng.random())
    centres = [((r[0] + r[2]) // 2, (r[1] + r[3]) // 2) for r in rooms]

    def carve(a, b):
        (ax, ay), (bx, by) = a, b
        if rng.random() < 0.5:
            pts = [(x, ay) for x in range(min(ax, bx), max(ax, bx) + 1)]
            pts += [(bx, y) for y in range(min(ay, by), max(ay, by) + 1)]
        else:
            pts = [(ax, y) for y in range(min(ay, by), max(ay, by) + 1)]
            pts += [(x, by) for x in range(min(ax, bx), max(ax, bx) + 1)]
        for x, y in pts:
            g[y][x] = ground
    for r in rooms:
        for y in range(r[1], r[3] + 1):
            for x in range(r[0], r[2] + 1):
                g[y][x] = ground
    for a, b in zip(centres, centres[1:]):
        carve(a, b)
    for _ in range(2):                  # a loop or two
        i, j = sorted(rng.sample(range(len(rooms)), 2))
        carve(centres[i], centres[j])
    up = centres[0]
    g[up[1]][up[0]] = "ladder_up_%d" % th
    down = None
    end = centres[-1]
    if floor not in (MINE_FLOORS, TOWER_TOP):
        down = end
        g[end[1]][end[0]] = "ladder_down_%d" % th
    elif floor == MINE_FLOORS:           # where the winged key waits
        g[end[1]][end[0]] = "pedestal_key"
    keep = {up, (up[0], up[1] + 1), end, (end[0], end[1] + 1)}
    spots = [(x, y) for y in range(H) for x in range(W)
             if g[y][x] == ground and (x, y) not in keep]
    chests = []
    inner = [(x, y) for r in rooms[1:] for x in range(r[0] + 1, r[2])
             for y in range(r[1] + 1, r[3]) if (x, y) not in keep]
    for x, y in rng.sample(inner, min(len(inner), rng.randint(1, 3))):
        g[y][x] = "chest_%d" % th
        chests.append((x, y))
    faces = [(x, y) for y in range(1, H - 1) for x in range(1, W - 1)
             if g[y][x] == wall and any(g[y + dy][x + dx] == ground
                                        for dx, dy in DIRS)]
    metals = [k for k in METALS if ORES[k][0][0] <= floor <= ORES[k][0][1]]
    for x, y in rng.sample(faces, min(len(faces), rng.randint(3, 6)
                                      if metals else 0)):
        g[y][x] = "ore_%s_%d" % (rng.choice(metals + metals[-1:]), th)
    faces = [p for p in faces if g[p[1]][p[0]] == wall]
    if 1 < floor < TOWER:
        for x, y in rng.sample(faces, min(len(faces), (rng.random() < 0.6) +
                                          (floor > 6))):
            g[y][x] = "ore_crystal_%d" % th
    kinds = [k for k, m in MONSTERS.items() if "boss" not in m.traits and
             m.floors[0] <= floor <= m.floors[1]]
    far = [p for p in spots if p not in chests and
           abs(p[0] - up[0]) + abs(p[1] - up[1]) >= 6]
    mobs = [(rng.choice(kinds), x, y) for x, y in rng.sample(
        far, min(len(far), 3 + floor // 2 + rng.randint(0, 2)))]
    if floor == KING_FLOOR:              # on the stair down, guarding it
        mobs.append(("king", end[0], end[1] + 1))
    if floor == TOWER_TOP:
        mobs.append(("archangel", end[0], end[1]))
    return g, up, down, mobs, chests


