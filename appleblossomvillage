def outfit_look(look, kind, colour):
    """A maid out of uniform: a shawl over it, a sundress and straw hat,
    or a yukata with an obi."""
    new = dict(look)
    if kind == "shawl":
        new["extras"] = tuple(look.get("extras", ())) + ("scarf",)
        new["scarfc"] = colour
        return new
    new["extras"] = tuple(e for e in look.get("extras", ())
                          if e not in ("apron", "maidcap", "bow"))
    skin = SKIN[look.get("skin", 1) % len(SKIN)]
    if kind == "sundress":
        new["extras"] += ("hat",)
        new.update(shirt=colour, pants=colour, trim=shade(colour, 0.85),
                   collar=skin, hat="#e8c870", hatc="#e8c870",
                   shoes="#c89060")
    elif kind == "sailor":
        new["extras"] += ("sailor",)
        new.update(shirt="#f4f2ec", pants=colour, trim=colour,
                   collar=colour, sailorc=colour, shoes="#2a2028",
                   kerchief="#d03040" if colour != "#5a2232" else
                   "#f4c040")
    elif kind == "pirate":
        new["extras"] += ("tricorn", "eyepatch")
        new.update(shirt=colour, pants="#2a2420", trim="#c8a040",
                   collar="#f4f0e8", hat="#1e1a1e", hatc="#1e1a1e",
                   shoes="#2a1a10")
    else:                                               # a yukata
