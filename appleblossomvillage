    """A villager turned tree: leaves for the season, a hint of their hair
    in the green, and their face peering out of the trunk; hung with
    fruit, if they're a fruit tree."""
    if fruit:
        px = tree_art(look, season)
        col = FRUIT_TREES[fruit][1]
        for x, y in FRUIT_SPOTS:
            if px[y][x] and px[y][x] != "#7a5434":
                px[y][x] = col
