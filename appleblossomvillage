def cap(s):
    return s[:1].upper() + s[1:]


def an(s):
    if s in ITEMS and ITEMS[s][2] in ("material",) or s.endswith("s") and \
            s not in ("cress",):
        return "some " + s
    return ("an " if s[:1] in "aeiou" else "a ") + s


def and_list(words):
    """"a", "a and b", "a, b and c"."""
    words = list(words)
    if len(words) < 2:
        return "".join(words)
    return ", ".join(words[:-1]) + " and " + words[-1]


def plural(s, n):
    if n == 1 or s.endswith(("s", "fish")) or s in (
            "wood", "stone", "fiber", "corn", "holly", "coral", "bread",
            "tea", "coffee", "stew", "salad", "chocolate", "salmon", "tuna",
            "trout", "perch", "pike", "carp", "bream", "herring",
            "flounder", "catfish", "sunfish", "golden carp", "eel"):
        return s
    if s.endswith("y") and not s.endswith(("ey", "ay")):
        return s[:-1] + "ies"
    if s.endswith(("o", "ch", "sh")):
        return s + "es"
    return s + "s"


def wrap(text, width):
    out = []
    for para in text.split("\n"):
        line = ""
        for word in para.split():
            if line and len(line) + 1 + len(word) > width:
                out.append(line)
                line = word
            else:
                line = (line + " " + word) if line else word
        out.append(line)
    return out


def fill_in(text, game):
    p = game.p
    return text.replace("{name}", p["name"]).replace("{farm}", p["farm"])


def describe_item(n):
    val, energy, kind = ITEMS.get(n, (0, 0, "?"))
    if n.endswith(" seeds"):
        c = n[:-6]
        return "%s: plant in %s; ripe in %d days%s. Sells for %dg." % (
            cap(n), " or ".join(SEASONS[s] for s in crop(c, "seasons")),
            crop(c, "days"), ", then every %d" % crop(c, "regrow")
            if crop(c, "regrow") else "", crop(c, "price"))
    if n == "sprinkler":
        return "A sprinkler: waters the four squares around it each morning."
    bits = [cap(n) + "."]
    if val:
        bits.append("Sells for %dg." % val)
    if energy:
        bits.append("Eat it for %d energy." % energy)
    if kind == "gift":
        bits.append("A gift for someone special.")
    if kind == "romance":
        bits.append({"blossom bouquet": "Give it to someone at 8 hearts to "
                                        "ask them to go steady.",
                     "blossom pendant": "Give it to your sweetheart at 10 "
                                        "hearts to propose."}[n])
    return " ".join(bits)


