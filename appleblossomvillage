def loo_special_art(look, season, filthy, decor, tipped):
    """An outhouse with something about it: flies, flowers, a wreath on
    the door, curtains in the moon, or knocked onto its side."""
    px = loo_art(look, season)
    if "curtains" in decor:
        for row in px:
            for x, c in enumerate(row):
                if c == "#f4e070":
                    row[x] = "#e05878"
    if "wreath" in decor:
        for x, y in ((6, 9), (7, 8), (8, 8), (9, 9), (6, 10), (9, 10),
                     (7, 11), (8, 11)):
            px[y][x] = "#2a7a3a"
        px[8][7] = "#d02030"
    if "flowers" in decor:
        for x, y, c in ((0, 13, "#a0603a"), (1, 13, "#a0603a"),
                        (0, 14, "#7a4428"), (1, 14, "#7a4428"),
                        (0, 12, "#4a8a3a"), (1, 11, "#f06080"),
                        (0, 11, "#f4d030")):
            px[y][x] = c
    if filthy:
        for x, y in ((1, 3), (14, 2), (13, 6), (2, 7)):
            px[y][x] = "#1a1a1a"
            if px[y - 1][x] is None:
                px[y - 1][x] = "#c8d8e8"
