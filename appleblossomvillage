        self.talk_menu()

    def loo_room(self, n):
        """Is there room for an outhouse where somebody stands: out of
        doors, off any doorstep, with clear ground in front for the
        door?"""
        if not self.area.outdoor or n.where != "valley":
            return False
        x, y = n.x, n.y + 1
        if (n.x, n.y) in self.door_at or (x, y) in self.door_at:
            return False
        if not self.can_stand(x, y):
            return False
        o = self.npc_at(x, y)
        return o is None or not self.rooted(o.vid)

    def outside_door(self):
        """The square outside the room you're in."""
        key = self.area.key
        if key == "loo":
            vid = self.st.get("loo_in")
            if vid in self.st["loos"]:
                x, y = self.loo_door(vid)
                return x, y - 1
            key = "cabin"
        return door_of(key)

    def loo_door(self, vid):
        n = self.npcs[vid]
        return n.x, n.y + 1

    def loo_bump(self, n):
        """Walking into an outhouse: in by the door, a knock anywhere
        else."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        inside = [o for o in self.npcs.values()
                  if o.visit and o.visit["loo"] == vid and o.hidden]
        if tuple(self.pos()) != self.loo_door(vid):
            self.walking = None
            done = self.friend(vid).get("cleaned") == self.st["day"]
            self.open_menu("The outhouse that is %s" % name, [
                ("Clean it%s" % (" (done today)" if done else ""),
                 lambda: self.clean_loo(vid)),
                ("Knock", lambda: self.knock_loo(vid)),
                ("Leave it be", lambda: None)])
            return
        if inside:
            self.say("You rattle the door. \"Occupied!\" calls %s from "
                     "inside." % inside[0].name, "info")
            self.end_turn(1)
            return
        self.st["loo_in"] = vid
        a = self.areas["loo"]
        self.sound.play("door")
        self.area = a
        self.st["pos"] = list(a.entry)
        self.face(0, -1)
        self.say("You step into the outhouse that is %s and latch the "
                 "door. %s" % (name, random.choice(
                     LOO_IN_LIKE if self.likes_change(vid, "looify") else
                     LOO_IN_HATE)), "info")
        self.walking = None
        self.layout()
        self.end_turn(WALK_COST)

    def knock_loo(self, vid):
        self.say("You knock on the side of the outhouse that is %s. "
                 "The door's round the front." % VILLAGERS[vid]["short"],
                 "info")
        self.end_turn(1)

    def clean_loo(self, vid):
        """A scrub of the outside walls, once a day: as good as a gift
        they like, and sometimes they say so."""
        f = self.friend(vid)
        name = VILLAGERS[vid]["short"]
        if f.get("cleaned") == self.st["day"]:
            self.say("You've already scrubbed %s today. The boards are "
                     "still damp." % name, "info")
            self.render()
            return
        f["cleaned"] = self.st["day"]
        n = self.npcs[vid]
        self.sound.play("pour")
        self.flash(n.x, n.y, "heart")
        self.say(random.choice(LOO_CLEAN) % name, "good")
        if random.random() < 0.5:
            self.say(random.choice(
                LOO_CLEAN_LIKE if self.likes_change(vid, "looify") else
                LOO_CLEAN_HATE).replace("{who}", name), "talk")
        self.befriend(vid, GIFT_POINTS["like"])
        self.end_turn(TOOL_COST)

    def do_business(self):
        vid = self.st["loo_in"]
        name = VILLAGERS[vid]["short"] if vid else "nobody"
        self.sound.play(random.choice(("pour", "raspberry")))
        self.say(random.choice(LOO_BUSINESS), "info")
        if vid and random.random() < 0.5:
            self.say(random.choice(
                LOO_VOICE_LIKE if self.likes_change(vid, "looify") else
                LOO_VOICE_HATE).replace("{who}", name), "info")
        if vid and random.random() < 0.25:
            here = self.npcs[vid]
            near = [o for o in self.npcs.values()
                    if o.where == "valley" and not o.hidden and
                    not self.rooted(o.vid) and
                    abs(o.x - here.x) + abs(o.y - here.y) <= 8]
            if near:
                self.say("Somebody knocks. \"Will you be long?\" calls "
                         "%s." % random.choice(near).name, "info")
        self.end_turn(5)

    def loo_visits(self, n, here, visible):
        """Somebody near an outhouse may pop in for a minute or two: True
        if they're busy with that and shouldn't go anywhere else."""
        st = self.st
        v = n.visit
        if v:
            o = self.npcs.get(v["loo"])
            if not self.loo(v["loo"]):
                n.visit, n.hidden = None, False
                return False
            if v["in"]:
                if st["minute"] >= v["until"]:
                    n.visit, n.hidden = None, False
                    x, y = self.loo_door(v["loo"])
                    taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                             if m is not n}
                    n.x, n.y = self.free_spot("valley", x, y, taken)
                    if here == "valley" and visible and self.near_you(n):
                        self.say(random.choice(LOO_OUT).replace(
                            "{who}", n.name), "info")
                    n.goal, n.path = None, []
                    return False
                return True
            if (n.where, n.x, n.y) == ("valley",) + self.loo_door(v["loo"]):
                if here == "loo" and st["loo_in"] == v["loo"]:
                    self.say("Somebody tries the door. \"Oh! Sorry!\" says "
                             "%s, and footsteps hurry away." % n.name,
                             "info")
                    n.visit = None
                    return False
                v["in"], n.hidden = True, True
                v["until"] = st["minute"] + random.randint(3, 8)
                if here == "valley" and visible and self.near_you(n):
                    self.say(random.choice(LOO_GO_IN).replace(
                        "{who}", n.name).replace(
                        "{loo}", VILLAGERS[o.vid]["short"]), "info")
                return True
            if st["minute"] > v["give_up"]:
                n.visit = None
            return False
        if not st["loos"] or n.where != "valley" or here != "valley" or \
                not visible or random.random() > 0.012:
            return False
        for lv in st["loos"]:
            o = self.npcs[lv]
            if o.where == "valley" and \
                    abs(o.x - n.x) + abs(o.y - n.y) <= 6 and \
                    not any(m.visit and m.visit["loo"] == lv
                            for m in self.npcs.values()):
                n.visit = {"loo": lv, "in": False,
                           "give_up": st["minute"] + 40}
                n.goal, n.path, n.stuck = None, [], 0
                return False
        return False

    def near_you(self, n):
        x, y = self.pos()
        return abs(n.x - x) <= 9 and abs(n.y - y) <= 7

    def tree_bump(self, n):
        """Walking into a villager-tree: a rustle, glad or cross; walk into
        it again straight away to push through the branches."""
        vid = n.vid
        here = (vid, self.area.key, n.x, n.y, self.pos())
        if getattr(self, "last_statue", None) == here and \
                self.squeeze_past(n):
            self.last_statue = None
            self.say("You push through %s's branches and out the other "
                     "side, picking a leaf out of your collar." %
                     VILLAGERS[vid]["short"], "info")
        else:
            self.last_statue = here
            self.say(random.choice(
                TREE_HAPPY if self.likes_change(vid, "treeify") else
                TREE_CROSS).replace("{who}", VILLAGERS[vid]["short"]) +
                " (Walk into it again to push past.)", "info")
        self.end_turn(1)

    def tend_tree(self, n, tool):
        """A watering can or an axe, used on somebody who's a tree."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        if tool == "axe":
            self.chop_villager(n)
            return
        f = self.friend(vid)
        if f.get("watered") == self.st["day"]:
            self.say("%s's roots are already soaked today." % name, "info")
            self.render()
            return
        if self.p["water"] <= 0:
            self.say("The can's empty. Fill it at the well or any water.",
                     "bad")
            return
        if not self.spend("watering can"):
            return
        self.p["water"] -= 1
        f["watered"] = self.st["day"]
        self.sound.play("water")
        if self.likes_change(vid, "treeify"):
            self.say("You water %s. The leaves shiver happily, and a "
                     "blossom or two opens just for you." % name, "heart")
            self.befriend(vid, GIFT_POINTS["like"])
        else:
            self.say("You water %s, who shakes the water off at you, "
                     "crossly." % name, "info")
        self.end_turn(TOOL_COST - 1)

    def chop_tree(self, x, y, kind):
        """A swing of the axe at a tree; the third brings it down, for wood
        and a stump.  It grows back in a season."""
        if not self.spend("axe"):
            return
        k = "%d,%d" % (x, y)
        chops = getattr(self, "chops", {})
        if chops.get("at") != k:
            chops = {"at": k, "n": 0}
        chops["n"] += 1
        self.chops = chops
        self.sound.play("chop")
        if chops["n"] < CHOPS:
            left = CHOPS - chops["n"]
            self.say("You chop at the %s. Chips fly. (%d more swing%s.)" % (
                kind, left, "s" if left > 1 else ""), "info")
            self.end_turn(TOOL_COST)
            return
        self.chops = {}
        wood = CHOPPABLE[kind]
        self.st["felled"][k] = [self.st["day"], kind]
        self.areas["valley"].grid[y][x] = "grass"
        self.st["debris"][k] = "stump"
        self.give("wood", wood)
        self.flash(x, y, "puff")
        self.say("Timber! The %s comes down with a creak and a crash. "
                 "(+%d wood, and a stump to clear.)" % (kind, wood), "good")
        self.end_turn(TOOL_COST + 2)

    def apply_felled(self):
        """Felled trees, onto a freshly built valley (forgetting any that
        no longer stand there, if the valley has changed since)."""
        g = self.areas["valley"].grid
        st = self.st
        for k in list(st.get("felled", {})):
            x, y = map(int, k.split(","))
            if 0 <= x < VW and 0 <= y < VH and g[y][x] in CHOPPABLE:
                g[y][x] = "grass"
            else:
                del st["felled"][k]
                if st["debris"].get(k) == "stump":
                    del st["debris"][k]

    def regrow_trees(self):
        """Felled trees grow back after a season, where there's room."""
        st = self.st
        g = self.areas["valley"].grid
        for k, (day, kind) in list(st["felled"].items()):
            if st["day"] - day < REGROW_DAYS:
                continue
            x, y = map(int, k.split(","))
            if (x, y) == tuple(st["pos"]) or k in st["soil"] or \
                    k in st["sprinklers"] or k in st["forage"] or \
                    any(n.where == "valley" and (n.x, n.y) == (x, y)
                        for n in self.npcs.values()):
                continue
            if st["debris"].get(k) not in (None, "stump"):
                continue
            st["debris"].pop(k, None)
            g[y][x] = kind
            del st["felled"][k]

    def chop_villager(self, n):
        """The axe, on somebody who's a tree.  It works, but the tree
        screams, and it doesn't forgive you."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        if VILLAGERS[vid]["look"].get("age") == "child":
            self.say("You raise the axe, see %s's little face in the bark, "
                     "and can't do it. Nobody could." % name, "info")
            self.render()
            return
        if not self.spend("axe"):
            return
        k = "npc:" + vid
        chops = getattr(self, "chops", {})
        if chops.get("at") != k:
            chops = {"at": k, "n": 0}
        chops["n"] += 1
        self.chops = chops
        self.sound.play("scream")
        self.befriend(vid, -100, quiet=True)
        if chops["n"] < CHOPS:
            self.say(TREE_SCREAMS[chops["n"] - 1].replace("{who}", name),
                     "bad")
            self.end_turn(TOOL_COST)
            return
        self.chops = {}
        self.st["trees"].remove(vid)
        n.goal, n.path, n.stuck = None, [], 0
        self.give("wood", CHOPPABLE["tree"])
        self.flash(n.x, n.y, "puff")
        self.say("With a last, long scream the tree that was %s topples, "
                 "and the trunk splits open. Out tumbles %s, whole, shaking, "
                 "and covered in sawdust. (+%d wood.)" % (
                     name, name, CHOPPABLE["tree"]), "bad")
        self.befriend(vid, -300, quiet=True)
        if self.talk:
            self.end_talk()
        self.talk = {"v": vid, "mode": "kw", "expr": "cross", "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.friend(vid)["met"] = True
        self.speak(vid, TREE_CHOPPED[vid])
        self.say("(%s will not forget this.)" % name, "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    def chore_menu(self, vid):
        name = VILLAGERS[vid]["short"]
        now = self.st["maids"].get(vid)
        self.open_menu("What should %s do each morning?%s" % (
            name, " (Now: %s.)" % MAID_CHORES[now][0].lower() if now
            else ""), [
            (label, lambda c=c: self.set_chore(vid, c))
            for c, (label, _) in MAID_CHORES.items()],
            cancel=lambda: None)

    def set_chore(self, vid, chore):
        self.st["maids"][vid] = chore
        pool = MAID_OK_LIKE if self.likes_change(vid, "maidify") else \
            MAID_OK_HATE
        self.speak(vid, random.choice(pool).replace(
            "{chore}", MAID_CHORES[chore][1]))

    def kiss_maid(self, vid):
        """A kiss for your maid: twice a day, each one as good as a gift
        she likes."""
        f = self.friend(vid)
        day, n = f.get("kissed") or (None, 0)
        if day != self.st["day"]:
            n = 0
        name = VILLAGERS[vid]["short"]
        if n >= 2:
            self.speak(vid, random.choice(MAID_KISS_ENOUGH))
            self.talk_menu()
            return
        f["kissed"] = [self.st["day"], n + 1]
        self.say("> (you kiss %s on the cheek)" % name, "you")
        likes = self.likes_change(vid, "maidify")
        self.speak(vid, random.choice(MAID_KISS_LIKE if likes else
                                      MAID_KISS_HATE))
        self.befriend(vid, GIFT_POINTS["like"])
        self.flash(self.npcs[vid].x, self.npcs[vid].y, "heart")
        self.sound.play("heart")
        self.pass_time(1)
        self.check_scene(vid)
        if not self.scene:
            self.talk_menu()

    def maid_morning(self):
        """Every maid does what she was told, before you're up."""
        st = self.st
        order = list(MAID_CHORES)
        maids = sorted(st.get("maids", {}).items(),
                       key=lambda m: (order.index(m[1]) if m[1] in order
                                      else 99, m[0]))
        for vid, chore in maids:
            name = VILLAGERS[vid]["short"]
            if self.statue(vid):
                continue
            if chore is None:
                self.say("%s is waiting in your cabin to be told her "
                         "CHORE." % name, "info")
                continue
            likes = self.likes_change(vid, "maidify")
            how = random.choice(MAID_HAPPILY if likes else MAID_GRUMBLING)
            done = self.do_chore(vid, chore)
            if done:
                self.say("%s %s, %s." % (name, done, how),
                         "heart" if likes else "info")

    def do_chore(self, vid, chore):
        """One maid's chore; what she did, or None if there was nothing to
        do."""
        st = self.st
        if chore == "water":
            soil = [s for s in st["soil"].values() if s[1] and not s[3]]
            if not soil or st["weather"] in ("rain", "storm"):
                return None
            for s in st["soil"].values():
                s[0] = 1
            return "watered all the crops"
        if chore == "harvest":
            got = {}
            for k, s in st["soil"].items():
                if self.ripe(s):
                    name = s[1]
                    got[name] = got.get(name, 0) + 1
                    regrow = crop(name, "regrow")
                    if regrow:
                        s[2] = crop(name, "days") - regrow
                    else:
                        s[1], s[2] = None, 0
            if not got:
                return None
            for item, c in got.items():
                self.give(item, c)
            st["stats"]["harvested"] += sum(got.values())
            return "picked %s and put %s in your bag" % (and_list(
                ["%d %s" % (c, plural(n, c)) for n, c in sorted(got.items())]),
                "it" if sum(got.values()) == 1 else "them")
        if chore == "weed":
            keys = [k for k in st["debris"]
                    if FARM[0] < int(k.split(",")[0]) < FARM[2] and
                    FARM[1] < int(k.split(",")[1]) < FARM[3]]
            random.shuffle(keys)
            got = {}
            for k in keys[:12]:
                item, c = DEBRIS[st["debris"].pop(k)][1]
                got[item] = got.get(item, 0) + c
            if not got:
                return None
            for item, c in got.items():
                self.give(item, c)
            return "cleared %d things from the fields (%s for your bag)" % (
                len(keys[:12]), and_list(["%d %s" % (c, n) for n, c in
                                          sorted(got.items())]))
        if chore == "eggs":
            hens = st["chickens"]
            if not hens:
                return None
            n = len(st["eggs"])
            st["eggs"] = []
            for c in hens:
                c["petted"] = st["day"]
            if n:
                self.give("egg", n)
            return "%s and petted %s" % (
                "collected %d egg%s for your bag" % (n, "s" if n > 1 else "")
                if n else "found no eggs", "your hen" if len(hens) == 1
                else "all %d hens" % len(hens))
        if chore == "milk":
            cows = [c for c in st["cows"] if c.get("milked") != st["day"]]
            if not cows:
                return None
            for c in cows:
                c["milked"] = st["day"]
                c["milk"] = c.get("milk", 0) + 1
            self.give("milk", len(cows))
            return "milked %s (%d milk for your bag)" % (
                "your cow" if len(cows) == 1 else "all %d cows" % len(cows),
                len(cows))
        if chore == "cook":
            food = random.choice(("pancakes", "bread", "honey cake",
                                  "stew"))
            self.give(food)
            return "made you breakfast (%s, in your bag)" % food
        return None

    def leashed(self, vid):
        return self.st.get("leashed") == vid

    def leashable(self, vid):
        return (self.chicken(vid) or self.is_cow(vid)) and \
            not self.statue(vid)

    def kept(self, vid):
        """In your coop or your barn, one of your animals."""
        return self.cooped(vid) or self.barned(vid)

    def is_cow(self, vid):
        return vid in self.st.setdefault("cowified", [])

    def barned(self, vid):
        return any(c.get("vid") == vid for c in self.st.get("cows", ()))

    def cow_colour(self, vid):
        """The cow somebody becomes, by the colour of their hair."""
        hair = VILLAGERS[vid]["look"].get("hair", "")
        return {"#1e1a1a": "black", "#221a18": "black", "#4a4040": "black",
                "#5a3a1e": "brown", "#8a4a22": "brown",
                "#a83a1e": "ginger", "#d0502a": "ginger",
                "#e4641c": "ginger", "#2a1a14": "black"}.get(hair,
                                                            "spotted")

    def cowify(self, n):
        """The cowify spell: a cow like the ones Mabel sells, going about
        the villager's day; cast again, and back they come."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        flags = st["flags"]
        if not self.is_cow(vid):
            why = None
            if VILLAGERS[vid]["look"].get("age") == "child":
                why = ("%s moos with delight, but the spell won't stick. "
                       "Some things are best left to grown-ups." % name)
            elif self.statue(vid):
                why = "The spell skids off the gold. Gold doesn't moo."
            elif self.chicken(vid):
                why = ("The spell slides off the hen's feathers. A hen can "
                       "only be so much bigger.")
            elif self.maid(vid):
                why = ("The spell glances off %s's starched apron. A maid "
                       "stays a maid until the spell that made her is "
                       "undone." % name)
            elif self.tree(vid):
                why = ("The spell sinks into %s's bark and is gone." % name)
            elif self.loo(vid):
                why = ("The spell splinters against the outhouse door.")
            if why:
                self.say(why, "info")
                self.end_turn(TOOL_COST)
                return
        if self.talk:
            self.end_talk()
        likes = self.likes_change(vid, "cowify")
        if not self.is_cow(vid):
            st["cowified"].append(vid)
            n.goal, n.path, n.stuck = None, [], 0
            self.say("With a sound like a contented sigh, %s grows, and "
                     "grows, and there stands a %s cow, %s." % (
                         name, self.cow_colour(vid), "mooing happily" if
                         likes else "lowing indignantly"), "quest")
            if likes:
                pts = 0 if "cowliked:" + vid in flags else 150
                flags.append("cowliked:" + vid)
            else:
                pts = -200
            if pts:
                self.befriend(vid, pts, quiet=True)
                self.say("(%s %s.)" % (name, "seems to enjoy being a cow"
                                       if pts > 0 else "is upset with you"),
                         "heart" if pts > 0 else "bad")
            self.end_turn(TOOL_COST)
            return
        st["cowified"].remove(vid)
        n.goal, n.path, n.stuck = None, [], 0
        if self.leashed(vid):
            st["leashed"] = None
        self.unbarn(vid)
        self.say("A last long moo, and %s is back on two feet, brushing "
                 "straw off." % name, "quest")
        if likes:
            pts = -80
        else:
            pts = 0 if "cowfixed:" + vid in flags else 120
            flags.append("cowfixed:" + vid)
        self.talk = {"v": vid, "mode": "kw", "expr": "surprised",
                     "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.friend(vid)["met"] = True
        self.speak(vid, COW_BACK[vid][0 if likes else 1])
        if pts:
            self.befriend(vid, pts)
            self.say("(%s %s.)" % (name, "likes you more for it" if pts > 0
                                   else "is upset with you"),
                     "heart" if pts > 0 else "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    def barn_cow(self, vid):
        """A villager-cow led into the barn: one of your cows now."""
        st = self.st
        n = self.npcs[vid]
        name = VILLAGERS[vid]["short"]
        if len(st["cows"]) >= BARN_ROOM:
            self.say("The barn's full. %s waits by the door with you, "
                     "chewing." % name, "info")
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            n.where = "barn"
            n.x, n.y = self.free_spot("barn", *self.pos(), taken)
            return
        st["leashed"] = None
        x, y = self.free_barn_square() or self.barn_squares()[0]
        st["cows"].append({"name": name, "colour": self.cow_colour(vid),
                           "x": x, "y": y, "petted": -1, "milked": -1,
                           "day": st["day"], "milk": 0, "vid": vid})
        n.where, n.x, n.y, n.hidden = "barn", x, y, True
        n.goal, n.path, n.visit = None, [], None
        self.say("You unclip the leash, and %s the cow ambles into a stall "
                 "and starts on the hay. She's one of your cows now. (%s)" % (
                     name, "She looks very content." if self.likes_change(
                         vid, "cowify") else "She does not look pleased."),
                 "quest")
        self.render()

    def unbarn(self, vid):
        st = self.st
        n = self.npcs[vid]
        for c in list(st["cows"]):
            if c.get("vid") == vid:
                st["cows"].remove(c)
                n.where, n.x, n.y = "barn", c["x"], c["y"]
        n.hidden = self.cooped(vid)

    def build_barn(self):
        self.build_on_farm("barn")

    def barn_squares(self):
        a = self.areas["barn"]
        return [(x, y) for y in range(a.h) for x in range(a.w)
                if a.grid[y][x] == "straw" and (x, y) != a.entry]

    def cow_at(self, x, y):
        for i, c in enumerate(self.st["cows"]):
            if (c["x"], c["y"]) == (x, y):
                return i
        return None

    def free_barn_square(self):
        here = self.pos() if self.area and self.area.key == "barn" else None
        free = [sq for sq in self.barn_squares()
                if self.cow_at(*sq) is None and sq != here]
        return random.choice(free) if free else None

    def add_cow(self):
        used = {c["name"] for c in self.st["cows"]}
        names = [n for n in COW_NAMES if n not in used] or COW_NAMES
        x, y = self.free_barn_square() or self.barn_squares()[0]
        c = {"name": random.choice(names), "colour": random.choice(
            COW_COLOURS), "x": x, "y": y, "petted": -1, "milked": -1,
            "day": self.st["day"], "milk": 0}
        self.st["cows"].append(c)
        if self.area.key == "barn":
            self.render()
        return c

    def cow_minute(self):
        a = self.areas["barn"]
        for c in self.st["cows"]:
            if random.random() > 0.08:
                continue
            dx, dy = random.choice(DIRS)
            x, y = c["x"] + dx, c["y"] + dy
            if a.inside(x, y) and a.grid[y][x] == "straw" and \
                    (x, y) != a.entry and self.cow_at(x, y) is None and \
                    (x, y) != self.pos():
                c["x"], c["y"] = x, y

    def cow_menu(self, i):
        c = self.st["cows"][i]
        age = self.st["day"] - c.get("day", 0)
        milked = c.get("milked") == self.st["day"]
        items = [("Pet %s" % c["name"], lambda: self.pet_cow(i))]
        if "milk pail" in self.p["tools"]:
            items.append(("Milk %s%s" % (c["name"], " (done today)" if milked
                                         else ""), lambda: self.milk_cow(i)))
        if not c.get("vid"):
            items.append(("Give her a new name",
                          lambda: self.start_naming(i, "cows")))
        items.append(("Squeeze past",
                      lambda: self.edge_past(i, "cows")))
        items.append(("Leave her be", lambda: None))
        self.open_menu("%s, a %s cow (%s; %d pail%s of milk)" % (
            c["name"], c["colour"], "new today" if age == 0 else
            "%d day%s with you" % (age, "s" if age > 1 else ""),
            c.get("milk", 0), "" if c.get("milk", 0) == 1 else "s"), items)

    def pet_cow(self, i):
        c = self.st["cows"][i]
        self.flash(c["x"], c["y"], "heart")
        vid = c.get("vid")
        if c.get("petted") == self.st["day"]:
            self.say("%s has had her fuss for today. She flicks an ear at "
                     "you." % c["name"], "info")
        elif vid:
            c["petted"] = self.st["day"]
            if self.likes_change(vid, "cowify"):
                self.say("You scratch %s behind the ears. She moos softly "
                         "and leans into you." % c["name"], "good")
                self.befriend(vid, GIFT_POINTS["like"])
            else:
                self.say("You pat %s's flank. She puts up with it, chewing "
                         "pointedly." % c["name"], "info")
        else:
            c["petted"] = self.st["day"]
            self.say(random.choice(COW_PETS) % c["name"], "good")
        self.end_turn(1)

    def milk_cow(self, i):
        """Once a day a cow gives a pail of milk, if you've the pail."""
        c = self.st["cows"][i]
        if "milk pail" not in self.p["tools"]:
            self.say("You'll need a milk pail. Mabel sells them.", "info")
            self.render()
            return
        if c.get("milked") == self.st["day"]:
            self.say("%s's been milked today. She gives you a look that "
                     "says so." % c["name"], "info")
            self.render()
            return
        if not self.spend("milk pail"):
            return
        c["milked"] = self.st["day"]
        c["milk"] = c.get("milk", 0) + 1
        self.give("milk")
        self.sound.play("pour")
        vid = c.get("vid")
        if vid and not self.likes_change(vid, "cowify"):
            self.say("You milk %s, who stamps a hoof the whole time. (+1 "
                     "milk)" % c["name"], "good")
        else:
            self.say("You milk %s. Warm, sweet milk froths into the pail. "
                     "(+1 milk)" % c["name"], "good")
        self.end_turn(TOOL_COST)

    def cooped(self, vid):
        return any(c.get("vid") == vid for c in self.st.get("chickens", ()))

    def leash(self, n):
        """Clip the leash on a villager turned hen."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        if not (self.chicken(vid) or self.is_cow(vid)):
            self.say("You can't put a leash on %s. Well, you could. You "
                     "shouldn't." % name, "info")
        elif self.statue(vid):
            self.say("She's solid gold. She isn't going anywhere.", "info")
        elif st.get("leashed"):
            self.say("You've only the one leash, and %s is on it." %
                     VILLAGERS[st["leashed"]]["short"], "info")
        else:
            st["leashed"] = vid
            n.goal, n.path, n.stuck, n.visit = None, [], 0, None
            if self.is_cow(vid):
                self.say("You clip the leash on. %s the cow %s" % (
                    name, "moos happily and plods after you." if
                    self.likes_change(vid, "cowify") else "lows crossly, "
                    "but plods along. She has no choice."), "good")
            else:
                self.say("You clip the leash on. %s the hen %s" % (
                    name, "clucks happily and trots after you." if
                    self.likes_change(vid, "chickenfy") else "clucks "
                    "furiously, but follows. She has no choice."), "good")
            self.end_turn(1)
            return
        self.render()

    def unleash(self, n, quiet=False):
        self.st["leashed"] = None
        n.goal, n.path, n.stuck = None, [], 0
        if not quiet:
            self.say(("You unclip the leash. %s the cow flicks her tail "
                      "and ambles off about her day." if self.is_cow(n.vid)
                      else "You unclip the leash. %s the hen shakes out her "
                      "feathers and potters off about her day.") %
                     VILLAGERS[n.vid]["short"], "info")
            self.end_turn(1)

    def lead(self, before):
        """After you move, the hen on your leash comes too: into your old
        square, or in beside you when you change places.  Into the coop,
        and she's one of your hens."""
        st = self.st
        vid = st.get("leashed")
        n = self.npcs[vid]
        if not (self.chicken(vid) or self.is_cow(vid)) or self.kept(vid):
            st["leashed"] = None
            return
        if self.statue(vid):
            st["leashed"] = None
            self.say("The leash slips off the golden %s." % (
                "cow" if self.is_cow(vid) else "hen"), "info")
            return
        area, pos = before
        here = self.area.key
        if here == "coop" and area != "coop" and self.chicken(vid):
            self.coop_hen(vid)
            return
        if here == "barn" and area != "barn" and self.is_cow(vid):
            self.barn_cow(vid)
            return
        if here != area and here == "coop" and self.is_cow(vid):
            self.say("%s won't fit through the coop door. She waits "
                     "outside, chewing." % VILLAGERS[vid]["short"], "info")
            return
        if n.where == "valley" and here == "coop" and self.is_cow(vid):
            return
        if n.where != here or area != here:
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            x, y = self.pos()
            n.where = here
            n.x, n.y = self.free_spot(here, x, y, taken)
        elif tuple(self.pos()) != pos:
            n.x, n.y = pos
        n.goal, n.path = (n.where, n.x, n.y), []

    def coop_hen(self, vid):
        """A villager-hen led into the coop: one of your hens now, laying
        and petted with the rest, till chickenfy turns her back."""
        st = self.st
        n = self.npcs[vid]
        name = VILLAGERS[vid]["short"]
        if len(st["chickens"]) >= COOP_ROOM:
            self.say("The coop's full. %s peers in, clucks, and waits by "
                     "the door with you." % name, "info")
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            n.where = "coop"
            n.x, n.y = self.free_spot("coop", *self.pos(), taken)
            return
        st["leashed"] = None
        x, y = self.free_coop_square() or self.coop_squares()[0]
        st["chickens"].append({"name": name, "colour": self.hen_colour(vid),
                               "x": x, "y": y, "petted": -1,
                               "day": st["day"], "eggs": 0, "vid": vid})
        n.where, n.x, n.y, n.hidden = "coop", x, y, True
        n.goal, n.path, n.visit = None, [], None
        self.say("You unclip the leash, and %s the hen hops down into the "
                 "straw with the others. She's one of your hens now. (%s)" % (
                     name, "She looks delighted." if self.likes_change(
                         vid, "chickenfy") else "She does not look pleased."),
                 "quest")
        self.render()

    def uncoop(self, vid):
        """Out of the coop: no longer one of your hens."""
        st = self.st
        n = self.npcs[vid]
        for c in list(st["chickens"]):
            if c.get("vid") == vid:
                st["chickens"].remove(c)
                n.where, n.x, n.y = "coop", c["x"], c["y"]
        n.hidden = False

    def hen_colour(self, vid):
        """The hen somebody becomes, by the colour of their hair."""
        hair = VILLAGERS[vid]["look"].get("hair", "")
        return {"#1e1a1a": "black", "#4a4040": "black",
                "#5a3a1e": "brown", "#8a4a22": "brown", "#a83a1e": "brown",
                "#d0502a": "brown", "#e8c870": "speckled",
                "#9a9a9a": "speckled", "#eeeeee": "white",
                "#e4641c": "brown", "#221a18": "black",
                "#2a1a14": "black"}.get(hair,
                                                              "white")

    def look_of(self, vid):
        look = VILLAGERS[vid]["look"]
        if self.maid(vid):
            return maid_look(look)
        return swap_look(look) if self.swapped(vid) else look

    def display_name(self, vid):
        name = VILLAGERS[vid]["name"]
        if self.swapped(vid) and not self.maid(vid):
            for a, b in (("Granny", "Grandpa"),):
                name = name.replace(a, b) if a in name else name.replace(
                    b, a)
        return name

    def genderswap(self, n):
        """The genderswap spell: the other sex, sprite and portrait; again,
        and back as they were.  They like it or they don't, and say so,
        and it shows in how they feel about you."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        back = self.swapped(vid)
        if back:
            st["swapped"].remove(vid)
        else:
            st["swapped"].append(vid)
        self.portraits = {}
        if self.statue(vid):
            self.say("The golden statue of %s ripples and shifts shape. "
                     "It doesn't seem to mind. It's a statue." % name,
                     "gold")
            self.end_turn(TOOL_COST)
            return
        if self.talk:
            self.end_talk()
        likes = self.likes_change(vid)
        lines = SWAP_LINES[vid]
        flags = st["flags"]
        if not back:
            self.say("Pink sparks fizz round %s, and when they clear, %s "
                     "is the other sex entirely." % (name, name), "quest")
            line = lines[0] if likes else lines[1]
            if likes:
                pts = 0 if "swapliked:" + vid in flags else 150
                flags.append("swapliked:" + vid)
            else:
                pts = -200
        else:
            self.say("Pink sparks again, and %s is back as they were." %
                     name, "quest")
            line = lines[3] if likes else lines[2]
            if likes:
                pts = -80
            else:
                pts = 0 if "swapfixed:" + vid in flags else 120
                flags.append("swapfixed:" + vid)
        self.talk = {"v": vid, "mode": "kw", "expr": "surprised",
                     "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.friend(vid)["met"] = True
        self.speak(vid, line)
        if pts:
            self.befriend(vid, pts)
            self.say("(%s %s.)" % (name, "likes you more for it" if pts > 0
                                   else "is upset with you"),
                     "heart" if pts > 0 else "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    # ── The chicken coop ──

    def build_coop(self):
        self.build_on_farm("coop")

    def build_on_farm(self, key):
        """Put up a farm building you've paid for, clearing whatever's
        there."""
        p, st = self.p, self.st
        if key in p["built"]:
            return
        p["built"].append(key)
        v = self.areas["valley"]
        x0, y0, w, h = BUILDINGS[key][:4]
        put_building(v.grid, v.labels, key)
        dx, dy = door_of(key)
        for y in range(y0, VH):
            for x in range(x0, x0 + w):
                if y >= y0 + h and (x != dx or v.grid[y][x] != "path"):
                    continue
                k = "%d,%d" % (x, y)
                for d in (st["debris"], st["soil"], st["forage"]):
                    d.pop(k, None)
                if k in st["sprinklers"]:
                    st["sprinklers"].remove(k)
                    self.give("sprinkler")
            if y >= y0 + h and v.grid[y][dx] != "path":
                break
        self.door_at[(dx, dy)] = key
        if self.area is v:
            self.layout()

    def coop_squares(self):
        a = self.areas["coop"]
        return [(x, y) for y in range(a.h) for x in range(a.w)
                if a.grid[y][x] == "straw"]

    def chicken_at(self, x, y):
        for i, c in enumerate(self.st["chickens"]):
            if (c["x"], c["y"]) == (x, y):
                return i
        return None

    def free_coop_square(self, eggs_too=False):
        here = self.pos() if self.area and self.area.key == "coop" else None
        free = [sq for sq in self.coop_squares()
                if self.chicken_at(*sq) is None and sq != here and
                (not eggs_too or list(sq) not in self.st["eggs"])]
        return random.choice(free) if free else None

    def add_chicken(self):
        used = {c["name"] for c in self.st["chickens"]}
        names = [n for n in HEN_NAMES if n not in used] or HEN_NAMES
        x, y = self.free_coop_square() or self.coop_squares()[0]
        c = {"name": random.choice(names), "colour": random.choice(
            HEN_COLOURS), "x": x, "y": y, "petted": -1,
            "day": self.st["day"], "eggs": 0}
        self.st["chickens"].append(c)
        if self.area.key == "coop":
            self.render()
        return c

    def chicken_minute(self):
        a = self.areas["coop"]
        for i, c in enumerate(self.st["chickens"]):
            if random.random() > 0.2:
                continue
            dx, dy = random.choice(DIRS)
            x, y = c["x"] + dx, c["y"] + dy
            if a.inside(x, y) and a.grid[y][x] == "straw" and \
                    self.chicken_at(x, y) is None and (x, y) != self.pos():
                c["x"], c["y"] = x, y

    def chicken_menu(self, i):
        c = self.st["chickens"][i]
        age = self.st["day"] - c.get("day", 0)
        self.open_menu("%s, a %s hen (%s; %d egg%s laid)" % (
            c["name"], c["colour"], "new today" if age == 0 else
            "%d day%s with you" % (age, "s" if age > 1 else ""),
            c.get("eggs", 0), "" if c.get("eggs", 0) == 1 else "s"), [
            ("Pet %s" % c["name"], lambda: self.pet_chicken(i))] + (
            [] if c.get("vid") else
            [("Give her a new name", lambda: self.start_naming(i))]) +
            [("Squeeze past", lambda: self.edge_past(i, "chickens")),
             ("Leave her be", lambda: None)])

    def edge_past(self, i, pen):
        """Swap squares with a hen or cow standing in your way."""
        c = self.st[pen][i]
        squares = self.coop_squares() if pen == "chickens" else \
            self.barn_squares()
        here = self.pos()
        entry = self.areas["coop" if pen == "chickens" else "barn"].entry
        to = here if here in squares and here != entry else (
            self.free_coop_square() if pen == "chickens" else
            self.free_barn_square())
        if to is None:
            self.say("There's no room to get round %s." % c["name"], "info")
            self.render()
            return
        x, y = c["x"], c["y"]
        c["x"], c["y"] = to
        self.st["pos"] = [x, y]
        if c.get("vid") and c["vid"] in self.npcs:
            n = self.npcs[c["vid"]]
            n.x, n.y = to
        if pen == "chickens":
            self.say(random.choice((
                "You scoop %s up, step past and set her down behind you. "
                "She clucks, offended.",
                "%s flaps aside with a squawk and you slip past.")) %
                c["name"], "info")
            if [x, y] in self.st["eggs"]:
                self.st["eggs"].remove([x, y])
                self.give("egg")
                self.sound.play("pick")
                self.say("You pick up a fresh egg. Still warm.", "good")
        else:
            self.say(random.choice((
                "You put a shoulder to %s and lean. Eventually, grudgingly, "
                "she shuffles round and you squeeze past.",
                "\"Shift over, %s.\" She does, with a long-suffering moo.")) %
                c["name"], "info")
        self.end_turn(WALK_COST)

    def pet_chicken(self, i):
        c = self.st["chickens"][i]
        self.flash(c["x"], c["y"], "heart")
        if c.get("petted") == self.st["day"]:
            self.say("%s has had her fuss for today, and lets you know "
                     "it." % c["name"], "info")
        elif c.get("vid"):
            c["petted"] = self.st["day"]
            vid = c["vid"]
            if self.likes_change(vid, "chickenfy"):
                self.say("You stroke %s's feathers. She clucks happily and "
                         "leans into your hand." % c["name"], "good")
                self.befriend(vid, GIFT_POINTS["like"])
            else:
                self.say("You stroke %s's feathers. She puts up with it, "
                         "glaring." % c["name"], "info")
        else:
            c["petted"] = self.st["day"]
            self.say(random.choice(HEN_PETS) % c["name"], "good")
        self.end_turn(1)

    def start_naming(self, i, pen="chickens"):
        """Rename a hen or a cow: the talk bar asks, and Return settles
        it."""
        self.naming = i
        self.naming_pen = pen
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Her new name:")
        self.entry.delete(0, "end")
        self.entry.insert(0, self.st[pen][i]["name"])
        self.entry.select_range(0, "end")
        self.entry.focus_set()
        self.say("Type a new name for %s and press Return (Esc keeps the "
                 "old one)." % self.st[pen][i]["name"], "info")
        self.render()

    def finish_naming(self, text):
        i = self.naming
        name = " ".join(text.split())[:16]
        if i is not None and name:
            c = self.st[getattr(self, "naming_pen", "chickens")][i]
            old, c["name"] = c["name"], name
            if old != name:
                self.say("%s is now called %s. She seems to approve." % (
                    old, name), "good")
        self.end_naming()

    def end_naming(self):
        self.naming = None
        self.prompt.config(text="Ask about:")
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        self.render()

    def statue_bump(self, n):
        """Walking into a statue: a polish, a rub for luck...  and walk
        into the same one again straight away to squeeze past it."""
        here = (n.vid, self.area.key, n.x, n.y, self.pos())
        if getattr(self, "last_statue", None) == here and \
                self.squeeze_past(n):
            self.last_statue = None
            self.say("You squeeze past the statue of %s, breathing in." %
                     VILLAGERS[n.vid]["short"], "info")
        else:
            self.last_statue = here
            self.say(random.choice(STATUE_PHRASES).replace(
                "{who}", VILLAGERS[n.vid]["short"]) +
                " (Walk into it again to squeeze past.)", "info")
        self.end_turn(1)

    def squeeze_past(self, n):
        """Trade places with somebody standing next to you, so nobody can
        block a doorway for good: True if you did."""
        x, y = self.pos()
        if n.where != self.area.key or abs(n.x - x) + abs(n.y - y) != 1:
            return False
        n.x, n.y, self.st["pos"] = x, y, [n.x, n.y]
        n.path, n.stuck = [], 0
        if self.area.outdoor:
            self.step_on(*self.pos())
        return True

    def spend(self, h):
        need = TOOL_ENERGY.get(h, 0)
        if self.p["energy"] < need:
            self.say("You're too tired to swing the %s. Eat something, or "
                     "go to bed." % h, "bad")
            return False
        self.p["energy"] -= need
        return True

    def use_tool_at(self, x, y):
        h = self.held()
        if h == "magic wand":
            self.start_aim()
            return
        a = self.area
        k = "%d,%d" % (x, y)
        if h == "milk pail" and a.key == "barn":
            i = self.cow_at(x, y)
            if i is not None:
                self.milk_cow(i)
            else:
                self.say("Use the pail on a cow.", "info")
            return
        n = self.npc_at(x, y)
        if n and self.leashed(n.vid):
            self.unleash(n)
            return
        if n and h == "leash":
            self.leash(n)
            return
        if n and self.tree(n.vid) and h in ("watering can", "axe"):
            self.tend_tree(n, h)
            return
        if not a.outdoor:
            n = self.npc_at(x, y)
            if n:
                self.start_talk(n)
            else:
                self.say("Not in here.", "info")
            return
        if not a.inside(x, y):
            return
        n = self.npc_at(x, y)
        if n:
            self.start_talk(n)
            return
        t = self.tile_at(x, y)
        th = self.thing_at(x, y)
        if th and th[0] == "crop" and self.ripe(th[1]):
            self.harvest(x, y)
            return
        if th and th[0] == "forage":
            self.step_on(x, y)
            self.end_turn(1)
            return
        if th and th[0] == "debris":
            self.clear_debris(x, y, th[1])
            return
        if t == "bin":
            self.ship_menu()
            return
        st, p = self.st, self.p
        if h == "watering can":
            if t in WATER or t in ("well", "fountain"):
                if t == "pond" and self.season() == 3:
                    self.say("The pond's frozen.", "info")
                    return
                p["water"] = p["can"]
                self.sound.play("water")
                self.say("You fill the watering can.", "info")
                self.end_turn(1)
            elif t == "soil":
                s = st["soil"][k]
                if s[0]:
                    self.say("That's already damp.", "info")
                    return
                if p["water"] <= 0:
                    self.say("The can's empty. Fill it at the well or any "
                             "water.", "bad")
                    return
                if not self.spend(h):
                    return
                p["water"] -= 1
                s[0] = 1
                self.sound.play("water")
                self.end_turn(TOOL_COST - 1)
            else:
                self.say("Nothing there needs watering.", "info")
            return
        if h == "hoe":
            if t == "soil" and th and th[0] == "crop" and th[1][3]:
                if not self.spend(h):
                    return
                st["soil"][k] = [st["soil"][k][0], None, 0, 0]
                self.say("You turn the dead plant under.", "info")
                self.end_turn(TOOL_COST)
                return
            if not on_farm(x, y):
                self.say("That's not your land to dig.", "info")
                return
            if t == "soil":
                self.say("That's already tilled.", "info")
                return
            if t not in TILLABLE or th:
                self.say("You can't dig there.", "info")
                return
            if self.season() == 3 and "winter_till" not in st["flags"]:
                st["flags"].append("winter_till")
                self.say("The ground's hard with frost, but you break it. "
                         "Nothing will grow till spring.", "info")
            if not self.spend(h):
                return
            st["soil"][k] = [1 if st["weather"] in ("rain", "storm") else 0,
                             None, 0, 0]
            self.sound.play("till")
            self.end_turn(TOOL_COST)
            return
        if h and h.endswith(" seeds"):
            cname = h[:-6]
            if t != "soil" or th:
                self.say("Seeds go in tilled soil. Use the hoe first.",
                         "info")
                return
            if self.season() not in crop(cname, "seasons"):
                self.say("%s won't grow in %s." % (
                    cap(cname) + ("s" if not cname.endswith(("s", "y"))
                                  else ""), SEASONS[self.season()]), "bad")
                return
            st["soil"][k][1] = cname
            st["soil"][k][2] = 0
            st["soil"][k][3] = 0
            self.take(h)
            self.sound.play("pick")
            self.end_turn(1)
            return
        if h == "sprinkler":
            if not on_farm(x, y) or th or not (t == "soil" or
                                               t in TILLABLE):
                self.say("Put a sprinkler on open ground on your farm.",
                         "info")
                return
            st["sprinklers"].append(k)
            st["soil"].pop(k, None)
            self.take("sprinkler")
            self.say("You set the sprinkler in the ground. It'll water the "
                     "four squares around it every morning.", "good")
            self.end_turn(TOOL_COST)
            return
        if h == "fishing rod":
            if t not in WATER:
                self.say("Face the water to fish.", "info")
                return
            self.fish(t)
            return
        if h == "axe" and t in CHOPPABLE:
            self.chop_tree(x, y, t)
            return
        if h in ("axe", "pickaxe"):
            self.say("Nothing to %s there." % ("chop" if h == "axe" else
                                               "break"), "info")
            return
        if h == "scythe":
            if t == "tallgrass" or (t in ("grass", "meadow") and
                                    random.random() < 0.1):
                if self.spend(h):
                    self.give("fiber")
                    self.say("You cut some fiber.", "info")
                    self.end_turn(TOOL_COST)
                return
            self.say("You swing the scythe at nothing in particular.",
                     "info")
            return
        self.say("Nothing to do there.", "info")

    def clear_debris(self, x, y, kind, auto=False):
        need, (item, n) = DEBRIS[kind]
        if need not in self.p["tools"]:
            self.say("You'd need %s to clear that %s." % (an(need), kind),
                     "info")
            return
        if self.held() != need and not auto:
            self.say("That %s needs the %s." % (kind, need), "info")
            return
        if not self.spend(need):
            return
        del self.st["debris"]["%d,%d" % (x, y)]
        self.give(item, n)
        self.sound.play({"weed": "pick", "stone": "chop",
                         "branch": "chop", "stump": "chop"}[kind])
        self.flash(x, y, "puff")
        self.say("You clear the %s%s. (+%d %s)" % (
            kind, " with the " + need if auto else "", n, item), "info")
        self.end_turn(TOOL_COST + (3 if kind == "stump" else 0))

    # ── Crops ──

    @staticmethod
    def ripe(s):
        return s[1] and not s[3] and s[2] >= crop(s[1], "days")

    @staticmethod
    def stage(s):
        if s[3]:
            return "c_dead"
        days = crop(s[1], "days")
        f = s[2] / days
        return "c_%s_%d" % (s[1], 3 if f >= 1 else 0 if s[2] == 0 else
                            1 if f < 0.5 else 2)

    def harvest(self, x, y):
        k = "%d,%d" % (x, y)
        s = self.st["soil"][k]
        name = s[1]
        n = 2 if random.random() < 0.12 else 1
        self.give(name, n)
        regrow = crop(name, "regrow")
        if regrow:
            s[2] = crop(name, "days") - regrow
        else:
            s[1], s[2] = None, 0
        self.st["stats"]["harvested"] += n
        self.sound.play("pick")
        self.flash(x, y, "sparkle")
        self.say("You pick %s%s!" % ("two " if n > 1 else "a ",
                                     plural(name, n)), "good")
        self.end_turn(1)

    def pick_apples(self, x, y):
        k = "%d,%d" % (x, y)
        n = self.st["apples"].get(k, 0)
        if not n:
            self.say({0: "The apple tree is in blossom, pink and white and "
                         "humming with bees.",
                      1: "Small green apples. Not ripe till fall.",
                      2: "No apples left on this one today.",
                      3: "The apple tree is bare and sleeping."}[
                          self.season()], "info")
            self.render()
            return
        self.st["apples"][k] = 0
        self.give("apple", n)
        self.sound.play("pick")
        self.say("You pick %d apple%s." % (n, "s" if n > 1 else ""), "good")
        self.end_turn(2)

    # ── Things ──

    def give(self, item, n=1):
        self.p["items"][item] = self.p["items"].get(item, 0) + n

    def take(self, item, n=1):
        have = self.p["items"].get(item, 0)
        if have < n:
            return False
        if have == n:
            del self.p["items"][item]
        else:
            self.p["items"][item] = have - n
        return True

    def bag_menu(self):
        if not self.ready():
            return
        items = sorted(n for n, c in self.p["items"].items() if c)
        if not items:
            self.say("Your bag is empty.", "info")
            return
        rows = []
        for n in items:
            c = self.p["items"][n]
            rows.append(("%s%s" % (n, " x%d" % c if c > 1 else ""),
                         lambda n=n: self.item_menu(n)))
        rows.append(("Close", lambda: None))
        self.open_menu("Your bag (%dg)" % self.p["gold"], rows)

    def item_menu(self, n):
        acts = []
        val, energy, kind = ITEMS.get(n, (0, 0, "?"))
        if energy and self.p["items"].get(n):
            acts.append(("Eat it (+%d energy)" % energy,
                         lambda: self.eat(n)))
        if n.endswith(" seeds") or n == "sprinkler":
            acts.append(("Hold it", lambda: (self.p.update(hand=n),
                                             self.say("You hold the %s." %
                                                      self.hand_name(),
                                                      "info"),
                                             self.render())))
        acts.append(("Look at it", lambda: self.say(describe_item(n),
                                                    "info")))
        acts.append(("Back", self.bag_menu))
        self.open_menu(cap(n), acts)

    def eat(self, food):
        energy = ITEMS[food][1]
        if not self.take(food):
            return
        p = self.p
        p["energy"] = min(p["max_energy"], p["energy"] + energy)
        self.sound.play("potion")
        self.say("You eat %s. (+%d energy)" % (an(food), energy), "good")
        self.flags_today()
        if "tired" in self.flags_today() and p["energy"] > 0:
            self.flags_today().remove("tired")
        self.end_turn(5)

    # ── Shipping ──

    def ship_menu(self):
        sell = sorted(n for n, c in self.p["items"].items()
                      if c and ITEMS.get(n, (0,))[0] > 0
                      and ITEMS[n][2] not in ("material",))
        mats = sorted(n for n, c in self.p["items"].items()
                      if c and n in ("fiber",))
        rows = []
        for n in sell + mats:
            c = self.p["items"][n]
            rows.append(("%s x%d  (%dg each)" % (n, c, ITEMS[n][0]),
                         lambda n=n: self.ship(n)))
        if len(sell) > 1:
            rows.insert(0, ("Everything above", lambda: [self.ship(n, True)
                                                         for n in sell]))
        pending = sum(ITEMS[n][0] * c for n, c in self.st["shipped"].items())
        if not rows:
            self.say("The shipping bin. Anything you put in is sold "
                     "overnight. You've nothing to sell." +
                     (" (%dg waiting to be paid.)" % pending if pending
                      else ""), "info")
            self.render()
            return
        rows.append(("Done", lambda: None))
        self.open_menu("Ship what? (%dg in the bin)" % pending, rows)

    def ship(self, n, quiet=False):
        c = self.p["items"].pop(n, 0)
        if not c:
            return
        self.st["shipped"][n] = self.st["shipped"].get(n, 0) + c
        self.sound.play("ship")
        self.say("You put %d %s in the bin (%dg tomorrow)." % (
            c, plural(n, c), c * ITEMS[n][0]), "gold")
        if not quiet:
            self.ship_menu()

    # ── Fishing ──

    def fish(self, t):
        if not self.spend("fishing rod"):
            return
        where = t if t in FISH else "water"
        if where == "pond" and self.season() == 3:
            self.say("The pond's frozen solid.", "info")
            return
        wait = random.randint(10, 35)
        self.say("You cast your line and wait...", "info")
        self.busy = True
        self.render()

        def bite():
            self.busy = False
            self.pass_time(wait)
            if self.area is None:
                return
            chance = 0.62 + (0.15 if self.p["items"].get("fishing lure")
                             else 0) + (0.1 if self.st["weather"] == "rain"
                                        else 0)
            x, y = self.ahead()
            if random.random() > chance:
                self.say("...It got away. (%d minutes)" % wait, "info")
                self.render()
                return
            if where == "pond" and "golden carp" not in self.st["flags"] \
                    and random.random() < 0.04:
                self.st["flags"].append("golden carp")
                fish = "golden carp"
                self.say("The water flashes gold! You've caught the "
                         "LEGEND: the golden carp your grandmother "
                         "caught!", "quest")
            else:
                pool = FISH[where][self.season()]
                fish = random.choices(pool, [6, 4, 2, 1][:len(pool)])[0]
                self.say("You catch %s! (%d minutes)" % (an(fish), wait),
                         "good")
            self.give(fish)
            self.st["stats"]["fish"] += 1
            self.sound.play("splash")
            self.flash(x, y, "splash")
            self.render()
        self.root.after(350, bite)

    # ── Sleeping, and the morning ──

    def bed_menu(self):
        h = self.hhmm()
        self.open_menu("Go to bed?" if h >= 1800 or h < 600 else
                       "Go to bed? It's only %s." % self.clock(),
                       [("Sleep until morning", self.sleep),
                        ("Not yet", lambda: None)])

    def sleep(self):
        late = self.st["minute"] >= 24 * 60
        self.say("You sleep.", "info")
        self.new_day(0.8 if late else 1.0)

    def collapse(self):
        self.end_talk()
        self.menu = None
        self.say("It's two in the morning. You collapse...", "bad")
        fee = min(300, self.p["gold"] // 10)
        if self.area.key != "cabin":
            self.say("Dr. Thorne found you and carried you home. He left "
                     "a bill for %dg, and a note: 'Please sleep.'" % fee,
                     "bad")
            self.p["gold"] -= fee
        self.area = self.areas["cabin"]
        bx, by = self.areas["cabin"].spots["1"]
        self.st["pos"] = [bx - 1, by]
        self.new_day(0.5)

    def new_day(self, rest):
        """Overnight: ship, grow, and wake on the next day."""
        st, p = self.st, self.p
        self.end_talk()
        self.menu = None
        # the bin
        pay = sum(ITEMS[n][0] * c for n, c in st["shipped"].items())
        if pay:
            p["gold"] += pay
            st["stats"]["earned"] += pay
            st["stats"]["shipped"] += sum(st["shipped"].values())
            self.say("Overnight, the bin was emptied: %s. You earn %dg." % (
                ", ".join("%d %s" % (c, plural(n, c))
                          for n, c in sorted(st["shipped"].items())), pay),
                "gold")
            st["shipped"] = {}
        # the hens lay
        for c in st["chickens"]:
            spot = self.free_coop_square(eggs_too=True)
            if spot and len(st["eggs"]) < 2 * COOP_ROOM:
                st["eggs"].append(list(spot))
                c["eggs"] = c.get("eggs", 0) + 1
        n = len(st["chickens"])
        if n:
            self.say("%s laid %s overnight." % (
                "Your hen" if n == 1 else "Your %d hens" % n,
                "an egg" if n == 1 else "an egg each"), "good")
        # the crops
        for k, s in st["soil"].items():
            if s[1] and s[0] and not s[3]:
                s[2] += 1
            s[0] = 0
        old_season = self.season()
        st["day"] += 1
        st["minute"] = WAKE
        st["today"] = []
        season = self.season()
        st["weather"] = st["tomorrow"]
        st["tomorrow"] = self.roll_weather(season)
        if season != old_season:
            dead = 0
            for k, s in st["soil"].items():
                if s[1] and season not in crop(s[1], "seasons"):
                    s[3] = 1
                    dead += 1
            self.say("It's the first of %s!" % SEASONS[season], "quest")
            if dead:
                self.say("%d crop%s didn't survive the change of season." % (
                    dead, "s" if dead > 1 else ""), "bad")
        if st["weather"] in ("rain", "storm"):
            for s in st["soil"].values():
                s[0] = 1
        for k in st["sprinklers"]:
            x, y = map(int, k.split(","))
            for dx, dy in DIRS:
                s = st["soil"].get("%d,%d" % (x + dx, y + dy))
                if s:
                    s[0] = 1
        # tilled ground left empty goes back to grass
        for k in [k for k, s in st["soil"].items()
                  if not s[1] and random.random() < 0.04]:
            del st["soil"][k]
        # weeds creep back, apples ripen, the wild grows
        valley = self.areas["valley"]
        for _ in range(random.randint(1, 4)):
            x = random.randint(FARM[0] + 1, FARM[2] - 1)
            y = random.randint(FARM[1] + 1, FARM[3] - 1)
            k = "%d,%d" % (x, y)
            if valley.grid[y][x] == "grass" and k not in st["soil"] and \
                    k not in st["debris"] and k not in st["sprinklers"] and \
                    (x, y) != self.pos() and season != 3:
                st["debris"][k] = "weed"
        if season == 2:
            for x in (5, 8, 11, 14):
                k = "%d,%d" % (x, 17)
                st["apples"][k] = min(3, st["apples"].get(k, 0) + 1)
        else:
            st["apples"] = {}
        self.spawn_forage()
        self.regrow_trees()
        # people
        for f in st["friends"].values():
            if self.weekday() == 0:
                f["week"] = 0
        p["energy"] = round(p["max_energy"] * rest)
        if self.season_drawn != season:
            self.load_images()
        self.morning_news()
        self.settle_npcs()
        self.layout()
        self.save()

    def roll_weather(self, season):
        r = random.random()
        if season == 3:
            return "snow" if r < 0.3 else "sun"
        if season == 1 and r < 0.06:
            return "storm"
        return "rain" if r < (0.22 if season != 1 else 0.14) else "sun"

    def spawn_forage(self):
        st = self.st
        st["forage"] = {k: v for k, v in st["forage"].items()
                        if random.random() < 0.4}
        season = self.season()
        for item, shape, col, where in FORAGE[season]:
            spots = self.forage_zones[where]
            for _ in range(random.randint(1, 3)):
                x, y = random.choice(spots)
                k = "%d,%d" % (x, y)
                if k not in st["forage"] and k not in st["debris"]:
                    st["forage"][k] = item

    def mail(self, sender, text):
        self.st["mail"].append({"from": sender, "text": text,
                                "day": self.st["day"], "read": False})

    def read_mail(self):
        new = [m for m in self.st["mail"] if not m["read"]]
        if not new:
            self.say("Your mailbox is empty. (Your letters are in the "
                     "diary.)", "info")
            self.render()
            return
        for m in new:
            m["read"] = True
        self.sound.play("gold")
        self.show_text("\n\n".join(
            "From %s:\n\n%s" % (m["from"], "\n".join(wrap(m["text"], 52)))
            for m in new) + "\n\n(Any key closes.)")

    # ── Where everyone is ──

    def schedule(self, vid):
        """Today's list of (hhmm, spot) for somebody."""
        v = VILLAGERS[vid]
        f = self.st["friends"][vid]
        s = v["sched"]
        maids = self.st.get("maids", {})
        if vid in maids:
            home = "cabin." + MAID_SPOTS[sorted(maids).index(vid) %
                                         len(MAID_SPOTS)]
            if maids[vid] in ("water", "harvest", "weed") and \
                    self.st["weather"] not in ("rain", "storm", "snow"):
                return [(600, "out.farmyard"), (900, home)]
            return [(600, home)]
        if f["status"] == "married":
            work = self.spot_at(s["day"], 1100)
            if work.split(".")[0] in ("juniper", "shack", "smithhouse",
                                      "rose", "mayor"):
                work = "out.fountain_s"
            return [(600, "cabin.1"), (1000, work), (1800, "cabin.1")]
        if self.st["weather"] in ("rain", "storm", "snow") and "rain_s" in s:
            return s["rain_s"]
        if self.weekday() == v["rest"] and "rest_s" in s:
            return s["rest_s"]
        if "show_s" in s and self.weekday() in (4, 5):
            return s["show_s"]
        return s["day"]

    @staticmethod
    def spot_at(sched, hhmm):
        cur = sched[-1][1]
        for t, spot in sched:
            if hhmm >= t:
                cur = spot
        return cur

    def wanted(self, vid):
        """Where somebody means to be right now: (area, x, y)."""
        n = self.npcs[vid]
        if n.visit:
            return ("valley",) + self.loo_door(n.visit["loo"])
        h = self.hhmm()
        if h < 600:
            h += 2400
        f = self.festival_on()
        st = self.st
        fest = self.festival_today()
        if f or (fest and fest[1] <= h < fest[2]):
            spots = FEST_SPOTS[fest[3]]
            i = sorted(VILLAGERS).index(vid)
            x, y = spots[i % len(spots)]
            return ("valley", x, y)
        if st["wedding"] == st["day"] and 1000 <= h < 1300:
            i = sorted(VILLAGERS).index(vid)
            x, y = FEST_SPOTS["square"][i]
            return ("valley", x, y)
        spot = self.spot_at(self.schedule(vid), h)
        area, mark = spot.split(".")
        if area == "out":
            x, y = OUT_SPOTS[mark]
            return ("valley", x, y)
        x, y = self.areas[area].spots[mark]
        return (area, x, y)

    def settle_npcs(self):
        """Everyone straight to where they should be (mornings, and after
        long waits)."""
        taken = {(n.where, n.x, n.y) for vid, n in self.npcs.items()
                 if self.rooted(vid) and n.where}
        for vid, n in self.npcs.items():
            n.visit, n.hidden = None, self.kept(vid)
            if (self.rooted(vid) or self.kept(vid) or
                    self.leashed(vid)) and n.where:
                continue
            area, x, y = self.wanted(vid)
            x, y = self.free_spot(area, x, y, taken)
            n.where, n.x, n.y = area, x, y
            n.goal, n.path, n.stuck = (area, x, y), [], 0
            taken.add((area, x, y))

    def free_spot(self, area, x, y, taken):
        a = self.areas[area]
        px, py = self.st["pos"]
        for r in range(0, 4):
            for dy in range(-r, r + 1):
                for dx in range(-r, r + 1):
                    if max(abs(dx), abs(dy)) != r:
                        continue
                    nx, ny = x + dx, y + dy
                    if (area, nx, ny) in taken or (
                            area == self.area.key and (nx, ny) == (px, py)):
                        continue
                    if self.can_stand(nx, ny, a) and (
                            a.outdoor or a.grid[ny][nx] != "exit"):
                        return nx, ny
        return x, y

    def npc_minute(self, visible):
        """A minute for everyone: whoever's going somewhere takes a step
        (or, out of your sight, simply gets there)."""
        here = self.area.key
        if here == "coop" and visible:
            self.chicken_minute()
        if here == "barn" and visible:
            self.cow_minute()
        taken = {(n.where, n.x, n.y) for n in self.npcs.values()}
        for vid, n in self.npcs.items():
            if self.talk and self.talk.get("v") == vid or self.rooted(vid) \
                    or self.kept(vid) or self.leashed(vid):
                continue
            if self.loo_visits(n, here, visible):
                continue
            goal = self.wanted(vid)
            if goal != n.goal:
                n.goal, n.path, n.stuck = goal, [], 0
            if (n.where, n.x, n.y) == goal:
                continue
            for _ in range(4):
                if n.where == here and visible:
                    break
                tgt, hop = self.hop(n)
                taken.discard((n.where, n.x, n.y))
                n.x, n.y = tgt
                if hop:
                    n.where, n.x, n.y = hop
                taken.add((n.where, n.x, n.y))
                n.path = []
                if (n.where, n.x, n.y) == goal or not hop:
                    break
            if n.where != here or not visible:
                continue
            tgt, hop = self.hop(n)
            if (n.x, n.y) == tgt:
                if hop:
                    taken.discard((n.where, n.x, n.y))
                    n.where, n.x, n.y = hop
                    n.path = []
                continue
            if not n.path:
                n.path = self.npc_path(n, tgt)
                if not n.path:
                    n.stuck += 1
                    if n.stuck > 20:
                        n.x, n.y = tgt
                    continue
            nx, ny = n.path[0]
            if (n.where, nx, ny) in taken or (nx, ny) == self.pos():
                n.stuck += 1
                if n.stuck > 6:
                    n.path = []
                if n.stuck > 25:
                    taken.discard((n.where, n.x, n.y))
                    n.x, n.y = self.free_spot(n.where, tgt[0], tgt[1],
                                              taken)
                    n.path = []
                    taken.add((n.where, n.x, n.y))
                continue
            taken.discard((n.where, n.x, n.y))
            n.x, n.y = nx, ny
            n.path.pop(0)
            n.stuck = 0
            taken.add((n.where, nx, ny))

    def hop(self, n):
        """Where somebody should walk next in the area they're in, and
        where they come out if that's a doorway."""
        area, gx, gy = n.goal
        if n.where == area:
            return (gx, gy), None
        if n.where != "valley":
            room = self.areas[n.where]
            dx, dy = door_of(n.where)
            return room.entry, ("valley", dx, dy + 1)
        dx, dy = door_of(area)
        return (dx, dy + 1), (area,) + self.areas[area].entry

    def npc_path(self, n, tgt):
        a = self.areas[n.where]
        start = (n.x, n.y)
        prev = {start: None}
        q = deque([start])
        while q:
            cur = q.popleft()
            if cur == tgt:
                break
            for dx, dy in DIRS:
                nx, ny = cur[0] + dx, cur[1] + dy
                if (nx, ny) in prev:
                    continue
                if (nx, ny) != tgt and not self.can_stand(nx, ny, a):
                    continue
                if not a.inside(nx, ny):
                    continue
                prev[(nx, ny)] = cur
                q.append((nx, ny))
        if tgt not in prev:
            return []
        path = []
        cur = tgt
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        return path[::-1]

    # ── Friendship ──

    def friend(self, vid):
        return self.st["friends"][vid]

    def hearts(self, vid):
        return self.friend(vid)["pts"] // HEART

    def partner(self):
        for vid, f in self.st["friends"].items():
            if f["status"] in ("dating", "engaged", "married"):
                return vid
        return None

    def befriend(self, vid, pts, quiet=False):
        f = self.friend(vid)
        before = f["pts"] // HEART
        cap_ = 10 * HEART
        if VILLAGERS[vid]["romance"] and f["status"] is None:
            cap_ = 8 * HEART
        f["pts"] = max(0, min(cap_, f["pts"] + pts))
        after = f["pts"] // HEART
        n = self.npcs[vid]
        if pts > 0 and n.where == self.area.key:
            self.flash(n.x, n.y, "heart")
        if after > before and not quiet:
            self.sound.play("heart")
            self.say("%s: %s" % (VILLAGERS[vid]["short"],
                                 "♥" * after + "♡" * (10 - after)),
                     "heart")

    # ── Talking ──

    def speak(self, vid, line, log=True):
        """Show somebody saying a line, portrait and all."""
        expr, text = parse_line(fill_in(line, self))
        narr = text.startswith("*")
        if narr:
            text = text[1:]
        self.talk.update(expr=expr, text=text, narr=narr)
        if log:
            if narr:
                self.say(text, "info")
            else:
                self.say("%s: %s" % (VILLAGERS[vid]["short"], text), "talk")
        for w in re.findall(r"\b[A-Z][A-Z]{2,}(?: [A-Z]{3,})?\b", text):
            w = w.lower()
            if w not in self.st["topics"]:
                self.st["topics"].append(w)
        self.render()

    def start_talk(self, n):
        vid = n.vid
        if self.statue(vid):
            self.walking = None
            self.statue_bump(n)
            return
        if self.tree(vid):
            self.walking = None
            self.tree_bump(n)
            return
        if self.loo(vid):
            self.walking = None
            self.loo_bump(n)
            return
        if self.is_cow(vid):
            self.walking = None
            self.say(random.choice(
                MOO_HAPPY if self.likes_change(vid, "cowify") else
                MOO_ANGRY).replace("{who}", VILLAGERS[vid]["short"]),
                "info")
            if self.squeeze_past(n):
                self.say("She ambles aside and lets you by.", "info")
            self.end_turn(1)
            return
        if self.chicken(vid):
            self.walking = None
            self.say(random.choice(
                CLUCK_HAPPY if self.likes_change(vid, "chickenfy") else
                CLUCK_ANGRY).replace("{who}", VILLAGERS[vid]["short"]),
                "info")
            if self.squeeze_past(n):
                self.say("She scuttles past you, still clucking.", "info")
            self.end_turn(1)
            return
        v = VILLAGERS[vid]
        f = self.friend(vid)
        self.walking = None
        self.talk = {"v": vid, "mode": "kw", "expr": "neutral", "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        # turn to face you
        if not f["met"]:
            f["met"] = True
            self.speak(vid, v["intro"])
            self.say("(Choose a word, or type one and press Return. Words "
                     "in CAPITALS are worth asking about.)", "info")
        else:
            birthday = v["birthday"] == (self.season(), self.dom())
            if birthday:
                self.speak(vid, "(happy)It's my birthday today! Did you "
                                "remember?")
            elif self.maid(vid):
                self.speak(vid, random.choice(
                    MAID_GREET_LIKE if self.likes_change(vid, "maidify")
                    else MAID_GREET_HATE))
            elif self.swapped(vid):
                self.speak(vid, random.choice(
                    SWAP_GREET_LIKE if self.likes_change(vid) else
                    SWAP_GREET_HATE))
            else:
                self.speak(vid, random.choice(v["greet"][self.tier(vid)]))
        if f["talked"] != self.st["day"]:
            f["talked"] = self.st["day"]
            self.befriend(vid, CHAT_POINTS)
        if self.check_scene(vid):
            return
        self.talk_menu()

    def tier(self, vid):
        h = self.hearts(vid)
        return 0 if h < 2 else 1 if h < 5 else 2 if h < 8 else 3

    def talk_words(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        words = ["CHAT", "GIFT"]
        if self.shop_open(vid):
            words.append("BUY")
        fest = self.festival_on()
        if fest:
            key = fest[0]
            if "Blossom" in key:
                words.append("DANCE")
            elif "Picnic" in key and vid == "bernard":
                words.append("SHARE")
            elif "Harvest" in key and vid == "edmund":
                words.append("ENTER")
        if f["status"] in ("dating", "engaged", "married") and \
                f["dated"] != self.st["day"] and 1700 <= self.hhmm() < 2300:
            words.append("DATE")
        r = self.st["request"]
        if r and r["who"] == vid:
            words.append("REQUEST")
        for w in self.st["topics"]:
            if w in v["topics"] and w.upper() not in words:
                words.append(w.upper())
        if self.maid(vid):
            words.insert(0, "CHORE")
            words.insert(1, "KISS")
        if self.swapped(vid) or self.maid(vid):
            words.append("CHANGE")
        words += ["NAME", "JOB", "NEWS", "ABOUT...", "SQUEEZE PAST"]
        return words

    def talk_menu(self):
        t = self.talk
        if not t or self.scene:
            return
        vid = t["v"]
        if t["mode"] == "buy":
            self.shop_menu(vid)
            return
        if t["mode"] == "gift":
            self.gift_menu(vid)
            return
        words = self.talk_words(vid)
        self.open_menu("Talk to %s:" % VILLAGERS[vid]["short"],
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        if w != "ABOUT...":
            self.say("> " + (w or "bye"), "you")
        self.converse(w.lower())
        self.back_to_talk()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.scene = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if self.p and self.area:
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if getattr(self, "naming", None) is not None:
            self.finish_naming(text)
            return
        if self.menu and (not text or text.isdigit()):
            i = int(text) - 1 if text.isdigit() else None
            if i is None or 0 <= i < len(self.menu["items"]):
                self.menu_pick(i)
            return
        if not self.talk or self.scene:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()

    def converse(self, w):
        t = self.talk
        if not t:
            return
        vid = t["v"]
        v = VILLAGERS[vid]
        w = w.strip().rstrip("?!.").strip()
        if w in ("", "bye", "goodbye"):
            self.speak(vid, random.choice(BYES[self.tier(vid)]))
            self.end_talk()
            self.end_turn(1)
            return
        if w[:4] in ("sque", "past", "move", "excu", "scoo", "swap"):
            if self.squeeze_past(self.npcs[vid]):
                self.say("%s: %s" % (v["short"], random.choice(
                    PAST_LINES)), "talk")
                self.say("%s steps aside, and you squeeze past." %
                         v["short"], "info")
            else:
                self.say("You're not in each other's way.", "info")
            self.end_talk()
            self.end_turn(1)
            return
        if self.maid(vid) and w[:4] in ("chor", "work", "task", "duty",
                                        "duti", "clea"):
            self.chore_menu(vid)
            return
        if self.maid(vid) and w[:4] in ("kiss", "smoo", "peck"):
            self.kiss_maid(vid)
            return
        if w == "chat":
            self.chat(vid)
        elif w == "gift":
            t["mode"] = "gift"
        elif w in ("buy", "shop"):
            if self.shop_open(vid):
                t["mode"] = "buy"
            else:
                self.speak(vid, "The shop's not open right now.")
        elif w == "name":
            self.speak(vid, "I'm %s." % v["name"] if self.hearts(vid) else
                       v["intro"])
        elif w == "job":
            self.speak(vid, "I'm %s." % v["job"])
        elif w == "news":
            self.speak(vid, self.news(vid))
        elif w == "about...":
            self.about_menu(vid)
            return
        elif w == "dance":
            self.dance(vid)
        elif w == "share":
            self.share_menu(vid)
            return
        elif w == "enter":
            self.enter_menu(vid)
            return
        elif w == "date":
            self.go_on_date(vid)
        elif w in ("request", "help"):
            self.deliver(vid)
        elif w in ("weather", "rain"):
            self.speak(vid, {"sun": "Should be fine tomorrow.",
                             "rain": "Feels like rain tomorrow.",
                             "storm": "(surprised)There's a storm coming "
                                      "tomorrow, I'd bet on it.",
                             "snow": "Snow tomorrow, I think."}[
                                 self.st["tomorrow"]])
        elif w[:4] in ("chan", "zap", "wand", "spel", "maid") and \
                self.maid(vid):
            self.speak(vid, random.choice(
                MAID_ABOUT_LIKE if self.likes_change(vid, "maidify") else
                MAID_ABOUT_HATE))
        elif w[:4] in ("chan", "swap", "zap", "wand", "spel") and \
                self.swapped(vid):
            self.speak(vid, random.choice(
                SWAP_ABOUT_LIKE if self.likes_change(vid) else
                SWAP_ABOUT_HATE))
        elif w in ("farm", "crops"):
            self.speak(vid, self.farm_talk(vid))
        elif w in ("love", "marry", "marriage", "date me", "romance"):
            self.speak(vid, self.love_talk(vid))
        else:
            self.topic(vid, w)

    def topic(self, vid, w):
        v = VILLAGERS[vid]
        if vid == "theo" and w.startswith("fish") and \
                "fishing rod" not in self.p["tools"]:
            self.p["tools"].append("fishing rod")
            self.p["hand"] = "fishing rod"
            self.sound.play("quest")
            self.speak(vid, "(laugh)Here, take Dad's old rod! Face the "
                            "water and use it. Rivers, the pond and the "
                            "lake each have their own fish. Go get 'em!")
            self.say("Theo gives you a fishing rod!", "good")
            return
        for k, line in v["topics"].items():
            if w == k or (len(w) >= 4 and k.startswith(w[:4])):
                self.speak(vid, line)
                return
        for other, ov in VILLAGERS.items():
            names = (other, ov["short"].lower(), ov["name"].lower())
            if w in names or (len(w) >= 4 and any(
                    n.startswith(w[:4]) for n in names)):
                if other == vid:
                    self.speak(vid, "(laugh)That's me!")
                else:
                    self.speak(vid, v["opinions"].get(
                        other, "%s? We get along fine." % ov["short"]))
                return
        for k, line in COMMON_TOPICS.items():
            if w == k or (len(w) >= 4 and k.startswith(w[:4])):
                self.speak(vid, line)
                return
        self.speak(vid, v["unknown"])

    def about_menu(self, vid):
        met = [o for o in sorted(VILLAGERS, key=lambda o:
                                 VILLAGERS[o]["short"])
               if o != vid and self.friend(o)["met"]]
        if not met:
            self.speak(vid, "You should get out and meet people!")
            self.talk_menu()
            return
        self.open_menu("Ask about whom?", [
            (VILLAGERS[o]["short"], lambda o=o: (
                self.say("> %s" % VILLAGERS[o]["short"].upper(), "you"),
                self.topic(vid, o), self.talk_menu())) for o in met] +
            [("Never mind", self.talk_menu)], self.talk_menu)

    def chat(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        pool = list(v["chat"][self.tier(vid)])
        pool.append(v["season"][self.season()])
        if self.st["weather"] in ("rain", "storm"):
            pool += [v["rain"]] * 3
        if f["status"] in ("dating", "engaged") and v.get("dating"):
            pool += v["dating"]
        if f["status"] == "married":
            pool = v["spouse"] + [v["season"][self.season()]]
        if vid == self.st.get("secret") and self.season() == 3 and \
                self.dom() < 24:
            pool.append("(happy)I wonder who my secret friend is this year!")
        last = self.talk.get("last")
        gossip = self.gossip(vid)
        if gossip and gossip != last and random.random() < 0.35:
            self.talk["last"] = gossip
            self.speak(vid, gossip)
            return
        choices = [ln for ln in pool if ln != last] or pool
        line = random.choice(choices)
        self.talk["last"] = line
        self.speak(vid, line)

    def transformed(self, vid):
        """What the wand has made of somebody, most striking first, or
        None."""
        for kind, test in (("loo", self.loo), ("tree", self.tree),
                           ("chicken", self.chicken), ("cow", self.is_cow),
                           ("statue", self.statue),
                           ("maid", self.maid), ("swapped", self.swapped)):
            if test(vid):
                return kind
        return None

    def gossip(self, vid):
        """A word about somebody else the wand has changed, wondering how
        they're taking to it, with a hint of the truth."""
        others = [(o, self.transformed(o)) for o in VILLAGERS if o != vid]
        others = [(o, k) for o, k in others if k]
        if not others:
            return None
        other, kind = random.choice(others)
        who = GOSSIP_KIN.get((vid, other), VILLAGERS[other]["short"])
        line = random.choice(GOSSIP[kind])
        if kind != "statue":
            spell = {"loo": "looify", "tree": "treeify", "chicken":
                     "chickenfy", "maid": "maidify",
                     "cow": "cowify"}.get(kind, "genderswap")
            likes = self.likes_change(other, spell)
            line += " " + random.choice(GOSSIP_HINTS[kind][0 if likes
                                                          else 1])
        return line.replace("{who}", who)

    def news(self, vid):
        st = self.st
        opts = []
        for d in range(0, 8):
            day = st["day"] + d
            f = FESTIVALS.get((self.season(day), self.dom(day)))
            if f:
                opts.append("The %s is %s! %s" % (
                    f[0], "today" if d == 0 else "tomorrow" if d == 1 else
                    "on %s %d" % (SEASONS[self.season(day)], self.dom(day)),
                    f[4]))
                break
        for other, ov in VILLAGERS.items():
            for d in range(0, 4):
                day = st["day"] + d
                if ov["birthday"] == (self.season(day), self.dom(day)) and \
                        other != vid:
                    opts.append("It's %s's birthday %s! Bring something "
                                "nice." % (ov["short"], "today" if d == 0
                                           else "tomorrow" if d == 1 else
                                           "on " + SEASONS[self.season(day)]
                                           + " %d" % self.dom(day)))
        tilled = len(st["soil"])
        if tilled > 30:
            opts.append("Everyone's talking about your farm. %d squares "
                        "planted! Your grandmother would be proud." % tilled)
        if st["stats"]["fish"] > 10:
            opts.append("Theo says you're a natural with a rod.")
        p = self.partner()
        if p and p != vid:
            opts.append({"dating": "I hear you and %s are courting! How "
                                   "lovely!",
                         "engaged": "You and %s are getting married! The "
                                    "whole village is buzzing!",
                         "married": "You and %s make a lovely couple."}[
                             st["friends"][p]["status"]] %
                        VILLAGERS[p]["short"])
        if st["tomorrow"] in ("rain", "storm"):
            opts.append("Theo says it'll rain tomorrow. He's usually "
                        "right. About weather.")
        opts += GENERIC_NEWS
        return random.choice(opts)

    def farm_talk(self, vid):
        n = len(self.st["soil"])
        if n == 0:
            return "Have you planted anything yet? Mabel sells seeds."
        if n < 20:
            return "A little garden's a good start."
        return "(happy)Your farm's coming along wonderfully!"

    def love_talk(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        if f["status"] == "married":
            return "(blush)We're married, silly. I love you."
        if f["status"] in ("dating", "engaged"):
            return "(blush)You know how I feel about you."
        if not v["romance"]:
            return "(laugh)Oh, you charmer! Not for me, I'm afraid."
        if self.hearts(vid) >= 8:
            return "(blush)...Maybe if someone gave me a bouquet, I'd say " \
                   "yes. Just maybe."
        return "(surprised)Oh! Um. Let's get to know each other first."

    # ── Gifts ──

    def gift_menu(self, vid):
        items = sorted(n for n, c in self.p["items"].items()
                       if c and not n.endswith(" seeds")
                       and n != "sprinkler")
        if not items:
            self.talk["mode"] = "kw"
            self.speak(vid, "You've nothing to give right now.", log=False)
            self.say("You've nothing to give.", "info")
            self.talk_menu()
            return

        def back():
            self.talk["mode"] = "kw"
            self.talk_menu()
        self.open_menu("Give %s what?" % VILLAGERS[vid]["short"], [
            ("%s%s" % (n, " x%d" % self.p["items"][n]
                       if self.p["items"][n] > 1 else ""),
             lambda n=n: self.give_gift(vid, n)) for n in items] +
            [("Nothing", back)], back)

    def give_gift(self, vid, item):
        self.talk["mode"] = "kw"
        v = VILLAGERS[vid]
        f = self.friend(vid)
        st = self.st
        self.say("> (you give %s %s)" % (v["short"], an(item)), "you")
        if item == "blossom bouquet":
            self.bouquet(vid)
            self.talk_menu()
            return
        if item == "blossom pendant":
            self.pendant(vid)
            self.talk_menu()
            return
        birthday = v["birthday"] == (self.season(), self.dom())
        secret = (self.festival_on() and self.season() == 3 and
                  vid == st.get("secret"))
        if f["gift_day"] == st["day"]:
            self.speak(vid, "You've already given me something today. "
                            "That's plenty!")
            self.talk_menu()
            return
        if f["week"] >= 2 and not birthday and not secret and \
                f["status"] != "married":
            self.speak(vid, "You've been so generous this week! Save it "
                            "for someone else.")
            self.talk_menu()
            return
        self.take(item)
        taste = gift_taste(vid, item)
        pts = GIFT_POINTS[taste]
        if birthday:
            pts *= 5 if pts > 0 else 2
        if secret:
            pts = max(pts, 0) * 3 + 100
        f["gift_day"] = st["day"]
        f["week"] += 1
        self.speak(vid, v["gift"][taste])
        if birthday and pts > 0:
            self.speak(vid, "(happy)And on my birthday, too!")
        if secret:
            self.speak(vid, "(laugh)You're my secret friend?! I'd never "
                            "have guessed!")
            st["flags"].append("secret_done%d" % self.year())
        self.befriend(vid, pts)
        self.check_scene(vid)
        if not self.scene:
            self.talk_menu()

    def bouquet(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        other = self.partner()
        if not v["romance"]:
            self.speak(vid, "(surprised)Oh! Flowers! That's very sweet of "
                            "you, but I'm not looking for anything like "
                            "that.")
            return
        if f["status"]:
            self.speak(vid, "(blush)We're already together, silly. But "
                            "thank you.")
            return
        if other:
            self.speak(vid, "(sad)Aren't you with %s?" %
                       VILLAGERS[other]["short"])
            return
        if self.hearts(vid) < 8:
            self.speak(vid, "(blush)Oh... I like you, {name}. But not like "
                            "that. Not yet.")
            return
        self.take("blossom bouquet")
        f["status"] = "dating"
        self.sound.play("quest")
        self.speak(vid, ACCEPT[vid])
        self.say("You and %s are going steady!" % v["short"], "heart")
        self.flash(self.npcs[vid].x, self.npcs[vid].y, "heart")

    def pendant(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        if f["status"] != "dating" or self.hearts(vid) < 10:
            if f["status"] in ("engaged", "married"):
                self.speak(vid, "(blush)You already asked. I already said "
                                "yes!")
            elif f["status"] == "dating":
                self.speak(vid, "(blush)Oh! It's beautiful. I... I'm not "
                                "ready for that yet. Give it time.")
            else:
                self.speak(vid, "(surprised)A pendant?! We're not even "
                                "courting!")
            return
        if not self.p["extension"]:
            self.speak(vid, "(blush)Yes! Of course yes! ...But where would "
                            "we live? Your cabin barely fits you. Talk to "
                            "Ivy about a bigger CABIN?")
            self.st["topics"].append("cabin")
            return
        self.take("blossom pendant")
        f["status"] = "engaged"
        self.st["wedding"] = self.st["day"] + 3
        self.sound.play("quest")
        self.speak(vid, PROPOSAL[vid])
        self.say("You're engaged to %s! The wedding will be in three days, "
                 "in the square, at ten in the morning." % v["short"],
                 "heart")

    # ── Scenes ──

    def check_scene(self, vid):
        """Somebody you've grown close to shares a moment: True if a scene
        has begun."""
        v = VILLAGERS[vid]
        f = self.friend(vid)
        for level in sorted(v["scenes"]):
            if level not in f["scenes"] and self.hearts(vid) >= level:
                f["scenes"].append(level)
                self.play_scene(vid, v["scenes"][level], level)
                return True
        return False

    def play_scene(self, vid, steps, level=None, after=None):
        self.scene = {"v": vid, "steps": list(steps), "i": 0,
                      "level": level, "after": after}
        self.menu = None
        if not self.talk:
            self.talk = {"v": vid, "mode": "kw", "expr": "neutral",
                         "text": ""}
        self.sound.play("heart")
        self.scene_step()

    def scene_step(self):
        sc = self.scene
        vid = sc["v"]
        if sc["i"] >= len(sc["steps"]):
            gift = SCENE_GIFTS.get((vid, sc["level"]))
            if gift:
                self.give(gift)
                self.say("(You receive %s.)" % an(gift), "good")
            after = sc["after"]
            self.scene = None
            if after:
                after()
            elif self.talk:
                self.talk_menu()
            return
        step = sc["steps"][sc["i"]]
        sc["i"] += 1
        if isinstance(step, tuple):
            _, question, answers = step
            self.speak(vid, "*" + question)

            def answer(a):
                text, pts, reply = a
                self.say("> " + text, "you")
                if pts:
                    self.befriend(vid, pts, quiet=True)
                self.speak(vid, reply)
                self.open_menu("", [("▶", self.scene_step)],
                               self.scene_step)
            self.open_menu("", [(a[0], lambda a=a: answer(a))
                                for a in answers])
            return
        self.speak(vid, step)
        self.open_menu("", [("▶", self.scene_step)], self.scene_step)

    # ── Shops ──

    def shop_open(self, vid):
        shop = VILLAGERS[vid]["shop"]
        if not shop or self.festival_on() or self.maid(vid):
            return False
        n = self.npcs[vid]
        area, mark = shop[0].split(".")
        if area == "out":
            spot = ("valley",) + OUT_SPOTS[mark]
        else:
            spot = (area,) + self.areas[area].spots[mark]
        return (n.where, n.x, n.y) == spot

    def offers(self, vid):
        kind = VILLAGERS[vid]["shop"][1]
        out = []
        for entry in SHOP_STOCK[kind]:
            if entry == "seeds":
                for c in sorted(CROPS):
                    if self.season() in crop(c, "seasons"):
                        out.append((c + " seeds", crop(c, "seed")))
                continue
            name, price = entry
            if name in ("fishing rod", "leash", "milk pail") and \
                    name in self.p["tools"]:
                continue
            if name == "barn" and "barn" in self.built():
                continue
            if name == "cow" and ("barn" not in self.built() or len(
                    self.st["cows"]) >= BARN_ROOM):
                continue
            if name == "copper can" and self.p["can"] > 20:
                continue
            if name == "cabin extension" and self.p["extension"]:
                continue
            if name == "chicken coop" and "coop" in self.built():
                continue
            if name == "chicken" and ("coop" not in self.built() or len(
                    self.st["chickens"]) >= COOP_ROOM):
                continue
            if name == "blossom pendant" and not (
                    self.partner() and self.hearts(self.partner()) >= 10):
                continue
            if name == "checkup" and "checkup" in self.flags_today():
                continue
            out.append((name, price))
        return out

    def shop_menu(self, vid):
        def back():
            self.talk["mode"] = "kw"
            self.talk_menu()
        rows = []
        for name, price in self.offers(vid):
            extra = EXTRA_COST.get(name, {})
            label = "%s%s  %s" % (
                name, " x%d" % BUNDLES[name] if name in BUNDLES else "",
                "%dg" % price if price else "free")
            if extra:
                label += " + " + ", ".join("%d %s" % (c, n)
                                           for n, c in extra.items())
            if name.endswith(" seeds"):
                rows.append((label, lambda n=name, pr=price:
                             self.how_many(vid, n, pr)))
            else:
                rows.append((label, lambda n=name, pr=price:
                             self.buy(vid, n, pr)))
        rows.append(("Nothing, thanks", back))
        self.open_menu("Buy what? (you have %dg)" % self.p["gold"], rows,
                       back)

    def how_many(self, vid, name, price):
        rows = [("%d for %dg" % (k, k * price),
                 lambda k=k: self.buy(vid, name, price, k))
                for k in (1, 5, 10, 20) if k * price <= self.p["gold"]]
        if not rows:
            self.speak(vid, "You can't afford that.")
            return
        self.open_menu("How many %s?" % name, rows +
                       [("None", lambda: None)], lambda: None)

    def buy(self, vid, name, price, k=1):
        p = self.p
        extra = EXTRA_COST.get(name, {})
        if k > 1:
            if p["gold"] < price * k:
                self.speak(vid, "You can't afford that many.")
                return
            p["gold"] -= price * k
            self.give(name, k)
            self.sound.play("gold")
            self.say("You buy %d %s for %dg." % (k, name, price * k), "gold")
            return
        if p["gold"] < price:
            self.speak(vid, "You can't afford that.")
            self.say("You can't afford it.", "bad")
            return
        for n, c in extra.items():
            if p["items"].get(n, 0) < c:
                self.speak(vid, "I'll need %d %s for that." % (c, n))
                return
        p["gold"] -= price
        for n, c in extra.items():
            self.take(n, c)
        self.sound.play("gold")
        if name in ("fishing rod", "leash", "milk pail"):
            p["tools"].append(name)
            p["hand"] = name
            if name == "milk pail":
                self.speak(vid, "(happy)A good pail. Once a day per cow, "
                                "mind. Cows have opinions about that.")
                return
            if name == "leash":
                self.speak(vid, "(laugh)A leash? For a chicken? Well, it's "
                                "your gold. Mind she doesn't lead YOU.")
                return
        elif name == "copper can":
            p["can"] = p["water"] = 40
            self.speak(vid, "(laugh)There! A copper can! Holds twice as "
                            "much!")
            return
        elif name == "cow":
            c = self.add_cow()
            self.speak(vid, "(happy)She's in your barn already. Her name's "
                            "%s. Milk her once a day and she'll be happy "
                            "as anything." % c["name"])
            return
        elif name == "barn":
            self.build_barn()
            self.speak(vid, "(happy)There. A proper barn, up by your fields. "
                            "Room for six cows. Mabel sells them, and the "
                            "pail to milk them.")
            return
        elif name == "chicken coop":
            self.build_coop()
            self.speak(vid, "(happy)Done and dusted. Your coop's up beside "
                            "the cabin. Room for eight hens. Go see Mabel "
                            "about chickens.")
            return
        elif name == "chicken":
            c = self.add_chicken()
            self.speak(vid, "(happy)One hen, healthy and laying! She's "
                            "called %s. I've had her sent up to your "
                            "coop." % c["name"])
            return
        elif name == "cabin extension":
            p["extension"] = True
            self.speak(vid, "(happy)Deal. I'll have it done by morning. A "
                            "proper bedroom, room for two. Just saying.")
            return
        elif name == "checkup":
            self.flags_today().append("checkup")
            p["energy"] = min(p["max_energy"], p["energy"] + 30)
            self.speak(vid, "(happy)Heart's good, lungs are good. Here, "
                            "some water and a rest. (+30 energy)")
            return
        else:
            self.give(name, BUNDLES.get(name, 1))
        self.say("You buy %s for %dg." % (
            "%d %s" % (BUNDLES[name], name) if name in BUNDLES else
            an(name), price), "gold")

    # ── Festivals ──

    def fest_key(self):
        return "fest%d-%d" % (self.season(), self.year())

    def dance(self, vid):
        st = self.st
        k = self.fest_key()
        if k in st["flags"]:
            self.speak(vid, "(happy)You've already had your dance! Wasn't "
                            "it lovely?")
            return
        if self.hearts(vid) < 4:
            self.speak(vid, "(blush)Oh! I... don't think I know you well "
                            "enough yet. Sorry!")
            return
        st["flags"].append(k)
        self.sound.play("quest")
        self.say("You dance with %s beneath the blossoms while Wren plays. "
                 "Petals fall like snow." % VILLAGERS[vid]["short"], "heart")
        self.speak(vid, "(blush)That was wonderful. Thank you, {name}.")
        self.befriend(vid, 250 if VILLAGERS[vid]["romance"] else 150)
        self.pass_time(30)

    def share_menu(self, vid):
        if self.fest_key() in self.st["flags"]:
            self.speak(vid, "(happy)You've already shared! Everyone's "
                            "still talking about it.")
            self.talk_menu()
            return
        food = sorted(n for n, c in self.p["items"].items()
                      if c and ITEMS.get(n, (0, 0, "?"))[2] in
                      ("crop", "food", "fruit", "fish", "forage", "animal")
                      and ITEMS[n][1])
        if not food:
            self.speak(vid, "Bring something to share! Anything you can "
                            "eat.")
            self.talk_menu()
            return

        def share(n):
            self.take(n)
            self.st["flags"].append(self.fest_key())
            self.sound.play("quest")
            self.speak(vid, "(happy)%s! Into the pot it goes! Everyone, "
                            "%s brought %s!" % (cap(n), "{name}", an(n)))
            for o in VILLAGERS:
                self.befriend(o, 30 + ITEMS[n][0] // 10, quiet=True)
            self.say("The whole village enjoys your %s. (Everyone +"
                     "friendship)" % n, "heart")
            self.talk_menu()
        self.open_menu("Share what?", [(n, lambda n=n: share(n))
                                       for n in food] +
                       [("Never mind", self.talk_menu)], self.talk_menu)

    def enter_menu(self, vid):
        if self.fest_key() in self.st["flags"]:
            self.speak(vid, "You've entered already! The judging's done.")
            self.talk_menu()
            return
        crops = sorted(n for n, c in self.p["items"].items()
                       if c and ITEMS.get(n, (0, 0, "?"))[2] in
                       ("crop", "fruit"))
        if not crops:
            self.speak(vid, "Bring your best crop to enter! Anything you "
                            "grew yourself.")
            self.talk_menu()
            return

        def enter(n):
            self.take(n)
            self.st["flags"].append(self.fest_key())
            score = ITEMS[n][0] + random.randint(0, 90) + \
                len(self.st["soil"]) // 4
            prize, place = ((1000, "First") if score >= 220 else
                            (500, "Second") if score >= 120 else
                            (200, "Third"))
            self.p["gold"] += prize
            self.sound.play("quest")
            self.speak(vid, "(happy)Ahem! The judges have tasted, weighed "
                            "and admired! %s prize, for %s's magnificent "
                            "%s! %d gold!" % (place, "{name}", n, prize))
            self.befriend(vid, 100)
            self.talk_menu()
        self.open_menu("Enter which crop?", [(n, lambda n=n: enter(n))
                                             for n in crops] +
                       [("Never mind", self.talk_menu)], self.talk_menu)

    # ── Dates, and the wedding ──

    def go_on_date(self, vid):
        f = self.friend(vid)
        f["dated"] = self.st["day"]
        v = VILLAGERS[vid]

