        if style in ("long", "curly", "braid", "bob", "pigtails", "bangs"):
            for y in range(line, fy + 6):          # hair framing the face
                for x in (round(cx - frx) - 1, round(cx - frx),
                          round(cx - frx) + 1):
                    if y < fy + 3 or x < round(cx - frx) + 1:
                        g[y][x] = hair
                        g[y][mirror(x)] = hair
        # bangs
        if style == "bangs":                       # heavy, to the brows
            prect(g, 8, line, 23, line + 1, hair)
            for x in range(9, 23):
                if x % 3 != 1:
                    g[line + 2][x] = hair
            for x in range(10, 22, 4):
                g[line + 1][x] = hd
        elif style in ("bob", "pigtails", "braid"):
            prect(g, 9, line, 22, line + 1, hair)
            for x in range(9, 23, 3):
                g[line + 2][x] = hair
        elif style in ("messy", "spiky", "curly"):
            for x in range(10, 22, 2):
                prect(g, x, line, x, line + 1 + (x // 2) % 2, hair)
        elif style in ("long", "ponytail", "bun"):
            # a side parting
            prect(g, 9, line, 14, line + 1, hair)
            g[line + 2][9] = g[line + 2][10] = hair
            prect(g, 18, line, 22, line, hair)
        else:
            prect(g, 9, line, 22, line, hair)
            prect(g, 9, line, 12, line + 1, hair)
        # shine
        for x in range(10, 15):
            if g[top + 2][x] == hair:
                g[top + 2][x] = hl
        if g[top + 1][13] == hair:
            g[top + 1][13] = hl
        if style == "braid":
            for y in range(fy + 2, 30, 2):
                pdisc(g, cx + frx + 1, y, 1.6, 1.2, hair)
                g[y][round(cx + frx + 1)] = hd
    if "hat" in extras:
        hc = look.get("hatc", "#a07040")
        prect(g, 5, top + 2, 26, top + 3, shade(hc, 0.85))
        pdisc(g, cx, top + 1, 7, 4, hc, lambda x, y: y <= top + 2)
