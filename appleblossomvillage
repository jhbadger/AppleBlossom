        disc(g, 7.5, 6, 4.5, "#3a9a3a", rng, 0.6)
        disc(g, 6, 5, 2, "#5ab850")
        return g
    if name == "cot":
        g = draw_terrain("tile")
        rect(g, 2, 1, 13, 14, "#c0c8d0")
        rect(g, 3, 2, 12, 4, "#ffffff")
        rect(g, 3, 6, 12, 13, "#a0d0e0")
        return g
    if name == "cabinet":
        g = grid_of("#e8e8e8")
        rect(g, 1, 1, 14, 14, "#d0d0d8")
        rect(g, 7, 1, 8, 14, "#a0a0a8")
        rect(g, 5, 6, 10, 9, "#e04040")
        rect(g, 7, 5, 8, 10, "#e04040")
        return g
    if name == "piano":
        g = grid_of("#2a1a14")
        rect(g, 1, 1, 14, 9, "#3a2418")
        rect(g, 1, 10, 14, 13, "#ffffff")
        for x in range(2, 14, 2):
            rect(g, x, 10, x, 11, "#1a1a1a")
        return g
    if name == "easel":
        g = planks(rng, "#a07850", "#7a5838", vertical=True, width=5)
        rect(g, 3, 1, 12, 10, "#f8f4ec")
        disc(g, 6, 5, 2.5, "#f080a0")
        rect(g, 7, 7, 11, 9, "#60a0d0")
        rect(g, 4, 11, 4, 15, "#5a3a20")
        rect(g, 11, 11, 11, 15, "#5a3a20")
        return g
    if name == "nets":
        g = planks(rng, "#a07850", "#7a5838", vertical=True, width=5)
        for i in range(0, 16, 3):
            rect(g, i, 0, i, 15, "#c8b890")
            rect(g, 0, i, 15, i, "#c8b890")
        return g
    if name == "toolrack":
        g = planks(rng, "#a07850", "#7a5838", vertical=True, width=5)
        rect(g, 0, 2, 15, 2, "#5a3a20")
        for x, c in ((2, "#9a9aa0"), (6, "#c0c0c8"), (10, "#9a9aa0"),
                     (13, "#c0a040")):
            rect(g, x, 3, x, 12, "#7a4a28")
            rect(g, x - 1, 11, x + 1, 13, c)
        return g
    if name == "tv":
        return draw_terrain("goods", frame, s)
    raise KeyError(name)


