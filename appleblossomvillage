                "Uwaa~! "]
KAWAII_END = [", senpai!", ", senpai~", "~ ehehe", " Kawaii desu!",
              ", senpai. Notice me~"]


def kawaiify(text, you):
    """Say it like an anime schoolgirl: you're senpai, things are kawaii
    and sugoi, and there's a Kyaa~! or a senpai at the end."""
    if you:
        text = re.sub(r"\b%s\b" % re.escape(you), "senpai", text)
        text = re.sub(r"(^|[.!?] )senpai", lambda m: m.group(1) + "Senpai",
                      text)

    def swap(m):
        w = m.group(0)
        new = {k.lower(): v for k, v in KAWAII_WORDS}[w.lower()]
        return new[:1].upper() + new[1:] if w[:1].isupper() else new
    pattern = r"\b(%s)\b" % "|".join(re.escape(a) for a, _ in KAWAII_WORDS)
    text = re.sub(pattern, swap, text, flags=re.I)
    if random.random() < 0.5:
        text = random.choice(KAWAII_START) + text
    text = re.sub(r"(^|[.!?] )Sorry\b", lambda m: m.group(1) + "Gomen",
                  text)
    if "senpai" not in text.lower() or random.random() < 0.4:
        m = re.search(r"[.!?~]+$", text)
        end = random.choice(KAWAII_END)
        if end.startswith(" "):                 # a sentence of its own
            text = text + ("" if m else ".") + end
        elif m:                                 # tucked in before the stop
            text = text[:m.start()] + end + ("" if end[-1] in "!~" else
                                              text[m.start():])
        else:
            text += end
    return text


