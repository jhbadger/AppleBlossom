        g[fy2][fx] = "#f0e040"
    if "headband" in extras:
        prect(g, 9, top + 3, 22, top + 3, look.get("bandc", "#e04080"))
    if "hairbow" in extras:
        cc = look.get("clipc", "#90dcc8")
        bx, by = 7, top + 4
