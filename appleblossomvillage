    def build_world(self, seed, built=()):
        """The valley and every room, from the code (and the farm's debris
        from the seed)."""
        grid, labels = make_valley(seed, built)
        v = Area("valley", grid, "Apple Blossom Village")
        v.labels = labels
        self.areas = {"valley": v}
        for key in ROOMS:
            g, spots, entry, ex = make_room(key)
            a = Area(key, g, BUILDINGS[key][6])
            a.spots, a.entry, a.exit = spots, entry, ex
            self.areas[key] = a
        for key in EXTRA_ROOMS:
            g, spots, entry, ex = make_room(key)
            a = Area(key, g, "the outhouse")
            a.spots, a.entry, a.exit = spots, entry, ex
            self.areas[key] = a
        self.forage_zones = forage_spots(grid)
        self.lamps = [(x, y) for y in range(VH) for x in range(VW)
                      if grid[y][x] in ("lamp", "fountain")]
        self.door_at = {door_of(k): k for k in BUILDINGS
                        if k not in ON_ORDER or k in built}
        self.npcs = {vid: Villager(vid) for vid in VILLAGERS}

    def new_game(self, who=None):
        if who is None:
            if self.p is None:
                self.ask_hero(lambda w: self.new_game(w) if w else
                              self.new_game(self.default_hero()))
            else:
                self.ask_hero(lambda w: w and self.new_game(w))
            return
        self.end_talk()
        self.menu = None
        self.overlay = None
        seed = random.randrange(1 << 30)
        self.build_world(seed)
        self.p = {"name": who["name"], "farm": who["farm"],
                  "pron": who["pron"], "look": who["look"], "gold": 500,
                  "energy": MAX_ENERGY, "max_energy": MAX_ENERGY,
