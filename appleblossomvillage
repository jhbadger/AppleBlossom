        if not st["request"] and random.random() < 0.5:
            self.new_request()
        if any(not m["read"] for m in st["mail"]):
            self.say("There's mail in your mailbox.", "info")
        if st["wedding"] is not None and st["wedding"] < st["day"]:
            st["wedding"] = st["day"]
            self.say("You missed your wedding! Everyone's agreed to try "
                     "again today.", "bad")
        if st["wedding"] == st["day"]:
            self.say("Today's your wedding day! Go to the square between "
                     "ten and three.", "heart")
        self.spouse_morning()
        self.maid_morning()

    def new_request(self):
        s = self.season()
        pool = [c for c in CROPS if s in crop(c, "seasons")] + \
            [f[0] for f in FORAGE[s]] + FISH["river"][s][:2]
        item = random.choice(pool)
        who = random.choice(sorted(VILLAGERS))
        n = 1 if ITEMS[item][0] > 100 else random.randint(1, 3)
        self.st["request"] = {"who": who, "item": item, "n": n,
                              "due": self.st["day"] + 3,
                              "reward": ITEMS[item][0] * n * 3 + 60}

    def read_board(self):
        r = self.st["request"]
        f = self.festival_today()
        lines = ["THE NOTICE BOARD", ""]
        if r:
            lines += wrap("HELP WANTED: %s needs %d %s, by %s %d. Reward: "
                          "%dg. (Bring it to them and ask about the "
                          "REQUEST.)" % (VILLAGERS[r["who"]]["name"], r["n"],
                                         plural(r["item"], r["n"]),
                                         SEASONS[self.season(r["due"])],
                                         self.dom(r["due"]), r["reward"]),
                          50)
        else:
            lines.append("No requests today.")
        lines.append("")
        for d in range(0, 28):
            day = self.st["day"] + d
            f = FESTIVALS.get((self.season(day), self.dom(day)))
            if f:
                lines += wrap("COMING UP: the %s, %s %d. %s" % (
                    f[0], SEASONS[self.season(day)], self.dom(day), f[4]),
                    50)
                break
        lines.append("")
        lines.append("LOST: one cat, orange, answers to Biscuit. - M. Pike")
        self.st["topics"].append("request") if "request" not in \
            self.st["topics"] else None
        self.show_text("\n".join(lines) + "\n\n(Any key closes.)")

    def deliver(self, vid):
        r = self.st["request"]
        if not r or r["who"] != vid:
            self.speak(vid, "I don't need anything right now. Thanks, "
                            "though!")
            return
        if self.p["items"].get(r["item"], 0) < r["n"]:
            self.speak(vid, "I'm still hoping for %d %s, if you come "
                            "across any!" % (r["n"], plural(r["item"],
                                                            r["n"])))
            return
        self.take(r["item"], r["n"])
        self.p["gold"] += r["reward"]
        self.st["request"] = None
        self.sound.play("quest")
        self.speak(vid, "(happy)You found them! Thank you so much! Here, "
                        "%dg, as promised." % r["reward"])
        self.befriend(vid, 120)

    # ── Keys ──

    def on_key(self, ev):
        k = ev.keysym
        if getattr(self, "dialog", None) is not None:
            return
        if getattr(self, "naming", None) is not None:
            if k == "Escape":
                self.end_naming()
            return
        if self.talk and ev.widget is self.entry:
            # typing a word: the entry has it, but arrows still move
            # through the menu, and Return picks from it when it's empty
            if self.menu and k in ("Up", "Down"):
                self.menu_move(-1 if k == "Up" else 1)
            return
        if self.menu:
            if k in ("Up", "w", "KP_Up", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "KP_Down", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "KP_Enter", "space", "e"):
                self.menu_pick()
            elif k == "Escape":
                self.menu_cancel()
            elif k.isdigit() and k != "0":
                i = int(k) - 1
                m = self.menu
                if i < len(m["items"]):
                    self.menu_pick(i)
            elif self.talk and len(ev.char) == 1 and ev.char.isalpha() \
                    and not self.scene:
                self.menu = None
                self.entry.focus_set()
                self.entry.insert("end", ev.char)
                self.render()
            return "break"
        if self.overlay:
            self.close_overlay()
            return
        if self.talk:
            return
        if not self.p or self.busy:
            return
        ctrl = ev.state & 0x4
        if getattr(self, "aim", False):
            if k in MOVE_KEYS and not ctrl:
                self.zap(*MOVE_KEYS[k])
            elif k in ("space", "e", "Return", "KP_Enter"):
                self.zap()
            elif k == "Escape":
                self.cancel_aim()
            return
        if k in MOVE_KEYS and not ctrl:
            self.walking = None
            self.move(*MOVE_KEYS[k])
        elif k in ("space", "e", "Return", "KP_Enter"):
            self.use_tool()
        elif k in ("q", "Tab"):
            self.next_tool(1)
        elif k in ("Q", "ISO_Left_Tab"):
            self.next_tool(-1)
        elif k.isdigit() and k != "0":
            self.pick_tool(int(k) - 1)
        elif k == "i":
            self.bag_menu()
        elif k == "z":
            self.wait_menu()
        elif k == "f":
            self.show_friends()
        elif k == "j":
            self.show_diary()
        elif k == "m":
            self.toggle_map()
        elif k in ("question", "slash", "h"):
            self.show_help()
        elif k == "v":
            self.toggle_mute()
        elif k == "b":
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "KP_Subtract"):
            self.zoom(-1)
        elif k == "n":
            self.ask_new_game()
        elif k == "Escape":
            self.action_menu()

    def close_overlay(self):
        self.overlay = None
        self.overlay_text = None
        self.render()

    def show_text(self, text):
        self.overlay = "text"
        self.overlay_text = text
        self.render()

    # ── Menus ──

    def open_menu(self, title, items, cancel=None):
        self.menu = {"title": title, "items": items, "sel": 0,
                     "cancel": cancel}
        self.render()

    def menu_move(self, d):
        m = self.menu
        m["sel"] = (m["sel"] + d) % len(m["items"])
        self.render()

    def menu_pick(self, i=None):
        if i in ("up", "down"):
            m = self.menu
            page = m.get("page", 1)
            m["sel"] = max(0, min(len(m["items"]) - 2, m["sel"] + (
                page if i == "down" else -page)))
            self.render()
            return
        m, self.menu = self.menu, None
        self.render()
        m["items"][m["sel"] if i is None else i][1]()
        self.back_to_talk()

    def menu_cancel(self):
        if self.scene and self.menu and not self.menu["cancel"]:
            return              # a scene's choice has to be answered
        m, self.menu = self.menu, None
        if m is None:
            return
        self.render()
        if m["cancel"]:
            m["cancel"]()
        self.back_to_talk()

    def back_to_talk(self):
        """After a choice in a conversation, carry on talking."""
        if self.talk and not self.menu and not self.scene:
            self.talk_menu()

    def draw_menu(self):
        """The menu: in the middle of the map, or, while you're talking,
        above the conversation on the right."""
        c, m = self.canvas, self.menu
        W, H = c.winfo_width(), c.winfo_height()
        size = 15 if ANDROID else 13
        f, bold = F("Helvetica", size), F("Helvetica", size, "bold")
        rh = f.metrics("linespace") + S(14 if ANDROID else 8)
        labels = [label for label, _ in m["items"]]
        title = m["title"]
        top_y, bottom_y = 8, H - 8
        if self.talk:
            bottom_y = self.talk_box_top - S(6)
        bw = min(W - 20, max([f.measure(t) for t in labels] +
                             [bold.measure(title) if title else 0]) + 40)
        if title and bold.measure(title) > bw - 40:
            title = "\n".join(wrap(title, max(20, len(title) * (bw - 40) //
                                              bold.measure(title))))
        th = (title.count("\n") + 1) * rh if title else 0
        fit = max(1, (bottom_y - top_y - th - 16) // rh)
        n_items = len(labels)
        if n_items <= fit:
            shown = list(enumerate(labels))
        else:
            page = max(1, fit - 3)
            m["page"] = page
            first = max(0, min(m["sel"] - page // 2, n_items - 1 - page))
            shown = [("up", "▲ more" if first else "")] + \
                [(i, labels[i]) for i in range(first, first + page)] + \
                [("down", "▼ more" if first + page < n_items - 1
                  else ""), (n_items - 1, labels[-1])]
        bh = len(shown) * rh + th + 16
        if self.talk:
            x0 = W - bw - 10
            y0 = max(top_y, bottom_y - bh)
        else:
            x0, y0 = (W - bw) // 2, max(8, (H - bh) // 2)
        c.create_rectangle(x0, y0, x0 + bw, y0 + bh, fill=PANEL,
                           outline=ACCENT, width=2, tags="overlay")
        if title:
            c.create_text(x0 + 20, y0 + 8 + th // 2, text=title, anchor="w",
                          fill=ACCENT, font=bold, tags="overlay")
        self.menu_rows = []
        for n, (i, label) in enumerate(shown):
            ry = y0 + 8 + th + n * rh
            if i == m["sel"]:
                c.create_rectangle(x0 + 6, ry, x0 + bw - 6, ry + rh,
                                   fill="#5a3450", outline="",
                                   tags="overlay")
            if isinstance(i, str):
                if label:
                    c.create_text(x0 + bw // 2, ry + rh // 2, text=label,
                                  fill=ACCENT, font=f, tags="overlay")
                    self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))
                continue
            c.create_text(x0 + 20, ry + rh // 2, text=label, anchor="w",
                          fill=INK, font=f, tags="overlay")
            self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))

    def action_menu(self):
        if self.busy or self.talk:
            return
        self.overlay = None
        self.open_menu("Apple Blossom Village", [
            ("Help", self.show_help), ("Your bag", self.bag_menu),
            ("Hold a tool", self.tool_menu), ("Friends", self.show_friends),
            ("Diary", self.show_diary), ("Map", self.toggle_map),
            ("Wait...", self.wait_menu),
            ("Zoom in", lambda: self.zoom(1)),
            ("Zoom out", lambda: self.zoom(-1)),
            ("Bigger text", lambda: self.text_size(1)),
            ("Smaller text", lambda: self.text_size(-1)),
            ("Sound effects %s" % ("on" if self.sound.muted else "off"),
             self.toggle_mute),
            ("Music %s" % ("on" if self.sound.music_off else "off"),
             self.toggle_music),
            ("New game", self.ask_new_game), ("Quit", self.quit)])

    def wait_menu(self):
        if not self.ready():
            return
        rows = [("Ten minutes", lambda: self.wait_for(10)),
                ("An hour", lambda: self.wait_for(60))]
        h = self.hhmm()
        if h < 1800:
            rows.append(("Until evening", lambda: self.wait_for(
                18 * 60 - self.st["minute"])))
        if self.area.key == "cabin":
            rows.append(("Go to bed", self.sleep))
        rows.append(("Never mind", lambda: None))
        self.open_menu("Wait how long?", rows)

    def wait_for(self, minutes):
        self.say("You wait a while.", "info")
        self.pass_time(minutes)
        if minutes >= 30:
            self.settle_npcs()
        self.render()

    def ask_new_game(self):
        if self.busy:
            return
        self.open_menu("Start over? This farm will be lost.",
                       [("Yes, a new farmer", lambda: self.new_game()),
                        ("No", lambda: None)])

    # ── Taps and walking ──

    def on_tap(self, ev):
        self.walking = None
        if not self.cells:
            return
        if self.menu:
            for x0, y0, x1, y1, i in self.menu_rows:
                if x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
                    self.menu_pick(i)
                    return
            if self.scene:
                self.menu_pick(0) if len(self.menu["items"]) == 1 else None
                return
            if not self.talk:
                self.menu_cancel()
            return
        if self.busy or self.talk:
            return
        if self.overlay:
            self.close_overlay()
            return
        cols, rows, ox, oy, ts = self.view
        tx = self.cam[0] + (ev.x - ox) // ts
        ty = self.cam[1] + (ev.y - oy) // ts
        x, y = self.pos()
        dx, dy = tx - x, ty - y
        if getattr(self, "aim", False):
            if (dx, dy) == (0, 0):
                self.zap()
            elif abs(dx) >= abs(dy):
                self.zap(1 if dx > 0 else -1, 0)
            else:
                self.zap(0, 1 if dy > 0 else -1)
            return
        if self.held() == "magic wand" and (dx == 0) != (dy == 0) and \
                self.ready():
            d = (0 if dx == 0 else dx // abs(dx),
                 0 if dy == 0 else dy // abs(dy))
            n = self.wand_target(*d)
            if n and (n.x, n.y) == (tx, ty):
                self.start_aim(d)       # tapped someone in line: which spell?
                return
        if (dx, dy) == (0, 0):
            self.use_tool()
        elif abs(dx) + abs(dy) == 1:
            self.face(dx, dy)
            if self.tool_applies(tx, ty) and self.ready():
                self.use_tool_at(tx, ty)
            else:
                self.move(dx, dy)
        elif self.area.key == "loo" and self.area.inside(tx, ty) and \
                self.tile_at(tx, ty) == "loohole" and self.ready():
            self.use_hole(tx, ty)
        else:
            self.walk_to(tx, ty)

    def use_hole(self, tx, ty):
        """Tapped a hole along the bench: shuffle over and use it."""
        for _ in range(4):
            x, y = self.pos()
            if x == tx or self.area.key != "loo":
                break
            self.move(1 if tx > x else -1, 0)
            if self.pos() == (x, y) or list(self.pos()) == [x, y]:
                break
        if self.area.key == "loo" and tuple(self.pos()) == (tx, ty + 1):
            self.move(0, -1)

    def passable(self, x, y, goal):
        a = self.area
        if not a.inside(x, y):
            return False
        if (x, y) == goal:
            return True
        if self.npc_at(x, y):
            return False
        if not a.outdoor and a.grid[y][x] == "exit":
            return False
        return self.can_stand(x, y)

    def walk_to(self, tx, ty):
        start, goal = self.pos(), (tx, ty)
        prev = {start: None}
        q = deque([start])
        while q and goal not in prev:
            x, y = q.popleft()
            if abs(x - start[0]) + abs(y - start[1]) > 60:
                continue
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if n not in prev and self.passable(n[0], n[1], goal):
                    prev[n] = (x, y)
                    q.append(n)
        if goal not in prev:
            self.say("You can't find a way there.", "info")
            return
        path = []
        while goal != start:
            path.append(goal)
            goal = prev[goal]
        self.walking = path[::-1]
        self.walk_area = self.area
        self.walk_step()

    def walk_step(self):
        if (not self.walking or not self.ready()
                or self.area is not self.walk_area):
            self.walking = None
            return
        before = self.pos()
        x, y = self.walking.pop(0)
        self.move(x - before[0], y - before[1])
        if self.pos() != (x, y):
            self.walking = None
            return
        if self.walking:
            self.root.after(80, self.walk_step)

    # ── Drawing ──

    def layout(self):
        if not self.area or not self.p:
            return
        c = self.canvas
        scale = self.auto_scale()
        if scale != self.scale:
            self.scale = scale
            self.scale_images()
            self.portraits = {}
        c.delete("all")
        ts = 16 * self.scale
        W, H = max(c.winfo_width(), ts * 5), max(c.winfo_height(), ts * 5)
        cols, rows = -(-W // ts), -(-H // ts)
        cols += 1 - cols % 2
        rows += 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append(tuple(
                    c.create_image(x, y, anchor="nw", state="hidden")
                    for _ in range(3)))
        self.shown = [(None, None, None)] * len(self.cells)
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.cursor = c.create_rectangle(0, 0, 0, 0, outline=GOLD, width=2,
                                         state="hidden")
        self.render()

    def camera(self):
        cols, rows = self.view[0], self.view[1]
        a = self.area
        x, y = self.pos()

        def axis(p, n, size):
            if size <= n:
                return -((n - size) // 2)
            return max(0, min(size - n, p - n // 2))
        return axis(x, cols, a.w), axis(y, rows, a.h)

    def render(self):
        if not self.cells or not self.area or not self.p:
            return
        if self.season_drawn != self.season():
            self.load_images()
            self.layout()
            return
        c, a, st = self.canvas, self.area, self.st
        cols, rows, ox, oy, ts = self.view
        self.cam = cx, cy = self.camera()
        px, py = self.pos()
        lvl = self.light_level()
        people = {(n.x, n.y): self.npc_tile(n.vid)
                  for n in self.npcs.values()
                  if n.where == a.key and not n.hidden}
        if a.key == "coop":
            for hen in st["chickens"]:
                people[(hen["x"], hen["y"])] = "hen_" + hen["colour"]
        if a.key == "barn":
            for cow in st["cows"]:
                people[(cow["x"], cow["y"])] = "cow_" + cow["colour"]
        lit = {}
        if lvl and a.outdoor:
            for lx, ly in self.lamps + [(px, py)]:
                if abs(lx - px) <= cols and abs(ly - py) <= rows:
                    for dy in range(-3, 4):
                        for dx in range(-3, 4):
                            d = dx * dx + dy * dy
                            if d <= 10:
                                k = (lx + dx, ly + dy)
                                b = 0 if d <= 2 else 1
                                lit[k] = min(b, lit.get(k, 2))
        soil, things = st["soil"], self.thing_at
        for j in range(rows):
            y = cy + j
            for i in range(cols):
                x = cx + i
                base = mid = top = None
                if a.inside(x, y):
                    t = a.grid[y][x]
                    k = "%d,%d" % (x, y)
                    if a.outdoor:
                        s = soil.get(k)
                        if s:
                            t = "soil_w" if s[0] else "soil"
                        th = things(x, y)
                        if th:
                            kind, what = th
                            mid = ("c_dead" if kind == "crop" and what[3]
                                   else self.stage(what) if kind == "crop"
                                   else "fg_" + what if kind == "forage"
                                   else "sprinkler" if kind == "sprinkler"
                                   else what)
                    base = t
                    if a.key == "coop" and [x, y] in st["eggs"]:
                        mid = "egg"
                    top = people.get((x, y))
                    if (x, y) == (px, py):
                        top = "you"
                    if lvl:
                        l2 = min(lvl, lit.get((x, y), 2))
                        if l2:
                            base = "%d:%s" % (l2, base)
                            if mid:
                                mid = "%d:%s" % (l2, mid)
                names = (self.framed(base), self.framed(mid),
                         self.framed(top))
                idx = j * cols + i
                old = self.shown[idx]
                if old == names:
                    continue
                self.shown[idx] = names
                for item, o, n in zip(self.cells[idx], old, names):
                    if n == o:
                        continue
                    if n is None:
                        c.itemconfig(item, state="hidden")
                    else:
                        c.itemconfig(item, image=self.image(n),
                                     state="normal")
        # the square you're facing
        fx, fy = self.ahead()
        if (a.outdoor or self.held() == "magic wand") and not self.talk \
                and self.tool_applies(fx, fy):
            sx, sy = ox + (fx - cx) * ts, oy + (fy - cy) * ts
            c.coords(self.cursor, sx + 1, sy + 1, sx + ts - 1, sy + ts - 1)
            c.itemconfig(self.cursor, state="normal")
            c.tag_raise(self.cursor)
        else:
            c.itemconfig(self.cursor, state="hidden")
        c.delete("overlay")
        if getattr(self, "aim", False):
            self.draw_aim()
        self.draw_weather()
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay == "text":
            self.draw_text_box(self.overlay_text)
        if self.talk:
            self.draw_talk()
        if self.menu:
            self.draw_menu()
        self.render_chrome()

    def draw_aim(self):
        """While the wand is raised: an arrow each way, and a gold ring
        round anyone a spell that way would hit."""
        c = self.canvas
        cols, rows, ox, oy, ts = self.view
        cx, cy = self.cam
        px, py = self.pos()
        f = F("Helvetica", 18, "bold")
        for (dx, dy), arrow in zip(DIRS, ("\u25b2", "\u25bc", "\u25c0",
                                          "\u25b6")):
            sx = ox + (px + dx - cx) * ts + ts // 2
            sy = oy + (py + dy - cy) * ts + ts // 2
            c.create_text(sx + 1, sy + 1, text=arrow, font=f, fill="#000000",
                          tags="overlay")
            c.create_text(sx, sy, text=arrow, font=f, fill=GOLD,
                          tags="overlay")
            n = self.wand_target(dx, dy)
            if n:
                x0 = ox + (n.x - cx) * ts
                y0 = oy + (n.y - cy) * ts
                c.create_oval(x0 + 1, y0 + 1, x0 + ts - 1, y0 + ts - 1,
                              outline=GOLD, width=3, tags="overlay")

    def draw_weather(self):
        c = self.canvas
        c.delete("weather")
        if not self.area or not self.area.outdoor or self.overlay:
            return
        w = self.st["weather"]
        if w not in ("rain", "storm", "snow"):
            return
        W, H = c.winfo_width(), c.winfo_height()
        rng = random.Random(self.frame * 7 + self.st["minute"])
        n = 70 if w == "storm" else 45
        for _ in range(n):
            x, y = rng.uniform(0, W), rng.uniform(0, H)
            if w == "snow":
                r = rng.uniform(1.5, 3.5) * self.scale / 2
                c.create_oval(x, y, x + r, y + r, fill="#ffffff",
                              outline="", tags="weather")
            else:
                ln = 6 * self.scale
                c.create_line(x, y, x - ln / 3, y + ln, fill="#a8c8f0",
                              width=1, tags="weather")
        c.tag_raise("overlay")

    def draw_talk(self):
        """The conversation: their portrait large on the left, their name
        and hearts, and what they've just said."""
        c, t = self.canvas, self.talk
        W, H = c.winfo_width(), c.winfo_height()
        vid = t["v"]
        v = VILLAGERS[vid]
        pz = max(2, min(7, int(min(H * 0.3, W * 0.28) / PW)))
        psz = PW * pz
        pad = S(10)
        f = F("Helvetica", 14)
        bold = F("Helvetica", 14, "bold")
        lh = f.metrics("linespace")
        tx = pad * 2 + psz + pad
        tw = W - tx - pad * 2
        text = t.get("text", "")
        tid = c.create_text(0, 0, text=text, width=max(80, tw), font=f,
                            anchor="nw", tags="overlay")
        bb = c.bbox(tid)
        c.delete(tid)
        text_h = (bb[3] - bb[1]) if bb else lh
        bh = max(psz + pad * 2, text_h + lh * 3 + pad * 3)
        bh = min(bh, H - 20)
        y0 = H - bh - pad
        self.talk_box_top = y0
        c.create_rectangle(pad, y0, W - pad, y0 + bh, fill=PANEL,
                           outline=ACCENT, width=2, tags="overlay")
        expr = t.get("expr", "neutral")
        c.create_image(pad * 2, y0 + pad, anchor="nw", tags="overlay",
                       image=self.portrait_image(vid, expr, pz))
        c.create_rectangle(pad * 2, y0 + pad, pad * 2 + psz, y0 + pad + psz,
                           outline=shade(v["look"]["bg"], 0.6), width=2,
                           tags="overlay")
        h = self.hearts(vid)
        f_ = self.friend(vid)
        status = {"dating": "  (sweetheart)", "engaged": "  (engaged)",
                  "married": "  (spouse)"}.get(f_["status"], "")
        if self.maid(vid):
            status += "  (your maid)"
        c.create_text(tx, y0 + pad, anchor="nw", tags="overlay",
                      text=self.display_name(vid), font=bold, fill=ACCENT)
        hf = F("Helvetica", 13)
        hearts = "♥" * h + "♡" * (10 - h) + status
        hx, hy = tx + bold.measure(self.display_name(vid)) + S(12), \
            y0 + pad
        if hx + hf.measure(hearts) > W - pad * 2:
            hx, hy = tx, y0 + pad + lh
        c.create_text(hx, hy, anchor="nw", tags="overlay", text=hearts,
                      font=hf, fill=HEARTC)
        c.create_text(tx, hy + lh + S(6), anchor="nw", width=tw,
                      text=text, font=F("Helvetica", 14, "italic") if
                      t.get("narr") else f,
                      fill=INK_DIM if t.get("narr") else INK,
                      tags="overlay")

    def flash(self, x, y, tile="sparkle"):
        cols, rows, ox, oy, ts = self.view
        cx, cy = self.cam
        i, j = x - cx, y - cy
        if not (0 <= i < cols and 0 <= j < rows) or tile not in self.img:
            return
        self.fx_token += 1
        token = self.fx_token
        self.canvas.coords(self.fx, ox + i * ts, oy + j * ts)
        self.canvas.itemconfig(self.fx, image=self.img[tile], state="normal")
        self.canvas.tag_raise(self.fx)

        def hide():
            if token == self.fx_token:
                self.canvas.itemconfig(self.fx, state="hidden")
        self.root.after(300, hide)

    def draw_text_box(self, text, color=INK):
        c = self.canvas
        W, H = c.winfo_width(), c.winfo_height()
        t = c.create_text(W / 2, H / 2, text=text, fill=color, font=F(*MONO),
                          justify="left", tags="overlay")
        x0, y0, x1, y1 = c.bbox(t)
        if y1 - y0 > H - 20 or x1 - x0 > W - 20:
            k = min((H - 20) / (y1 - y0), (W - 20) / (x1 - x0))
            c.itemconfig(t, font=F("Menlo", max(7, int(12 * k))))
            x0, y0, x1, y1 = c.bbox(t)
        r = c.create_rectangle(x0 - 16, y0 - 12, x1 + 16, y1 + 12,
                               fill=PANEL, outline=ACCENT, width=2,
                               tags="overlay")
        c.tag_raise(t, r)

    def draw_map(self):
        c, a = self.canvas, self.areas["valley"]
        W, H = c.winfo_width(), c.winfo_height()
        rows = []
        for y in range(a.h):
            row = []
            for x in range(a.w):
                t = a.grid[y][x]
                k = "%d,%d" % (x, y)
                if k in self.st["soil"]:
                    t = "soil"
                row.append("#f0a050" if (x, y) in self.door_at else
                           self.avg.get(t, "#000000"))
            rows.append("{" + " ".join(row) + "}")
        img = tk.PhotoImage(width=a.w, height=a.h)
        img.put(" ".join(rows))
        z = max(1, min((W - 20) // a.w, (H - 50) // a.h))
        self.map_img = img.zoom(z)
        c.create_rectangle(0, 0, W, H, fill="black", tags="overlay")
        mx, my = (W - a.w * z) / 2, (H - a.h * z) / 2 + 10
        c.create_image(mx, my, image=self.map_img, anchor="nw",
                       tags="overlay")
        small = F("Helvetica", 9 if z < 9 else 11)
        for key in BUILDINGS:
            if key in ON_ORDER and key not in self.built():
                continue
            x, y = door_of(key)
            name = BUILDINGS[key][6].replace("the ", "", 1)
            c.create_text(mx + (x + 0.5) * z, my + (y - 4) * z,
                          text=cap(name), fill="#ffffff", font=small,
                          anchor="s", tags="overlay")
        for n in self.npcs.values():
            if n.where == "valley" and self.friend(n.vid)["met"]:
                c.create_oval(mx + n.x * z, my + n.y * z, mx + (n.x + 1) * z,
                              my + (n.y + 1) * z, fill=HEARTC, outline="",
                              tags="overlay")
        if self.area is a:
            px, py = self.pos()
        else:
            px, py = self.outside_door()
        c.create_rectangle(mx + px * z - 2, my + py * z - 2,
                           mx + (px + 1) * z + 2, my + (py + 1) * z + 2,
                           outline="#ffff00", width=2, tags="overlay")
        c.create_text(W / 2, my - 14, fill=ACCENT, font=F(*MONO),
                      tags="overlay",
                      text="Apple Blossom Village   (yellow: you; pink: "
                           "friends; any key closes)")

    def render_chrome(self):
        p, st = self.p, self.st
        a = self.area
        here = a.name if not a.outdoor else self.district()
        self.status.config(text=cap(here))
        self.clock_label.config(text="%s %d  %s  %s" % (
            SEASONS[self.season()], self.dom(), WEEKDAYS[self.weekday()],
            self.clock()))
        e = max(0, p["energy"])
        bar = int(10 * e / p["max_energy"] + 0.99) if e else 0
        lines = [p["name"], "%s Farm" % p["farm"], "",
                 "%s, Year %d" % (SEASONS[self.season()], self.year()),
                 "%s %d, %s" % (WEEKDAYS[self.weekday()], self.dom(),
                                self.clock()),
                 WEATHER_SHORT[st["weather"]], "",
                 "Gold    %dg" % p["gold"],
                 "Energy  %s%s %d" % ("█" * bar, "░" * (10 - bar),
                                      e), "",
                 "Holding:", "  " + self.hand_name(), ""]
        things = ["%s%s" % (n, " x%d" % v if v > 1 else "")
                  for n, v in sorted(p["items"].items()) if v]
        if things:
            lines += ["Bag:"] + ["  " + t for t in things[:14]]
            if len(things) > 14:
                lines.append("  ...and %d more" % (len(things) - 14))
        self.show_panel(lines)
        cond = []
        if any(not m["read"] for m in st["mail"]):
            cond.append("✉ New mail!")
        f = self.festival_today()
        if f:
            cond.append(f[0].upper())
        for vid, v in VILLAGERS.items():
            if v["birthday"] == (self.season(), self.dom()):
                cond.append("%s's birthday!" % v["short"])
        if st["wedding"] is not None:
            cond.append("Wedding: %s" % ("TODAY" if st["wedding"] ==
                                         st["day"] else "in %d days" % (
                                             st["wedding"] - st["day"])))
        if p["energy"] <= 0:
            cond.append("EXHAUSTED")
        if getattr(self, "aim", False):
            cond.append("WAND RAISED: pick a direction")
        self.condition.config(text="\n".join(cond))
        if self.festival_on():
            self.sound.tune = "festival"
        elif not a.outdoor:
            self.sound.tune = "inside"
        elif self.light_level() == 2:
            self.sound.tune = "night"
        else:
            self.sound.tune = SEASONS[self.season()].lower()

    def district(self):
        x, y = self.pos()
        if on_farm(x, y):
            return "%s Farm" % self.p["farm"]
        if y >= LAKE_Y - 6:
            return "the beach"
        if RIVER[0] - 1 <= x <= RIVER[1] + 1:
            return "the river"
        if y < 9:
            return "the woods"
        x0, y0, x1, y1 = SQUARE
        if x0 <= x <= x1 and y0 <= y <= y1:
            return "the village square"
        if x < RIVER[0]:
            return "the meadow"
        return "Apple Blossom Village"

    # ── Diaries and lists ──

    def show_friends(self):
        if not self.ready():
            return
        lines = ["FRIENDS", ""]
        for vid in sorted(VILLAGERS, key=lambda v: VILLAGERS[v]["short"]):
            v = VILLAGERS[vid]
            f = self.friend(vid)
            if not f["met"]:
                lines.append("%-8s (not met yet)" % "???")
                continue
            h = self.hearts(vid)
            mark = {"dating": " sweetheart", "engaged": " engaged",
                    "married": " spouse"}.get(f["status"], "")
            if self.maid(vid):
                chore = self.st["maids"][vid]
                mark += " maid: %s" % (MAID_CHORES[chore][0].lower()
                                       if chore else "no chore yet")
            if not mark and v["romance"]:
                mark = " ❀"
            bd = "%s %d" % (SEASONS[v["birthday"][0]][:3], v["birthday"][1])
            lines.append("%-8s %s  %s%s  %s%s" % (
                v["short"], "♥" * h + "♡" * (10 - h), bd,
                "  talked" if f["talked"] == self.st["day"] else "",
                "gifts %d/2" % f["week"], mark))
        lines += ["", "❀ could become a sweetheart"]
        hens = self.st["chickens"]
        if hens:
            lines += [""] + wrap("Your hens: " + ", ".join(
                "%s%s" % (c["name"], " \u2665" if c.get("petted") ==
                          self.st["day"] else "") for c in hens) +
                ".  (\u2665 petted today)", 64)
        cows = self.st.get("cows", [])
        if cows:
            lines += [""] + wrap("Your cows: " + ", ".join(
                "%s%s%s" % (c["name"], " \u2665" if c.get("petted") ==
                            self.st["day"] else "", " (milked)" if
                            c.get("milked") == self.st["day"] else "")
                for c in cows) + ".", 64)
        lines.append("(Any key closes.)")
        self.show_text("\n".join(lines))

    def show_diary(self):
        if not self.ready():
            return
        st = self.st
        s = self.season()
        lines = ["%s, YEAR %d" % (SEASONS[s].upper(), self.year()), "",
                 " Mo  Tu  We  Th  Fr  Sa  Su"]
        week = ""
        marks = {}
        for (fs, fd), f in FESTIVALS.items():
            if fs == s:
                marks[fd] = "*"
        for vid, v in VILLAGERS.items():
            if v["birthday"][0] == s:
                marks[v["birthday"][1]] = "b"
        for d in range(1, SEASON_DAYS + 1):
            cell = "%2d%s" % (d, marks.get(d, " "))
            if d == self.dom():
                cell = "[%d]" % d if d < 10 else "%d]" % d
                cell = cell.rjust(3)
            week += " " + cell
            if d % 7 == 0:
                lines.append(week)
                week = ""
        lines += ["", " * festival   b birthday", ""]
        for (fs, fd), f in sorted(FESTIVALS.items()):
            if fs == s:
                lines.append("%s %d: the %s" % (SEASONS[s], fd, f[0]))
        for vid, v in sorted(VILLAGERS.items(),
                             key=lambda kv: kv[1]["birthday"]):
            if v["birthday"][0] == s:
                lines.append("%s %d: %s's birthday" % (
                    SEASONS[s], v["birthday"][1], v["short"]))
        r = st["request"]
        if r:
            lines += [""] + wrap("Request: %s wants %d %s by %s %d (%dg)." %
                                 (VILLAGERS[r["who"]]["short"], r["n"],
                                  plural(r["item"], r["n"]),
                                  SEASONS[self.season(r["due"])],
                                  self.dom(r["due"]), r["reward"]), 46)
        lines += ["", "Shipped %d things, earned %dg, caught %d fish." % (
            st["stats"]["shipped"], st["stats"]["earned"],
            st["stats"]["fish"])]
        old = [m for m in st["mail"] if m["read"]][-2:]
        if old:
            lines += ["", "Last letters:"]
            for m in old:
                lines += wrap("%s: %s" % (m["from"], m["text"]), 46)[:3] + \
                    ["  ..."]
        lines.append("\n(Any key closes.)")
        self.show_text("\n".join(lines))

    # ── Commands ──

    def toggle_map(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "map" else "map"
        self.render()

    def show_help(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "help" else "help"
        self.render()

    def zoom(self, d):
        z = max(-2, min(2, self.zoom_d + d))
        if z != self.zoom_d:
            self.zoom_d = z
            self.layout()

    def auto_scale(self):
        c = self.canvas
        short = min(c.winfo_width(), c.winfo_height())
        return max(1, min(MAX_ZOOM, round(short / (16 * 12)) + self.zoom_d))

    def on_resize(self, ev):
        if ev.widget is self.root:
            if getattr(self, "fit_job", None):
                self.root.after_cancel(self.fit_job)
            self.fit_job = self.root.after(80, self.fit)

    def fit(self, force=False):
        """Scale the fonts, the side panel and the buttons to the window:
        a wide window has the panel at the side and one row of buttons, a
        tall one (a phone held upright) the panel underneath and two."""
        self.fit_job = None
        if getattr(self, "small_dialog", None) and not force:
            return
        root = self.root
        W, H = root.winfo_width(), root.winfo_height()
        if W < 100 or H < 100:
            return
        tall = H > W * 1.15
        u = min(W / 620, H / 1000) if tall else min(W / 1000, H / 740)
        u = max(0.6, min(4.0, u)) * self.text_k
        if not force and abs(u - UI[0]) < 0.02 and \
                tall == getattr(self, "tall", None):
            return
        self.tall = tall
        set_fonts(u)
        n = len(self.btn)
        root.update_idletasks()
        each = max(b.winfo_reqwidth() for b in self.btn.values()) + S(4)
        rows = 2 if tall else 1
        while rows < n and -(-n // rows) * each > W:
            rows += 1
        per = -(-n // rows)
        for i, b in enumerate(self.btn.values()):
            b.grid(row=i // per, column=i % per, sticky="ew", padx=S(2),
                   pady=S(4))
        for col in range(n):
            self.bar.columnconfigure(col, weight=int(col < per),
                                     uniform="b" if col < per else "")
        sb = self.sidebar
        sb.pack_forget()
        if tall:
            sb.pack_propagate(True)
            sb.pack(side="bottom", fill="x", before=self.leftside)
            wrap_ = (W - S(50)) // 2
        else:
            sb.configure(width=S(250))
            sb.pack_propagate(False)
            sb.pack(side="right", fill="y", before=self.leftside)
            wrap_ = S(230)
        for w in (self.panel, self.panel2, self.condition):
            w.configure(wraplength=wrap_ if w is not self.condition or
                        not tall else W - S(24))
        self.log.configure(height=4 if tall else 6)
        self.portraits = {}
        if hasattr(self, "panel_lines"):
            self.show_panel(self.panel_lines)
        self.layout()

    def show_panel(self, lines):
        self.panel_lines = lines
        if not self.tall or len(lines) < 8:
            self.panel.config(text="\n".join(lines))
            self.panel2.pack_forget()
            return
        mid = len(lines) // 2
        cuts = [i for i, line in enumerate(lines) if not line.strip()]
        cut = min(cuts, key=lambda i: abs(i - mid)) if cuts else mid
        first, second = lines[:cut], lines[cut:]
        while second and not second[0].strip():
            second = second[1:]
        self.panel.config(text="\n".join(first))
        self.panel2.config(text="\n".join(second))
        if not self.panel2.winfo_manager():
            self.panel2.pack(side="left", fill="x", expand=True, anchor="n",
                             padx=(S(10), S(10)), pady=(S(8), 0))

    def fit_dialog(self, dlg):
        root = self.root
        root.update_idletasks()
        self.fit()
        W, H = root.winfo_width(), root.winfo_height()
        if W < 100:
            return
        shrunk = False
        for _ in range(5):
            dlg.update_idletasks()
            k = min(1.0, (W - 8) / max(1, dlg.winfo_reqwidth()),
                    (H - 8) / max(1, dlg.winfo_reqheight()))
            if k >= 1.0:
                break
            shrunk = True
            set_fonts(UI[0] * k * 0.97)
            todo = [dlg]
            while todo:
                w = todo.pop()
                todo += w.winfo_children()
                try:
                    wl = int(w.cget("wraplength"))
                except (tk.TclError, ValueError):
                    continue
                if wl:
                    w.configure(wraplength=max(60, int(wl * k)))
        if shrunk:
            self.small_dialog = dlg

            def closed(e):
                if e.widget is dlg:
                    self.small_dialog = None
                    self.root.after_idle(self.fit, True)
            dlg.bind("<Destroy>", closed, add="+")

    def text_size(self, d):
        i = TEXT_SIZES.index(self.text_k) + d
        if 0 <= i < len(TEXT_SIZES):
            self.text_k = TEXT_SIZES[i]
            self.fit(True)
            self.say("(Text size %d%%.)" % round(self.text_k * 100), "info")

    def toggle_mute(self):
        self.sound.muted = not self.sound.muted
        self.say("Sound effects %s." % ("off" if self.sound.muted else "on"),
                 "info")
        self.render_chrome()

    def toggle_music(self):
        self.sound.music_off = not self.sound.music_off
        self.sound.tick()
        self.say("Music %s." % ("off" if self.sound.music_off else "on"),
                 "info")
        self.render_chrome()


