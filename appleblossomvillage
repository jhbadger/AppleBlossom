def wall_face(rng, mat):
    base, line = WALLS[mat]
    if mat == "wood":
        return planks(rng, base, line, vertical=True)
    if mat == "log":
        g = grid_of(base)
        for y in range(0, 16, 4):
            rect(g, 0, y + 3, 15, y + 3, line)
            g[y + 1][rng.randrange(16)] = shade(base, 1.2)
        return g
    if mat == "brick":
        return stone_blocks(rng, base, "#d8c8b0", 6, 4)
    if mat == "stone":
        return stone_blocks(rng, base, line, 5, 4)
    if mat == "glass":                          # panes in white frames
        g = grid_of(base)
        for i in range(0, 16, 5):
            rect(g, i, 0, i, 15, line)
            rect(g, 0, i, 15, i, line)
        for _ in range(6):
            x, y = rng.randrange(1, 15), rng.randrange(1, 15)
            if g[y][x] == base:
                g[y][x] = "#dff2f8"
        speckle_within(g, rng, base, ["#7ab070", "#8ac080"], 0.12)
        return g
    g = grid_of(base)                           # half-timbered
    speckle(g, rng, ["#e8e0c8"], 0.2)
    for x in (0, 15):
        rect(g, x, 0, x, 15, line)
    rect(g, 0, 0, 15, 0, line)
    return g


def window(g, lit=False):
    rect(g, 4, 3, 11, 10, "#5a3a20")
    rect(g, 5, 4, 10, 9, "#f8e8a0" if lit else "#a8d0f0")
    rect(g, 7, 4, 8, 9, "#5a3a20")
    rect(g, 5, 6, 10, 6, "#5a3a20")
    rect(g, 3, 11, 12, 11, "#e070a0")          # a window box of flowers
    for x in (4, 6, 9, 11):
        g[10][x] = "#f8c8e0"


def door(g):
    rect(g, 4, 3, 11, 15, "#5a3420")
    disc(g, 7.5, 4, 3.5, "#5a3420")
    rect(g, 5, 4, 10, 15, "#a06a3a")
    rect(g, 7, 4, 8, 15, "#7a4a28")
    g[10][9] = "#f0d040"


def mine_tile(name, rng):
    """The mine's rock and floor, in the colours of its depth, and the
    ladders and chests on it."""
    if name.startswith("pedestal"):             # the winged key's
        g = mine_tile("mfloor_4", rng)
        rect(g, 4, 7, 11, 15, "#6a6478")
        rect(g, 3, 6, 12, 7, "#8a84a0")
        rect(g, 4, 14, 11, 15, "#4a4458")
        if name == "pedestal_key":
            for x, y in ((5, 2), (4, 3), (6, 3), (10, 2), (9, 3), (11, 3)):
                g[y][x] = "#ffffff"                   # the wings
            rect(g, 7, 1, 8, 5, "#f0d060")            # the key
            rect(g, 6, 1, 9, 2, "#f8e8a0")
        return g
    if name.startswith("ore_crystal"):
        g = mine_tile("mwall_" + name[-1], rng)
        for x0, h, c in ((3, 7, "#80e8f8"), (7, 10, "#b090f8"),
                         (11, 6, "#80e8f8")):
            rect(g, x0, 13 - h, x0 + 1, 12, c)
            rect(g, x0, 13 - h, x0, 12, shade(c, 1.3))
            g[12 - h][x0] = g[12 - h][x0 + 1] = shade(c, 1.4)
        return g
    if name.startswith("ore_"):
        g = mine_tile("mwall_" + name[-1], rng)
        col = ORES[name.split("_")[1]][2]
        for _ in range(6):
            x, y = rng.randrange(1, 13), rng.randrange(1, 11)
            rect(g, x, y, x + 1, y + 1, shade(col, 0.75))
            g[y][x] = col
            g[y][x + 1] = shade(col, 1.25)
        return g
    if name.startswith(("ladder_", "chest")):
        th = int(name[-1]) if name[-1].isdigit() else 0
        g = mine_tile("mfloor_%d" % th, rng)
        if th == 5 and name.startswith("ladder"):   # the tower's stairs
            up = name.startswith("ladder_down")       # (the far one, up)
            for i in range(4):
                y = 12 - i * 3 if up else 3 + i * 3
                rect(g, 2 + i, y, 13 - i, y + 2,
                     "#f0d060" if up else "#b4bccc")
                rect(g, 2 + i, y, 13 - i, y, "#fff8d0" if up else
                     "#e4e6f0")
        elif name.startswith("ladder_down"):
            disc(g, 7.5, 8, 6, "#0e0a08")
            for x in (5, 10):
                rect(g, x, 2, x, 9, "#8a5a30")
            for y in (3, 6, 9):
                rect(g, 5, y, 10, y, "#a06a38")
        elif name.startswith("ladder_up"):
            disc(g, 7.5, 7.5, 6.5, mix(g[0][0], "#f8f0c0", 0.35))
            for x in (4, 11):
                rect(g, x, 0, x, 15, "#8a5a30")
            for y in range(1, 16, 3):
                rect(g, 4, y, 11, y, "#a06a38")
        elif name.startswith("chest_open"):
            rect(g, 2, 3, 13, 6, "#5a3a1e")
            rect(g, 2, 7, 13, 14, "#8a5a30")
            rect(g, 3, 8, 12, 9, "#2a1a0e")
            rect(g, 2, 7, 13, 7, "#d0a040")
        else:
            rect(g, 2, 5, 13, 14, "#8a5a30")
            rect(g, 2, 5, 13, 8, "#a06a38")
            rect(g, 2, 9, 13, 9, "#d0a040")
            rect(g, 2, 5, 2, 14, "#d0a040")
            rect(g, 13, 5, 13, 14, "#d0a040")
            rect(g, 7, 8, 8, 11, "#f4d070")
        return g
    th = int(name[-1])
    wall, shadow, glint, floor, specks = MINE_THEMES[th]
    if name.startswith("mfloor_"):
        g = grid_of(floor)
        speckle(g, rng, list(specks), 0.18)
        for _ in range(3):
            x, y = rng.randrange(1, 15), rng.randrange(1, 15)
            g[y][x] = g[y][x + 1] = shade(floor, 0.75)
        return g
    g = grid_of(wall)
    speckle(g, rng, [shade(wall, 1.12), shade(wall, 0.88)], 0.35)
    for _ in range(5):
        x, y = rng.randrange(0, 13), rng.randrange(0, 15)
        rect(g, x, y, x + rng.randrange(1, 4), y, shadow)
    for _ in range(2 + th):
        x, y = rng.randrange(1, 15), rng.randrange(1, 15)
        g[y][x] = glint
    rect(g, 0, 13, 15, 15, shadow)
    return g


def draw_terrain(name, frame=0, season=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random("%s%d%d" % (name, frame, season))
    s = season
    if name.startswith(("mwall_", "mfloor_", "ladder_", "chest", "ore_",
                        "pedestal")):
        return mine_tile(name, rng)
    if name in ("towerwall", "towertop", "towerdoor", "towerwin"):
        g = stone_blocks(rng, "#e8e8f0", "#b8bcc8", 6, 4)
        if name == "towertop":
            rect(g, 0, 0, 15, 4, GROUND[s][0])
            for x in (0, 5, 10):
                rect(g, x, 1, x + 3, 4, "#e8e8f0")
            rect(g, 0, 4, 15, 5, "#c8ccd8")
        elif name == "towerwin":
            rect(g, 6, 4, 9, 10, "#5a6a9a")
            disc(g, 7.5, 4.5, 2, "#5a6a9a")
            rect(g, 6, 7, 9, 7, "#f0d060")
        elif name == "towerdoor":
            rect(g, 4, 5, 11, 15, "#c0a050")
            disc(g, 7.5, 5.5, 3.6, "#c0a050")
            rect(g, 5, 6, 10, 15, "#e8c860")
            for x, y in ((6, 9), (9, 9), (5, 10), (10, 10)):
                g[y][x] = "#ffffff"                   # the keyhole's wings
            rect(g, 7, 9, 8, 12, "#3a3020")
        return g
    if name == "cave":
        g = ground(rng, s, 0)
        disc(g, 7.5, 9, 7.6, "#7a746a", rng, 0.6)
        disc(g, 6, 6.5, 4, "#9a948a", rng, 0.5)
        speckle_within(g, rng, "#7a746a", ["#6a645a", "#8a847a"], 0.3)
        rect(g, 4, 8, 11, 15, "#1a1410")
        disc(g, 7.5, 8.5, 3.6, "#1a1410")
        for y in (8, 15):
            rect(g, 3, y if y == 15 else 7, 12, y if y == 15 else 7,
                 "#7a5030")
        rect(g, 3, 7, 3, 15, "#7a5030")
        rect(g, 12, 7, 12, 15, "#7a5030")
        return g
    if name == "grass":
        return ground(rng, s)
    if name == "tallgrass":
        g = ground(rng, s, 0)
        base = GROUND[s][1][1]
        for x in range(0, 16, 2):
            h = rng.randrange(3, 7)
            rect(g, x, 15 - h, x, 15 - h + 2, shade(base, 0.8))
        return g
    if name == "meadow":
        return ground(rng, s, 0.08)
    if name == "flowers":
        g = ground(rng, s, 0)
        if s == 3:
            return g
        cols = {0: ("#f04060", "#f0e040", "#f080d0", "#ffffff"),
                1: ("#f0c020", "#e04040", "#8060f0"),
                2: ("#d06020", "#a03040", "#e0a030")}[s]
        for y in range(1, 16, 4):
            for x in range(1 + (y // 4) % 2 * 2, 16, 4):
                rect(g, x, y, x + 1, y + 1, rng.choice(cols))
                g[min(15, y + 2)][x] = "#2e7a2e"
        return g
    if name in ("path", "snowpath"):
        return dirt(rng, s)
    if name == "cobble":
        g = stone_blocks(rng, "#b8b0a0", "#8a8478", 4, 4)
        if s == 3:
            speckle(g, rng, ["#f4f8ff"], 0.25)
        return g
    if name == "plaza":
        g = grid_of("#d8ccb4")
        speckle(g, rng, ["#e0d6c0", "#ccc0a8"], 0.3)
        for i in range(16):
            g[i][0] = g[0][i] = "#b0a48c"
        disc(g, 0, 0, 2.2, "#b8ac94")
        disc(g, 15, 15, 2.2, "#c8bca4")
        if s == 3:
            speckle(g, rng, ["#f4f8ff"], 0.25)
        return g
    if name == "sand":
        g = grid_of("#e8d8a0")
        speckle(g, rng, ["#f0e0b0", "#d8c890"], 0.3)
        return g
    if name in ("soil", "soil_w"):
        wet = name == "soil_w"
        base = "#6a4a2a" if wet else "#9a7448"
        g = grid_of(base)
        for y in range(2, 16, 4):
            rect(g, 0, y, 15, y, shade(base, 0.75))
            rect(g, 0, y + 1, 15, y + 1, shade(base, 1.15))
        speckle(g, rng, [shade(base, 0.9)], 0.15)
        if s == 3 and not wet:
            speckle(g, rng, ["#f0f4fa"], 0.2)
        return g
    if name in ("water", "river", "pond"):
        frozen = s == 3 and name == "pond"
