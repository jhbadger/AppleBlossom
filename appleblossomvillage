    def show_friends(self):
        if not self.ready():
            return
        lines = ["FRIENDS", ""]
        for vid in sorted(VILLAGERS, key=lambda v: VILLAGERS[v]["short"]):
            v = VILLAGERS[vid]
            f = self.friend(vid)
            if not f["met"]:
                lines.append("%-8s (not met yet)" % "???")
                continue
            h = self.hearts(vid)
            mark = {"dating": " sweetheart", "engaged": " engaged",
                    "married": " spouse"}.get(f["status"], "")
            if self.maid(vid):
                chore = self.st["maids"][vid]
                mark += " maid: %s" % (MAID_CHORES[chore][0].lower()
                                       if chore else "no chore yet")
            if not mark and v["romance"]:
                mark = " ❀"
            bd = "%s %d" % (SEASONS[v["birthday"][0]][:3], v["birthday"][1])
            lines.append("%-8s %s  %s%s  %s%s" % (
                v["short"], "♥" * h + "♡" * (10 - h), bd,
                "  talked" if f["talked"] == self.st["day"] else "",
                "gifts %d/2" % f["week"], mark))
        lines += ["", "❀ could become a sweetheart"]
        if self.kids():
            lines += [""] + wrap("Your children: " + ", ".join(
                ("%s (%s, %d days) %s" % (
                    k["name"], "girl" if k["sex"] == "F" else "boy",
                    self.kid_age(k), "\u2665" * min(10, k["love"] // 100)
                )).strip()
                for k in self.kids()) + ".", 64)
        if self.st.get("baby_due") is not None:
            lines.append("A baby is due in %d days." % (
                self.st["baby_due"] - self.st["day"]))
        if self.mmaids():
            lines += ["", "Your maids who were monsters:"]
            for m in self.mmaids():
                h = self.mm_hearts(m)
                lines.append("%-12s %s  %s%s" % (
                    m["name"][:12], "♥" * h + "♡" * (10 - h),
                    "talked  " if m["talked"] == self.st["day"] else "",
                    {"dating": "sweetheart", "engaged": "engaged",
                     "married": "spouse"}.get(m["status"], "❀")))
        hens = self.st["chickens"]
        if hens:
            lines += [""] + wrap("Your hens: " + ", ".join(
                "%s%s" % (c["name"], " \u2665" if c.get("petted") ==
                          self.st["day"] else "") for c in hens) +
                ".  (\u2665 petted today)", 64)
        pets = self.st.get("pets", [])
        if pets:
            lines += [""] + wrap("Your pets: " + ", ".join(
                "%s the %s %s%s" % (c["name"], c["kind"],
                                    self.pet_hearts_text(c), " (petted)" if
                                    c.get("petted") == self.st["day"] else "")
                for c in pets) + ".", 64)
