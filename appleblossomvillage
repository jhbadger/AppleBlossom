        g[by][bx] = shade(cc, 0.7)
        g[by - 1][bx - 3] = g[by + 1][bx + 3] = shade(cc, 1.15)
    if "maidcap" in extras:
        lace, lace_d = "#fbf8f2", "#d8d0c8"
        prect(g, 8, top + 1, 23, top + 2, lace)
        for x in range(8, 24, 2):
            g[top][x] = lace
            g[top + 3][x + 1] = lace_d
        prect(g, 8, top + 3, 23, top + 3, lace_d)
        for x in range(9, 23, 4):
            g[top + 1][x + 1] = lace_d
    if "bow" in extras:
        bc = look.get("bowc", "#c03050")
        prect(g, 13, 25, 14, 26, bc)
        prect(g, 17, 25, 18, 26, bc)
        g[25][15] = g[25][16] = shade(bc, 0.75)
        g[26][15] = g[26][16] = shade(bc, 0.75)
    return g

