PIRATE_START = ["Yarr! ", "Arr, ", "Ahoy! ", "Shiver me timbers! ",
                "Avast! ", "Yo ho! "]
PIRATE_END = [", matey", ", me hearty", ", ye scallywag", ", arr"]


def piratify(text):
    """Say it like a pirate: ye, me and aye, droppin' yer g's, and a
    Yarr! or a matey thrown in."""
    def swap(m):
        w = m.group(0)
        if w.isupper() and len(w) > 1:          # a topic word: leave it
            return w
        low = w.lower()
        new = PIRATE_WORDS.get(low)
        if new is None and low.endswith("ing") and len(low) > 4:
            new = low[:-1] + "'"
        if new is None:
            return w
        return new[:1].upper() + new[1:] if w[:1].isupper() else new
    text = re.sub(r"[A-Za-z']+", swap, text)
    if random.random() < 0.6:
        start = random.choice(PIRATE_START)
        if start.endswith(", ") and text[:1].isupper() and \
                not text[:2].isupper() and not text.startswith("I "):
            text = text[:1].lower() + text[1:]
        text = start + text
    if random.random() < 0.5:
        m = re.search(r"[.!?]+$", text)
        end = random.choice(PIRATE_END)
        text = text[:m.start()] + end + text[m.start():] if m else \
            text + end + "!"
    return text


