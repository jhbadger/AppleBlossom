        doors, and only where there's room for the door to open."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        flags = st["flags"]
        if not self.loo(vid):
            why = None
            if VILLAGERS[vid]["look"].get("age") == "child":
                why = ("%s giggles so hard at the very idea that the spell "
                       "misses entirely." % name)
            elif self.statue(vid):
                why = "The spell skids off the gold. Gold makes a poor privy."
            elif self.chicken(vid):
                why = ("The spell slides off the hen's feathers. She shakes "
                       "herself and clucks.")
            elif self.is_cow(vid):
                why = "The spell bounces off the cow's hide. Cows are cows."
            elif self.maid(vid):
                why = ("The spell glances off %s's starched apron. A maid "
                       "stays a maid until the spell that made her is "
                       "undone." % name)
            elif self.tree(vid):
                why = ("The spell sinks into %s's bark and is gone. Trees "
                       "don't hold with that sort of magic." % name)
            elif not self.loo_room(n):
                why = ("The spell fizzles. An outhouse needs to be out of "
                       "doors, with room in front for the door to open." if
                       not self.area.outdoor else
                       "The spell fizzles. There's no room for an outhouse "
                       "there: it needs clear ground in front for the door.")
            if why:
                self.say(why, "info")
                self.end_turn(TOOL_COST)
                return
        if self.talk:
            self.end_talk()
        likes = self.likes_change(vid, "looify")
        n.goal, n.path, n.stuck = None, [], 0
        if not self.loo(vid):
            st["loos"].append(vid)
            self.say("There's a creak of planks and a smell of pine, and "
                     "where %s stood there's an outhouse with a moon on the "
                     "door. %s" % (name, "It looks oddly proud of itself."
                                   if likes else "Its door rattles "
                                   "furiously."), "quest")
            if likes:
                pts = 0 if "looliked:" + vid in flags else 150
                flags.append("looliked:" + vid)
            else:
                pts = -200
            if pts:
                self.befriend(vid, pts, quiet=True)
                self.say("(%s %s.)" % (name, "seems to enjoy being an "
                                       "outhouse" if pts > 0 else
                                       "is upset with you"),
                         "heart" if pts > 0 else "bad")
            self.end_turn(TOOL_COST)
            return
        st["loos"].remove(vid)
        for o in self.npcs.values():          # anybody inside comes out fast
            if o.visit and o.visit["loo"] == vid:
                o.visit, o.hidden = None, False
