        tall = 3 if (fem or child or expr == "surprised") else 2
        top = ey - tall + 1
        for i in range(eye_w):
            for j in range(tall):
                g[top + j][x0 + i] = "#ffffff"
        ix = x0 + (1 if side == 0 else 0)
        for j in range(tall):
            g[top + j][ix] = eyes
            g[top + j][ix + 1] = eyes if j > 0 or tall == 2 else \
                shade(eyes, 0.6)
        g[top + (1 if tall == 3 else 0)][ix + (1 if side == 0 else 0)] = \
            "#101010"
        g[top][ix + (0 if side == 0 else 1)] = "#ffffff" if tall > 2 else \
            g[top][ix + (0 if side == 0 else 1)]
        if happy and expr != "laugh":
            for i in range(eye_w):
                g[ey][x0 + i] = skin
            g[ey][x0 + (0 if side == 0 else eye_w - 1)] = "#2a1a1a" \
                if tall == 3 else skin
        if fem or expr == "surprised":
            for i in range(-1 if side == 0 else 0, eye_w + (0 if side == 0
                                                           else 1)):
                g[top - 1][x0 + i] = "#2a1a1a"
        # brows
        by = top - (3 if expr == "surprised" else 2)
        b = [(x0 + i, by) for i in range(eye_w)]
        if expr == "cross":
            b = [(x0 + i, by + (i if side == 0 else eye_w - 1 - i))
                 for i in range(eye_w)]
        elif sad:
            b = [(x0 + i, by + (eye_w - 1 - i if side == 0 else i) // 2)
                 for i in range(eye_w)]
        for (x, y) in b:
            g[y][x] = hd if style != "bald" else shade(skin, 0.6)
    if "liner" in extras:
        for side in (0, 1):
            x0 = lx if side == 0 else mirror(lx + eye_w - 1)
            top = ey - 2
            out = x0 - 1 if side == 0 else x0 + eye_w
            wing = x0 - 2 if side == 0 else x0 + eye_w + 1
            for i in range(-1 if side == 0 else 0,
                           eye_w + (0 if side == 0 else 1)):
                g[top - 1][x0 + i] = "#141010"
            g[top - 1][out] = g[top - 2][wing] = "#141010"
            g[top][out] = "#141010"
    if "glasses" in extras:
        gc = look.get("glassc", "#3a3040")
        for side in (0, 1):
            x0 = (lx - 1) if side == 0 else mirror(lx + eye_w)
            prect(g, x0, ey - 2, x0 + eye_w + 1, ey - 2, gc)
            prect(g, x0, ey + 1, x0 + eye_w + 1, ey + 1, gc)
            prect(g, x0, ey - 2, x0, ey + 1, gc)
            prect(g, x0 + eye_w + 1, ey - 2, x0 + eye_w + 1, ey + 1, gc)
        g[ey - 1][15] = g[ey - 1][16] = gc
    ny = fy + 3
    g[ny][15] = skd
    g[ny + 1][15] = skdd
    g[ny + 1][16] = skd
    if "nosering" in extras:
        g[ny + 2][15] = g[ny + 2][16] = "#d4d4dc"
        g[ny + 2][14] = g[ny + 2][17] = "#9a9aa8"
    my = fy + 6 if not child else fy + 5
    lips = look.get("lips", shade(skin, 0.62) if not fem else "#c05060")
    if expr == "neutral":
        prect(g, 14, my, 17, my, lips)
    elif expr in ("happy", "blush"):
        prect(g, 14, my, 17, my, lips)
        prect(g, 15, my + 1, 16, my + 1, shade(lips, 1.15))
        g[my - 1][13] = g[my - 1][18] = lips
    elif expr == "laugh":
        prect(g, 13, my - 1, 18, my - 1, lips)
        prect(g, 14, my, 17, my + 1, "#7a2a2a")
        prect(g, 14, my, 17, my, "#ffffff")
    elif expr == "sad":
        prect(g, 14, my, 17, my, lips)
        g[my + 1][13] = g[my + 1][18] = lips
    elif expr == "surprised":
        prect(g, 15, my - 1, 16, my + 1, "#5a2020")
    elif expr == "cross":
        prect(g, 13, my, 18, my, lips)
        g[my - 1][15] = g[my - 1][16] = lips
    if expr == "blush" or "freckles" in extras or look.get("rosy"):
        bc = "#f08a9a" if expr == "blush" else (
            shade(skin, 0.8) if "freckles" in extras else mix(skin, "#f08a9a",
                                                              0.4))
        for side in (0, 1):
            x0 = 9 if side == 0 else mirror(10)
            if "freckles" in extras and expr != "blush":
                for (dx, dy) in ((0, 0), (2, 0), (1, 1)):
                    g[fy + 2 + dy][x0 + dx] = bc
            else:
                prect(g, x0, fy + 2, x0 + 1, fy + 3, bc)
    if expr == "sad":
        g[ey + 2][lx + 2] = "#a0d0f8"
    if "beard" in extras:
        bc = look.get("beardc", hd)
        for y in range(fy + 3, fy + fry + 2):
            for x in range(PW):
                if g[y][x] in (skin, skd, skdd) and not (
                        my - 1 <= y <= my + 1 and 13 <= x <= 18) and (
                        y >= my - 2 or abs(x - cx) > 4.5):
                    g[y][x] = bc
        prect(g, 13, my - 2, 18, my - 2, bc)
    elif "mustache" in extras:
        bc = look.get("beardc", hd)
        prect(g, 13, my - 2, 18, my - 2, bc)
