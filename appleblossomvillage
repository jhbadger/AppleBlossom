                        while x < 16:
                            c = row[x]
                            x1 = x
                            while x1 < 16 and row[x1] == c:
                                x1 += 1
                            if c:
                                img.put(c if k == 1.0 else shade(c, k),
                                        to=(x, y, x1, y + 1))
                            x = x1
                else:
                    img.put(" ".join("{" + " ".join(
                        c if k == 1.0 else shade(c, k) for c in r) + "}"
                        for r in px))
                self.base[("%d:" % lvl if lvl else "") + name] = img
            if not sprite:
                tot = [0, 0, 0]
                for r in px:
                    for c in r:
                        for i in range(3):
                            tot[i] += int(c[1 + 2 * i:3 + 2 * i], 16)
                self.avg[name] = "#%02x%02x%02x" % tuple(v // 256
                                                        for v in tot)
        self.loo_painted = {}
        self.maid_painted = {}
        if self.p:
            self.paint_hero()
            self.paint_specials()
        self.scale_images()

    def paint_hero(self):
        pal, rows = person_art(self.p["look"])
        px = art_pixels(pal, rows)
        for n, frame in (("you", px), ("you@1", px[1:] + [[None] * 16])):
            img = tk.PhotoImage(width=16, height=16)
            for y, row in enumerate(frame):
                for x, c in enumerate(row):
                    if c:
                        img.put(c, to=(x, y, x + 1, y + 1))
            self.base[n] = img
        SPRITES.add("you")

    def paint_specials(self, scale=False):
        """Sprites made to order: each maid in a bikini, in her colour, and
        each villager turned fruit tree, in fruit."""
        frames = []
        for vid, b in self.st.get("bikinis", {}).items():
            px = art_pixels(*person_art(self.look_of(vid)))
            frames += [("vb_" + vid, px),
                       ("vb_" + vid + "@1", px[1:] + [[None] * 16]),
                       ("sb_" + vid, golden(px))]
        for vid, t in self.st.get("fruitful", {}).items():
            frames.append(("tvf_" + vid, tree_art(
                VILLAGERS[vid]["look"], self.season(), t["kind"])))
        for i, k in enumerate(self.st.get("kids", ())):
            px = art_pixels(*person_art(k["look"]))
            frames += [("kid_%d" % i, px),
                       ("kid_%d@1" % i, px[1:] + [[None] * 16]),
                       ("kidb_%d" % i, crib_art(k["look"]))]
        for n, frame in frames:
            self.paint_sprite(n, frame, scale)

    def paint_sprite(self, n, frame, scale=True):
        """One sprite made to order, drawn into the same image if there's
        one already: the map still shows it, and a new one would leave it
        pointing at nothing."""
        img = self.base.get(n)
        if img is None:
            img = self.base[n] = tk.PhotoImage(width=16, height=16)
        img.blank()
        for y, row in enumerate(frame):
            for x, c in enumerate(row):
                if c:
                    img.put(c, to=(x, y, x + 1, y + 1))
        SPRITES.add(n.split("@")[0])
        if scale and hasattr(self, "img"):
            big = self.img.get(n)
            if big is None:
                self.img[n] = img.zoom(self.scale)
            else:
                big.blank()
                big.tk.call(big.name, "copy", img.name, "-zoom",
                            self.scale, self.scale)
            if n.endswith("@1"):
                self.animated.add(n[:-2])

    def scale_images(self):
        s = self.scale
        self.img = {n: i.zoom(s) for n, i in self.base.items()}
        self.animated = {n for n in self.base if n + "@1" in self.base}

    def image(self, name):
        img = self.img.get(name)
        if img is None:
            img = self.img.get(name[2:] if name[:2] in ("1:", "2:")
                               else name)
        return img

    def mmaid_portrait(self, kind, expr, z):
        key = ("mmaid", kind, expr, z)
        img = self.portraits.get(key)
        if img is None:
            px = portrait(monster_maid_look(kind), expr)
            base = tk.PhotoImage(width=PW, height=PW)
            base.put(" ".join("{" + " ".join(r) + "}" for r in px))
            img = self.portraits[key] = base.zoom(z)
        return img

    def portrait_image(self, who, expr, z):
        """A portrait as a Tk image, zoomed z times; who is a villager's
        id, or "you"."""
        key = (who, expr, z, who != "you" and self.swapped(who),
               who != "you" and self.maid(who),
               who != "you" and tuple(self.st.get("bikinis", {}).get(
                   who) or ()),
               who != "you" and tuple(self.st.get("wear", {}).get(who) or
                                      ()),
               who != "you" and self.st.get("uniform", {}).get(who))
        img = self.portraits.get(key)
        if img is None:
            look = self.p["look"] if who == "you" else self.look_of(who)
            px = portrait(look, expr)
            base = tk.PhotoImage(width=PW, height=PW)
            base.put(" ".join("{" + " ".join(r) + "}" for r in px))
            img = self.portraits[key] = base.zoom(z)
        return img

