def fruit_tree_art(kind, stage, season):
    """A fruit tree you planted: a sapling, a young tree, or grown, in
    blossom in spring, and hung with fruit ("f") in its season."""
    leaf, dark, hi, _ = TREE_LEAVES[season]
    _, fruit, bloom, _ = FRUIT_TREES[kind]
    pal = {"L": leaf, "l": dark, "H": hi, "T": "#7a5434", "t": "#5a3c24"}
    px = art_pixels(pal, FRUIT_TREE_ROWS["m" if stage == "f" else stage])
    if stage in ("m", "f") and season == 0:
        for x, y in BLOSSOM_SPOTS:
            px[y][x] = bloom
    if stage == "f":
        for x, y in FRUIT_SPOTS:
            px[y][x] = fruit
            px[y + 1][x] = shade(fruit, 0.75)
    return px


