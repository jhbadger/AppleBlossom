                     "you.'" % v, "heart")

    # ── The morning ──

    def morning_news(self):
        st = self.st
        self.say("%s. %s" % (self.date_text(), WEATHER_TEXT[st["weather"]]),
                 "quest")
        f = self.festival_today()
        if f:
            self.say("Today is the %s! (%s-%s, the %s.) %s" % (
                f[0], self.clock(f[1] // 100 * 60), self.clock(
                    f[2] // 100 * 60), f[3], f[4]), "quest")
        for vid, v in VILLAGERS.items():
            if v["birthday"] == (self.season(), self.dom()):
                self.say("It's %s's birthday!" % v["short"], "heart")
        tomorrow = st["day"] + 1
        f2 = FESTIVALS.get((self.season(tomorrow), self.dom(tomorrow)))
        if f2:
            self.mail("Mayor Edmund Pell",
                      "Don't forget: tomorrow is the %s! %s From %s to %s "
                      "in the %s. Everyone will be there!" % (
                          f2[0], f2[4], self.clock(f2[1] // 100 * 60),
                          self.clock(f2[2] // 100 * 60), f2[3]))
        for vid, v in VILLAGERS.items():
            if v["birthday"] == (self.season(tomorrow), self.dom(tomorrow)) \
                    and self.friend(vid)["met"]:
                self.mail("Granny Rose",
                          "A little reminder, dear: tomorrow is %s's "
                          "birthday. A thoughtful gift goes a long way." %
                          v["short"])
        if self.season() == 3 and self.dom() == 17:
            st["secret"] = random.choice(sorted(VILLAGERS))
            self.mail("Mayor Edmund Pell",
                      "The Long Night Feast is on the 24th! This year your "
                      "secret friend is... %s! Bring them a gift at the "
                      "feast." % VILLAGERS[st["secret"]]["name"])
        r = st["request"]
        if r and r["due"] < st["day"]:
            self.say("%s's request on the notice board has expired." %
                     VILLAGERS[r["who"]]["short"], "info")
