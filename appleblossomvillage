NOTE_STEPS = {"C": 0, "D": 2, "E": 4, "F": 5, "G": 7, "A": 9, "B": 11}


def note_number(name):
    """MIDI note number of a name such as 'C#4' or 'Bb3'."""
    n = NOTE_STEPS[name[0]] + 12 * (int(name[-1]) + 1)
    return n + name[1:-1].count("#") - name[1:-1].count("b")


def freq_of(midi):
    return 440.0 * 2 ** ((midi - 69) / 12)


def chord_note(chord, token):
    """Pitch of pattern token R/T/F<octave> over a chord such as 'F#m'."""
    minor = chord.endswith("m")
    root = note_number((chord[:-1] if minor else chord) + token[1])
    return root + {"R": 0, "T": 3 if minor else 4, "F": 7}[token[0]]


def synth_note(buf, start, n, freq, wave, duty, gain):
    att = int(0.004 * RATE)
    rel = max(1, min(int(0.025 * RATE), n // 3))
    step = freq / RATE
    for k in range(min(n, len(buf) - start)):
        ph = (k * step) % 1.0
        if wave == "square":
            v = 1.0 if ph < duty else -1.0
        else:
            v = 4 * ph - 1 if ph < 0.5 else 3 - 4 * ph
        env = gain * (1 - 0.3 * k / n)
        if k < att:
            env *= k / att
        elif k > n - rel:
            env *= (n - k) / rel
        buf[start + k] += v * env


def synth_drum(buf, start, kind, rng):
    if kind == "k":                                  # falling sine thump
        n = int(0.12 * RATE)
        for k in range(min(n, len(buf) - start)):
            t = k / RATE
            buf[start + k] += 0.35 * (1 - k / n) ** 2 * math.sin(
                2 * math.pi * (110 * t - 160 * t * t))
        return
    n, gain, a = ((int(0.11 * RATE), 0.12, 0.75) if kind == "s"
                  else (int(0.03 * RATE), 0.06, 0.95))
    y = x_prev = 0.0
    for k in range(min(n, len(buf) - start)):
        x = rng.uniform(-1, 1)
        y = a * (y + x - x_prev)                     # high-passed noise
        x_prev = x
        buf[start + k] += y * gain * (1 - k / n) ** 2


def render_tune(tune):
    step = int(RATE * 60 / tune["tempo"])
    chords = tune["chords"].split()
    bar = tune["bar"]
    nsteps = len(chords) * bar
    buf = [0.0] * (nsteps * step)

    def play(tokens, wave, duty, gain, pitch):
        i = 0
        while i < len(tokens):
            j = i + 1
            while j < len(tokens) and tokens[j] == "-":
                j += 1
            if tokens[i] not in ".-":
                synth_note(buf, i * step, (j - i) * step,
                           freq_of(pitch(i, tokens[i])), wave, duty, gain)
            i = j

    melody = tune["melody"].replace("|", " ").split()
    if len(melody) != nsteps:
        raise ValueError("melody has %d steps, not %d" % (len(melody), nsteps))
    wave, duty, gain = tune["lead"]
    play(melody, wave, duty, gain, lambda i, t: note_number(t))
    for wave, duty, gain, pattern in tune["voices"]:
        play(pattern.split() * len(chords), wave, duty, gain,
             lambda i, t: chord_note(chords[i // bar], t))
    rng = random.Random(1)
    for i, t in enumerate(tune["drums"].split() * len(chords)):
        if t != ".":
            synth_drum(buf, i * step, t, rng)
    return [v * MUSIC_VOLUME for v in buf]


# Players.  Each starts a WAV file and returns a handle that, like a
# subprocess, has poll() (None while it plays) and terminate().  On the
# desktop that is a command-line player; Android has none, so there the game
# uses Android's MediaPlayer through pyjnius, or failing that SDL's mixer.

class CommandPlayer:
    def __init__(self, cmd):
        self.cmd = cmd

    def start(self, path):
        return subprocess.Popen(self.cmd + [path], stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)

    @classmethod
    def find(cls):
        for cmd in (["afplay"], ["paplay"], ["aplay", "-q"]):
            if shutil.which(cmd[0]):
                return cls(cmd)


class MediaPlayer:
    """Android's android.media.MediaPlayer, reached through pyjnius (pip
    install pyjnius in Pydroid)."""

    class Handle:
        def __init__(self, mp):
            self.mp = mp

        def poll(self):
            if self.mp is None:
                return 0
            try:
                if self.mp.isPlaying():
                    return None
            except Exception:
                pass
            self.terminate()
            return 0

        def terminate(self):
            if self.mp is not None:
                try:
                    self.mp.stop()
                except Exception:
                    pass
                self.mp.release()
                self.mp = None

    def __init__(self, cls):
        self.cls = cls

    def start(self, path):
        mp = self.cls()
        try:
            mp.setDataSource(path)
            mp.prepare()
            mp.start()
        except Exception as e:
            mp.release()
            raise OSError(str(e))
        return self.Handle(mp)

    @classmethod
    def find(cls):
        try:
            import importlib
            jnius = importlib.import_module("jnius")
            return cls(jnius.autoclass("android.media.MediaPlayer"))
        except Exception:
            return None


class MixerPlayer:
    """SDL's mixer, through pygame.  Pydroid chooses how to run a script
    from the modules it imports, so the module's name is put together at
    run time: a Tk game must not be started as an SDL one."""

    class Handle:
        def __init__(self, channel, snd):
            self.channel, self.snd = channel, snd

        def poll(self):
            ch = self.channel
            if ch and ch.get_busy() and ch.get_sound() is self.snd:
                return None
            return 0

        def terminate(self):
            if self.poll() is None:
                self.channel.stop()

    def __init__(self, mixer):
        self.mixer = mixer
        self.sounds = {}

    def start(self, path):
        snd = self.sounds.get(path)
        if snd is None:
            try:
                snd = self.sounds[path] = self.mixer.Sound(path)
            except Exception as e:
                raise OSError(str(e))
        return self.Handle(snd.play(), snd)

    @classmethod
    def find(cls):
        try:
            import importlib
            os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
            mixer = importlib.import_module("py" + "game.mixer")
            mixer.init(RATE, -16, 1, 512)
            mixer.set_num_channels(8)
            return cls(mixer)
        except Exception:
            return None


def find_player():
    player = CommandPlayer.find()
    if not player and ANDROID:
        player = MediaPlayer.find()
    return player or MixerPlayer.find()


class Sound:
    def __init__(self):
        self.muted = False
        self.music_off = False
        self.tune = None            # the tune that should be playing
        self.music_proc = None
        self.music_playing = None
        self.music_deadline = 0     # when the playing loop should be over
        self.player = find_player()
        self.files = {}
        self.tunes = {}
        self.lengths = {}           # tune file: seconds
        self.procs = []             # effects still playing
        if self.player:
            atexit.register(self.stop_music)
            self.dir = tempfile.mkdtemp(prefix="appleblossom-")
            atexit.register(shutil.rmtree, self.dir, True)
            threading.Thread(target=self.synthesize, daemon=True).start()

    @staticmethod
    def tone(buf, t0, freq, dur, wave_type="sine", gain=0.25, attack=0.005):
        start = int(t0 * RATE)
        n = int(dur * RATE)
        need = start + n
        if len(buf) < need:
            buf.extend([0.0] * (need - len(buf)))
        for k in range(n):
            t = k / RATE
            if t < attack:
                env = 0.0001 * (gain / 0.0001) ** (t / attack)
            else:
                env = gain * (0.0001 / gain) ** ((t - attack) / (dur - attack))
            ph = (freq * t) % 1.0
            if wave_type == "sine":
                v = math.sin(2 * math.pi * ph)
            elif wave_type == "square":
                v = 1.0 if ph < 0.5 else -1.0
            else:  # triangle
                v = 4 * ph - 1 if ph < 0.5 else 3 - 4 * ph
            buf[start + k] += v * env

    @staticmethod
    def noise(buf, t0, dur, freq=800, gain=0.3):
        """High-passed white-noise burst with an exponential decay."""
        start = int(t0 * RATE)
        n = int(dur * RATE)
        need = start + n
        if len(buf) < need:
            buf.extend([0.0] * (need - len(buf)))
        rc = 1 / (2 * math.pi * freq)
        a = rc / (rc + 1 / RATE)
        y = x_prev = 0.0
        for k in range(n):
            x = random.uniform(-1, 1)
            y = a * (y + x - x_prev)
            x_prev = x
            env = gain * (0.0001 / gain) ** (k / n)
            buf[start + k] += y * env

    @staticmethod
    def pour(buf, dur=1.5, gain=0.32):
        """Water poured into water: a hiss of bubbly, gurgling noise, with
        little plinks that rise in pitch as it fills."""
        rng = random.Random(7)
        n = int(dur * RATE)
        buf.extend([0.0] * max(0, n - len(buf)))
        lo = hi = x_prev = 0.0
        a_lo = 1 / (1 + RATE / (2 * math.pi * 2600))    # low-pass
        rc = 1 / (2 * math.pi * 500)
        a_hi = rc / (rc + 1 / RATE)                      # high-pass
        gurgle, target = 0.5, 0.5
        for k in range(n):
            t = k / RATE
            if k % 1200 == 0:
                target = rng.uniform(0.25, 1.0)
            gurgle += (target - gurgle) * 0.002
            x = rng.uniform(-1, 1)
            lo += a_lo * (x - lo)
            hi = a_hi * (hi + lo - x_prev)
            x_prev = lo
            env = min(1.0, t / 0.08) * min(1.0, (dur - t) / 0.25)
            buf[k] += hi * gain * gurgle * env * 2.2
        t = 0.05
        while t < dur - 0.2:
            f = 500 + 700 * (t / dur) + rng.uniform(-60, 60)
            start, m = int(t * RATE), int(0.035 * RATE)
            for k in range(m):
                e = math.sin(math.pi * k / m)
                ph = 2 * math.pi * (f + 900 * k / m) * k / RATE  # a chirp
                buf[start + k] += math.sin(ph) * e * gain * 0.35
            t += rng.uniform(0.04, 0.11)

    @staticmethod
    def raspberry(buf, dur=0.8, gain=0.34):
        """Blowing a raspberry: a buzzing, flapping lip-trill that wobbles
        in pitch, with breath through it."""
        rng = random.Random(11)
        n = int(dur * RATE)
        buf.extend([0.0] * max(0, n - len(buf)))
        ph, f0, lo = 0.0, 105.0, 0.0
        a_lo = 1 / (1 + RATE / (2 * math.pi * 1400))
        for k in range(n):
            t = k / RATE
            f = f0 + 22 * math.sin(2 * math.pi * 5.5 * t) - 25 * t / dur
            ph += f * (1 + rng.uniform(-0.06, 0.06)) / RATE
            if ph >= 1.0:
                ph -= 1.0
            buzz = 1.0 if ph < 0.22 else -0.28        # a narrow pulse
            flap = 0.55 + 0.45 * math.sin(2 * math.pi * 31 * t) ** 2
            lo += a_lo * (rng.uniform(-1, 1) - lo)
            env = min(1.0, t / 0.03) * min(1.0, (dur - t) / 0.12)
            buf[k] += (buzz * 0.9 + lo * 1.0) * flap * env * gain

    @staticmethod
    def scream(buf, dur=1.1, gain=0.3):
        """A tree screaming: a shrill, wavering wail that climbs and then
        falls away, raw with breath."""
        rng = random.Random(5)
        n = int(dur * RATE)
        buf.extend([0.0] * max(0, n - len(buf)))
        ph, lo = 0.0, 0.0
        a_lo = 1 / (1 + RATE / (2 * math.pi * 3000))
        for k in range(n):
            t = k / RATE
            u = t / dur
            f = 620 + 520 * math.sin(math.pi * min(1.0, u * 1.4)) - 250 * u
            f += 38 * math.sin(2 * math.pi * 7.5 * t)        # the waver
            ph += f / RATE
            v = (math.sin(2 * math.pi * ph) + 0.55 *
                 math.sin(4 * math.pi * ph) + 0.35 *
                 math.sin(6 * math.pi * ph) + 0.2 *
                 math.sin(10 * math.pi * ph))
            lo += a_lo * (rng.uniform(-1, 1) - lo)
            env = min(1.0, t / 0.04) * min(1.0, (dur - t) / 0.3)
            buf[k] += (v * 0.5 + lo * 0.9) * env * gain

    @staticmethod
    def meow(buf, dur=0.6, gain=0.26):
        """A cat's mew: a rising, then falling, nasal cry."""
        n = int(dur * RATE)
        buf.extend([0.0] * max(0, n - len(buf)))
        ph = 0.0
        for k in range(n):
            t = k / RATE
            u = t / dur
            f = 520 + 380 * math.sin(math.pi * min(1.0, u * 1.3)) - 120 * u
            ph += f / RATE
            v = (math.sin(2 * math.pi * ph) + 0.5 *
                 math.sin(4 * math.pi * ph) + 0.3 *
                 math.sin(6 * math.pi * ph))
            env = min(1.0, t / 0.04) * min(1.0, (dur - t) / 0.18)
            buf[k] += v * env * gain * 0.6

    @staticmethod
    def bark(buf, gain=0.22):
        """A dog's "woof woof": each a short, rough, voiced burst whose
        pitch jumps then falls, through two mouth resonances sweeping from
        "wuh" to "uff", with a breathy edge and a puff of air at the end."""
        rng = random.Random(5)

        def woof(t0, f0, dur):
            start, n = int(t0 * RATE), int(dur * RATE)
            buf.extend([0.0] * max(0, start + n - len(buf)))
            ph = 0.0
            r1 = [0.0, 0.0]
            r2 = [0.0, 0.0]
            for k in range(n):
                u = k / n
                pitch = f0 * (1 + 0.25 * math.sin(math.pi * min(1, u * 3)) -
                              0.45 * u) * (1 + rng.uniform(-0.04, 0.04))
                ph += pitch / RATE
                if ph >= 1.0:
                    ph -= 1.0
                src = (1 - 2 * ph) * 0.8 + rng.uniform(-0.5, 0.5) * (
                    0.3 + 0.7 * u)             # a pulse, rougher as it goes
                out = 0.0
                for res, f, bw, w in ((r1, 900 - 450 * u, 180, 1.0),
                                      (r2, 1700 - 700 * u, 260, 0.5)):
                    rr = math.exp(-math.pi * bw / RATE)
                    a1 = 2 * rr * math.cos(2 * math.pi * f / RATE)
                    y = (1 - rr) * src + a1 * res[0] - rr * rr * res[1]
                    res[1], res[0] = res[0], y
                    out += y * w
                env = min(1.0, k / (0.006 * RATE)) * (1 - u) ** 1.6
                buf[start + k] += out * env * gain * 3

        woof(0.0, 430, 0.17)
        woof(0.24, 380, 0.19)
        rng2 = random.Random(9)
        for t0 in (0.15, 0.40):            # a little puff of breath after
            start = int(t0 * RATE)
            n = int(0.05 * RATE)
            buf.extend([0.0] * max(0, start + n - len(buf)))
            lo = 0.0
            for k in range(n):
                x = rng2.uniform(-1, 1)
                lo += (x - lo) * 0.35
                buf[start + k] += (x - lo) * (1 - k / n) * gain * 0.15

    @staticmethod
    def baa(buf, dur=0.7, gain=0.3):
        """A sheep's bleat: a nasal, buzzy note with a fast goat-ish
        tremble, sliding down at the end."""
        rng = random.Random(3)
        n = int(dur * RATE)
        buf.extend([0.0] * max(0, n - len(buf)))
        ph = 0.0
        for k in range(n):
            t = k / RATE
            u = t / dur
            f = 330 + 40 * math.sin(math.pi * min(1.0, u * 2)) - 90 * u * u
            ph += f / RATE
            if ph >= 1.0:
                ph -= 1.0
            v = (2 * ph - 1) * 0.6 + math.sin(2 * math.pi * ph * 3) * 0.3
            trem = 0.6 + 0.4 * math.sin(2 * math.pi * 23 * t)
            env = min(1.0, t / 0.05) * min(1.0, (dur - t) / 0.2)
            buf[k] += (v + rng.uniform(-0.08, 0.08)) * trem * env * gain

    def write(self, name, buf, path=None):
        path = path or os.path.join(self.dir, name + ".wav")
        pcm = array.array("h", (int(max(-1.0, min(1.0, v)) * 32000)
                                for v in buf + [0.0] * 200))
        if sys.byteorder == "big":
            pcm.byteswap()
        with wave.open(path, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm.tobytes())
        self.files[name] = path
        return path

