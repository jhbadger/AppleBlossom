    def gazette(self):
        """Amy's riddle in today's Gazette: answer it right, once a day,
        for a little prize."""
        st = self.st
        q, right, wrong = RIDDLES[st["day"] % len(RIDDLES)]
        if st.get("riddle_day") == st["day"]:
            self.say("You've done today's Gazette riddle. Tomorrow's paper "
                     "will have a new one.", "info")
            self.render()
            return
        answers = [right] + list(wrong)
        random.Random(st["day"]).shuffle(answers)
        self.open_menu("Today's Gazette riddle, by A.H.: %s" % q, [
            (a, lambda a=a: self.answer_riddle(a == right, right))
            for a in answers])

    def answer_riddle(self, ok, right):
        st = self.st
        st["riddle_day"] = st["day"]
        if not ok:
            self.say("Wrong! The answer, printed upside down at the bottom, "
                     "is '%s'." % right, "info")
            self.end_turn(1)
            return
        self.p["gold"] += 50
        self.sound.play("gold")
        self.say("Right! The Gazette pays 50g to anyone who sends in the "
                 "answer, and you scribble yours on the coupon. (+50g)",
                 "gold")
        if self.friend("amy").get("met"):
            self.befriend("amy", 15, quiet=True)
            self.say("(Amy will be pleased somebody got it.)", "heart")
        self.end_turn(1)

    def carving(self):
        """Something somebody's scratched into the outhouse wall."""
        st = self.st
        you = self.p["name"]
        lines = list(LOO_CARVINGS)
        partner = self.partner_name()
        if partner:
            lines += ["%s + %s, carved inside a lopsided heart." % (
                you, partner)] * 3
        for vid, f in st["friends"].items():
            if self.hearts(vid) >= 8 and not partner:
                lines.append("'%s was here,' and underneath, in different "
                             "writing, '%s likes %s!!'" % (
                                 VILLAGERS[vid]["short"],
                                 VILLAGERS[vid]["short"], you))
        for vid in VILLAGERS:
            kind = self.transformed(vid)
            if kind and kind not in ("loo", "swapped"):
                lines.append("'%s IS A %s NOW?!' Somebody's drawn one." % (
                    VILLAGERS[vid]["short"].upper(), {
                        "statue": "STATUE", "maid": "MAID"}.get(
                        kind, kind.upper())))
        loo = st.get("loo_in")
        if loo:
            lines.append("'%s was here.' Well, %s still is." % (
                VILLAGERS[loo]["short"], VILLAGERS[loo]["short"]))
        self.say("Carved in the wall: " + random.choice(lines), "info")
        self.end_turn(1)

    def knock_loo(self, vid):
        self.say("You knock on the side of the outhouse that is %s. "
                 "The door's round the front." % VILLAGERS[vid]["short"],
                 "info")
        self.end_turn(1)

    def clean_loo(self, vid):
        """A scrub of the outside walls, once a day: as good as a gift
        they like, and sometimes they say so."""
        f = self.friend(vid)
        name = VILLAGERS[vid]["short"]
        if f.get("cleaned") == self.st["day"]:
            self.say("You've already scrubbed %s today. The boards are "
                     "still damp." % name, "info")
            self.render()
            return
        f["cleaned"] = self.st["day"]
        self.loo_state(vid)["grime"] = 0
        n = self.npcs[vid]
        self.sound.play("pour")
        self.flash(n.x, n.y, "heart")
        self.say(random.choice(LOO_CLEAN) % name, "good")
        if random.random() < 0.5:
            self.say(random.choice(
                LOO_CLEAN_LIKE if self.likes_change(vid, "looify") else
                LOO_CLEAN_HATE).replace("{who}", name), "talk")
        self.befriend(vid, GIFT_POINTS["like"])
        self.end_turn(TOOL_COST)

    def do_business(self):
        vid = self.st["loo_in"]
        name = VILLAGERS[vid]["short"] if vid else "nobody"
        self.sound.play(random.choice(("pour", "raspberry")))
        self.say(random.choice(LOO_BUSINESS), "info")
        season = self.season()
        if random.random() < (0.45, 0.15, 0.15, 0.5)[season]:
            self.say(random.choice(LOO_SEASON[season]), "info")
        if vid:
            self.use_loo(vid)
            grime = self.loo_state(vid)["grime"]
            if grime >= LOO_FILTHY:
                self.say("Flies buzz round your head. It could do with a "
                         "good clean.", "bad")
            elif grime == LOO_GRUBBY:
                self.say("It's getting a bit grubby in here.", "info")
        ml = self.st.get("mine_loo")
        if ml:
            e = self.floor_state(ml["floor"])["changed"].get(ml["at"])
            if e:
                e["pit"] += 1
            if random.random() < 0.4:
                self.say(random.choice((
                    "The walls give a low, grumpy creak.",
                    "Somewhere in the planks, something mutters about "
                    "the indignity of it all.",
                    "A drip echoes, far off down the tunnels.")), "info")
        if vid and random.random() < 0.5:
            self.say(random.choice(
                LOO_VOICE_LIKE if self.likes_change(vid, "looify") else
                LOO_VOICE_HATE).replace("{who}", name), "info")
        if vid and random.random() < 0.25:
            here = self.npcs[vid]
            near = [o for o in self.npcs.values()
                    if o.where == "valley" and not o.hidden and
                    not self.rooted(o.vid) and
                    abs(o.x - here.x) + abs(o.y - here.y) <= 8]
            if near:
                self.say("Somebody knocks. \"Will you be long?\" calls "
                         "%s." % random.choice(near).name, "info")
        self.end_turn(5)

    def loo_visits(self, n, here, visible):
        """Somebody near an outhouse may pop in for a minute or two: True
        if they're busy with that and shouldn't go anywhere else."""
        st = self.st
        v = n.visit
        if v:
            o = self.npcs.get(v["loo"])
            if not self.loo(v["loo"]):
                n.visit, n.hidden = None, False
                return False
            if v["in"]:
                if st["minute"] >= v["until"]:
                    self.use_loo(v["loo"])
                    n.visit, n.hidden = None, False
                    x, y = self.loo_door(v["loo"])
                    taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                             if m is not n}
                    n.x, n.y = self.free_spot("valley", x, y, taken)
                    if here == "valley" and visible and self.near_you(n):
                        self.say(random.choice(LOO_OUT).replace(
                            "{who}", n.name), "info")
                    n.goal, n.path = None, []
                    return False
                return True
            dx, dy = self.loo_door(v["loo"])
            busy = [m for m in self.npcs.values() if m is not n and
                    m.visit and m.visit["loo"] == v["loo"] and m.visit["in"]]
            if busy and n.where == "valley" and \
                    abs(n.x - dx) + abs(n.y - dy) <= 2:
                if not v.get("queued"):
                    v["queued"] = True
                    if here == "valley" and visible and self.near_you(n):
                        self.say(random.choice(LOO_QUEUE).replace(
                            "{who}", n.name).replace(
                            "{in}", busy[0].name).replace(
                            "{loo}", VILLAGERS[v["loo"]]["short"]), "info")
                if st["minute"] > v["give_up"]:
                    n.visit = None              # she'll find a bush
                    return False
                return True
            if (n.where, n.x, n.y) == ("valley",) + self.loo_door(v["loo"]):
                if here == "loo" and st["loo_in"] == v["loo"]:
                    self.say("Somebody tries the door. \"Oh! Sorry!\" says "
                             "%s, and footsteps hurry away." % n.name,
                             "info")
                    n.visit = None
                    return False
                v["in"], n.hidden = True, True
                v["until"] = st["minute"] + random.randint(3, 8)
                if here == "valley" and visible and self.near_you(n):
                    self.say(random.choice(LOO_GO_IN).replace(
                        "{who}", n.name).replace(
                        "{loo}", VILLAGERS[o.vid]["short"]), "info")
                return True
            if st["minute"] > v["give_up"]:
                n.visit = None
            return False
        if not st["loos"] or n.where != "valley" or here != "valley" or \
                not visible or random.random() > 0.012:
            return False
        for lv in st["loos"]:
            o = self.npcs[lv]
            ls = self.loo_state(lv)
            if o.where == "valley" and not ls["tipped"] and \
                    ls["grime"] < LOO_FILTHY and \
                    abs(o.x - n.x) + abs(o.y - n.y) <= 6 and \
                    sum(1 for m in self.npcs.values()
                        if m.visit and m.visit["loo"] == lv) < 2:
                n.visit = {"loo": lv, "in": False,
                           "give_up": st["minute"] + 40}
                n.goal, n.path, n.stuck = None, [], 0
                return False
        return False

    def near_you(self, n):
        x, y = self.pos()
        return abs(n.x - x) <= 9 and abs(n.y - y) <= 7

    def tree_bump(self, n):
        """Walking into a villager-tree: a rustle, glad or cross; walk into
        it again straight away to push through the branches.  A fruit tree
        in fruit, you pick first."""
        vid = n.vid
        here = (vid, self.area.key, n.x, n.y, self.pos())
        t = self.st["fruitful"].get(vid)
        if t and t.get("fruit"):
            self.pick_villager_fruit(n, t)
            self.last_statue = None
            return
        if getattr(self, "last_statue", None) == here and \
                self.squeeze_past(n):
            self.last_statue = None
            self.say("You push through %s's branches and out the other "
                     "side, picking a leaf out of your collar." %
                     VILLAGERS[vid]["short"], "info")
        else:
            self.last_statue = here
            self.say(random.choice(
                TREE_HAPPY if self.likes_change(vid, "treeify") else
                TREE_CROSS).replace("{who}", VILLAGERS[vid]["short"]) +
                " (Walk into it again to push past.)", "info")
        self.end_turn(1)

    def tend_tree(self, n, tool):
        """A watering can or an axe, used on somebody who's a tree."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        if tool == "axe":
            self.chop_villager(n)
            return
        f = self.friend(vid)
        if f.get("watered") == self.st["day"]:
            self.say("%s's roots are already soaked today." % name, "info")
            self.render()
            return
        if self.p["water"] <= 0:
            self.say("The can's empty. Fill it at the well or any water.",
                     "bad")
            return
        if not self.spend("watering can"):
            return
        self.p["water"] -= 1
        f["watered"] = self.st["day"]
        self.sound.play("water")
        if self.likes_change(vid, "treeify"):
            self.say("You water %s. The leaves shiver happily, and a "
                     "blossom or two opens just for you." % name, "heart")
            self.befriend(vid, GIFT_POINTS["like"])
        else:
            self.say("You water %s, who shakes the water off at you, "
                     "crossly." % name, "info")
        self.end_turn(TOOL_COST - 1)

    def chop_tree(self, x, y, kind):
        """A swing of the axe at a tree; the third brings it down, for wood
        and a stump.  It grows back in a season."""
        if not self.spend("axe"):
            return
        k = "%d,%d" % (x, y)
        chops = getattr(self, "chops", {})
        if chops.get("at") != k:
            chops = {"at": k, "n": 0}
        chops["n"] += 1
        self.chops = chops
        self.sound.play("chop")
        if chops["n"] < AXE_CHOPS[self.lv("axe")]:
            left = AXE_CHOPS[self.lv("axe")] - chops["n"]
            self.say("You chop at the %s. Chips fly. (%d more swing%s.)" % (
                kind, left, "s" if left > 1 else ""), "info")
            self.end_turn(TOOL_COST)
            return
        self.chops = {}
        wood = CHOPPABLE[kind]
        self.st["felled"][k] = [self.st["day"], kind]
        self.areas["valley"].grid[y][x] = "grass"
        self.st["debris"][k] = "stump"
        self.give("wood", wood)
        self.flash(x, y, "puff")
        self.say("Timber! The %s comes down with a creak and a crash. "
                 "(+%d wood, and a stump to clear.)" % (kind, wood), "good")
        self.end_turn(TOOL_COST + 2)

    def apply_felled(self):
        """Felled trees, onto a freshly built valley (forgetting any that
        no longer stand there, if the valley has changed since)."""
        g = self.areas["valley"].grid
        st = self.st
        for k in list(st.get("felled", {})):
            x, y = map(int, k.split(","))
            if 0 <= x < VW and 0 <= y < VH and g[y][x] in CHOPPABLE:
                g[y][x] = "grass"
            else:
                del st["felled"][k]
                if st["debris"].get(k) == "stump":
                    del st["debris"][k]

    def regrow_trees(self):
        """Felled trees grow back after a season, where there's room."""
        st = self.st
        g = self.areas["valley"].grid
        for k, (day, kind) in list(st["felled"].items()):
            if st["day"] - day < REGROW_DAYS:
                continue
            x, y = map(int, k.split(","))
            if (x, y) == tuple(st["pos"]) or k in st["soil"] or \
                    k in st["sprinklers"] or k in st["forage"] or \
                    k in st["machines"] or k in st["orchard"] or \
                    any(n.where == "valley" and (n.x, n.y) == (x, y)
                        for n in self.npcs.values()):
                continue
            if st["debris"].get(k) not in (None, "stump"):
                continue
            st["debris"].pop(k, None)
            g[y][x] = kind
            del st["felled"][k]

    def chop_villager(self, n):
        """The axe, on somebody who's a tree.  It works, but the tree
        screams, and it doesn't forgive you."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        if VILLAGERS[vid]["look"].get("age") == "child":
            self.say("You raise the axe, see %s's little face in the bark, "
                     "and can't do it. Nobody could." % name, "info")
            self.render()
            return
        if not self.spend("axe"):
            return
        k = "npc:" + vid
        chops = getattr(self, "chops", {})
        if chops.get("at") != k:
            chops = {"at": k, "n": 0}
        chops["n"] += 1
        self.chops = chops
        self.sound.play("scream")
        self.befriend(vid, -100, quiet=True)
        if chops["n"] < CHOPS:
            self.say(TREE_SCREAMS[chops["n"] - 1].replace("{who}", name),
                     "bad")
            self.end_turn(TOOL_COST)
            return
        self.chops = {}
        self.st["trees"].remove(vid)
        self.st["fruitful"].pop(vid, None)
        n.goal, n.path, n.stuck = None, [], 0
        self.give("wood", CHOPPABLE["tree"])
        self.flash(n.x, n.y, "puff")
        self.say("With a last, long scream the tree that was %s topples, "
                 "and the trunk splits open. Out tumbles %s, whole, shaking, "
                 "and covered in sawdust. (+%d wood.)" % (
                     name, name, CHOPPABLE["tree"]), "bad")
        self.befriend(vid, -300, quiet=True)
        if self.talk:
            self.end_talk()
        self.talk = {"v": vid, "mode": "kw", "expr": "cross", "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.friend(vid)["met"] = True
        self.speak(vid, TREE_CHOPPED[vid])
        self.say("(%s will not forget this.)" % name, "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    def chore_menu(self, vid):
        name = VILLAGERS[vid]["short"]
        now = self.st["maids"].get(vid)
        self.open_menu("What should %s do each morning?%s" % (
            name, " (Now: %s.)" % MAID_CHORES[now][0].lower() if now
            else ""), [
            (label, lambda c=c: self.set_chore(vid, c))
            for c, (label, _) in MAID_CHORES.items()],
            cancel=lambda: None)

    def set_chore(self, vid, chore):
        self.st["maids"][vid] = chore
        pool = MAID_OK_LIKE if self.likes_change(vid, "maidify") else \
            MAID_OK_HATE
        self.speak(vid, random.choice(pool).replace(
            "{chore}", MAID_CHORES[chore][1]))

    def kiss_maid(self, vid):
        """A kiss for your maid: twice a day, each one as good as a gift
        she likes."""
        f = self.friend(vid)
        day, n = f.get("kissed") or (None, 0)
        if day != self.st["day"]:
            n = 0
        name = VILLAGERS[vid]["short"]
        if n >= 2:
            self.speak(vid, random.choice(MAID_KISS_ENOUGH))
            self.talk_menu()
            return
        f["kissed"] = [self.st["day"], n + 1]
        self.say("> (you kiss %s on the cheek)" % name, "you")
        likes = self.likes_change(vid, "maidify")
        self.speak(vid, random.choice(MAID_KISS_LIKE if likes else
                                      MAID_KISS_HATE))
        self.befriend(vid, GIFT_POINTS["like"])
        self.flash(self.npcs[vid].x, self.npcs[vid].y, "heart")
        self.sound.play("heart")
        self.pass_time(1)
        self.check_scene(vid)
        if not self.scene:
            self.talk_menu()

    def maid_romance(self, vid, lines):
        """A maid's word on love: whether she likes being a maid colours
        what she says."""
        return lines[0 if self.likes_change(vid, "maidify") else 1]

    def outfit(self, vid):
        """What a maid has on: bikini, shawl, sundress, yukata or
        uniform."""
        if vid in self.st.get("bikinis", {}):
            return "bikini"
        w = self.st.get("wear", {}).get(vid)
        return w[0] if w else "uniform"

    def outfit_words(self, vid):
        """Her outfit, as you'd describe it: 'a blue polka-dot bikini'."""
        kind = self.outfit(vid)
        if kind == "bikini":
            c, dots = self.st["bikinis"][vid]
            words = "%s %sbikini" % (BIKINI_NAMES.get(c, "bright"),
                                     "polka-dot " if dots else "")
            return ("an " if words[0] in "aeiou" else "a ") + words
        if kind == "uniform":
            colour = self.st.get("uniform", {}).get(vid)
            names = {v: k for k, v in MAID_UNIFORMS.items()}
            return "her %smaid's uniform" % (
                names[colour] + " " if colour in names and
                colour != MAID_UNIFORMS["black"] else "")
        c = self.st["wear"][vid][1]
        words = "%s %s" % (COLOUR_NAMES.get(c, "pretty"), {
            "shawl": "shawl over her uniform", "sundress": "sundress",
            "yukata": "yukata",
            "pirate": "pirate coat, tricorn hat and eyepatch",
            "sailor": "sailor school uniform"}[kind])
        return ("an " if words[0] in "aeiou" else "a ") + words

    def maid_wear(self, vid):
        """WEAR: her wardrobe, from the uniform (in any colour) to a
        bikini."""
        name = VILLAGERS[vid]["short"]
        now = self.outfit(vid)
        items = [("Her uniform" + (" (wearing it)" if now == "uniform"
                                   else ""),
                  lambda: self.put_on(vid, "uniform"))]
        items.append(("A different bikini" if now == "bikini" else
                       "A bikini", lambda: self.put_on(vid, "bikini")))
        for kind, (label, _) in OUTFITS.items():
            items.append(("A different " + label[2:] if now == kind else
                          label, lambda k=kind: self.put_on(vid, k)))
        items.append(("A new colour for her uniform",
                      lambda: self.uniform_menu(vid)))
        items.append(("Never mind", self.talk_menu))
        self.open_menu("What should %s wear? (Now: %s.)" % (
            name, self.outfit_words(vid)), items, self.talk_menu)

    def uniform_menu(self, vid):
        self.open_menu("What colour should %s's uniform be?" %
                       VILLAGERS[vid]["short"], [
                           (cap(n), lambda c=c: self.set_uniform(vid, c))
                           for n, c in MAID_UNIFORMS.items()] +
                       [("Never mind", self.talk_menu)], self.talk_menu)

    def set_uniform(self, vid, colour):
        st = self.st
        if colour == MAID_UNIFORMS["black"]:
            st["uniform"].pop(vid, None)
        else:
            st["uniform"][vid] = colour
        st["bikinis"].pop(vid, None)
        st["wear"].pop(vid, None)
        names = {v: k for k, v in MAID_UNIFORMS.items()}
        self.say("%s changes into a %s uniform." % (
            VILLAGERS[vid]["short"], names[colour]), "info")
        self.speak(vid, random.choice(UNIFORM_LINES).replace(
            "{Colour}", cap(names[colour])).replace("{colour}",
                                                    names[colour]))
        self.dressed(vid)

    def put_on(self, vid, kind):
        """Out of one outfit and into another; each maid likes some and
        not others, and says so."""
        st = self.st
        name = VILLAGERS[vid]["short"]
        was = self.outfit(vid)
        if kind == "uniform" and was == "uniform":
            self.speak(vid, "(surprised)I'm already in my uniform!")
            self.talk_menu()
            return
        st["bikinis"].pop(vid, None)
        st["wear"].pop(vid, None)
        season = self.season()
        if kind == "uniform":
            self.say("%s slips back into her dress, apron and cap." % name,
                     "info")
            liked = self.likes_change(vid, "bikini" if was == "bikini" else
                                      "wear_" + was)
            self.speak(vid, random.choice(
                (BIKINI_OFF_LIKE if liked else BIKINI_OFF_HATE)
                if was == "bikini" else
                (UNIFORM_BACK_SORRY if liked else UNIFORM_BACK_GLAD)))
            self.dressed(vid)
            return
        if kind == "bikini":
            colour = random.choice(BIKINI_COLOURS)
            dots = None
            if random.random() < 0.4:
                dots = "#1a1a22" if colour in ("#f4d020", "#40d0d0") else \
                    "#ffffff"
                if colour == "#1a1a22":
                    dots = "#ffffff"
            st["bikinis"][vid] = [colour, dots]
            likes = self.likes_change(vid, "bikini")
            lines = BIKINI_ON_LIKE if likes else BIKINI_ON_HATE
            cold = season == 3
        else:
            st["wear"][vid] = [kind, random.choice(OUTFITS[kind][1])]
            likes = self.likes_change(vid, "wear_" + kind)
            lines = OUTFIT_LINES[kind][0 if likes else 1]
            cold = kind == "sundress" and season == 3
        self.say("%s goes behind the screen and comes back out in %s." % (
            name, self.outfit_words(vid)), "info")
        self.speak(vid, random.choice(lines))
        if cold:
            self.speak(vid, random.choice(BIKINI_WINTER).replace(
                    "{outfit}", self.outfit(vid)))
        elif kind == "shawl" and season == 1:
            self.speak(vid, random.choice(SHAWL_SUMMER))
        flag = "%sliked:%s" % (kind, vid)
        if likes and flag not in st["flags"]:
            st["flags"].append(flag)
            self.befriend(vid, 40)
            self.say("(%s likes you more for it.)" % name, "heart")
        elif not likes:
            self.befriend(vid, -30, quiet=True)
            self.say("(%s %s, but does as she's told.)" % (
                name, "is embarrassed" if kind == "bikini" else
                "isn't keen"), "bad")
        self.dressed(vid)

    def dressed(self, vid):
        """She's changed: her portrait and sprite, and on we talk."""
        n = self.npcs[vid]
        self.portraits = {}
        self.paint_specials(scale=True)
        self.flash(n.x, n.y, "sparkle")
        self.pass_time(1)
        self.render()
        self.talk_menu()

    def maid_morning(self):
        """Every maid does what she was told, before you're up."""
        st = self.st
        order = list(MAID_CHORES)
        maids = sorted(st.get("maids", {}).items(),
                       key=lambda m: (order.index(m[1]) if m[1] in order
                                      else 99, m[0]))
        for vid, chore in maids:
            name = VILLAGERS[vid]["short"]
            if self.statue(vid):
                continue
            if chore is None:
                self.say("%s is waiting in your cabin to be told her "
                         "CHORE." % name, "info")
                continue
            likes = self.likes_change(vid, "maidify")
            how = random.choice(MAID_HAPPILY if likes else MAID_GRUMBLING)
            done = self.do_chore(vid, chore)
            if done:
                self.say("%s %s, %s." % (name, done, how),
                         "heart" if likes else "info")
        for m in sorted(self.mmaids(), key=lambda m: (
                order.index(m["chore"]) if m["chore"] in order else 99,
                m["name"])):
            if m["chore"] is None:
                self.say("%s is waiting in your cabin to be told her "
                         "chore." % m["name"], "info")
                continue
            done = self.do_chore(None, m["chore"])
            if done:
                self.say("%s %s, %s." % (m["name"], done,
                                         random.choice(MAID_HAPPILY)),
                         "heart")

    def do_chore(self, vid, chore):
        """One maid's chore; what she did, or None if there was nothing to
        do."""
        st = self.st
        if chore == "water":
            gh = st.setdefault("gh", {})
            dry = [s for s in list(st["soil"].values()) + list(gh.values())
                   if s[1] and not s[3] and not s[0]]
            if not dry or (st["weather"] in ("rain", "storm") and
                           not any(s[1] for s in gh.values())):
                return None
            for s in list(st["soil"].values()) + list(gh.values()):
                s[0] = 1
            return "watered all the crops" + (
                ", the greenhouse's too" if any(s[1] for s in gh.values())
                else "")
        if chore == "harvest":
            got = {}
            for beds, pre in ((st["soil"], ""),
                              (st.setdefault("gh", {}), "gh:")):
                for k, s in beds.items():
                    if self.ripe(s):
                        item, n = self.pick_crop(pre + k, s)
                        self.take(item, n)
                        got[item] = got.get(item, 0) + n
            for t in st["orchard"].values():
                if t.get("fruit"):
                    got[t["kind"]] = got.get(t["kind"], 0) + t["fruit"]
                    st["stats"]["harvested"] += t["fruit"]
                    t["fruit"] = 0
            if not got:
                return None
            for item, c in got.items():
                self.give(item, c)
            return "picked %s and put %s in your bag" % (and_list(
                ["%d %s" % (c, plural(n, c)) for n, c in sorted(got.items())]),
                "it" if sum(got.values()) == 1 else "them")
        if chore == "weed":
            keys = [k for k in st["debris"]
                    if FARM[0] < int(k.split(",")[0]) < FARM[2] and
                    FARM[1] < int(k.split(",")[1]) < FARM[3]]
            random.shuffle(keys)
            got = {}
            for k in keys[:12]:
                item, c = DEBRIS[st["debris"].pop(k)][1]
                got[item] = got.get(item, 0) + c
            if not got:
                return None
            for item, c in got.items():
                self.give(item, c)
            return "cleared %d things from the fields (%s for your bag)" % (
                len(keys[:12]), and_list(["%d %s" % (c, n) for n, c in
                                          sorted(got.items())]))
        if chore == "eggs":
            hens = st["chickens"]
            if not hens:
                return None
            big = sum(1 for e in st["eggs"] if e in st["large_eggs"])
            n = len(st["eggs"])
            st["eggs"], st["large_eggs"] = [], []
            for c in hens:
                if c.get("petted") != st["day"]:
                    self.farm_love(c, PET_LOVE["maid"], quiet=True)
                c["petted"] = st["day"]
            if n - big:
                self.give("egg", n - big)
            if big:
                self.give("large egg", big)
            return "%s and petted %s" % (
                "collected %d egg%s for your bag" % (n, "s" if n > 1 else "")
                if n else "found no eggs", "your hen" if len(hens) == 1
                else "all %d hens" % len(hens))
        if chore == "milk":
            cows = [c for c in st["cows"] if self.milk_ready(c)]
            if not cows:
                return None
            for c in cows:
                c["milked"] = st["day"]
                c["milk"] = c.get("milk", 0) + 1
            self.give("milk", len(cows))
            kinds = {c.get("kind", "cow") for c in cows}
            return "milked %s (%d milk for your bag)" % (
                ("your " + kinds.pop()) if len(cows) == 1 else
                "%d %s" % (len(cows), "cows" if kinds == {"cow"} else
                           "sheep" if kinds == {"sheep"} else
                           "cows and sheep"), len(cows))
        if chore == "shear":
            woolly = [c for c in st["cows"] if self.shear_ready(c)]
            if not woolly or "shears" not in self.p["tools"]:
                return None
            for c in woolly:
                c["shorn"] = st["day"]
                c["wool"] = c.get("wool", 0) + 1
            self.give("wool", len(woolly))
            return "sheared %s (%d wool for your bag)" % (
                "your sheep" if len(woolly) == 1 else
                "%d sheep" % len(woolly), len(woolly))
        if chore == "pets":
            pets = st.get("pets", [])
            if not pets:
                return None
            for c in pets:
                c["petted"] = st["day"]
                c["love"] = min(5 * PET_HEART, c.get("love", 100) +
                                PET_LOVE["maid"])
            return "fed %s and gave %s a fuss" % (
                pets[0]["name"] if len(pets) == 1 else
                and_list([c["name"] for c in pets]),
                "her" if len(pets) == 1 else "them all")
        if chore == "machines":
            got, loaded = {}, 0
            for k, m in st["machines"].items():
                if self.machine_ready(m):
                    got[m["out"]] = got.get(m["out"], 0) + 1
                    self.give(m["out"])
                    if m["kind"] == "beehive":
                        m["ready"] = (st["day"] + HIVE_DAYS) * 1440 + 360
                    else:
                        m["out"] = None
                if not m.get("out") and m["kind"] != "beehive":
                    choices = self.machine_inputs(m["kind"])
                    if choices:
                        _, need, n, made, mins = choices[0]
                        self.take(need, n)
                        m["out"] = made
                        m["ready"] = (st["day"] + 1) * 1440 + 360 \
                            if mins is None else self.now_abs() + mins
                        loaded += 1
            if not got and not loaded:
                return None
            return "%s%s%s" % (
                "took %s out of the machines" % and_list(
                    ["%d %s" % (c, n) for n, c in sorted(got.items())])
                if got else "", " and " if got and loaded else "",
                "filled %d machine%s from your bag" % (
                    loaded, "" if loaded == 1 else "s") if loaded else "")
        if chore == "loos":
            loos = [v for v in st["loos"] if not self.statue(v)]
            dropped = len(st["droppings"])
            if not loos and not dropped:
                return None
            st["droppings"].clear()
            sacks, righted = dropped, 0
            for v in loos:
                ls = self.loo_state(v)
                ls["grime"] = 0
                n = ls["pit"] // PIT_PER_FERT
                ls["pit"] -= n * PIT_PER_FERT
                sacks += n
                if ls["tipped"]:
                    ls["tipped"] = False
                    righted += 1
            if sacks:
                self.give("fertilizer", sacks)
            done = []
            if loos:
                done.append("scrubbed %s%s" % (
                    "the outhouse" if len(loos) == 1 else
                    "all %d outhouses" % len(loos),
                    ", set one back on its feet" if righted else ""))
            if dropped:
                done.append("scooped up %d dropping%s in the pastures" % (
                    dropped, "" if dropped == 1 else "s"))
            return and_list(done) + (
                ", and bagged %d fertilizer for you" % sacks if sacks
                else "")
        if chore == "ship":
            goods = {n: c for n, c in self.p["items"].items()
                     if c and ITEMS.get(n, (0, 0, ""))[2] in ("crop",
                                                             "fruit")}
            if not goods:
                return None
            pay = 0
            for n, c in goods.items():
                self.p["items"].pop(n)
                st["shipped"][n] = st["shipped"].get(n, 0) + c
                pay += c * ITEMS[n][0]
            return "took %s to the shipping bin (%dg tonight)" % (
                and_list(["%d %s" % (c, plural(n, c))
                          for n, c in sorted(goods.items())]), pay)
        if chore == "cook":
            dishes = [d for d in self.st.get("recipes", ())
                      if self.can_cook(d, pantry_only=True)]
            if dishes:
                food = max(dishes, key=lambda d: ITEMS[d][1])
                self.use_ingredients(food, pantry_only=True)
                self.give(food)
                return "cooked you %s from the pantry (in your bag)" % an(
                    food)
            food = random.choice(("pancakes", "bread", "honey cake",
                                  "stew"))
            self.give(food)
            return "made you breakfast (%s, in your bag)" % food
        return None

    def leashed(self, vid):
        return self.st.get("leashed") == vid

    def leashable(self, vid):
        return (self.chicken(vid) or self.hoofed(vid)) and \
            not self.statue(vid)

    def kept(self, vid):
        """In your coop, your barn or your home: one of your animals."""
        return self.cooped(vid) or self.barned(vid) or self.homed(vid)

    def homed(self, vid):
        return any(c.get("vid") == vid for c in self.st.get("pets", ()))

    def is_cow(self, vid):
        return vid in self.st.setdefault("cowified", [])

    def is_sheep(self, vid):
        return vid in self.st.setdefault("sheepified", [])

    def beast(self, vid):
        """What animal (cow, sheep, cat or dog) the wand has made of
        somebody, or None."""
        for kind, b in BEASTS.items():
            if vid in self.st.setdefault(b["list"], []):
                return kind
        return None

    def hoofed(self, vid):
        """Turned into any of the BEASTS (hens are their own thing)."""
        return self.beast(vid) is not None

    def barn_beast(self, vid):
        return self.beast(vid) in ("cow", "sheep")

    def pet_kind(self, vid):
        return self.beast(vid) in ("cat", "dog")

    def sheep_colour(self, vid):
        """The fleece somebody grows, by the colour of their hair."""
        return {"black": "black", "brown": "brown",
                "ginger": "cream"}.get(self.cow_colour(vid), "white")

    def beast_colour(self, vid, kind):
        hair = self.cow_colour(vid)          # black, brown, ginger, spotted
        if kind == "cat":
            pale = VILLAGERS[vid]["look"].get("hair") in ("#eeeeee",
                                                          "#9a9a9a")
            return {"black": "black", "ginger": "ginger",
                    "brown": "tabby"}.get(hair, "grey" if pale else "white")
        if kind == "dog":
            if VILLAGERS[vid]["look"].get("hair") in ("#eeeeee", "#9a9a9a"):
                return "white"
            return {"black": "black", "brown": "brown"}.get(hair, "golden")
        return self.cow_colour(vid) if kind == "cow" else \
            self.sheep_colour(vid)

    def barned(self, vid):
        return any(c.get("vid") == vid for c in self.st.get("cows", ()))

    def cow_colour(self, vid):
        """The cow somebody becomes, by the colour of their hair."""
        hair = VILLAGERS[vid]["look"].get("hair", "")
        return {"#1e1a1a": "black", "#221a18": "black", "#4a4040": "black",
                "#5a3a1e": "brown", "#8a4a22": "brown",
                "#a83a1e": "ginger", "#d0502a": "ginger",
                "#e4641c": "ginger", "#2a1a14": "black"}.get(hair,
                                                            "spotted")

    def beastify(self, n, kind):
        """The cowify and sheepify spells: a barn animal like the ones
        Mabel sells, going about the villager's day; cast the same spell
        again, and back they come."""
        b = BEASTS[kind]
        spell = b["spell"]
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        flags = st["flags"]
        mine = vid in st[b["list"]]
        if not mine:
            why = None
            if VILLAGERS[vid]["look"].get("age") == "child" and \
                    b.get("child"):
                why = b["child"] % name
            elif self.statue(vid):
                why = b["gold"]
            elif self.chicken(vid):
                why = ("The spell slides off the hen's feathers. Hens are "
                       "hens.")
            elif self.hoofed(vid):
                why = BEASTS[self.beast(vid)]["bounce"]
            elif self.maid(vid):
                why = ("The spell glances off %s's starched apron. A maid "
                       "stays a maid until the spell that made her is "
                       "undone." % name)
            elif self.tree(vid):
                why = ("The spell sinks into %s's bark and is gone." % name)
            elif self.loo(vid):
                why = ("The spell splinters against the outhouse door.")
            if why:
                self.say(why, "info")
                self.end_turn(TOOL_COST)
                return
        if self.talk:
            self.end_talk()
        likes = self.likes_change(vid, spell)
        if not mine:
            st[b["list"]].append(vid)
            n.goal, n.path, n.stuck = None, [], 0
            self.sound.play({"sheep": "baa", "cat": "meow",
                             "dog": "bark"}.get(kind, "spell"))
            self.say(b["grow"] % (name, self.beast_colour(vid, kind),
                                  b["happy"] if likes else b["cross"]),
                     "quest")
            if likes:
                pts = 0 if kind + "liked:" + vid in flags else 150
                flags.append(kind + "liked:" + vid)
            else:
                pts = -200
            if pts:
                self.befriend(vid, pts, quiet=True)
                self.say("(%s %s.)" % (name, "seems to enjoy being a " + kind
                                       if pts > 0 else "is upset with you"),
                         "heart" if pts > 0 else "bad")
            self.end_turn(TOOL_COST)
            return
        st[b["list"]].remove(vid)
        n.goal, n.path, n.stuck = None, [], 0
        if self.leashed(vid):
            st["leashed"] = None
        self.unbarn(vid)
        self.say(b["unmade"] % name, "quest")
        if likes:
            pts = -80
        else:
            pts = 0 if kind + "fixed:" + vid in flags else 120
            flags.append(kind + "fixed:" + vid)
        self.talk = {"v": vid, "mode": "kw", "expr": "surprised",
                     "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.friend(vid)["met"] = True
        self.speak(vid, b["back"][vid][0 if likes else 1])
        if pts:
            self.befriend(vid, pts)
            self.say("(%s %s.)" % (name, "likes you more for it" if pts > 0
                                   else "is upset with you"),
                     "heart" if pts > 0 else "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    def barn_cow(self, vid):
        """A villager-cow led into the barn: one of your cows now."""
        st = self.st
        n = self.npcs[vid]
        name = VILLAGERS[vid]["short"]
        if len(st["cows"]) >= BARN_ROOM:
            self.say("The barn's full. %s waits by the door with you, "
                     "chewing." % name, "info")
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            n.where = "barn"
            n.x, n.y = self.free_spot("barn", *self.pos(), taken)
            return
        st["leashed"] = None
        kind = self.beast(vid)
        x, y = self.free_barn_square() or self.barn_squares()[0]
        c = {"name": name, "colour": self.beast_colour(vid, kind),
             "x": x, "y": y, "petted": -1, "milked": -9,
             "day": st["day"], "milk": 0, "vid": vid}
        if kind == "sheep":
            c.update(kind="sheep", shorn=st["day"] - SHEAR_DAYS, wool=0)
        st["cows"].append(c)
        n.where, n.x, n.y, n.hidden = "barn", x, y, True
        n.goal, n.path, n.visit = None, [], None
        self.say("You unclip the leash, and %s the %s %s. She's one of "
                 "your %s now. (%s)" % (
                     name, kind, "ambles into a stall and starts on the hay"
                     if kind == "cow" else "trots in and settles in the "
                     "straw", "cows" if kind == "cow" else "sheep",
                     "She looks very content." if self.likes_change(
                         vid, BEASTS[kind]["spell"]) else
                     "She does not look pleased."), "quest")
        self.render()

    def unbarn(self, vid):
        st = self.st
        n = self.npcs[vid]
        for c in list(st["cows"]):
            if c.get("vid") == vid:
                st["cows"].remove(c)
                n.where, n.x, n.y = "barn", c["x"], c["y"]
        for c in list(st.get("pets", ())):
            if c.get("vid") == vid:
                st["pets"].remove(c)
                n.where, n.x, n.y = c["where"], c["x"], c["y"]
        n.hidden = self.cooped(vid)

    def build_barn(self):
        self.build_on_farm("barn")

    def barn_squares(self):
        a = self.areas["barn"]
        return [(x, y) for y in range(a.h) for x in range(a.w)
                if a.grid[y][x] == "straw" and (x, y) != a.entry]

    def cow_at(self, x, y):
        out = self.grazing_now("barn")
        for i, c in enumerate(self.st["cows"]):
            if (c["x"], c["y"]) == (x, y) and not (out and c.get("ox")
                                                   is not None):
                return i
        return None

    def free_barn_square(self):
        here = self.pos() if self.area and self.area.key == "barn" else None
        free = [sq for sq in self.barn_squares()
                if self.cow_at(*sq) is None and sq != here]
        return random.choice(free) if free else None

    def add_cow(self):
        used = {c["name"] for c in self.st["cows"]}
        names = [n for n in COW_NAMES if n not in used] or COW_NAMES
        x, y = self.free_barn_square() or self.barn_squares()[0]
        c = {"name": random.choice(names), "colour": random.choice(
            COW_COLOURS), "x": x, "y": y, "petted": -1, "milked": -1,
            "day": self.st["day"], "milk": 0}
        self.st["cows"].append(c)
        if self.area.key == "barn":
            self.render()
        return c

    def add_sheep(self):
        used = {c["name"] for c in self.st["cows"]}
        names = [n for n in SHEEP_NAMES if n not in used] or SHEEP_NAMES
        x, y = self.free_barn_square() or self.barn_squares()[0]
        c = {"name": random.choice(names), "kind": "sheep",
             "colour": random.choice(SHEEP_COLOURS), "x": x, "y": y,
             "petted": -1, "milked": -9, "shorn": self.st["day"] -
             SHEAR_DAYS, "day": self.st["day"], "milk": 0, "wool": 0}
        self.st["cows"].append(c)
        if self.area.key == "barn":
            self.render()
        return c

    def milk_ready(self, c):
        """A cow gives milk every day, a sheep every other day."""
        if c.get("kind") == "sheep":
            return self.st["day"] - c.get("milked", -9) >= SHEEP_MILK_DAYS
        return c.get("milked") != self.st["day"]

    def shear_ready(self, c):
        """A sheep's woolly enough to shear three days after the last."""
        return c.get("kind") == "sheep" and \
            self.st["day"] - c.get("shorn", -9) >= SHEAR_DAYS

    def barn_tile(self, c):
        if c.get("kind") == "sheep":
            return ("sheepf_" if self.shear_ready(c) else "sheep_") + \
                c["colour"]
        return "cow_" + c["colour"]

    def cow_minute(self):
        a = self.areas["barn"]
        for c in self.st["cows"]:
            if random.random() > 0.08 or self.is_out(c, "barn"):
                continue
            dx, dy = random.choice(DIRS)
            x, y = c["x"] + dx, c["y"] + dy
            if a.inside(x, y) and a.grid[y][x] == "straw" and \
                    (x, y) != a.entry and self.cow_at(x, y) is None and \
                    (x, y) != self.pos():
                c["x"], c["y"] = x, y

    def cow_menu(self, i):
        """Walking into one of your barn animals: a cow or a sheep."""
        c = self.st["cows"][i]
        sheep = c.get("kind") == "sheep"
        age = self.st["day"] - c.get("day", 0)
        items = [("Pet %s" % c["name"], lambda: self.pet_cow(i))]
        if "milk pail" in self.p["tools"]:
            items.append(("Milk %s%s" % (c["name"], "" if self.milk_ready(c)
                                         else " (done today)" if
                                         c.get("milked") == self.st["day"]
                                         else " (tomorrow)"),
                          lambda: self.milk_cow(i)))
        if sheep and "shears" in self.p["tools"]:
            wait = SHEAR_DAYS - (self.st["day"] - c.get("shorn", -9))
            items.append(("Shear %s%s" % (c["name"], "" if wait <= 0 else
                                          " (in %d day%s)" % (
                                              wait, "s" if wait > 1
                                              else "")),
                          lambda: self.shear(i)))
        if not c.get("vid"):
            items.append(("Give her a new name",
                          lambda: self.start_naming(i, "cows")))
        items.append(("Squeeze past",
                      lambda: self.edge_past(i, "cows")))
        items.append(("Leave her be", lambda: None))
        m = c.get("milk", 0)
        self.open_menu("%s, a %s%s %s %s%s (%s; %d pail%s of milk%s)" % (
            c["name"], "woolly " if self.shear_ready(c) else "",
            c["colour"], "sheep" if sheep else "cow",
            self.pet_hearts_text(c), " (hungry)" if c.get("hungry") else "",
            "new today" if age == 0 else
            "%d day%s with you" % (age, "s" if age > 1 else ""),
            m, "" if m == 1 else "s", "; %d wool" % c.get("wool", 0)
            if sheep else ""), items)

    def pet_cow(self, i):
        c = self.st["cows"][i]
        sheep = c.get("kind") == "sheep"
        self.flash(*self.animal_spot(c, "barn"), "heart")
        if c.get("petted") != self.st["day"]:
            self.farm_love(c, FARM_LOVE["pet"])
        vid = c.get("vid")
        if c.get("petted") == self.st["day"]:
            self.say("%s has had her fuss for today. She flicks an ear at "
                     "you." % c["name"], "info")
        elif vid:
            c["petted"] = self.st["day"]
            if self.likes_change(vid, "sheepify" if sheep else "cowify"):
                self.say(("You ruffle %s's wool. She bleats softly and "
                          "leans into you." if sheep else
                          "You scratch %s behind the ears. She moos softly "
                          "and leans into you.") % c["name"], "good")
                self.befriend(vid, GIFT_POINTS["like"])
            else:
                self.say(("You pat %s. She puts up with it, chewing "
                          "pointedly.") % c["name"], "info")
        else:
            c["petted"] = self.st["day"]
            if sheep:
                self.sound.play("baa")
            self.say(random.choice(SHEEP_PETS if sheep else COW_PETS) %
                     c["name"], "good")
        self.end_turn(1)

    def milk_cow(self, i):
        """A cow gives a pail of milk once a day, a sheep every other day,
        if you've the pail."""
        c = self.st["cows"][i]
        sheep = c.get("kind") == "sheep"
        if "milk pail" not in self.p["tools"]:
            self.say("You'll need a milk pail. Mabel sells them.", "info")
            self.render()
            return
        if not self.milk_ready(c):
            self.say(("%s's been milked today. She gives you a look that "
                      "says so." if c.get("milked") == self.st["day"] else
                      "%s's still got none to give. Sheep need a day "
                      "between milkings.") % c["name"], "info")
            self.render()
            return
        if not self.spend("milk pail"):
            return
        c["milked"] = self.st["day"]
        c["milk"] = c.get("milk", 0) + 1
        large = random.random() < self.large_chance(c)
        self.give("large milk" if large else "milk")
        self.sound.play("pour")
        if large:
            self.say("What a pail! %s's so content she gives twice the "
                     "cream. (+1 large milk)" % c["name"], "heart")
            self.end_turn(TOOL_COST)
            return
        vid = c.get("vid")
        if vid and not self.likes_change(vid, "sheepify" if sheep else
                                         "cowify"):
            self.say("You milk %s, who stamps a hoof the whole time. (+1 "
                     "milk)" % c["name"], "good")
        elif sheep:
            self.say("You milk %s. It takes a while; sheep are small. "
                     "Rich, creamy milk. (+1 milk)" % c["name"], "good")
        else:
            self.say("You milk %s. Warm, sweet milk froths into the pail. "
                     "(+1 milk)" % c["name"], "good")
        self.end_turn(TOOL_COST)

    def shear(self, i):
        """Every third day a sheep has grown enough wool to shear."""
        c = self.st["cows"][i]
        if c.get("kind") != "sheep":
            self.say("%s doesn't need a haircut. She's a cow." % c["name"],
                     "info")
            self.render()
            return
        if "shears" not in self.p["tools"]:
            self.say("You'll need shears. Mabel sells them.", "info")
            self.render()
            return
        if not self.shear_ready(c):
            wait = SHEAR_DAYS - (self.st["day"] - c.get("shorn", -9))
            self.say("%s's fleece is still short. Give it %d more day%s." %
                     (c["name"], wait, "s" if wait > 1 else ""), "info")
            self.render()
            return
        if not self.spend("shears"):
            return
        c["shorn"] = self.st["day"]
        c["wool"] = c.get("wool", 0) + 1
        fine = random.random() < self.large_chance(c)
        self.give("fine wool" if fine else "wool")
        self.sound.play("snip")
        if fine:
            self.say("The fleece comes away soft as a cloud: %s's so well "
                     "kept it's the finest wool you've seen. (+1 fine "
                     "wool)" % c["name"], "heart")
            self.flash(*self.animal_spot(c, "barn"), "heart")
            self.end_turn(TOOL_COST)
            return
        vid = c.get("vid")
        if vid and not self.likes_change(vid, "sheepify"):
            self.say("You shear %s, who bleats indignantly through every "
                     "snip and then stands there, shivering and furious. "
                     "(+1 wool)" % c["name"], "good")
        elif vid:
            self.say("You shear %s, who holds very still and then skips "
                     "about, light as anything. (+1 wool)" % c["name"],
                     "good")
        else:
            self.say("Snip, snip, snip: the fleece comes away in one soft "
                     "piece, and %s trots off looking half the size. (+1 "
                     "wool)" % c["name"], "good")
        self.flash(*self.animal_spot(c, "barn"), "heart")
        self.end_turn(TOOL_COST)

    # ── Pets: cats curled up in your cabin, dogs out in the farmyard ──

    def pet_home(self, kind):
        return "cabin" if kind == "cat" else "valley"

    def pet_squares(self, area):
        """Where a pet may be: the cabin floor for cats, the farmyard by
        the cabin door for dogs."""
        a = self.areas[area]
        if area == "cabin":
            return [(x, y) for y in range(a.h) for x in range(a.w)
                    if self.can_stand(x, y, a) and a.grid[y][x] != "exit"
                    and (x, y) != a.entry]
        if area != "valley":
            return []
        dx, dy = door_of("cabin")
        return [(x, y) for y in range(dy + 1, dy + 6)
                for x in range(dx - 5, dx + 6)
                if (x, y) != (dx, dy + 1) and (x, y) not in self.door_at
                and self.can_stand(x, y, a)]

    def pet_at(self, area, x, y):
        for i, c in enumerate(self.st.get("pets", ())):
            if c["where"] == area and (c["x"], c["y"]) == (x, y):
                return i
        return None

    def free_pet_square(self, area):
        here = self.pos() if self.area and self.area.key == area else None
        busy = {(n.x, n.y) for n in self.npcs.values()
                if n.where == area and not n.hidden}
        free = [sq for sq in self.pet_squares(area)
                if self.pet_at(area, *sq) is None and sq != here and
                sq not in busy]
        return random.choice(free) if free else None

    def add_pet(self, kind):
        used = {c["name"] for c in self.st["pets"]}
        pool = CAT_NAMES if kind == "cat" else DOG_NAMES
        names = [n for n in pool if n not in used] or pool
        where = self.pet_home(kind)
        x, y = self.free_pet_square(where) or self.pet_squares(where)[0]
        c = {"name": random.choice(names), "kind": kind,
             "colour": random.choice(CAT_COLOURS if kind == "cat" else
                                     DOG_COLOURS),
             "where": where, "x": x, "y": y, "petted": -1,
             "day": self.st["day"], "love": 100}
        self.st["pets"].append(c)
        if self.area and self.area.key == where:
            self.render()
        return c

    def pet_minute(self, area):
        pets = [c for c in self.st.get("pets", ()) if c["where"] == area]
        if not pets:
            return
        ok = set(self.pet_squares(area))
        busy = {(n.x, n.y) for n in self.npcs.values()
                if n.where == area and not n.hidden}
        for c in pets:
            if (c["x"], c["y"]) not in ok:          # built over, say
                sq = self.free_pet_square(area)
                if sq:
                    c["x"], c["y"] = sq
                continue
            if random.random() > (0.06 if c["kind"] == "cat" else 0.15):
                continue
            dx, dy = random.choice(DIRS)
            x, y = c["x"] + dx, c["y"] + dy
            if (x, y) in ok and (x, y) not in busy and \
                    self.pet_at(area, x, y) is None and (x, y) != self.pos():
                c["x"], c["y"] = x, y

    def pet_menu(self, i):
        c = self.st["pets"][i]
        age = self.st["day"] - c.get("day", 0)
        items = [("Pet %s" % c["name"], lambda: self.pet_pet(i))]
        if not c.get("vid"):
            items.append(("Give her a new name",
                          lambda: self.start_naming(i, "pets")))
        items.append(("Squeeze past", lambda: self.pet_squeeze(i)))
        items.append(("Leave her be", lambda: None))
        self.open_menu("%s, your %s %s (%s; %s)" % (
            c["name"], c["colour"], c["kind"], "new today" if age == 0 else
            "%d day%s with you" % (age, "s" if age > 1 else ""),
            self.pet_hearts_text(c)), items)

    def pet_pet(self, i):
        c = self.st["pets"][i]
        cat = c["kind"] == "cat"
        self.flash(c["x"], c["y"], "heart")
        if c.get("petted") == self.st["day"]:
            self.say(("%s has had her fuss for today, and lets you know "
                      "with a flick of her tail." if cat else
                      "%s's had her fuss today, but wags anyway.") %
                     c["name"], "info")
            self.end_turn(1)
            return
        c["petted"] = self.st["day"]
        self.sound.play("meow" if cat else "bark")
        self.love_pet(c, PET_LOVE["pet"] + (
            PET_LOVE["bowl"] if self.bowl_full(c["where"]) else 0))
        vid = c.get("vid")
        if vid:
            self.say(("You stroke %s, who purrs and pushes into your hand. "
                      "She's never looked happier." if cat else
                      "You ruffle %s's ears; she wags so hard she sits "
                      "down. She's never looked happier.") % c["name"],
                     "good")
            self.befriend(vid, GIFT_POINTS["like"])
        else:
            self.say(random.choice(CAT_PETS if cat else DOG_PETS) %
                     c["name"], "good")
        self.end_turn(1)

    def pet_hearts(self, c):
        default = 100 if c.get("kind") in ("cat", "dog") else 300
        return min(5, c.get("love", default) // PET_HEART)

    def pet_hearts_text(self, c):
        h = self.pet_hearts(c)
        return "\u2665" * h + "\u2661" * (5 - h)

    def pick_egg(self, x, y):
        st = self.st
        st["eggs"].remove([x, y])
        large = [x, y] in st["large_eggs"]
        if large:
            st["large_eggs"].remove([x, y])
        self.give("large egg" if large else "egg")
        self.sound.play("pick")
        self.say("You pick up a big brown egg, the size of a fist. (+1 "
                 "large egg)" if large else "You pick up a fresh egg. Still "
                 "warm.", "good")

    def grazing_now(self, b):
        """Whether the animals of the coop or barn are out in the pasture
        right now: let out today, before dusk, in fair weather."""
        st = self.st
        return st.get("grazing", {}).get(b) == st["day"] and \
            st["minute"] < DUSK and self.season() != 3 and \
            st["weather"] not in ("rain", "storm", "snow")

    def is_out(self, c, b):
        return c.get("ox") is not None and self.grazing_now(b)

    def animal_spot(self, c, b):
        return (c["ox"], c["oy"]) if self.is_out(c, b) and \
            self.area.outdoor else (c["x"], c["y"])

    def pasture(self, b):
        """The grass in front of the coop or the barn where its animals
        graze."""
        dx, dy = door_of(b)
        a = self.areas["valley"]
        return [(x, y) for y in range(dy + 1, dy + 7)
                for x in range(dx - 5, dx + 6)
                if (x, y) != (dx, dy + 1) and (x, y) not in self.door_at
                and "%d,%d" % (x, y) not in self.st["soil"]
                and (x, y) != self.bowl_at("valley")
                and self.can_stand(x, y, a)]

    def grazer_at(self, x, y):
        for b, pen in (("coop", "chickens"), ("barn", "cows")):
            if self.grazing_now(b):
                for i, c in enumerate(self.st[pen]):
                    if (c.get("ox"), c.get("oy")) == (x, y):
                        return pen, i
        return None

    def graze_minute(self):
        busy = {(n.x, n.y) for n in self.npcs.values()
                if n.where == "valley" and not n.hidden}
        for b, pen in (("coop", "chickens"), ("barn", "cows")):
            if not self.grazing_now(b):
                continue
            ok = set(self.pasture(b))
            taken = {(c.get("ox"), c.get("oy")) for c in self.st[pen]}
            for c in self.st[pen]:
                if c.get("ox") is None or random.random() > 0.12:
                    continue
                dx, dy = random.choice(DIRS)
                x, y = c["ox"] + dx, c["oy"] + dy
                if (x, y) in ok and (x, y) not in taken and \
                        (x, y) not in busy and (x, y) != self.pos():
                    left = (c["ox"], c["oy"])
                    taken.discard(left)
                    c["ox"], c["oy"] = x, y
                    taken.add((x, y))
                    self.maybe_drop(left, "hen" if pen == "chickens"
                                    else "pat")

    def maybe_drop(self, at, kind):
        """Now and then, a grazing animal leaves something behind."""
        st = self.st
        k = "%d,%d" % at
        if random.random() < (0.02 if kind == "pat" else 0.012) and \
                len(st["droppings"]) < DROPPINGS and \
                k not in st["droppings"] and not self.thing_at(*at):
            st["droppings"][k] = kind

    def scoop(self, k):
        """Scoop up a dropping from the next square: fertilizer."""
        kind = self.st["droppings"].pop(k)
        self.give("fertilizer")
        self.sound.play("pick")
        self.say(random.choice(SCOOPS[kind]) + " (+1 fertilizer)", "good")
        self.end_turn(1)

    def top_up_troughs(self):
        """The silo keeps the troughs filled: one hay for every animal."""
        st = self.st
        for b, pen in (("coop", "chickens"), ("barn", "cows")):
            need = len(st[pen]) - st["trough"].get(b, 0)
            n = min(max(0, need), st["hay"])
            if n:
                st["hay"] -= n
                st["trough"][b] = st["trough"].get(b, 0) + n

    def trough_menu(self, b):
        """The feed trough in the coop or the barn: hay, and the door to
        the pasture."""
        st = self.st
        self.top_up_troughs()
        pen = "chickens" if b == "coop" else "cows"
        herd = len(st[pen])
        inside = st["trough"].get(b, 0)
        have = self.p["items"].get("hay", 0)
        items = []
        if have and inside < herd:
            items.append(("Put in hay (have %d)" % have,
                          lambda: self.fill_trough(b)))
        if self.grazing_now(b):
            items.append(("Call them back in", lambda: self.call_in(b)))
        elif herd:
            items.append(("Let them out to graze", lambda: self.let_out(b)))
        items.append(("Leave it", lambda: None))
        self.open_menu("The feed trough: %d hay in it for %d %s%s. %s" % (
            inside, herd, "hen" if pen == "chickens" else "animal",
            "" if herd == 1 else "s",
            "The silo keeps it topped up (%d hay left in it)." % st["hay"]
            if self.silo_room() else
            "No silo: what's here is all they get, unless they graze."),
            items)

    def fill_trough(self, b):
        st = self.st
        pen = "chickens" if b == "coop" else "cows"
        n = min(self.p["items"].get("hay", 0),
                len(st[pen]) - st["trough"].get(b, 0))
        if n <= 0:
            return
        self.take("hay", n)
        st["trough"][b] = st["trough"].get(b, 0) + n
        self.sound.play("pick")
        self.say("You fork %d hay into the trough." % n, "good")
        self.end_turn(2)

    def let_out(self, b):
        """Open the doors: the animals spend the day in the pasture,
        happier for it, and come in by themselves at dusk."""
        st = self.st
        why = ("Nothing grazes in the snow. They'll need hay this winter."
               if self.season() == 3 else
               "Not in this weather. They'd rather stay in the dry."
               if st["weather"] in ("rain", "storm", "snow") else
               "It's nearly dusk. Let them out in the morning."
               if st["minute"] >= DUSK - 60 else None)
        if why:
            self.say(why, "info")
            self.render()
            return
        pen = "chickens" if b == "coop" else "cows"
        spots = self.pasture(b)
        random.shuffle(spots)
        for c, (x, y) in zip(st[pen], spots):
            c["ox"], c["oy"] = x, y
        st["grazing"][b] = st["day"]
        self.sound.play("door")
        self.say("You prop the %s doors open, and out they %s into the "
                 "sunshine. They'll be in by themselves at dusk." % (
                     b, "trot, clucking," if pen == "chickens" else
                     "amble, one by one,"), "good")
        self.end_turn(2)

    def call_in(self, b):
        st = self.st
        st["grazing"].pop(b, None)
        for c in st["chickens" if b == "coop" else "cows"]:
            c.pop("ox", None)
            c.pop("oy", None)
        self.say("You call them in, and in they come.", "info")
        self.end_turn(2)

    def farm_love(self, c, n, quiet=False):
        """A farm animal's happiness, up or down; a word when it grows a
        heart."""
        before = self.pet_hearts(c)
        c["love"] = max(0, min(5 * PET_HEART, c.get("love", 300) + n))
        if not quiet and self.pet_hearts(c) > before:
            self.say("%s is happier than ever. (%s)" % (
                c["name"], self.pet_hearts_text(c)), "heart")

    def large_chance(self, c):
        """How likely a happy animal is to give something special."""
        return max(0, self.pet_hearts(c) - 2) * 0.2

    def feed_animals(self):
        """Overnight: who grazed, who ate hay from the trough or the silo,
        who went hungry, and who was petted; happiness to match."""
        st = self.st
        hungry = 0
        for b, pen in (("coop", "chickens"), ("barn", "cows")):
            grazed = st["grazing"].get(b) == st["day"]
            for c in st[pen]:
                love = 0
                if grazed and c.get("ox") is not None:
                    love += FARM_LOVE["grazed"]
                    ate = True
                elif st["trough"].get(b, 0) > 0 or (
                        self.top_up_troughs() or st["trough"].get(b, 0)):
                    st["trough"][b] -= 1
                    ate = True
                else:
                    ate = False
                    hungry += 1
                c["hungry"] = not ate
                love += FARM_LOVE["fed"] if ate else FARM_LOVE["hungry"]
                if c.get("petted") != st["day"]:
                    love += FARM_LOVE["unpetted"]
                self.farm_love(c, love, quiet=True)
                c.pop("ox", None)
                c.pop("oy", None)
        self.top_up_troughs()                   # ready for tomorrow
        if hungry:
            self.say("%d of your animals went hungry overnight. Put hay in "
                     "the trough, keep the silo stocked, or let them out to "
                     "graze." % hungry, "bad")

    def love_pet(self, c, n):
        """More (or less) affection; a word when she gains a heart."""
        before = self.pet_hearts(c)
        c["love"] = max(0, min(5 * PET_HEART, c.get("love", 100) + n))
        if self.pet_hearts(c) > before:
            self.say("%s adores you a little more. (%s)" % (
                c["name"], self.pet_hearts_text(c)), "heart")

    def bowl_at(self, area):
        """Where the pets' water bowl sits: by the cabin door inside for
        the cats, and out in the farmyard for the dogs."""
        if area == "cabin":
            return (4, 5)
        if area == "valley":
            dx, dy = door_of("cabin")
            return (dx - 1, dy + 1)
        return None

    def bowl_shown(self, area):
        return any(c["where"] == area for c in self.st.get("pets", ()))

    def bowl_full(self, area):
        return self.st.get("bowls", {}).get(area) == self.st["day"]

    def fill_bowl(self, area):
        p = self.p
        if self.bowl_full(area):
            self.say("The water bowl's already full.", "info")
            self.render()
            return
        if p["water"] <= 0:
            self.say("The can's empty. Fill it at the well or any water.",
                     "bad")
            return
        p["water"] -= 1
        self.st["bowls"][area] = self.st["day"]
        self.sound.play("water")
        self.say("You fill the %s' water bowl. Fresh water makes a fuss go "
                 "further today." % ("cats" if area == "cabin" else "dogs"),
                 "good")
        self.end_turn(1)

    def pet_mornings(self):
        """Overnight: pets you didn't pet sulk a little; pets who adore
        you leave you something."""
        st = self.st
        for c in st.get("pets", ()):
            if c.get("petted") != st["day"] - 1:
                c["love"] = max(0, c.get("love", 100) - PET_LOVE["neglect"])
                c["unpetted"] = c.get("unpetted", 0) + 1
                if c["unpetted"] == 3:
                    self.say("%s is sulking. Nobody's petted her in days." %
                             c["name"], "bad")
            else:
                c["unpetted"] = 0
            h = self.pet_hearts(c)
            if h >= 2 and random.random() < h * 0.08:
                self.pet_gift(c)

    def pet_gift(self, c):
        """A present from a devoted pet: a cat leaves it by your bed, a
        dog digs it up in the farmyard."""
        season = self.season()
        if c["kind"] == "cat":
            r = random.random()
            if r < 0.35:
                item = "feather"
            elif r < 0.6:
                item = random.choice(FISH["river"][season][:2])
            elif r < 0.85:
                item = "mouse"
            else:
                item = random.choice([f[0] for f in FORAGE[season]])
            self.give(item)
            self.say(random.choice(CAT_GIFTS).replace(
                "{who}", c["name"]).replace("{it}", an(item)), "heart")
            return
        r = random.random()
        if r < 0.3:
            item = "old bone"
        elif r < 0.65:
            item = random.choice([f[0] for f in FORAGE[season]])
        elif r < 0.9:
            gold = random.randint(4, 20) * 10
            self.p["gold"] += gold
            self.say("%s digs up a little leather purse in the farmyard and "
                     "drops it at your feet. There's %dg inside!" % (
                         c["name"], gold), "gold")
            return
        else:
            item = random.choice(("old coin", "silver ring"))
        self.give(item)
        self.say(random.choice(DOG_GIFTS).replace(
            "{who}", c["name"]).replace("{it}", an(item)), "heart")

    def pet_squeeze(self, i):
        """Swap squares with a pet in your way (never into a doorway)."""
        c = self.st["pets"][i]
        here = self.pos()
        ok = self.pet_squares(c["where"])
        to = here if here in ok else self.free_pet_square(c["where"])
        if to is None:
            self.say("There's no room to get round %s." % c["name"], "info")
            self.render()
            return
        x, y = c["x"], c["y"]
        c["x"], c["y"] = to
        if c.get("vid"):
            n = self.npcs[c["vid"]]
            n.x, n.y = to
        self.st["pos"] = [x, y]
        self.say(("%s slinks between your feet and you step over her." if
                  c["kind"] == "cat" else
                  "%s bounces out of your way, delighted to be noticed.") %
                 c["name"], "info")
        self.end_turn(WALK_COST)

    def home_pet(self, vid):
        """A villager-cat or -dog led home: if she likes the life, she's
        your pet now; if not, she slips the leash and runs back to her
        own."""
        st = self.st
        n = self.npcs[vid]
        kind = self.beast(vid)
        name = VILLAGERS[vid]["short"]
        if not self.likes_change(vid, kind + "ify"):
            st["leashed"] = None
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            dx, dy = door_of("cabin")
            n.where = "valley"
            n.x, n.y = self.free_spot("valley", dx, dy + 2, taken)
            n.goal, n.path, n.stuck, n.visit = None, [], 0, None
            self.sound.play("meow" if kind == "cat" else "bark")
            self.say("%s the %s takes one look at your cabin, slips the "
                     "leash, and bolts out of the door, back to her own "
                     "day. She doesn't want to be anyone's pet." % (
                         name, kind), "bad")
            return
        if len(st["pets"]) >= PET_ROOM:
            self.say("You've no room for another pet. %s waits by the door "
                     "with you." % name, "info")
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            n.where = "cabin"
            n.x, n.y = self.free_spot("cabin", *self.pos(), taken)
            return
        st["leashed"] = None
        where = self.pet_home(kind)
        x, y = self.free_pet_square(where) or self.pet_squares(where)[0]
        st["pets"].append({"name": name, "kind": kind,
                           "colour": self.beast_colour(vid, kind),
                           "where": where, "x": x, "y": y, "petted": -1,
                           "day": st["day"], "vid": vid, "love": 400})
        n.where, n.x, n.y, n.hidden = where, x, y, True
        n.goal, n.path, n.visit = None, [], None
        self.sound.play("meow" if kind == "cat" else "bark")
        self.say(("You unclip the leash. %s the cat explores every corner, "
                  "picks the warmest spot, and curls up with a sigh. She's "
                  "your cat now." if kind == "cat" else
                  "You unclip the leash. %s the dog dashes round the cabin, "
                  "then out to the farmyard to guard it. She's your dog "
                  "now.") % name, "quest")
        self.render()

    def cooped(self, vid):
        return any(c.get("vid") == vid for c in self.st.get("chickens", ()))

    def leash(self, n):
        """Clip the leash on a villager turned hen."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        if not (self.chicken(vid) or self.hoofed(vid)):
            self.say("You can't put a leash on %s. Well, you could. You "
                     "shouldn't." % name, "info")
        elif self.statue(vid):
            self.say("She's solid gold. She isn't going anywhere.", "info")
        elif st.get("leashed"):
            self.say("You've only the one leash, and %s is on it." %
                     VILLAGERS[st["leashed"]]["short"], "info")
        elif st.get("mlead"):
            self.say("You've only the one leash, and the %s from the mine "
                     "is on it." % LEADS_TO[st["mlead"]["spell"]][0], "info")
        else:
            st["leashed"] = vid
            n.goal, n.path, n.stuck, n.visit = None, [], 0, None
            if self.is_sheep(vid):
                self.say("You clip the leash on. %s the sheep %s" % (
                    name, "bleats happily and skips after you." if
                    self.likes_change(vid, "sheepify") else "bleats "
                    "crossly, but trots along. She has no choice."), "good")
            elif self.pet_kind(vid):
                kind = self.beast(vid)
                self.say("You clip the leash on. %s the %s %s" % (
                    name, kind, BEASTS[kind]["leash"][
                        0 if self.likes_change(vid, kind + "ify") else 1]),
                    "good")
            elif self.is_cow(vid):
                self.say("You clip the leash on. %s the cow %s" % (
                    name, "moos happily and plods after you." if
                    self.likes_change(vid, "cowify") else "lows crossly, "
                    "but plods along. She has no choice."), "good")
            else:
                self.say("You clip the leash on. %s the hen %s" % (
                    name, "clucks happily and trots after you." if
                    self.likes_change(vid, "chickenfy") else "clucks "
                    "furiously, but follows. She has no choice."), "good")
            self.end_turn(1)
            return
        self.render()

    def unleash(self, n, quiet=False):
        self.st["leashed"] = None
        n.goal, n.path, n.stuck = None, [], 0
        if not quiet:
            if self.pet_kind(n.vid):
                self.say(BEASTS[self.beast(n.vid)]["unleash"] %
                         VILLAGERS[n.vid]["short"], "info")
                self.end_turn(1)
                return
            self.say(("You unclip the leash. %s the cow flicks her tail "
                      "and ambles off about her day." if self.is_cow(n.vid)
                      else "You unclip the leash. %s the sheep gives a "
                      "little skip and trots off about her day." if
                      self.is_sheep(n.vid) else "You unclip the leash. %s the hen shakes out her "
                      "feathers and potters off about her day.") %
                     VILLAGERS[n.vid]["short"], "info")
            self.end_turn(1)

    def lead(self, before):
        """After you move, the hen on your leash comes too: into your old
        square, or in beside you when you change places.  Into the coop,
        and she's one of your hens."""
        st = self.st
        vid = st.get("leashed")
        n = self.npcs[vid]
        if not (self.chicken(vid) or self.hoofed(vid)) or self.kept(vid):
            st["leashed"] = None
            return
        if self.statue(vid):
            st["leashed"] = None
            self.say("The leash slips off the golden %s." % (
                self.beast(vid) or "hen"), "info")
            return
        area, pos = before
        here = self.area.key
        if here == "coop" and area != "coop" and self.chicken(vid):
            self.coop_hen(vid)
            return
        if here == "barn" and area != "barn" and self.barn_beast(vid):
            self.barn_cow(vid)
            return
        if here == "cabin" and area != "cabin" and self.pet_kind(vid):
            self.home_pet(vid)
            return
        if here not in BUILDINGS and here != "valley":
            return                      # she waits outside the outhouse
        if here != area and here == "coop" and self.hoofed(vid):
            self.say("%s won't go in among the hens. She waits outside." %
                     VILLAGERS[vid]["short"], "info")
            return
        if n.where == "valley" and here == "coop" and self.hoofed(vid):
            return
        if n.where != here or area != here:
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            x, y = self.pos()
            n.where = here
            n.x, n.y = self.free_spot(here, x, y, taken)
        elif tuple(self.pos()) != pos:
            n.x, n.y = pos
        n.goal, n.path = (n.where, n.x, n.y), []

    def coop_hen(self, vid):
        """A villager-hen led into the coop: one of your hens now, laying
        and petted with the rest, till chickenfy turns her back."""
        st = self.st
        n = self.npcs[vid]
        name = VILLAGERS[vid]["short"]
        if len(st["chickens"]) >= COOP_ROOM:
            self.say("The coop's full. %s peers in, clucks, and waits by "
                     "the door with you." % name, "info")
            taken = {(m.where, m.x, m.y) for m in self.npcs.values()
                     if m is not n}
            n.where = "coop"
            n.x, n.y = self.free_spot("coop", *self.pos(), taken)
            return
        st["leashed"] = None
        x, y = self.free_coop_square() or self.coop_squares()[0]
        st["chickens"].append({"name": name, "colour": self.hen_colour(vid),
                               "x": x, "y": y, "petted": -1,
                               "day": st["day"], "eggs": 0, "vid": vid})
        n.where, n.x, n.y, n.hidden = "coop", x, y, True
        n.goal, n.path, n.visit = None, [], None
        self.say("You unclip the leash, and %s the hen hops down into the "
                 "straw with the others. She's one of your hens now. (%s)" % (
                     name, "She looks delighted." if self.likes_change(
                         vid, "chickenfy") else "She does not look pleased."),
                 "quest")
        self.render()

    def uncoop(self, vid):
        """Out of the coop: no longer one of your hens."""
        st = self.st
        n = self.npcs[vid]
        for c in list(st["chickens"]):
            if c.get("vid") == vid:
                st["chickens"].remove(c)
                n.where, n.x, n.y = "coop", c["x"], c["y"]
        n.hidden = False

    def hen_colour(self, vid):
        """The hen somebody becomes, by the colour of their hair."""
        hair = VILLAGERS[vid]["look"].get("hair", "")
        return {"#1e1a1a": "black", "#4a4040": "black",
                "#5a3a1e": "brown", "#8a4a22": "brown", "#a83a1e": "brown",
                "#d0502a": "brown", "#e8c870": "speckled",
                "#9a9a9a": "speckled", "#eeeeee": "white",
                "#e4641c": "brown", "#221a18": "black",
                "#2a1a14": "black"}.get(hair,
                                                              "white")

    def look_of(self, vid):
        look = VILLAGERS[vid]["look"]
        if self.maid(vid):
            b = self.st.get("bikinis", {}).get(vid)
            colour = self.st.get("uniform", {}).get(vid)
            base = uniform_look(look, colour) if colour else maid_look(look)
            if b:
                return bikini_look(base, *b)
            w = self.st.get("wear", {}).get(vid)
            if w:
                return outfit_look(base, *w)
            return base
        return swap_look(look) if self.swapped(vid) else look

    def display_name(self, vid):
        name = VILLAGERS[vid]["name"]
        if self.swapped(vid) and not self.maid(vid):
            for a, b in (("Granny", "Grandpa"),):
                name = name.replace(a, b) if a in name else name.replace(
                    b, a)
        return name

    def genderswap(self, n):
        """The genderswap spell: the other sex, sprite and portrait; again,
        and back as they were.  They like it or they don't, and say so,
        and it shows in how they feel about you."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        back = self.swapped(vid)
        if back:
            st["swapped"].remove(vid)
        else:
            st["swapped"].append(vid)
        self.portraits = {}
        if self.statue(vid):
            self.say("The golden statue of %s ripples and shifts shape. "
                     "It doesn't seem to mind. It's a statue." % name,
                     "gold")
            self.end_turn(TOOL_COST)
            return
        if self.talk:
            self.end_talk()
        likes = self.likes_change(vid)
        lines = SWAP_LINES[vid]
        flags = st["flags"]
        if not back:
            self.say("Pink sparks fizz round %s, and when they clear, %s "
                     "is the other sex entirely." % (name, name), "quest")
            line = lines[0] if likes else lines[1]
            if likes:
                pts = 0 if "swapliked:" + vid in flags else 150
                flags.append("swapliked:" + vid)
            else:
                pts = -200
        else:
            self.say("Pink sparks again, and %s is back as they were." %
                     name, "quest")
            line = lines[3] if likes else lines[2]
            if likes:
                pts = -80
            else:
                pts = 0 if "swapfixed:" + vid in flags else 120
                flags.append("swapfixed:" + vid)
        self.talk = {"v": vid, "mode": "kw", "expr": "surprised",
                     "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.friend(vid)["met"] = True
        self.speak(vid, line)
        if pts:
            self.befriend(vid, pts)
            self.say("(%s %s.)" % (name, "likes you more for it" if pts > 0
                                   else "is upset with you"),
                     "heart" if pts > 0 else "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    # ── The chicken coop ──

    def build_coop(self):
        self.build_on_farm("coop")

    def build_on_farm(self, key):
        """Put up a farm building you've paid for, clearing whatever's
        there."""
        p, st = self.p, self.st
        if key in p["built"]:
            return
        p["built"].append(key)
        v = self.areas["valley"]
        x0, y0, w, h = BUILDINGS[key][:4]
        put_building(v.grid, v.labels, key)
        dx, dy = door_of(key)
        for y in range(y0, VH):
            for x in range(x0, x0 + w):
                if y >= y0 + h and (x != dx or v.grid[y][x] != "path"):
                    continue
                k = "%d,%d" % (x, y)
                for d in (st["debris"], st["soil"], st["forage"]):
                    d.pop(k, None)
                if k in st["sprinklers"]:
                    st["sprinklers"].remove(k)
                    self.give("sprinkler")
                ft = st["orchard"].pop(k, None)
                if ft:
                    self.give(ft["kind"] + " sapling")
                m = st["machines"].pop(k, None)
                if m:
                    self.give(m["kind"])
                    if m.get("out") and m["kind"] != "beehive":
                        self.give(m["out"])
            if y >= y0 + h and v.grid[y][dx] != "path":
                break
        self.door_at[(dx, dy)] = key
        if self.area is v:
            self.layout()

    def coop_squares(self):
        a = self.areas["coop"]
        return [(x, y) for y in range(a.h) for x in range(a.w)
                if a.grid[y][x] == "straw"]

    def chicken_at(self, x, y):
        out = self.grazing_now("coop")
        for i, c in enumerate(self.st["chickens"]):
            if (c["x"], c["y"]) == (x, y) and not (out and c.get("ox")
                                                   is not None):
                return i
        return None

    def free_coop_square(self, eggs_too=False):
        here = self.pos() if self.area and self.area.key == "coop" else None
        free = [sq for sq in self.coop_squares()
                if self.chicken_at(*sq) is None and sq != here and
                (not eggs_too or list(sq) not in self.st["eggs"])]
        return random.choice(free) if free else None

    def add_chicken(self):
        used = {c["name"] for c in self.st["chickens"]}
        names = [n for n in HEN_NAMES if n not in used] or HEN_NAMES
        x, y = self.free_coop_square() or self.coop_squares()[0]
        c = {"name": random.choice(names), "colour": random.choice(
            HEN_COLOURS), "x": x, "y": y, "petted": -1,
            "day": self.st["day"], "eggs": 0}
        self.st["chickens"].append(c)
        if self.area.key == "coop":
            self.render()
        return c

    def chicken_minute(self):
        a = self.areas["coop"]
        for i, c in enumerate(self.st["chickens"]):
            if random.random() > 0.2 or self.is_out(c, "coop"):
                continue
            dx, dy = random.choice(DIRS)
            x, y = c["x"] + dx, c["y"] + dy
            if a.inside(x, y) and a.grid[y][x] == "straw" and \
                    self.chicken_at(x, y) is None and (x, y) != self.pos():
                c["x"], c["y"] = x, y

    def chicken_menu(self, i):
        c = self.st["chickens"][i]
        age = self.st["day"] - c.get("day", 0)
        self.open_menu("%s, a %s hen %s%s (%s; %d egg%s laid)" % (
            c["name"], c["colour"], self.pet_hearts_text(c),
            " (hungry)" if c.get("hungry") else "",
            "new today" if age == 0 else
            "%d day%s with you" % (age, "s" if age > 1 else ""),
            c.get("eggs", 0), "" if c.get("eggs", 0) == 1 else "s"), [
            ("Pet %s" % c["name"], lambda: self.pet_chicken(i))] + (
            [] if c.get("vid") else
            [("Give her a new name", lambda: self.start_naming(i))]) +
            [("Squeeze past", lambda: self.edge_past(i, "chickens")),
             ("Leave her be", lambda: None)])

    def edge_past(self, i, pen):
        """Swap squares with a hen or cow standing in your way."""
        c = self.st[pen][i]
        if self.area.outdoor and c.get("ox") is not None:
            here = self.pos()
            if here in self.pasture("coop" if pen == "chickens" else
                                    "barn"):
                c["ox"], c["oy"], self.st["pos"] = here[0], here[1], [
                    c["ox"], c["oy"]]
                self.say("%s steps aside, chewing, and you get by." %
                         c["name"], "info")
                self.end_turn(WALK_COST)
            else:
                self.say("There's no room to get round %s." % c["name"],
                         "info")
                self.render()
            return
        squares = self.coop_squares() if pen == "chickens" else \
            self.barn_squares()
        here = self.pos()
        entry = self.areas["coop" if pen == "chickens" else "barn"].entry
        to = here if here in squares and here != entry else (
            self.free_coop_square() if pen == "chickens" else
            self.free_barn_square())
        if to is None:
            self.say("There's no room to get round %s." % c["name"], "info")
            self.render()
            return
        x, y = c["x"], c["y"]
        c["x"], c["y"] = to
        self.st["pos"] = [x, y]
        if c.get("vid") and c["vid"] in self.npcs:
            n = self.npcs[c["vid"]]
            n.x, n.y = to
        if pen == "chickens":
            self.say(random.choice((
                "You scoop %s up, step past and set her down behind you. "
                "She clucks, offended.",
                "%s flaps aside with a squawk and you slip past.")) %
                c["name"], "info")
            if [x, y] in self.st["eggs"]:
                self.pick_egg(x, y)
        else:
            self.say(random.choice((
                "You put a shoulder to %s and lean. Eventually, grudgingly, "
                "she shuffles round and you squeeze past.",
                "\"Shift over, %s.\" She does, with a long-suffering moo.")) %
                c["name"], "info")
        self.end_turn(WALK_COST)

    def pet_chicken(self, i):
        c = self.st["chickens"][i]
        self.flash(*self.animal_spot(c, "coop"), "heart")
        if c.get("petted") != self.st["day"]:
            self.farm_love(c, FARM_LOVE["pet"])
        if c.get("petted") == self.st["day"]:
            self.say("%s has had her fuss for today, and lets you know "
                     "it." % c["name"], "info")
        elif c.get("vid"):
            c["petted"] = self.st["day"]
            vid = c["vid"]
            if self.likes_change(vid, "chickenfy"):
                self.say("You stroke %s's feathers. She clucks happily and "
                         "leans into your hand." % c["name"], "good")
                self.befriend(vid, GIFT_POINTS["like"])
            else:
                self.say("You stroke %s's feathers. She puts up with it, "
                         "glaring." % c["name"], "info")
        else:
            c["petted"] = self.st["day"]
            self.say(random.choice(HEN_PETS) % c["name"], "good")
        self.end_turn(1)

    def start_naming(self, i, pen="chickens"):
        """Rename a hen or a cow: the talk bar asks, and Return settles
        it."""
        self.naming = i
        self.naming_pen = pen
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="New name:" if pen == "kids" else
                           "Her new name:")
        self.entry.delete(0, "end")
        self.entry.insert(0, self.st[pen][i]["name"])
        self.entry.select_range(0, "end")
        self.entry.focus_set()
        self.say("Type a new name for %s and press Return (Esc keeps the "
                 "old one)." % self.st[pen][i]["name"], "info")
        self.render()

    def finish_naming(self, text):
        i = self.naming
        name = " ".join(text.split())[:16]
        if i is not None and name:
            c = self.st[getattr(self, "naming_pen", "chickens")][i]
            old, c["name"] = c["name"], name
            if old != name:
                self.say("%s is now called %s. %s seems to approve." % (
                    old, name, "He" if c.get("sex") == "M" else "She"),
                    "good")
        self.end_naming()

    def end_naming(self):
        self.naming = None
        self.prompt.config(text="Ask about:")
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        self.render()

    def statue_bump(self, n):
        """Walking into a statue: a polish, a rub for luck...  and walk
        into the same one again straight away to squeeze past it.  A
        plain statue (not a golden hen, say) you can pick up."""
        if self.transformed(n.vid) == "statue" and not self.leashed(n.vid):
            name = VILLAGERS[n.vid]["short"]
            self.open_menu("The statue of %s" % name, [
                ("Polish it", lambda: self.polish_statue(n)),
                ("Squeeze past", lambda: (
                    self.squeeze_past(n), self.say(
                        "You squeeze past the statue of %s, breathing in." %
                        name, "info"), self.end_turn(1))),
                ("Pick it up (%d energy)" % STATUE_HEFT,
                 lambda: self.lift_statue(n)),
                ("Leave it", lambda: None)])
            return
        here = (n.vid, self.area.key, n.x, n.y, self.pos())
        if getattr(self, "last_statue", None) == here and \
                self.squeeze_past(n):
            self.last_statue = None
            self.say("You squeeze past the statue of %s, breathing in." %
                     VILLAGERS[n.vid]["short"], "info")
        else:
            self.last_statue = here
            self.say(random.choice(STATUE_PHRASES).replace(
                "{who}", VILLAGERS[n.vid]["short"]) +
                " (Walk into it again to squeeze past.)", "info")
        self.end_turn(1)

    def polish_statue(self, n):
        self.say(random.choice(STATUE_PHRASES).replace(
            "{who}", VILLAGERS[n.vid]["short"]), "info")
        self.end_turn(1)

    def squeeze_past(self, n):
        """Trade places with somebody standing next to you, so nobody can
        block a doorway for good: True if you did."""
        x, y = self.pos()
        if n.where != self.area.key or abs(n.x - x) + abs(n.y - y) != 1:
            return False
        n.x, n.y, self.st["pos"] = x, y, [n.x, n.y]
        n.path, n.stuck = [], 0
        if self.area.outdoor:
            self.step_on(*self.pos())
        return True

    # ── Fruit trees ──

    def fruit_season(self, t):
        return self.season() == FRUIT_TREES[t["kind"]][0]

    def tree_stage(self, t):
        age = self.st["day"] - t.get("planted", -999)
        return "s" if age < 7 else "y" if age < FRUIT_TREE_DAYS else "m"

    def fruit_left(self, t):
        return t.get("fruit", 0) if self.fruit_season(t) else 0

    def fruit_tree_tile(self, t):
        stage = self.tree_stage(t)
        if stage == "m" and self.fruit_left(t):
            stage = "f"
        return "ft_%s_%s" % (t["kind"], stage)

    def plant_sapling(self, k, kind):
        st = self.st
        st["soil"].pop(k, None)
        st["orchard"][k] = {"kind": kind, "planted": st["day"], "fruit": 0}
        self.take(kind + " sapling")
        self.sound.play("pick")
        self.say("You plant the %s sapling and firm the earth round it. "
                 "In %d days it'll be grown, and every %s after that it'll "
                 "bear %s." % (kind, FRUIT_TREE_DAYS,
                               SEASONS[FRUIT_TREES[kind][0]].lower(),
                               plural(kind, 2)), "good")
        self.end_turn(TOOL_COST)

    def fruit_tree_bump(self, k):
        """Walking into a fruit tree you planted: pick it, or see how it's
        coming along."""
        t = self.st["orchard"].get(k)
        if not t:
            return
        self.walking = None
        kind = t["kind"]
        n = self.fruit_left(t)
        if n:
            t["fruit"] = 0
            self.give(kind, n)
            self.sound.play("pick")
            x, y = map(int, k.split(","))
            self.flash(x, y, "sparkle")
            self.say("You pick %d %s." % (n, plural(kind, n)), "good")
            self.end_turn(2)
            return
        stage = self.tree_stage(t)
        bears = SEASONS[FRUIT_TREES[kind][0]].lower()
        if stage != "m":
            left = FRUIT_TREE_DAYS - (self.st["day"] - t["planted"])
            self.say("Your %s %s is coming along. Grown in %d day%s, then "
                     "%s every %s." % (kind, "sapling" if stage == "s"
                                      else "tree", left,
                                      "" if left == 1 else "s",
                                      plural(kind, 2), bears), "info")
        elif self.fruit_season(t):
            self.say("No %s left on this tree today. More tomorrow." %
                     plural(kind, 2), "info")
        elif self.season() == 0:
            self.say("Your %s tree is in blossom, humming with bees. "
                     "%s come in %s." % (kind, cap(plural(kind, 2)), bears),
                     "info")
        elif self.season() == 3:
            self.say("Your %s tree is bare and sleeping till spring." % kind,
                     "info")
        else:
            self.say("Your %s tree is in full leaf. %s come in %s." % (
                kind, cap(plural(kind, 2)), bears), "info")
        self.render()

    def fell_fruit_tree_menu(self, k):
        t = self.st["orchard"].get(k)
        if not t:
            return
        self.open_menu("Chop down your %s %s?" % (
            t["kind"], "sapling" if self.tree_stage(t) == "s" else "tree"),
            [("Yes, chop it down", lambda: self.fell_fruit_tree(k)),
             ("No, leave it", lambda: None)])

    def fell_fruit_tree(self, k):
        t = self.st["orchard"].pop(k, None)
        if not t or not self.spend("axe"):
            return
        wood = {"s": 1, "y": 4, "m": 8}[self.tree_stage(t)]
        self.give("wood", wood)
        self.sound.play("chop")
        self.say("You chop down the %s tree. (+%d wood)" % (t["kind"], wood),
                 "info")
        self.end_turn(TOOL_COST)

    def pick_villager_fruit(self, n, t):
        """Picking fruit off somebody the wand made a fruit tree."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        kind = t["kind"]
        got = t["fruit"]
        t["fruit"] = 0
        self.give(kind, got)
        self.sound.play("pick")
        self.flash(n.x, n.y, "sparkle")
        what = "%d %s" % (got, plural(kind, got))
        if self.likes_change(vid, "treeify"):
            self.say("You pick %s from %s, who giggles and rustles: \"Ooh, "
                     "that tickles! Take them, take them!\"" % (what, name),
                     "good")
        else:
            self.say("You pick %s from %s. \"Hey! Those are MINE! I grew "
                     "those!\" creaks %s." % (what, name, name), "good")
            self.befriend(vid, -20, quiet=True)
        self.paint_specials(scale=True)
        self.end_turn(2)

    # ── Machines ──

    def now_abs(self):
        """Minutes since the game began, carrying on past midnight."""
        return self.st["day"] * 1440 + self.st["minute"]

    def machine_ready(self, m):
        if not m.get("out"):
            return False
        if m["kind"] == "beehive" and self.season() == 3:
            return False                        # the bees sleep in winter
        return self.now_abs() >= m["ready"]

    def machine_tile(self, m):
        return "m_" + m["kind"].replace(" ", "_") + (
            "_r" if self.machine_ready(m) else "")

    def place_machine(self, k, kind):
        st = self.st
        st["soil"].pop(k, None)
        m = {"kind": kind, "out": None, "ready": 0}
        if kind == "beehive":
            m["out"] = "honey"
            m["ready"] = (st["day"] + HIVE_DAYS) * 1440 + 360
        st["machines"][k] = m
        self.take(kind)
        self.sound.play("pick")
        self.say(MACHINE_PLACED[kind], "good")
        self.end_turn(TOOL_COST)

    def machine_inputs(self, kind):
        """What you could put in this machine now: (label, in, how many,
        out, minutes)."""
        have = self.p["items"]
        out = []
        for need, n, made, mins in MACHINES[kind]:
            if need in ("jam", "pickle"):
                for plain in (JAM_FRUIT if need == "jam" else PICKLE_VEG):
                    for c in [plain] + ["%s %s" % (q, plain)
                                        for q in QUALITY]:
                        if have.get(c, 0) >= n:
                            prod = plain + " jam" if need == "jam" else \
                                "pickled " + plain
                            out.append(("Make %s (1 %s, have %d)" % (
                                prod, c, have[c]), c, n, prod, mins))
            elif have.get(need, 0) >= n:
                out.append(("Make %s (%d %s, have %d)" % (
                    an(made) if made in ("wool scarf",) else made, n, need,
                    have[need]), need, n, made, mins))
        return out

    def silo_room(self):
        return SILO_HAY * sum(1 for m in self.st.get("machines", {}).values()
                              if m["kind"] == "silo")

    def silo_menu(self, k):
        st = self.st
        have = self.p["items"].get("hay", 0)
        room = self.silo_room()
        items = []
        if have and st["hay"] < room:
            items.append(("Put in your hay (%d)" % have,
                          lambda: self.fill_silo()))
        if room - SILO_HAY >= st["hay"]:
            items.append(("Pick it up", lambda: self.pick_up_machine(k)))
        items.append(("Leave it", lambda: None))
        self.open_menu("The silo: %d hay of %d. It feeds animals that "
                       "didn't graze, every night." % (st["hay"], room),
                       items)

    def fill_silo(self):
        st = self.st
        n = min(self.p["items"].get("hay", 0), self.silo_room() - st["hay"])
        if n <= 0:
            return
        self.take("hay", n)
        st["hay"] += n
        self.top_up_troughs()
        self.sound.play("pick")
        self.say("You fork %d hay into the silo. (%d of %d)" % (
            n, st["hay"], self.silo_room()), "good")
        self.end_turn(2)

    def machine_menu(self, k):
        m = self.st["machines"].get(k)
        if not m:
            return
        if m["kind"] == "silo":
            self.walking = None
            self.silo_menu(k)
            return
        kind = m["kind"]
        self.walking = None
        items = []
        title = cap(kind)
        if self.machine_ready(m):
            title += ": %s, ready!" % m["out"]
            items.append(("Take the %s" % m["out"],
                          lambda: self.collect_machine(k)))
        elif m.get("out"):
            if kind == "beehive" and self.season() == 3:
                title += ": the bees are huddled up for winter"
            else:
                left = m["ready"] - self.now_abs()
                days = m["ready"] // 1440 - self.st["day"]
                title += ": %s, %s" % (
                    "filling with honey" if kind == "beehive" else
                    "making %s" % m["out"],
                    "ready in about %d hour%s" % (
                        max(1, (left + 59) // 60), "" if left <= 60 else "s")
                    if m["ready"] % 1440 != 360 else
                    "ready by morning" if days <= 1 else
                    "ready in %d days" % days)
        else:
            choices = self.machine_inputs(kind)
            if choices:
                for label, need, n, made, mins in choices:
                    items.append((label, lambda a=(k, need, n, made, mins):
                                  self.load_machine(*a)))
            else:
                title += ": empty. It takes %s." % MACHINE_TAKES[kind]
        if not m.get("out") or kind == "beehive":
            items.append(("Pick it up", lambda: self.pick_up_machine(k)))
        items.append(("Leave it", lambda: None))
        self.open_menu(title, items)

    def load_machine(self, k, need, n, made, mins):
        st = self.st
        m = st["machines"].get(k)
        if not m or m.get("out") or self.p["items"].get(need, 0) < n:
            return
        self.take(need, n)
        m["out"] = made
        m["ready"] = (st["day"] + 1) * 1440 + 360 if mins is None else \
            self.now_abs() + mins
        self.sound.play("pick")
        self.say("You put %s in the %s. %s" % (
            "two fleeces of wool" if need == "wool" and n == 2 else
            measure(need), m["kind"],
            "It'll be ready by morning." if mins is None else
            "It'll be ready in about %d hours." % (mins // 60)), "info")
        self.end_turn(1)

    def collect_machine(self, k):
        st = self.st
        m = st["machines"].get(k)
        if not m or not self.machine_ready(m):
            return
        made = m["out"]
        self.give(made)
        self.sound.play("gold" if m["kind"] == "beehive" else "pick")
        x, y = map(int, k.split(","))
        self.flash(x, y, "sparkle")
        if m["kind"] == "beehive":
            m["ready"] = (st["day"] + HIVE_DAYS) * 1440 + 360
            self.say("You lift the lid, smoke the bees sleepy, and take a "
                     "comb of golden honey. (+1 honey)", "good")
        else:
            m["out"] = None
            self.say("You take %s from the %s. (+1 %s)" % (
                measure(made), m["kind"], made), "good")
        self.end_turn(1)

    def pick_up_machine(self, k):
        m = self.st["machines"].pop(k, None)
        if not m:
            return
        self.give(m["kind"])
        self.p["hand"] = m["kind"]
        self.say("You pick up the %s. Hold it and use it on open ground "
                 "to put it down again." % m["kind"], "info")
        self.end_turn(1)

    def spend(self, h):
        need = TOOL_ENERGY.get(h, 0)
        if need:
            need = max(1, need - self.lv(h))
        if self.p["energy"] < need:
            self.say("You're too tired to swing the %s. Eat something, or "
                     "go to bed." % h, "bad")
            return False
        self.p["energy"] -= need
        return True

    def use_tool_at(self, x, y):
        h = self.held()
        if h == "magic wand":
            self.start_aim()
            return
        if h in STATUE_OF:
            self.place_statue(x, y, h)
            return
        if self.area.key == "greenhouse":
            self.gh_tool(x, y, h)
            return
        a = self.area
        k = "%d,%d" % (x, y)
        if h == "milk pail" and a.key == "barn":
            i = self.cow_at(x, y)
            if i is not None:
                self.milk_cow(i)
            else:
                self.say("Use the pail on a cow or a sheep.", "info")
            return
        if h == "shears" and a.key == "barn":
            i = self.cow_at(x, y)
            if i is not None:
                self.shear(i)
            else:
                self.say("Use the shears on a sheep.", "info")
            return
        n = self.npc_at(x, y)
        if h == "shears" and n and self.is_sheep(n.vid) and \
                not self.leashed(n.vid):
            self.say("%s won't stand still for shearing out here. Lead her "
                     "into your barn." % VILLAGERS[n.vid]["short"], "info")
            return
        n = self.npc_at(x, y)
        if n and self.leashed(n.vid):
            self.unleash(n)
            return
        if n and h == "leash":
            self.leash(n)
            return
        if n and self.tree(n.vid) and h in ("watering can", "axe"):
            self.tend_tree(n, h)
            return
        if h == "watering can" and not n and self.bowl_shown(a.key) and \
                (x, y) == self.bowl_at(a.key):
            self.fill_bowl(a.key)
            return
        if not a.outdoor:
            n = self.npc_at(x, y)
            if n:
                self.start_talk(n)
            else:
                self.say("Not in here.", "info")
            return
        if not a.inside(x, y):
            return
        n = self.npc_at(x, y)
        if n:
            self.start_talk(n)
            return
        if k in self.st["droppings"]:
            self.scoop(k)
            return
        t = self.tile_at(x, y)
        th = self.thing_at(x, y)
        if th and th[0] == "crop" and self.ripe(th[1]):
            self.harvest(x, y)
            return
        if th and th[0] == "forage":
            self.step_on(x, y)
            self.end_turn(1)
            return
        if th and th[0] == "debris":
            self.clear_debris(x, y, th[1])
            return
        if th and th[0] == "machine":
            self.machine_menu(k)
            return
        if th and th[0] == "fruittree":
            if h == "axe":
                self.fell_fruit_tree_menu(k)
            else:
                self.fruit_tree_bump(k)
            return
        if t == "bin":
            self.ship_menu()
            return
        st, p = self.st, self.p
        if h == "watering can":
            if t in WATER or t in ("well", "fountain"):
                if t == "pond" and self.season() == 3:
                    self.say("The pond's frozen.", "info")
                    return
                p["water"] = p["can"]
                self.sound.play("water")
                self.say("You fill the watering can.", "info")
                self.end_turn(1)
            elif t == "soil":
                s = st["soil"][k]
                if s[0]:
                    self.say("That's already damp.", "info")
                    return
                if p["water"] <= 0:
                    self.say("The can's empty. Fill it at the well or any "
                             "water.", "bad")
                    return
                if not self.spend(h):
                    return
                p["water"] -= 1
                s[0] = 1
                for nx, ny in self.row_ahead(x, y, h):
                    s = st["soil"].get("%d,%d" % (nx, ny))
                    if not s or p["water"] <= 0:
                        break
                    if not s[0]:
                        s[0] = 1
                        p["water"] -= 1
                self.sound.play("water")
                self.end_turn(TOOL_COST - 1)
            else:
                self.say("Nothing there needs watering.", "info")
            return
        if h == "hoe":
            if t == "soil" and th and th[0] == "crop" and th[1][3]:
                if not self.spend(h):
                    return
                st["soil"][k] = [st["soil"][k][0], None, 0, 0]
                self.say("You turn the dead plant under.", "info")
                self.end_turn(TOOL_COST)
                return
            if not on_farm(x, y):
                self.say("That's not your land to dig.", "info")
                return
            if t == "soil":
                self.say("That's already tilled.", "info")
                return
            if t not in TILLABLE or th:
                self.say("You can't dig there.", "info")
                return
            if self.season() == 3 and "winter_till" not in st["flags"]:
                st["flags"].append("winter_till")
                self.say("The ground's hard with frost, but you break it. "
                         "Nothing will grow till spring.", "info")
            if not self.spend(h):
                return
            st["soil"][k] = [1 if st["weather"] in ("rain", "storm") else 0,
                             None, 0, 0]
            for nx, ny in self.row_ahead(x, y, h):
                if not on_farm(nx, ny) or self.thing_at(nx, ny) or \
                        self.tile_at(nx, ny) not in TILLABLE or \
                        self.npc_at(nx, ny):
                    break
                st["soil"]["%d,%d" % (nx, ny)] = [st["soil"][k][0], None, 0,
                                                  0]
            self.sound.play("till")
            self.end_turn(TOOL_COST)
            return
        if h and h.endswith(" seeds"):
            cname = h[:-6]
            if t != "soil" or th:
                self.say("Seeds go in tilled soil. Use the hoe first.",
                         "info")
                return
            if self.season() not in crop(cname, "seasons"):
                self.say("%s won't grow in %s." % (
                    cap(cname) + ("s" if not cname.endswith(("s", "y"))
                                  else ""), SEASONS[self.season()]), "bad")
                return
            st["soil"][k][1] = cname
            st["soil"][k][2] = 0
            st["soil"][k][3] = 0
            st.setdefault("care", {})[k] = [0, 0, 0]
            self.take(h)
            self.sound.play("pick")
            self.end_turn(1)
            return
        if h == "sprinkler":
            if not on_farm(x, y) or th or not (t == "soil" or
                                               t in TILLABLE):
                self.say("Put a sprinkler on open ground on your farm.",
                         "info")
                return
            st["sprinklers"].append(k)
            st["soil"].pop(k, None)
            self.take("sprinkler")
            self.say("You set the sprinkler in the ground. It'll water the "
                     "four squares around it every morning.", "good")
            self.end_turn(TOOL_COST)
            return
        if h == "fertilizer":
            if not (th and th[0] == "crop") or th[1][3] or \
                    self.ripe(th[1]):
                self.say("Fertilizer goes on a growing crop.", "info")
                return
            if st["fertilized"].get(k) == st["day"]:
                self.say("You've already fed that one today.", "info")
                return
            st["fertilized"][k] = st["day"]
            st.setdefault("care", {}).setdefault(k, [0, 0, 0])[2] += 1
            th[1][2] += 1
            self.take("fertilizer")
            self.sound.play("pick")
            self.say("You work fertilizer in round the %s. It perks up "
                     "visibly: a day's growth overnight." % th[1][1], "good")
            self.end_turn(1)
            return
        if h and h.endswith(" sapling"):
            if not on_farm(x, y) or th or not (t == "soil" or
                                               t in TILLABLE):
                self.say("Plant the %s in open ground on your farm." % h,
                         "info")
                return
            self.plant_sapling(k, h[:-8])
            return
        if h in MACHINES:
            if not on_farm(x, y) or th or not (t == "soil" or
                                               t in TILLABLE):
                self.say("Put the %s on open ground on your farm." % h,
                         "info")
                return
            self.place_machine(k, h)
            return
        if h == "fishing rod":
            if t not in WATER:
                self.say("Face the water to fish.", "info")
                return
            self.fish(t)
            return
        if h == "axe" and t in CHOPPABLE:
            self.chop_tree(x, y, t)
            return
        if h in ("axe", "pickaxe"):
            self.say("Nothing to %s there." % ("chop" if h == "axe" else
                                               "break"), "info")
            return
        if h in ("short sword", "broadsword"):
            self.say("You practise a few swings. Best save it for the old "
                     "mine.", "info")
            return
        if h == "scythe":
            if t == "tallgrass" or (t in ("grass", "meadow") and
                                    random.random() < 0.1 + 0.1 * self.lv(h)):
                if self.spend(h):
                    self.give("fiber", 1 + self.lv(h) // 2)
                    self.say("You cut some fiber.", "info")
                    self.end_turn(TOOL_COST)
                return
            self.say("You swing the scythe at nothing in particular.",
                     "info")
            return
        self.say("Nothing to do there.", "info")

    def row_ahead(self, x, y, tool):
        """The squares past (x, y), the way you face, that an upgraded hoe
        or can reaches too."""
        dx, dy = self.st["facing"]
        return [(x + dx * i, y + dy * i)
                for i in range(1, REACH[self.lv(tool)])]

    def clear_debris(self, x, y, kind, auto=False):
        need, (item, n) = DEBRIS[kind]
        if need not in self.p["tools"]:
            self.say("You'd need %s to clear that %s." % (an(need), kind),
                     "info")
            return
        if self.held() != need and not auto:
            self.say("That %s needs the %s." % (kind, need), "info")
            return
        if not self.spend(need):
            return
        del self.st["debris"]["%d,%d" % (x, y)]
        self.give(item, n)
        self.sound.play({"weed": "pick", "stone": "chop",
                         "branch": "chop", "stump": "chop"}[kind])
        self.flash(x, y, "puff")
        hay = ""
        if kind == "weed" and random.random() < 0.5:
            if self.st["hay"] < self.silo_room():
                self.st["hay"] += 1
                hay = ", and 1 hay into the silo"
            else:
                self.give("hay")
                hay = ", and 1 hay"
        self.say("You clear the %s%s. (+%d %s%s)" % (
            kind, " with the " + need if auto else "", n, item, hay),
            "info")
        self.end_turn(TOOL_COST + (3 if kind == "stump" else 0))

    # ── Crops ──

    @staticmethod
    def ripe(s):
        return s[1] and not s[3] and s[2] >= crop(s[1], "days")

    @staticmethod
    def stage(s):
        if s[3]:
            return "c_dead"
        days = crop(s[1], "days")
        f = s[2] / days
        return "c_%s_%d" % (s[1], 3 if f >= 1 else 0 if s[2] == 0 else
                            1 if f < 0.5 else 2)

    def quality(self, k):
        """How well a crop was kept decides what you pick: watered every
        day it was growing and it may come up gold; most days, silver.
        Fertilizer makes it likelier. Returns '', 'silver ' or 'gold '."""
        days, wet, fed = self.st.setdefault("care", {}).get(k, [0, 0, 0])
        if not days:
            return ""
        r, kept, fed = random.random(), wet / days, min(fed, 2)
        if kept >= 1 and r < 0.12 + 0.18 * fed:
            return "gold "
        if kept >= 0.75 and r < 0.4 + 0.15 * fed:
            return "silver "
        return ""

    def pick_crop(self, k, s):
        """Take what's ripe in a bed: what you got (one crop, perhaps two,
        of one quality), and the bed ready to grow again."""
        name = s[1]
        got = self.quality(k) + name
        n = 2 if random.random() < 0.12 else 1
        self.give(got, n)
        regrow = crop(name, "regrow")
        if regrow:
            s[2] = crop(name, "days") - regrow
        else:
            s[1], s[2] = None, 0
        self.st["care"][k] = [0, 0, 0]
        self.st["stats"]["harvested"] += n
        return got, n

    def harvest(self, x, y, beds=None, pre=""):
        k = "%d,%d" % (x, y)
        s = (beds or self.st["soil"])[k]
        got, n = self.pick_crop(pre + k, s)
        fine = base_item(got) != got
        self.sound.play("gold" if fine else "pick")
        self.flash(x, y, "sparkle")
        self.say("You pick %s!%s" % (
            "two " + plural(got, 2) if n > 1 else an(got),
            " Beautifully kept." if fine else ""), "gold" if fine else "good")
        self.end_turn(1)

    def pick_apples(self, x, y):
        k = "%d,%d" % (x, y)
        n = self.st["apples"].get(k, 0)
        if not n:
            self.say({0: "The apple tree is in blossom, pink and white and "
                         "humming with bees.",
                      1: "Small green apples. Not ripe till fall.",
                      2: "No apples left on this one today.",
                      3: "The apple tree is bare and sleeping."}[
                          self.season()], "info")
            self.render()
            return
        self.st["apples"][k] = 0
        self.give("apple", n)
        self.sound.play("pick")
        self.say("You pick %d apple%s." % (n, "s" if n > 1 else ""), "good")
        self.end_turn(2)

    # ── Things ──

    def give(self, item, n=1):
        self.p["items"][item] = self.p["items"].get(item, 0) + n

    def take(self, item, n=1):
        have = self.p["items"].get(item, 0)
        if have < n:
            return False
        if have == n:
            del self.p["items"][item]
        else:
            self.p["items"][item] = have - n
        return True

    def bag_menu(self):
        if not self.ready():
            return
        items = sorted(n for n, c in self.p["items"].items() if c)
        if not items:
            self.say("Your bag is empty.", "info")
            return
        rows = []
        for n in items:
            c = self.p["items"][n]
            rows.append(("%s%s" % (n, " x%d" % c if c > 1 else ""),
                         lambda n=n: self.item_menu(n)))
        rows.append(("Close", lambda: None))
        self.open_menu("Your bag (%dg)" % self.p["gold"], rows)

    def item_menu(self, n):
        acts = []
        val, energy, kind = ITEMS.get(n, (0, 0, "?"))
        if energy and self.p["items"].get(n):
            acts.append(("Eat it (+%d energy)" % energy,
                         lambda: self.eat(n)))
        if n == CRYSTAL and self.p["items"].get(n):
            acts.append(("Crush it (+%d magic)" % CRYSTAL_MAGIC,
                         self.crush_crystal))
        if n.endswith(" seeds") or n == "sprinkler" or n in MACHINES or \
                n.endswith(" sapling") or n == "fertilizer" or \
                n in STATUE_OF:
            acts.append(("Hold it", lambda: (self.p.update(hand=n),
                                             self.say("You hold the %s." %
                                                      self.hand_name(),
                                                      "info"),
                                             self.render())))
        acts.append(("Look at it", lambda: self.say(describe_item(n),
                                                    "info")))
        acts.append(("Back", self.bag_menu))
        self.open_menu(cap(n), acts)

    def crush_crystal(self):
        p = self.p
        if p["magic"] >= p["max_magic"]:
            self.say("Your magic's already full. Save the crystal.", "info")
            self.render()
            return
        if not self.take(CRYSTAL):
            return
        p["magic"] = min(p["max_magic"], p["magic"] + CRYSTAL_MAGIC)
        self.sound.play("spell")
        self.say("You crush the crystal in your fist. Light runs up your "
                 "arm and into the wand. (+%d magic)" % CRYSTAL_MAGIC,
                 "good")
        self.end_turn(1)

    def eat(self, food):
        energy = ITEMS[food][1]
        if not self.take(food):
            return
        p = self.p
        p["energy"] = min(p["max_energy"], p["energy"] + energy)
        self.sound.play("potion")
        self.say("You eat %s. (+%d energy)" % (an(food), energy), "good")
        self.flags_today()
        if "tired" in self.flags_today() and p["energy"] > 0:
            self.flags_today().remove("tired")
        self.end_turn(5)

    # ── Shipping ──

    def ship_menu(self):
        sell = sorted(n for n, c in self.p["items"].items()
                      if c and ITEMS.get(n, (0,))[0] > 0
                      and ITEMS[n][2] not in ("material",))
        mats = sorted(n for n, c in self.p["items"].items()
                      if c and n in ("fiber",))
        rows = []
        for n in sell + mats:
            c = self.p["items"][n]
            rows.append(("%s x%d  (%dg each)" % (n, c, ITEMS[n][0]),
                         lambda n=n: self.ship(n)))
        if len(sell) > 1:
            rows.insert(0, ("Everything above", lambda: [self.ship(n, True)
                                                         for n in sell]))
        pending = sum(ITEMS[n][0] * c for n, c in self.st["shipped"].items())
        if not rows:
            self.say("The shipping bin. Anything you put in is sold "
                     "overnight. You've nothing to sell." +
                     (" (%dg waiting to be paid.)" % pending if pending
                      else ""), "info")
            self.render()
            return
        rows.append(("Done", lambda: None))
        self.open_menu("Ship what? (%dg in the bin)" % pending, rows)

    def ship(self, n, quiet=False):
        c = self.p["items"].pop(n, 0)
        if not c:
            return
        self.st["shipped"][n] = self.st["shipped"].get(n, 0) + c
        self.sound.play("ship")
        self.say("You put %d %s in the bin (%dg tomorrow)." % (
            c, plural(n, c), c * ITEMS[n][0]), "gold")
        if not quiet:
            self.ship_menu()

    # ── Fishing ──

    def fish(self, t):
        if not self.spend("fishing rod"):
            return
        where = t if t in FISH else "water"
        if where == "pond" and self.season() == 3:
            self.say("The pond's frozen solid.", "info")
            return
        wait = random.randint(10, 35)
        self.say("You cast your line and wait...", "info")
        self.busy = True
        self.render()

        def bite():
            self.busy = False
            self.pass_time(wait)
            if self.area is None:
                return
            chance = 0.62 + (0.15 if self.p["items"].get("fishing lure")
                             else 0) + (0.1 if self.st["weather"] == "rain"
                                        else 0)
            x, y = self.ahead()
            if random.random() > chance:
                self.say("...It got away. (%d minutes)" % wait, "info")
                self.render()
                return
            if where == "pond" and "golden carp" not in self.st["flags"] \
                    and random.random() < 0.04:
                self.st["flags"].append("golden carp")
                fish = "golden carp"
                self.say("The water flashes gold! You've caught the "
                         "LEGEND: the golden carp your grandmother "
                         "caught!", "quest")
            else:
                pool = FISH[where][self.season()]
                fish = random.choices(pool, [6, 4, 2, 1][:len(pool)])[0]
                self.say("You catch %s! (%d minutes)" % (an(fish), wait),
                         "good")
            self.give(fish)
            self.st["stats"]["fish"] += 1
            self.sound.play("splash")
            self.flash(x, y, "splash")
            self.render()
        self.root.after(350, bite)

    # ── Sleeping, and the morning ──

    def bed_menu(self):
        h = self.hhmm()
        baby = [("Try for a baby with %s" % self.spouse_info()[0],
                 self.try_baby)] if self.can_try_baby() else []
        self.open_menu("Go to bed?" if h >= 1800 or h < 600 else
                       "Go to bed? It's only %s." % self.clock(),
                       [("Sleep until morning", self.sleep)] + baby +
                       [("Not yet", lambda: None)])

    def sleep(self):
        late = self.st["minute"] >= 24 * 60
        self.say("You sleep.", "info")
        self.new_day(0.8 if late else 1.0)

    def collapse(self):
        self.stash_floor()
        self.mlead_return()
        self.mine = None
        self.st["mine_loo"] = None
        self.end_talk()
        self.menu = None
        self.say("It's two in the morning. You collapse...", "bad")
        fee = min(300, self.p["gold"] // 10)
        if self.area.key != "cabin":
            self.say("Dr. Thorne found you and carried you home. He left "
                     "a bill for %dg, and a note: 'Please sleep.'" % fee,
                     "bad")
            self.p["gold"] -= fee
        self.area = self.areas["cabin"]
        bx, by = self.areas["cabin"].spots["1"]
        self.st["pos"] = [bx - 1, by]
        self.new_day(0.5)

    def new_day(self, rest):
        """Overnight: ship, grow, and wake on the next day."""
        st, p = self.st, self.p
        self.end_talk()
        self.menu = None
        # the bin
        pay = sum(ITEMS[n][0] * c for n, c in st["shipped"].items())
        if pay:
            p["gold"] += pay
            st["stats"]["earned"] += pay
            st["stats"]["shipped"] += sum(st["shipped"].values())
            self.say("Overnight, the bin was emptied: %s. You earn %dg." % (
                ", ".join("%d %s" % (c, plural(n, c))
                          for n, c in sorted(st["shipped"].items())), pay),
                "gold")
            st["shipped"] = {}
        # the hens lay
        self.feed_animals()
        n = 0
        for c in st["chickens"]:
            if c.get("hungry"):
                continue
            spot = self.free_coop_square(eggs_too=True)
            if spot and len(st["eggs"]) < 2 * COOP_ROOM:
                st["eggs"].append(list(spot))
                if random.random() < self.large_chance(c):
                    st["large_eggs"].append(list(spot))
                c["eggs"] = c.get("eggs", 0) + 1
                n += 1
        if n:
            self.say("%s laid %s overnight." % (
                "Your hen" if n == 1 else "Your %d hens" % n,
                "an egg" if n == 1 else "an egg each"), "good")
        # the crops, and the greenhouse's
        care = st.setdefault("care", {})
        for beds, pre in ((st["soil"], ""), (st.setdefault("gh", {}), "gh:")):
            for k, s in beds.items():
                if s[1] and not s[3] and not self.ripe(s):
                    c = care.setdefault(pre + k, [0, 0, 0])
                    c[0] += 1
                    if s[0]:
                        c[1] += 1
                        s[2] += 1
                s[0] = 0
        fest = self.festival_today()
        prank = fest and fest[0] == "Harvest Fair" and [
            v for v in st["loos"] if not self.loo_state(v)["tipped"]]
        for v in st["loos"]:
            if self.loo_state(v)["grime"] >= LOO_FILTHY:
                self.befriend(v, -10, quiet=True)
        st["fertilized"] = {}
        old_season = self.season()
        st["day"] += 1
        st["minute"] = WAKE
        st["today"] = []
        season = self.season()
        st["weather"] = st["tomorrow"]
        st["tomorrow"] = self.roll_weather(season)
        if season != old_season:
            dead = 0
            for k, s in st["soil"].items():
                if s[1] and season not in crop(s[1], "seasons"):
                    s[3] = 1
                    dead += 1
            self.say("It's the first of %s!" % SEASONS[season], "quest")
            if dead:
                self.say("%d crop%s didn't survive the change of season." % (
                    dead, "s" if dead > 1 else ""), "bad")
        if st["weather"] in ("rain", "storm"):
            for s in st["soil"].values():
                s[0] = 1
            st.setdefault("bowls", {})["valley"] = st["day"]
        for k in st["sprinklers"]:
            x, y = map(int, k.split(","))
            for dx, dy in DIRS:
                s = st["soil"].get("%d,%d" % (x + dx, y + dy))
                if s:
                    s[0] = 1
        # tilled ground left empty goes back to grass
        for k in [k for k, s in st["soil"].items()
                  if not s[1] and random.random() < 0.04]:
            del st["soil"][k]
        # weeds creep back, apples ripen, the wild grows
        valley = self.areas["valley"]
        for _ in range(random.randint(1, 4)):
            x = random.randint(FARM[0] + 1, FARM[2] - 1)
            y = random.randint(FARM[1] + 1, FARM[3] - 1)
            k = "%d,%d" % (x, y)
            if valley.grid[y][x] == "grass" and k not in st["soil"] and \
                    k not in st["debris"] and k not in st["sprinklers"] and \
                    k not in st["machines"] and k not in st["orchard"] and \
                    (x, y) != self.bowl_at("valley") and \
                    k not in st["droppings"] and \
                    (x, y) != self.pos() and season != 3:
                st["debris"][k] = "weed"
        for t in list(st["orchard"].values()) + list(
                st["fruitful"].values()):
            if self.fruit_season(t) and self.tree_stage(t) == "m":
                t["fruit"] = min(3, t.get("fruit", 0) + 1)
            else:
                t["fruit"] = 0
        if season == 2:
            for x in (5, 8, 11, 14):
                k = "%d,%d" % (x, 17)
                st["apples"][k] = min(3, st["apples"].get(k, 0) + 1)
        else:
            st["apples"] = {}
        self.spawn_forage()
        self.regrow_trees()
        # people
        for f in st["friends"].values():
            if self.weekday() == 0:
                f["week"] = 0
        for m in self.mmaids():
            if self.weekday() == 0:
                m["week"] = 0
        if p.get("feather_bed") and 0.5 < rest < 1:
            rest = 1.0                  # sleeping like an angel
        p["energy"] = round(p["max_energy"] * rest)
        p["magic"] = max(p["magic"], int(p["max_magic"] * rest + 0.5))
        if self.season_drawn != season:
            self.load_images()
        self.morning_news()
        if prank:
            vid = random.choice(prank)
            self.loo_state(vid)["tipped"] = True
            self.say("Pranksters were out after the Harvest Fair: the "
                     "outhouse that is %s has been tipped over!" %
                     VILLAGERS[vid]["short"], "quest")
        self.settle_npcs()
        self.layout()
        self.save()

    def roll_weather(self, season):
        r = random.random()
        if season == 3:
            return "snow" if r < 0.3 else "sun"
        if season == 1 and r < 0.06:
            return "storm"
        return "rain" if r < (0.22 if season != 1 else 0.14) else "sun"

    def spawn_forage(self):
        st = self.st
        st["forage"] = {k: v for k, v in st["forage"].items()
                        if random.random() < 0.4}
        season = self.season()
        for item, shape, col, where in FORAGE[season]:
            spots = self.forage_zones[where]
            for _ in range(random.randint(1, 3)):
                x, y = random.choice(spots)
                k = "%d,%d" % (x, y)
                if k not in st["forage"] and k not in st["debris"] and \
                        k not in st["machines"] and k not in st["orchard"]:
                    st["forage"][k] = item

    def mail(self, sender, text):
        self.st["mail"].append({"from": sender, "text": text,
                                "day": self.st["day"], "read": False})

    def read_mail(self):
        new = [m for m in self.st["mail"] if not m["read"]]
        if not new:
            self.say("Your mailbox is empty. (Your letters are in the "
                     "diary.)", "info")
            self.render()
            return
        for m in new:
            m["read"] = True
        self.sound.play("gold")
        self.show_text("\n\n".join(
            "From %s:\n\n%s" % (m["from"], "\n".join(wrap(m["text"], 52)))
            for m in new) + "\n\n(Any key closes.)")

    # ── Where everyone is ──

    def schedule(self, vid):
        """Today's list of (hhmm, spot) for somebody."""
        v = VILLAGERS[vid]
        f = self.st["friends"][vid]
        s = v["sched"]
        maids = self.st.get("maids", {})
        if vid in maids:
            home = "cabin." + MAID_SPOTS[sorted(maids).index(vid) %
                                         len(MAID_SPOTS)]
            if maids[vid] in ("water", "harvest", "weed") and \
                    self.st["weather"] not in ("rain", "storm", "snow"):
                return [(600, "out.farmyard"), (900, home)]
            return [(600, home)]
        if f["status"] == "married":
            work = self.spot_at(s["day"], 1100)
            if work.split(".")[0] in ("juniper", "shack", "smithhouse",
                                      "rose", "mayor"):
                work = "out.fountain_s"
            return [(600, "cabin.1"), (1000, work), (1800, "cabin.1")]
        if self.st["weather"] in ("rain", "storm", "snow") and "rain_s" in s:
            return s["rain_s"]
        if self.weekday() == v["rest"] and "rest_s" in s:
            return s["rest_s"]
        if "show_s" in s and self.weekday() in (4, 5):
            return s["show_s"]
        return s["day"]

    @staticmethod
    def spot_at(sched, hhmm):
        cur = sched[-1][1]
        for t, spot in sched:
            if hhmm >= t:
                cur = spot
        return cur

    def wanted(self, vid):
        """Where somebody means to be right now: (area, x, y)."""
        n = self.npcs[vid]
        if n.visit:
            return ("valley",) + self.loo_door(n.visit["loo"])
        h = self.hhmm()
        if h < 600:
            h += 2400
        f = self.festival_on()
        st = self.st
        fest = self.festival_today()
        if f or (fest and fest[1] <= h < fest[2]):
            spots = FEST_SPOTS[fest[3]]
            i = sorted(VILLAGERS).index(vid)
            x, y = spots[i % len(spots)]
            return ("valley", x, y)
        if st["wedding"] == st["day"] and 1000 <= h < 1300:
            i = sorted(VILLAGERS).index(vid)
            x, y = FEST_SPOTS["square"][i]
            return ("valley", x, y)
        spot = self.spot_at(self.schedule(vid), h)
        area, mark = spot.split(".")
        if area == "out":
            x, y = OUT_SPOTS[mark]
            return ("valley", x, y)
        x, y = self.areas[area].spots[mark]
        return (area, x, y)

    def settle_npcs(self):
        """Everyone straight to where they should be (mornings, and after
        long waits)."""
        taken = {(n.where, n.x, n.y) for vid, n in self.npcs.items()
                 if self.rooted(vid) and n.where}
        for vid, n in self.npcs.items():
            n.visit, n.hidden = None, self.kept(vid)
            if (self.rooted(vid) or self.kept(vid) or
                    self.leashed(vid)) and n.where:
                continue
            area, x, y = self.wanted(vid)
            x, y = self.free_spot(area, x, y, taken)
            n.where, n.x, n.y = area, x, y
            n.goal, n.path, n.stuck = (area, x, y), [], 0
            taken.add((area, x, y))

    def free_spot(self, area, x, y, taken):
        a = self.areas[area]
        px, py = self.st["pos"]
        for r in range(0, 4):
            for dy in range(-r, r + 1):
                for dx in range(-r, r + 1):
                    if max(abs(dx), abs(dy)) != r:
                        continue
                    nx, ny = x + dx, y + dy
                    if (area, nx, ny) in taken or (
                            area == self.area.key and (nx, ny) == (px, py)):
                        continue
                    if self.can_stand(nx, ny, a) and (
                            a.outdoor or a.grid[ny][nx] != "exit"):
                        return nx, ny
        return x, y

    def npc_minute(self, visible):
        """A minute for everyone: whoever's going somewhere takes a step
        (or, out of your sight, simply gets there)."""
        here = self.area.key
        if here == "coop" and visible:
            self.chicken_minute()
        if here == "barn" and visible:
            self.cow_minute()
        if visible:
            self.pet_minute(here)
            if here == "valley":
                self.graze_minute()
        taken = {(n.where, n.x, n.y) for n in self.npcs.values()}
        for vid, n in self.npcs.items():
            if self.talk and self.talk.get("v") == vid or self.rooted(vid) \
                    or self.kept(vid) or self.leashed(vid):
                continue
            if self.loo_visits(n, here, visible):
                continue
            goal = self.wanted(vid)
            if goal != n.goal:
                n.goal, n.path, n.stuck = goal, [], 0
            if (n.where, n.x, n.y) == goal:
                continue
            for _ in range(4):
                if n.where == here and visible:
                    break
                tgt, hop = self.hop(n)
                taken.discard((n.where, n.x, n.y))
                n.x, n.y = tgt
                if hop:
                    n.where, n.x, n.y = hop
                taken.add((n.where, n.x, n.y))
                n.path = []
                if (n.where, n.x, n.y) == goal or not hop:
                    break
            if n.where != here or not visible:
                continue
            tgt, hop = self.hop(n)
            if (n.x, n.y) == tgt:
                if hop:
                    taken.discard((n.where, n.x, n.y))
                    n.where, n.x, n.y = hop
                    n.path = []
                continue
            if not n.path:
                n.path = self.npc_path(n, tgt)
                if not n.path:
                    n.stuck += 1
                    if n.stuck > 20:
                        n.x, n.y = tgt
                    continue
            nx, ny = n.path[0]
            if (n.where, nx, ny) in taken or (nx, ny) == self.pos():
                n.stuck += 1
                if n.stuck > 6:
                    n.path = []
                if n.stuck > 25:
                    taken.discard((n.where, n.x, n.y))
                    n.x, n.y = self.free_spot(n.where, tgt[0], tgt[1],
                                              taken)
                    n.path = []
                    taken.add((n.where, n.x, n.y))
                continue
            taken.discard((n.where, n.x, n.y))
            n.x, n.y = nx, ny
            n.path.pop(0)
            n.stuck = 0
            taken.add((n.where, nx, ny))

    def hop(self, n):
        """Where somebody should walk next in the area they're in, and
        where they come out if that's a doorway."""
        area, gx, gy = n.goal
        if n.where == area:
            return (gx, gy), None
        if n.where != "valley":
            room = self.areas[n.where]
            if n.where not in BUILDINGS:        # an outhouse, say: out
                x, y = self.outside_door() if self.area.key == n.where \
                    else door_of("cabin")
                return room.entry, ("valley", x, y + 1)
            dx, dy = door_of(n.where)
            return room.entry, ("valley", dx, dy + 1)
        dx, dy = door_of(area)
        return (dx, dy + 1), (area,) + self.areas[area].entry

    def npc_path(self, n, tgt):
        a = self.areas[n.where]
        start = (n.x, n.y)
        prev = {start: None}
        q = deque([start])
        while q:
            cur = q.popleft()
            if cur == tgt:
                break
            for dx, dy in DIRS:
                nx, ny = cur[0] + dx, cur[1] + dy
                if (nx, ny) in prev:
                    continue
                if (nx, ny) != tgt and not self.can_stand(nx, ny, a):
                    continue
                if not a.inside(nx, ny):
                    continue
                prev[(nx, ny)] = cur
                q.append((nx, ny))
        if tgt not in prev:
            return []
        path = []
        cur = tgt
        while cur != start:
            path.append(cur)
            cur = prev[cur]
        return path[::-1]

    # ── Friendship ──

    def friend(self, vid):
        return self.st["friends"][vid]

    def hearts(self, vid):
        return self.friend(vid)["pts"] // HEART

    def partner(self):
        for vid, f in self.st["friends"].items():
            if f["status"] in ("dating", "engaged", "married"):
                return vid
        return None

    def befriend(self, vid, pts, quiet=False):
        f = self.friend(vid)
        before = f["pts"] // HEART
        cap_ = 10 * HEART
        if VILLAGERS[vid]["romance"] and f["status"] is None:
            cap_ = 8 * HEART
        f["pts"] = max(0, min(cap_, f["pts"] + pts))
        after = f["pts"] // HEART
        n = self.npcs[vid]
        if pts > 0 and n.where == self.area.key:
            self.flash(n.x, n.y, "heart")
        if after > before and not quiet:
            self.sound.play("heart")
            self.say("%s: %s" % (VILLAGERS[vid]["short"],
                                 "♥" * after + "♡" * (10 - after)),
                     "heart")
        if after >= 3 > before:
            self.teach_recipes()

    # ── Talking ──

    def speak(self, vid, line, log=True):
        """Show somebody saying a line, portrait and all."""
        expr, text = parse_line(fill_in(line, self))
        narr = text.startswith("*")
        if narr:
            text = text[1:]
        elif self.maid(vid) and self.outfit(vid) == "pirate" and \
                random.random() < 0.6:
            text = piratify(text)
        elif self.maid(vid) and self.outfit(vid) == "sailor" and \
                random.random() < 0.6:
            text = kawaiify(text, self.p["name"] if self.p else "")
        self.talk.update(expr=expr, text=text, narr=narr)
        if log:
            if narr:
                self.say(text, "info")
            else:
                self.say("%s: %s" % (VILLAGERS[vid]["short"], text), "talk")
        for w in re.findall(r"\b[A-Z][A-Z]{2,}(?: [A-Z]{3,})?\b", text):
            w = w.lower()
            if w not in self.st["topics"]:
                self.st["topics"].append(w)
        self.render()

    def start_talk(self, n):
        vid = n.vid
        if self.statue(vid):
            self.walking = None
            self.statue_bump(n)
            return
        if self.tree(vid):
            self.walking = None
            self.tree_bump(n)
            return
        if self.loo(vid):
            self.walking = None
            self.loo_bump(n)
            return
        if self.is_cow(vid):
            self.walking = None
            self.say(random.choice(
                MOO_HAPPY if self.likes_change(vid, "cowify") else
                MOO_ANGRY).replace("{who}", VILLAGERS[vid]["short"]),
                "info")
            if self.squeeze_past(n):
                self.say("She ambles aside and lets you by.", "info")
            self.end_turn(1)
            return
        if self.pet_kind(vid):
            self.walking = None
            kind = self.beast(vid)
            self.sound.play("meow" if kind == "cat" else "bark")
            happy = self.likes_change(vid, kind + "ify")
            self.say(random.choice(
                (MEOW_HAPPY if happy else MEOW_ANGRY) if kind == "cat" else
                (WOOF_HAPPY if happy else WOOF_ANGRY)).replace(
                    "{who}", VILLAGERS[vid]["short"]), "info")
            if self.squeeze_past(n):
                self.say("She %s aside and lets you by." % (
                    "slinks" if kind == "cat" else "bounds"), "info")
            self.end_turn(1)
            return
        if self.is_sheep(vid):
            self.walking = None
            self.sound.play("baa")
            self.say(random.choice(
                BAA_HAPPY if self.likes_change(vid, "sheepify") else
                BAA_ANGRY).replace("{who}", VILLAGERS[vid]["short"]),
                "info")
            if self.squeeze_past(n):
                self.say("She trots aside and lets you by.", "info")
            self.end_turn(1)
            return
        if self.chicken(vid):
            self.walking = None
            self.say(random.choice(
                CLUCK_HAPPY if self.likes_change(vid, "chickenfy") else
                CLUCK_ANGRY).replace("{who}", VILLAGERS[vid]["short"]),
                "info")
            if self.squeeze_past(n):
                self.say("She scuttles past you, still clucking.", "info")
            self.end_turn(1)
            return
        v = VILLAGERS[vid]
        f = self.friend(vid)
        self.walking = None
        self.talk = {"v": vid, "mode": "kw", "expr": "neutral", "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        # turn to face you
        if not f["met"]:
            f["met"] = True
            self.speak(vid, v["intro"])
            self.say("(Choose a word, or type one and press Return. Words "
                     "in CAPITALS are worth asking about.)", "info")
        else:
            birthday = v["birthday"] == (self.season(), self.dom())
            if birthday:
                self.speak(vid, "(happy)It's my birthday today! Did you "
                                "remember?")
            elif self.maid(vid) and self.season() == 3 and \
                    self.outfit(vid) in ("bikini", "sundress"):
                self.speak(vid, random.choice(BIKINI_WINTER).replace(
                    "{outfit}", self.outfit(vid)))
            elif self.maid(vid) and self.season() == 1 and \
                    self.outfit(vid) == "shawl":
                self.speak(vid, random.choice(SHAWL_SUMMER))
            elif self.maid(vid) and f["status"] == "married":
                self.speak(vid, random.choice(self.maid_romance(
                    vid, MAID_WIFE_GREET)))
            elif self.maid(vid):
                self.speak(vid, random.choice(
                    MAID_GREET_LIKE if self.likes_change(vid, "maidify")
                    else MAID_GREET_HATE))
            elif self.swapped(vid):
                self.speak(vid, random.choice(
                    SWAP_GREET_LIKE if self.likes_change(vid) else
                    SWAP_GREET_HATE))
            else:
                self.speak(vid, random.choice(v["greet"][self.tier(vid)]))
        if f["talked"] != self.st["day"]:
            f["talked"] = self.st["day"]
            self.befriend(vid, CHAT_POINTS)
        if self.check_scene(vid):
            return
        self.talk_menu()

    def tier(self, vid):
        h = self.hearts(vid)
        return 0 if h < 2 else 1 if h < 5 else 2 if h < 8 else 3

    def talk_words(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        words = ["CHAT", "GIFT"]
        if self.shop_open(vid):
            words.append("BUY")
        fest = self.festival_on()
        if fest:
            key = fest[0]
            if "Blossom" in key:
                words.append("DANCE")
            elif "Picnic" in key and vid == "bernard":
                words.append("SHARE")
            elif "Harvest" in key and vid == "edmund":
                words.append("ENTER")
        if f["status"] in ("dating", "engaged", "married") and \
                f["dated"] != self.st["day"] and 1700 <= self.hhmm() < 2300:
            words.append("DATE")
        r = self.st["request"]
        if r and r["who"] == vid:
            words.append("REQUEST")
        for w in self.st["topics"]:
            if w in v["topics"] and w.upper() not in words:
                words.append(w.upper())
        if self.maid(vid):
            words.insert(0, "CHORE")
            words.insert(1, "KISS")
            words.insert(2, "WEAR")
        if self.swapped(vid) or self.maid(vid):
            words.append("CHANGE")
        words += ["NAME", "JOB", "NEWS", "ABOUT...", "SQUEEZE PAST"]
        return words

    def talk_menu(self):
        t = self.talk
        if not t or self.scene:
            return
        if t.get("mm"):
            self.mmaid_menu(t["mm"])
            return
        if t.get("kid"):
            self.kid_menu(t["kid"])
            return
        if t.get("who"):
            self.auriel_menu(hello=False)
            return
        vid = t["v"]
        if t["mode"] == "buy":
            self.shop_menu(vid)
            return
        if t["mode"] == "gift":
            self.gift_menu(vid)
            return
        words = self.talk_words(vid)
        self.open_menu("Talk to %s:" % VILLAGERS[vid]["short"],
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        if w != "ABOUT...":
            self.say("> " + (w or "bye"), "you")
        self.converse(w.lower())
        self.back_to_talk()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.scene = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if self.p and self.area:
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if getattr(self, "naming", None) is not None:
            self.finish_naming(text)
            return
        if self.menu and (not text or text.isdigit()):
            i = int(text) - 1 if text.isdigit() else None
            if i is None or 0 <= i < len(self.menu["items"]):
                self.menu_pick(i)
            return
        if not self.talk or self.scene:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()

    def converse(self, w):
        t = self.talk
        if not t or t.get("mm") or t.get("kid") or t.get("who"):
            return
        vid = t["v"]
        v = VILLAGERS[vid]
        w = w.strip().rstrip("?!.").strip()
        if w in ("", "bye", "goodbye"):
            self.speak(vid, random.choice(BYES[self.tier(vid)]))
            self.end_talk()
            self.end_turn(1)
            return
        if w[:4] in ("sque", "past", "move", "excu", "scoo", "swap"):
            if self.squeeze_past(self.npcs[vid]):
                self.say("%s: %s" % (v["short"], random.choice(
                    PAST_LINES)), "talk")
                self.say("%s steps aside, and you squeeze past." %
                         v["short"], "info")
            else:
                self.say("You're not in each other's way.", "info")
            self.end_talk()
            self.end_turn(1)
            return
        if self.maid(vid) and w[:4] in ("chor", "work", "task", "duty",
                                        "duti", "clea"):
            self.chore_menu(vid)
            return
        if self.maid(vid) and w[:4] in ("kiss", "smoo", "peck"):
            self.kiss_maid(vid)
            return
        if self.maid(vid) and w[:4] in ("wear", "dres", "biki", "outf",
                                        "cost", "clot", "unif"):
            self.maid_wear(vid)
            return
        if w == "chat":
            self.chat(vid)
        elif w == "gift":
            t["mode"] = "gift"
        elif w in ("buy", "shop"):
            if self.shop_open(vid):
                t["mode"] = "buy"
            else:
                self.speak(vid, "The shop's not open right now.")
        elif w == "name":
            self.speak(vid, "I'm %s." % v["name"] if self.hearts(vid) else
                       v["intro"])
        elif w == "job":
            self.speak(vid, "I'm %s." % v["job"])
        elif w == "news":
            self.speak(vid, self.news(vid))
        elif w == "about...":
            self.about_menu(vid)
            return
        elif w == "dance":
            self.dance(vid)
        elif w == "share":
            self.share_menu(vid)
            return
        elif w == "enter":
            self.enter_menu(vid)
            return
        elif w == "date":
            self.go_on_date(vid)
        elif w in ("request", "help"):
            self.deliver(vid)
        elif w in ("weather", "rain"):
            self.speak(vid, {"sun": "Should be fine tomorrow.",
                             "rain": "Feels like rain tomorrow.",
                             "storm": "(surprised)There's a storm coming "
                                      "tomorrow, I'd bet on it.",
                             "snow": "Snow tomorrow, I think."}[
                                 self.st["tomorrow"]])
        elif w[:4] in ("chan", "zap", "wand", "spel", "maid") and \
                self.maid(vid):
            self.speak(vid, random.choice(
                MAID_ABOUT_LIKE if self.likes_change(vid, "maidify") else
                MAID_ABOUT_HATE))
        elif w[:4] in ("chan", "swap", "zap", "wand", "spel") and \
                self.swapped(vid):
            self.speak(vid, random.choice(
                SWAP_ABOUT_LIKE if self.likes_change(vid) else
                SWAP_ABOUT_HATE))
        elif w in ("farm", "crops"):
            self.speak(vid, self.farm_talk(vid))
        elif w in ("love", "marry", "marriage", "date me", "romance"):
            self.speak(vid, self.love_talk(vid))
        else:
            self.topic(vid, w)

    def topic(self, vid, w):
        v = VILLAGERS[vid]
        if vid == "theo" and w.startswith("fish") and \
                "fishing rod" not in self.p["tools"]:
            self.p["tools"].append("fishing rod")
            self.p["hand"] = "fishing rod"
            self.sound.play("quest")
            self.speak(vid, "(laugh)Here, take Dad's old rod! Face the "
                            "water and use it. Rivers, the pond and the "
                            "lake each have their own fish. Go get 'em!")
            self.say("Theo gives you a fishing rod!", "good")
            return
        for k, line in v["topics"].items():
            if w == k or (len(w) >= 4 and k.startswith(w[:4])):
                self.speak(vid, line)
                return
        for other, ov in VILLAGERS.items():
            names = (other, ov["short"].lower(), ov["name"].lower())
            if w in names or (len(w) >= 4 and any(
                    n.startswith(w[:4]) for n in names)):
                if other == vid:
                    self.speak(vid, "(laugh)That's me!")
                else:
                    self.speak(vid, v["opinions"].get(
                        other, "%s? We get along fine." % ov["short"]))
                return
        for k, line in COMMON_TOPICS.items():
            if w == k or (len(w) >= 4 and k.startswith(w[:4])):
                self.speak(vid, line)
                return
        self.speak(vid, v["unknown"])

    def about_menu(self, vid):
        met = [o for o in sorted(VILLAGERS, key=lambda o:
                                 VILLAGERS[o]["short"])
               if o != vid and self.friend(o)["met"]]
        if not met:
            self.speak(vid, "You should get out and meet people!")
            self.talk_menu()
            return
        self.open_menu("Ask about whom?", [
            (VILLAGERS[o]["short"], lambda o=o: (
                self.say("> %s" % VILLAGERS[o]["short"].upper(), "you"),
                self.topic(vid, o), self.talk_menu())) for o in met] +
            [("Never mind", self.talk_menu)], self.talk_menu)

    def chat(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        pool = list(v["chat"][self.tier(vid)])
        pool.append(v["season"][self.season()])
        if self.st["weather"] in ("rain", "storm"):
            pool += [v["rain"]] * 3
        if f["status"] in ("dating", "engaged") and v.get("dating"):
            pool += v["dating"]
            if self.maid(vid):
                pool += self.maid_romance(vid, MAID_COURTING)
        if f["status"] == "married":
            pool = v["spouse"] + [v["season"][self.season()]]
            if self.maid(vid):
                pool += self.maid_romance(vid, MAID_WIFE) * 2
        if vid == self.st.get("secret") and self.season() == 3 and \
                self.dom() < 24:
            pool.append("(happy)I wonder who my secret friend is this year!")
        last = self.talk.get("last")
        gossip = self.gossip(vid)
        if gossip and gossip != last and random.random() < 0.35:
            self.talk["last"] = gossip
            self.speak(vid, gossip)
            return
        choices = [ln for ln in pool if ln != last] or pool
        line = random.choice(choices)
        self.talk["last"] = line
        self.speak(vid, line)

    def transformed(self, vid):
        """What the wand has made of somebody, most striking first, or
        None."""
        for kind, test in (("loo", self.loo), ("tree", self.tree),
                           ("chicken", self.chicken), ("cow", self.is_cow),
                           ("sheep", self.is_sheep),
                           ("cat", lambda v: self.beast(v) == "cat"),
                           ("dog", lambda v: self.beast(v) == "dog"),
                           ("statue", self.statue),
                           ("maid", self.maid), ("swapped", self.swapped)):
            if test(vid):
                return kind
        return None

    def gossip(self, vid):
        """A word about somebody else the wand has changed, wondering how
        they're taking to it, with a hint of the truth."""
        others = [(o, self.transformed(o)) for o in VILLAGERS if o != vid]
        others = [(o, k) for o, k in others if k]
        if not others:
            return None
        other, kind = random.choice(others)
        who = GOSSIP_KIN.get((vid, other), VILLAGERS[other]["short"])
        line = random.choice(GOSSIP[kind])
        if kind != "statue":
            spell = {"loo": "looify", "tree": "treeify", "chicken":
                     "chickenfy", "maid": "maidify",
                     "cow": "cowify", "sheep": "sheepify",
                     "cat": "catify", "dog": "dogify"}.get(
                         kind, "genderswap")
            likes = self.likes_change(other, spell)
            line += " " + random.choice(GOSSIP_HINTS[kind][0 if likes
                                                          else 1])
        return line.replace("{who}", who)

    def news(self, vid):
        st = self.st
        opts = []
        for d in range(0, 8):
            day = st["day"] + d
            f = FESTIVALS.get((self.season(day), self.dom(day)))
            if f:
                opts.append("The %s is %s! %s" % (
                    f[0], "today" if d == 0 else "tomorrow" if d == 1 else
                    "on %s %d" % (SEASONS[self.season(day)], self.dom(day)),
                    f[4]))
                break
        for other, ov in VILLAGERS.items():
            for d in range(0, 4):
                day = st["day"] + d
                if ov["birthday"] == (self.season(day), self.dom(day)) and \
                        other != vid:
                    opts.append("It's %s's birthday %s! Bring something "
                                "nice." % (ov["short"], "today" if d == 0
                                           else "tomorrow" if d == 1 else
                                           "on " + SEASONS[self.season(day)]
                                           + " %d" % self.dom(day)))
        tilled = len(st["soil"])
        if tilled > 30:
            opts.append("Everyone's talking about your farm. %d squares "
                        "planted! Your grandmother would be proud." % tilled)
        if st["stats"]["fish"] > 10:
            opts.append("Theo says you're a natural with a rod.")
        p = self.partner()
        if p and p != vid:
            opts.append({"dating": "I hear you and %s are courting! How "
                                   "lovely!",
                         "engaged": "You and %s are getting married! The "
                                    "whole village is buzzing!",
                         "married": "You and %s make a lovely couple."}[
                             st["friends"][p]["status"]] %
                        VILLAGERS[p]["short"])
        if st["tomorrow"] in ("rain", "storm"):
            opts.append("Theo says it'll rain tomorrow. He's usually "
                        "right. About weather.")
        opts += self.mine_news(vid)
        opts += GENERIC_NEWS
        return random.choice(opts)

    def mine_news(self, vid):
        """What the village says about the mine, and what you've brought
        out of it: monster maids above all."""
        st, out = self.st, []
        for m in self.mmaids():
            was = MONSTERS[m["kind"]].name
            out.append((MM_GOSSIP_ANGEL if m["kind"] == "angel" else
                        MM_GOSSIP_POOP if m["kind"] == "poop" else
                        MM_GOSSIP[m["kind"]]).replace("{name}", m["name"]))
            out.append({
                None: "Is it true there's a maid in your cabin who used to "
                      "be %s? %s, she's called? She waved at me!" % (
                          an(was), m["name"]),
                "dating": "You and %s? The one who used to be %s? Well! "
                          "Love's love, I always say." % (m["name"], an(was)),
                "engaged": "You're marrying %s! I've never been to a "
                           "wedding with %s for a bride. I've bought a "
                           "hat." % (m["name"], an(was)),
                "married": "You married a maid who used to be %s! The "
                           "whole valley's still talking about it. In a "
                           "nice way." % an(was)}[m["status"]])
        for k in self.kids():
            her, she = ("her", "She") if k["sex"] == "F" else ("him", "He")
            out.append("Little %s's getting so big! %s" % (
                k["name"], random.choice((
                    "Bring %s by the bakery some time." % her,
                    "%s's got your smile." % she,
                    "Time flies, doesn't it?"))))
            if k["kind"]:
                out.append("Is it true little %s %s?" % (
                    k["name"], KID_TRAITS[k["kind"]][1][4:]))
        if st.get("baby_due") is not None:
            out.append("A baby on the way! The whole valley's knitting.")
        mine = st.get("mine", {})
        if st.get("auriel_came"):
            out.append("There's an angel by the square! Auriel. She asked me "
                       "what a 'Tuesday' was. Lovely girl. Very tall wings.")
        if mine.get("archangel"):
            out.append("They say you climbed the Sky Tower and faced down an "
                       "Archangel! Dmitri watched the whole thing through "
                       "his telescope." if vid != "dmitri" else
                       "(surprised)I watched you through my telescope, all "
                       "the way to the top of the tower. The light, when "
                       "the Archangel fell! I've never seen anything like "
                       "it.")
        elif mine.get("tower"):
            out.append("That white tower in the woods has its door open! "
                       "Nobody's ever got in before. Mind how you go.")
        if mine.get("king"):
            out.append("(happy)You beat the Mine King! My grandad would've "
                       "bought you a drink. I'll buy you two." if vid ==
                       "otto" else "Is it true you beat the Mine King? Otto "
                       "hasn't stopped telling everybody.")
        elif mine.get("deepest", 0) >= 5:
            out.append("They say you've been down to floor %d of the old "
                       "mine. Rather you than me." % mine["deepest"])
        n = len(st.get("museum", ()))
        if n >= len(ARTIFACTS) + 1:
            out.append("Juniper's museum is complete! There's a plaque with "
                       "your name on it. I've been twice.")
        elif n >= 3:
            out.append("(blush)%d pieces in the museum now, thanks to you." %
                       n if vid == "juniper" else "Juniper's ever so proud "
                       "of her museum. %d pieces now!" % n)
        was = [c for c in st["chickens"] + st["cows"] + st["pets"]
               if c.get("was")]
        if was:
            c = random.choice(was)
            out.append("Is it true %s on your farm used to be %s? %s" % (
                c["name"], an(MONSTERS[c["was"]].name), random.choice((
                    "Perfectly ordinary, I'm told.",
                    "You'd never know to look at her.",
                    "I'm not sure I'd turn my back on her."))))
        if any(k.startswith("valley:") for k in st.get("decor", ())):
            out.append("There's a golden monster standing on your farm! "
                       "People walk all the way out just to look at it.")
        if "greenhouse" in self.built():
            out.append("Fresh crops in the dead of winter! That greenhouse "
                       "of yours is the talk of the valley.")
        for old, new in MINE_NEWS_SELF.get(vid, ()):    # about themselves
            out = [line.replace(old, new) for line in out]
        return out

    def farm_talk(self, vid):
        n = len(self.st["soil"])
        if n == 0:
            return "Have you planted anything yet? Mabel sells seeds."
        if n < 20:
            return "A little garden's a good start."
        return "(happy)Your farm's coming along wonderfully!"

    def love_talk(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        if f["status"] == "married":
            return "(blush)We're married, silly. I love you."
        if f["status"] in ("dating", "engaged"):
            return "(blush)You know how I feel about you."
        if not v["romance"]:
            return "(laugh)Oh, you charmer! Not for me, I'm afraid."
        if self.hearts(vid) >= 8:
            return "(blush)...Maybe if someone gave me a bouquet, I'd say " \
                   "yes. Just maybe."
        return "(surprised)Oh! Um. Let's get to know each other first."

    # ── Gifts ──

    def gift_menu(self, vid):
        items = sorted(n for n, c in self.p["items"].items()
                       if c and not n.endswith(" seeds")
                       and n != "sprinkler" and n not in STATUE_OF)
        if not items:
            self.talk["mode"] = "kw"
            self.speak(vid, "You've nothing to give right now.", log=False)
            self.say("You've nothing to give.", "info")
            self.talk_menu()
            return

        def back():
            self.talk["mode"] = "kw"
            self.talk_menu()
        self.open_menu("Give %s what?" % VILLAGERS[vid]["short"], [
            ("%s%s" % (n, " x%d" % self.p["items"][n]
                       if self.p["items"][n] > 1 else ""),
             lambda n=n: self.give_gift(vid, n)) for n in items] +
            [("Nothing", back)], back)

    def give_gift(self, vid, item):
        self.talk["mode"] = "kw"
        v = VILLAGERS[vid]
        f = self.friend(vid)
        st = self.st
        self.say("> (you give %s %s)" % (v["short"], an(item)), "you")
        if item == "blossom bouquet":
            self.bouquet(vid)
            self.talk_menu()
            return
        if item == "blossom pendant":
            self.pendant(vid)
            self.talk_menu()
            return
        birthday = v["birthday"] == (self.season(), self.dom())
        secret = (self.festival_on() and self.season() == 3 and
                  vid == st.get("secret"))
        if f["gift_day"] == st["day"]:
            self.speak(vid, "You've already given me something today. "
                            "That's plenty!")
            self.talk_menu()
            return
        if f["week"] >= 2 and not birthday and not secret and \
                f["status"] != "married":
            self.speak(vid, "You've been so generous this week! Save it "
                            "for someone else.")
            self.talk_menu()
            return
        self.take(item)
        taste = gift_taste(vid, item)
        pts = GIFT_POINTS[taste]
        if birthday:
            pts *= 5 if pts > 0 else 2
        if secret:
            pts = max(pts, 0) * 3 + 100
        f["gift_day"] = st["day"]
        f["week"] += 1
        self.speak(vid, v["gift"][taste])
        if birthday and pts > 0:
            self.speak(vid, "(happy)And on my birthday, too!")
        if secret:
            self.speak(vid, "(laugh)You're my secret friend?! I'd never "
                            "have guessed!")
            st["flags"].append("secret_done%d" % self.year())
        self.befriend(vid, pts)
        self.check_scene(vid)
        if not self.scene:
            self.talk_menu()

    def bouquet(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        other = self.partner()
        if not v["romance"]:
            self.speak(vid, "(surprised)Oh! Flowers! That's very sweet of "
                            "you, but I'm not looking for anything like "
                            "that.")
            return
        if f["status"]:
            self.speak(vid, "(blush)We're already together, silly. But "
                            "thank you.")
            return
        if other or self.mm_partner():
            self.speak(vid, "(sad)Aren't you with %s?" % self.partner_name())
            return
        if self.hearts(vid) < 8:
            self.speak(vid, "(blush)Oh... I like you, {name}. But not like "
                            "that. Not yet.")
            return
        self.take("blossom bouquet")
        f["status"] = "dating"
        self.sound.play("quest")
        self.speak(vid, ACCEPT[vid])
        if self.maid(vid):
            self.speak(vid, random.choice(self.maid_romance(
                vid, MAID_ACCEPT)))
        self.say("You and %s are going steady!" % v["short"], "heart")
        self.flash(self.npcs[vid].x, self.npcs[vid].y, "heart")

    def pendant(self, vid):
        v = VILLAGERS[vid]
        f = self.friend(vid)
        if f["status"] != "dating" or self.hearts(vid) < 10:
            if f["status"] in ("engaged", "married"):
                self.speak(vid, "(blush)You already asked. I already said "
                                "yes!")
            elif f["status"] == "dating":
                self.speak(vid, "(blush)Oh! It's beautiful. I... I'm not "
                                "ready for that yet. Give it time.")
            else:
                self.speak(vid, "(surprised)A pendant?! We're not even "
                                "courting!")
            return
        if not self.p["extension"]:
            self.speak(vid, "(blush)Yes! Of course yes! ...But where would "
                            "we live? Your cabin barely fits you. Talk to "
                            "Ivy about a bigger CABIN?")
            self.st["topics"].append("cabin")
            return
        self.take("blossom pendant")
        f["status"] = "engaged"
        self.st["wedding"] = self.st["day"] + 3
        self.sound.play("quest")
        self.speak(vid, PROPOSAL[vid])
        if self.maid(vid):
            self.speak(vid, random.choice(self.maid_romance(
                vid, MAID_PROPOSAL)))
        self.say("You're engaged to %s! The wedding will be in three days, "
                 "in the square, at ten in the morning." % v["short"],
                 "heart")

    # ── Scenes ──

    def check_scene(self, vid):
        """Somebody you've grown close to shares a moment: True if a scene
        has begun."""
        v = VILLAGERS[vid]
        f = self.friend(vid)
        for level in sorted(v["scenes"]):
            if level not in f["scenes"] and self.hearts(vid) >= level:
                f["scenes"].append(level)
                self.play_scene(vid, v["scenes"][level], level)
                return True
        return False

    def play_scene(self, vid, steps, level=None, after=None):
        self.scene = {"v": vid, "steps": list(steps), "i": 0,
                      "level": level, "after": after}
        self.menu = None
        if not self.talk:
            self.talk = {"v": vid, "mode": "kw", "expr": "neutral",
                         "text": ""}
        self.sound.play("heart")
        self.scene_step()

    def scene_step(self):
        sc = self.scene
        vid = sc["v"]
        if sc["i"] >= len(sc["steps"]):
            gift = SCENE_GIFTS.get((vid, sc["level"]))
            if gift:
                self.give(gift)
                self.say("(You receive %s.)" % an(gift), "good")
            after = sc["after"]
            self.scene = None
            if after:
                after()
            elif self.talk:
                self.talk_menu()
            return
        step = sc["steps"][sc["i"]]
        sc["i"] += 1
        if isinstance(step, tuple):
            _, question, answers = step
            self.speak(vid, "*" + question)

            def answer(a):
                text, pts, reply = a
                self.say("> " + text, "you")
                if pts:
                    self.befriend(vid, pts, quiet=True)
                self.speak(vid, reply)
                self.open_menu("", [("▶", self.scene_step)],
                               self.scene_step)
            self.open_menu("", [(a[0], lambda a=a: answer(a))
                                for a in answers])
            return
        self.speak(vid, step)
        self.open_menu("", [("▶", self.scene_step)], self.scene_step)

    # ── Shops ──

    def shop_open(self, vid):
        shop = VILLAGERS[vid]["shop"]
        if not shop or self.festival_on() or self.maid(vid):
            return False
        n = self.npcs[vid]
        area, mark = shop[0].split(".")
        if area == "out":
            spot = ("valley",) + OUT_SPOTS[mark]
        else:
            spot = (area,) + self.areas[area].spots[mark]
        return (n.where, n.x, n.y) == spot

    def offers(self, vid):
        kind = VILLAGERS[vid]["shop"][1]
        out = []
        for entry in SHOP_STOCK[kind]:
            if entry == "seeds":
                for c in sorted(CROPS):         # all year, for a greenhouse
                    if self.season() in crop(c, "seasons") or \
                            "greenhouse" in self.built():
                        out.append((c + " seeds", crop(c, "seed")))
                continue
            name, price = entry
            if name in ("fishing rod", "leash", "milk pail", "shears") and \
                    name in self.p["tools"]:
                continue
            if name in ("barn", "greenhouse") and name in self.built():
                continue
            if name in ("cat", "dog") and len(self.st["pets"]) >= PET_ROOM:
                continue
            if name in ("cow", "sheep") and ("barn" not in self.built() or len(
                    self.st["cows"]) >= BARN_ROOM):
                continue
            if name in WEAPONS and name in self.p["tools"]:
                continue
            if name == "cabin extension" and self.p["extension"]:
                continue
            if name == "chicken coop" and "coop" in self.built():
                continue
            if name == "chicken" and ("coop" not in self.built() or len(
                    self.st["chickens"]) >= COOP_ROOM):
                continue
            if name == "blossom pendant" and not (
                    self.partner() and self.hearts(self.partner()) >= 10
                    or self.mm_partner() and self.mm_hearts(
                        self.mm_partner()) >= 10):
                continue
            if name == "checkup" and "checkup" in self.flags_today():
                continue
            out.append((name, price))
        if kind == "smithy":
            for tool in UPGRADABLE:
                lv = self.lv(tool)
                if tool in self.p["tools"] and lv < len(METALS):
                    out.append(("%s %s" % (METALS[lv], tool),
                                UPGRADE_PRICE[lv]))
        return out

    def shop_menu(self, vid):
        def back():
            self.talk["mode"] = "kw"
            self.talk_menu()
        rows = []
        for name, price in self.offers(vid):
            extra = EXTRA_COST.get(name, {})
            label = "%s%s  %s" % (
                name, " x%d" % BUNDLES[name] if name in BUNDLES else "",
                "%dg" % price if price else "free")
            if extra:
                label += " + " + ", ".join("%d %s" % (c, n)
                                           for n, c in extra.items())
            if name.endswith(" seeds") or name == "hay":
                rows.append((label, lambda n=name, pr=price:
                             self.how_many(vid, n, pr)))
            else:
                rows.append((label, lambda n=name, pr=price:
                             self.buy(vid, n, pr)))
        rows.append(("Nothing, thanks", back))
        self.open_menu("Buy what? (you have %dg)" % self.p["gold"], rows,
                       back)

    def how_many(self, vid, name, price):
        rows = [("%d for %dg" % (k, k * price),
                 lambda k=k: self.buy(vid, name, price, k))
                for k in (1, 5, 10, 20) if k * price <= self.p["gold"]]
        if not rows:
            self.speak(vid, "You can't afford that.")
            return
        self.open_menu("How many %s?" % name, rows +
                       [("None", lambda: None)], lambda: None)

    def buy(self, vid, name, price, k=1):
        p = self.p
        extra = EXTRA_COST.get(name, {})
        if k > 1:
            if p["gold"] < price * k:
                self.speak(vid, "You can't afford that many.")
                return
            p["gold"] -= price * k
            self.give(name, k)
            self.sound.play("gold")
            self.say("You buy %d %s for %dg." % (k, name, price * k), "gold")
            return
        if p["gold"] < price:
            self.speak(vid, "You can't afford that.")
            self.say("You can't afford it.", "bad")
            return
        for n, c in extra.items():
            if p["items"].get(n, 0) < c:
                self.speak(vid, "I'll need %d %s for that." % (c, n))
                return
        p["gold"] -= price
        for n, c in extra.items():
            self.take(n, c)
        self.sound.play("gold")
        metal, _, tool = name.partition(" ")
        if metal in METALS and tool in UPGRADABLE:
            lv = METALS.index(metal) + 1
            p.setdefault("tool_lv", {})[tool] = lv
            if tool == "watering can":
                p["can"] = p["water"] = CAN_SIZE[lv]
            self.speak(vid, "(happy)%s" % {
                "hoe": "There. It'll turn over %d squares in a row now, "
                       "and it's lighter in the hand." % REACH[lv],
                "watering can": "Holds %d now, and waters %d squares in a "
                                "row." % (CAN_SIZE[lv], REACH[lv]),
                "axe": "Keen as anything. %s" % (
                    "One swing'll fell a tree." if AXE_CHOPS[lv] == 1 else
                    "Two swings to fell a tree."),
                "pickaxe": "That'll go through %s now." % (
                    "anything in that mine" if lv == 3 else
                    "a vein of " + METALS[lv]),
                "scythe": "Cuts twice the fiber for half the sweat.",
            }.get(tool, "Better balanced, and it bites deeper. Mind the "
                        "edge."))
            self.say("Otto makes your %s %s." % (tool, metal), "gold")
            return
        if name.endswith(" bar") and name.split()[0] in METALS:
            self.give(name)
            self.speak(vid, "(happy)Into the forge with it... There. One "
                            "%s, still warm." % name)
            return
        if name in ("fishing rod", "leash", "milk pail", "shears",
                    "short sword", "broadsword"):
            if name in p["tools"]:
                p["gold"] += price
                for n, c in extra.items():
                    self.give(n, c)
                self.speak(vid, "You've already got one of those!")
                return
            p["tools"].append(name)
            p["hand"] = name
            if name in WEAPONS:
                self.speak(vid, "(happy)Good steel, that. You'll be wanting "
                                "it for the old mine up in the woods, I "
                                "suppose. My grandad worked it, before the "
                                "things moved in. Mind your energy down "
                                "there: get knocked flat and you'll come up "
                                "with empty pockets.")
                return
            if name == "shears":
                self.speak(vid, "(happy)Good sharp shears. A sheep's ready "
                                "for a trim every third day; you'll see "
                                "her go all fluffy.")
                return
            if name == "milk pail":
                self.speak(vid, "(happy)A good pail. Once a day per cow, "
                                "every other day for a sheep, mind. They "
                                "have opinions about that.")
                return
            if name == "leash":
                self.speak(vid, "(laugh)A leash? For a chicken? Well, it's "
                                "your gold. Mind she doesn't lead YOU.")
                return
        elif name == "cow":
            c = self.add_cow()
            self.speak(vid, "(happy)She's in your barn already. Her name's "
                            "%s. Milk her once a day and she'll be happy "
                            "as anything." % c["name"])
            return
        elif name in ("cat", "dog"):
            c = self.add_pet(name)
            self.sound.play("meow" if name == "cat" else "bark")
            self.speak(vid, "(happy)%s's yours! She'll be %s. Pet her every "
                            "day and she'll love you to bits." % (
                                c["name"], "curled up in your cabin" if
                                name == "cat" else "out in your farmyard, "
                                "guarding the place"))
            return
        elif name == "sheep":
            c = self.add_sheep()
            self.sound.play("baa")
            self.speak(vid, "(happy)She's in your barn with the others. "
                            "Her name's %s. Milk her every other day, and "
                            "shear her when she's gone all fluffy, every "
                            "third day or so." % c["name"])
            return
        elif name == "greenhouse":
            self.build_on_farm("greenhouse")
            self.speak(vid, "(happy)There! Glass on every side, up past "
                            "your coop. Anything'll grow in there, summer or "
                            "snow. You still have to water it, mind.")
            return
        elif name == "barn":
            self.build_barn()
            self.speak(vid, "(happy)There. A proper barn, up by your fields. "
                            "Room for ten cows and sheep. Mabel sells "
                            "them, and the pail and shears.")
            return
        elif name == "chicken coop":
            self.build_coop()
            self.speak(vid, "(happy)Done and dusted. Your coop's up beside "
                            "the cabin. Room for eight hens. Go see Mabel "
                            "about chickens.")
            return
        elif name == "chicken":
            c = self.add_chicken()
            self.speak(vid, "(happy)One hen, healthy and laying! She's "
                            "called %s. I've had her sent up to your "
                            "coop." % c["name"])
            return
        elif name == "cabin extension":
            p["extension"] = True
            self.speak(vid, "(happy)Deal. I'll have it done by morning. A "
                            "proper bedroom, room for two. Just saying.")
            return
        elif name == "checkup":
            self.flags_today().append("checkup")
            p["energy"] = min(p["max_energy"], p["energy"] + 30)
            self.speak(vid, "(happy)Heart's good, lungs are good. Here, "
                            "some water and a rest. (+30 energy)")
            return
        else:
            self.give(name, BUNDLES.get(name, 1))
            if name in MACHINES:
                p["hand"] = name
                self.speak(vid, MACHINE_SOLD[name])
        self.say("You buy %s for %dg." % (
            "%d %s" % (BUNDLES[name], name) if name in BUNDLES else
            an(name), price), "gold")

    # ── Festivals ──

    def fest_key(self):
        return "fest%d-%d" % (self.season(), self.year())

    def dance(self, vid):
        st = self.st
        k = self.fest_key()
        if k in st["flags"]:
            self.speak(vid, "(happy)You've already had your dance! Wasn't "
                            "it lovely?")
            return
        if self.hearts(vid) < 4:
            self.speak(vid, "(blush)Oh! I... don't think I know you well "
                            "enough yet. Sorry!")
            return
        st["flags"].append(k)
        self.sound.play("quest")
        self.say("You dance with %s beneath the blossoms while Wren plays. "
                 "Petals fall like snow." % VILLAGERS[vid]["short"], "heart")
        self.speak(vid, "(blush)That was wonderful. Thank you, {name}.")
        self.befriend(vid, 250 if VILLAGERS[vid]["romance"] else 150)
        self.pass_time(30)

    def share_menu(self, vid):
        if self.fest_key() in self.st["flags"]:
            self.speak(vid, "(happy)You've already shared! Everyone's "
                            "still talking about it.")
            self.talk_menu()
            return
        food = sorted(n for n, c in self.p["items"].items()
                      if c and ITEMS.get(n, (0, 0, "?"))[2] in
                      ("crop", "food", "fruit", "fish", "forage", "animal")
                      and ITEMS[n][1])
        if not food:
            self.speak(vid, "Bring something to share! Anything you can "
                            "eat.")
            self.talk_menu()
            return

        def share(n):
            self.take(n)
            self.st["flags"].append(self.fest_key())
            self.sound.play("quest")
            self.speak(vid, "(happy)%s! Into the pot it goes! Everyone, "
                            "%s brought %s!" % (cap(n), "{name}", an(n)))
            for o in VILLAGERS:
                self.befriend(o, 30 + ITEMS[n][0] // 10, quiet=True)
            self.say("The whole village enjoys your %s. (Everyone +"
                     "friendship)" % n, "heart")
            self.talk_menu()
        self.open_menu("Share what?", [(n, lambda n=n: share(n))
                                       for n in food] +
                       [("Never mind", self.talk_menu)], self.talk_menu)

    def enter_menu(self, vid):
        if self.fest_key() in self.st["flags"]:
            self.speak(vid, "You've entered already! The judging's done.")
            self.talk_menu()
            return
        crops = sorted(n for n, c in self.p["items"].items()
                       if c and ITEMS.get(n, (0, 0, "?"))[2] in
                       ("crop", "fruit"))
        if not crops:
            self.speak(vid, "Bring your best crop to enter! Anything you "
                            "grew yourself.")
            self.talk_menu()
            return

        def enter(n):
            self.take(n)
            self.st["flags"].append(self.fest_key())
            score = ITEMS[n][0] + random.randint(0, 90) + \
                len(self.st["soil"]) // 4
            prize, place = ((1000, "First") if score >= 220 else
                            (500, "Second") if score >= 120 else
                            (200, "Third"))
            self.p["gold"] += prize
            self.sound.play("quest")
            self.speak(vid, "(happy)Ahem! The judges have tasted, weighed "
                            "and admired! %s prize, for %s's magnificent "
                            "%s! %d gold!" % (place, "{name}", n, prize))
            self.befriend(vid, 100)
            self.talk_menu()
        self.open_menu("Enter which crop?", [(n, lambda n=n: enter(n))
                                             for n in crops] +
                       [("Never mind", self.talk_menu)], self.talk_menu)

    # ── Dates, and the wedding ──

    def go_on_date(self, vid):
        f = self.friend(vid)
        f["dated"] = self.st["day"]
        v = VILLAGERS[vid]

        def done():
            self.befriend(vid, 60)
            self.pass_time(120)
            self.settle_npcs()
            if self.talk:
                self.talk_menu()
        self.play_scene(vid, v["date"], after=done)

    def wedding(self):
        vid = self.partner()
        if not vid:
            m = self.mm_partner()
            if m and m["status"] == "engaged":
                self.mm_wedding(m)
            return
        v = VILLAGERS[vid]
        st = self.st
        drift = ("Apple blossom petals drift", "Summer sunlight dances",
                 "Golden leaves drift", "Snowflakes drift")[self.season()]
        music = ("Theo sings, badly, and nobody minds." if vid == "wren"
                 else "Wren plays something soft on her fiddle.")
        steps = ["*The whole village gathers in the square. %s over the "
                 "fountain." % drift,
                 "*Mayor Pell clears his throat. Bernard is already "
                 "crying. %s" % music,
                 VOWS[vid],
                 "*Everyone cheers. Pip throws far too much confetti.",
                 "(happy)Let's go home, {name}. Our home."]
        if self.maid(vid):
            name = v["short"]
            b = st.get("bikinis", {}).get(vid)
            if b:
                look = ("*%s comes up the aisle in %s and a long lace "
                        "veil. Agnes Whitlock has to sit down." % (
                            name, self.outfit_words(vid)))
            elif self.outfit(vid) != "uniform":
                look = ("*%s comes up the aisle in %s, with a veil, and "
                        "looks lovely." % (name, self.outfit_words(vid)))
                if self.season() == 3:
                    look += " Snow settles on %s's bare shoulders; she " \
                            "is trying very hard not to shiver." % name
            else:
                look = ("*%s comes up the aisle in her maid's dress, the "
                        "frilled cap traded for a veil, the apron starched "
                        "and pressed for the day." % name)
            steps.insert(2, look)
            steps[-1] = random.choice(self.maid_romance(vid, MAID_VOWS))
        def after():
            st["friends"][vid]["status"] = "married"
            st["spouse"] = vid
            st["married_day"] = st["day"]
            st["wedding"] = None
            self.say("You and %s are married!" % v["short"], "heart")
            self.end_talk()
            self.settle_npcs()
            self.save()
        self.play_scene(vid, steps, after=after)

    def spouse_morning(self):
        vid = self.st["spouse"]
        if not vid or random.random() < 0.4:
            return
        if vid.startswith("mm:"):
            m = next((m for m in self.mmaids()
                      if "mm:%d" % m["id"] == vid), None)
            if m:
                self.mm_spouse_morning(m)
            return
        v = VILLAGERS[vid]["short"]
        if self.maid(vid):
            v += (", apron and all," if self.outfit(vid) == "uniform" else
                  ", in %s," % self.outfit_words(vid))
        r = random.random()
        if r < 0.4 and self.st["soil"] and self.st["weather"] == "sun":
            for s in self.st["soil"].values():
                s[0] = 1
            self.say("%s watered all the crops before you woke up." % v,
                     "heart")
        elif r < 0.75:
            food = random.choice(("pancakes", "bread", "honey cake",
                                  "stew"))
            self.give(food)
            self.say("%s made you breakfast: %s, wrapped for later." % (
                v, food), "heart")
        else:
            self.say("%s fixed the fence and left you a note: 'Love "
                     "you.'" % v, "heart")

    def mm_spouse_morning(self, m):
        r = random.random()
        if r < 0.3 and self.st["soil"] and self.st["weather"] == "sun":
            for s in self.st["soil"].values():
                s[0] = 1
            self.say("%s watered all the crops before you woke up." %
                     m["name"], "heart")
        elif r < 0.6:
            food = random.choice(("pancakes", "bread", "honey cake",
                                  "stew"))
            self.give(food)
            self.say("%s made you breakfast: %s, wrapped for later." % (
                m["name"], food), "heart")
        else:
            self.say("%s %s." % (m["name"],
                                 MONSTER_ROMANCE[m["kind"]]["morning"]),
                     "heart")

    # ── The morning ──

    def morning_news(self):
        st = self.st
        self.say("%s. %s" % (self.date_text(), WEATHER_TEXT[st["weather"]]),
                 "quest")
        f = self.festival_today()
        if f:
            self.say("Today is the %s! (%s-%s, the %s.) %s" % (
                f[0], self.clock(f[1] // 100 * 60), self.clock(
                    f[2] // 100 * 60), f[3], f[4]), "quest")
        for vid, v in VILLAGERS.items():
            if v["birthday"] == (self.season(), self.dom()):
                self.say("It's %s's birthday!" % v["short"], "heart")
        tomorrow = st["day"] + 1
        f2 = FESTIVALS.get((self.season(tomorrow), self.dom(tomorrow)))
        if f2:
            self.mail("Mayor Edmund Pell",
                      "Don't forget: tomorrow is the %s! %s From %s to %s "
                      "in the %s. Everyone will be there!" % (
                          f2[0], f2[4], self.clock(f2[1] // 100 * 60),
                          self.clock(f2[2] // 100 * 60), f2[3]))
        for vid, v in VILLAGERS.items():
            if v["birthday"] == (self.season(tomorrow), self.dom(tomorrow)) \
                    and self.friend(vid)["met"]:
                self.mail("Granny Rose",
                          "A little reminder, dear: tomorrow is %s's "
                          "birthday. A thoughtful gift goes a long way." %
                          v["short"])
        if self.season() == 3 and self.dom() == 17:
            st["secret"] = random.choice(sorted(VILLAGERS))
            self.mail("Mayor Edmund Pell",
                      "The Long Night Feast is on the 24th! This year your "
                      "secret friend is... %s! Bring them a gift at the "
                      "feast." % VILLAGERS[st["secret"]]["name"])
        r = st["request"]
        if r and r["due"] < st["day"]:
            self.say("%s's request on the notice board has expired." %
                     VILLAGERS[r["who"]]["short"], "info")
            st["request"] = None
        if not st["request"] and random.random() < 0.5:
            self.new_request()
        if any(not m["read"] for m in st["mail"]):
            self.say("There's mail in your mailbox.", "info")
        if st["wedding"] is not None and st["wedding"] < st["day"]:
            st["wedding"] = st["day"]
            self.say("You missed your wedding! Everyone's agreed to try "
                     "again today.", "bad")
        if st["wedding"] == st["day"]:
            self.say("Today's your wedding day! Go to the square between "
                     "ten and three.", "heart")
        self.teach_recipes()
        self.kid_mornings()
        for m in self.mmaids():
            if self.mm_hearts(m) >= 4:
                self.mm_teach(m)
        self.spouse_morning()
        self.pet_mornings()             # before the maids give today's fuss
        self.maid_morning()

    def new_request(self):
        s = self.season()
        pool = [c for c in CROPS if s in crop(c, "seasons")] + \
            [f[0] for f in FORAGE[s]] + FISH["river"][s][:2]
        item = random.choice(pool)
        who = random.choice(sorted(VILLAGERS))
        n = 1 if ITEMS[item][0] > 100 else random.randint(1, 3)
        self.st["request"] = {"who": who, "item": item, "n": n,
                              "due": self.st["day"] + 3,
                              "reward": ITEMS[item][0] * n * 3 + 60}

    def read_board(self):
        r = self.st["request"]
        f = self.festival_today()
        lines = ["THE NOTICE BOARD", ""]
        if r:
            lines += wrap("HELP WANTED: %s needs %d %s, by %s %d. Reward: "
                          "%dg. (Bring it to them and ask about the "
                          "REQUEST.)" % (VILLAGERS[r["who"]]["name"], r["n"],
                                         plural(r["item"], r["n"]),
                                         SEASONS[self.season(r["due"])],
                                         self.dom(r["due"]), r["reward"]),
                          50)
        else:
            lines.append("No requests today.")
        lines.append("")
        for d in range(0, 28):
            day = self.st["day"] + d
            f = FESTIVALS.get((self.season(day), self.dom(day)))
            if f:
                lines += wrap("COMING UP: the %s, %s %d. %s" % (
                    f[0], SEASONS[self.season(day)], self.dom(day), f[4]),
                    50)
                break
        lines.append("")
        lines.append("LOST: one cat, orange, answers to Biscuit. - M. Pike")
        self.st["topics"].append("request") if "request" not in \
            self.st["topics"] else None
        self.show_text("\n".join(lines) + "\n\n(Any key closes.)")

    def deliver(self, vid):
        r = self.st["request"]
        if not r or r["who"] != vid:
            self.speak(vid, "I don't need anything right now. Thanks, "
                            "though!")
            return
        if self.p["items"].get(r["item"], 0) < r["n"]:
            self.speak(vid, "I'm still hoping for %d %s, if you come "
                            "across any!" % (r["n"], plural(r["item"],
                                                            r["n"])))
            return
        self.take(r["item"], r["n"])
        self.p["gold"] += r["reward"]
        self.st["request"] = None
        self.sound.play("quest")
        self.speak(vid, "(happy)You found them! Thank you so much! Here, "
                        "%dg, as promised." % r["reward"])
        self.befriend(vid, 120)

    # ── Keys ──

    def on_key(self, ev):
        k = ev.keysym
        if getattr(self, "dialog", None) is not None:
            return
        if getattr(self, "naming", None) is not None:
            if k == "Escape":
                self.end_naming()
            return
        if self.talk and ev.widget is self.entry:
            # typing a word: the entry has it, but arrows still move
            # through the menu, and Return picks from it when it's empty
            if self.menu and k in ("Up", "Down"):
                self.menu_move(-1 if k == "Up" else 1)
            return
        if self.menu:
            if k in ("Up", "w", "KP_Up", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "KP_Down", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "KP_Enter", "space", "e"):
                self.menu_pick()
            elif k == "Escape":
                self.menu_cancel()
            elif k.isdigit() and k != "0":
                i = int(k) - 1
                m = self.menu
                if i < len(m["items"]):
                    self.menu_pick(i)
            elif self.talk and len(ev.char) == 1 and ev.char.isalpha() \
                    and not self.scene and not self.talk.get("mm") and \
                    not self.talk.get("kid") and not self.talk.get("who"):
                self.menu = None
                self.entry.focus_set()
                self.entry.insert("end", ev.char)
                self.render()
            return "break"
        if self.overlay:
            self.close_overlay()
            return
        if self.talk:
            return
        if not self.p or self.busy:
            return
        ctrl = ev.state & 0x4
        if getattr(self, "aim", False):
            if k in MOVE_KEYS and not ctrl:
                self.zap(*MOVE_KEYS[k])
            elif k in ("space", "e", "Return", "KP_Enter"):
                self.zap()
            elif k == "Escape":
                self.cancel_aim()
            return
        if k in MOVE_KEYS and not ctrl:
            self.walking = None
            self.move(*MOVE_KEYS[k])
        elif k in ("space", "e", "Return", "KP_Enter"):
            self.use_tool()
        elif k in ("q", "Tab"):
            self.next_tool(1)
        elif k in ("Q", "ISO_Left_Tab"):
            self.next_tool(-1)
        elif k.isdigit() and k != "0":
            self.pick_tool(int(k) - 1)
        elif k == "i":
            self.bag_menu()
        elif k == "z":
            self.wait_menu()
        elif k == "f":
            self.show_friends()
        elif k == "j":
            self.show_diary()
        elif k == "m":
            self.toggle_map()
        elif k in ("question", "slash", "h"):
            self.show_help()
        elif k == "v":
            self.toggle_mute()
        elif k == "b":
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "KP_Subtract"):
            self.zoom(-1)
        elif k == "n":
            self.ask_new_game()
        elif k == "Escape":
            self.action_menu()

    def close_overlay(self):
        self.overlay = None
        self.overlay_text = None
        self.render()

    def show_text(self, text):
        self.overlay = "text"
        self.overlay_text = text
        self.render()

    # ── Menus ──

    def open_menu(self, title, items, cancel=None):
        self.menu = {"title": title, "items": items, "sel": 0,
                     "cancel": cancel}
        self.render()

    def menu_move(self, d):
        m = self.menu
        m["sel"] = (m["sel"] + d) % len(m["items"])
        self.render()

    def menu_pick(self, i=None):
        if i in ("up", "down"):
            m = self.menu
            page = m.get("page", 1)
            m["sel"] = max(0, min(len(m["items"]) - 2, m["sel"] + (
                page if i == "down" else -page)))
            self.render()
            return
        m, self.menu = self.menu, None
        self.render()
        m["items"][m["sel"] if i is None else i][1]()
        self.back_to_talk()

    def menu_cancel(self):
        if self.scene and self.menu and not self.menu["cancel"]:
            return              # a scene's choice has to be answered
        m, self.menu = self.menu, None
        if m is None:
            return
        self.render()
        if m["cancel"]:
            m["cancel"]()
        self.back_to_talk()

    def back_to_talk(self):
        """After a choice in a conversation, carry on talking."""
        if self.talk and not self.menu and not self.scene:
            self.talk_menu()

    def draw_menu(self):
        """The menu: in the middle of the map, or, while you're talking,
        above the conversation on the right."""
        c, m = self.canvas, self.menu
        W, H = c.winfo_width(), c.winfo_height()
        size = 15 if ANDROID else 13
        f, bold = F("Helvetica", size), F("Helvetica", size, "bold")
        rh = f.metrics("linespace") + S(14 if ANDROID else 8)
        labels = [label for label, _ in m["items"]]
        title = m["title"]
        top_y, bottom_y = 8, H - 8
        if self.talk:
            bottom_y = self.talk_box_top - S(6)
        bw = min(W - 20, max([f.measure(t) for t in labels] +
                             [bold.measure(title) if title else 0]) + 40)
        if title and bold.measure(title) > bw - 40:
            title = "\n".join(wrap(title, max(20, len(title) * (bw - 40) //
                                              bold.measure(title))))
        th = (title.count("\n") + 1) * rh if title else 0
        fit = max(1, (bottom_y - top_y - th - 16) // rh)
        n_items = len(labels)
        if n_items <= fit:
            shown = list(enumerate(labels))
        else:
            page = max(1, fit - 3)
            m["page"] = page
            first = max(0, min(m["sel"] - page // 2, n_items - 1 - page))
            shown = [("up", "▲ more" if first else "")] + \
                [(i, labels[i]) for i in range(first, first + page)] + \
                [("down", "▼ more" if first + page < n_items - 1
                  else ""), (n_items - 1, labels[-1])]
        bh = len(shown) * rh + th + 16
        if self.talk:
            x0 = W - bw - 10
            y0 = max(top_y, bottom_y - bh)
        else:
            x0, y0 = (W - bw) // 2, max(8, (H - bh) // 2)
        c.create_rectangle(x0, y0, x0 + bw, y0 + bh, fill=PANEL,
                           outline=ACCENT, width=2, tags="overlay")
        if title:
            c.create_text(x0 + 20, y0 + 8 + th // 2, text=title, anchor="w",
                          fill=ACCENT, font=bold, tags="overlay")
        self.menu_rows = []
        for n, (i, label) in enumerate(shown):
            ry = y0 + 8 + th + n * rh
            if i == m["sel"]:
                c.create_rectangle(x0 + 6, ry, x0 + bw - 6, ry + rh,
                                   fill="#5a3450", outline="",
                                   tags="overlay")
            if isinstance(i, str):
                if label:
                    c.create_text(x0 + bw // 2, ry + rh // 2, text=label,
                                  fill=ACCENT, font=f, tags="overlay")
                    self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))
                continue
            c.create_text(x0 + 20, ry + rh // 2, text=label, anchor="w",
                          fill=INK, font=f, tags="overlay")
            self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))

    def action_menu(self):
        if self.busy or self.talk:
            return
        self.overlay = None
        self.open_menu("Apple Blossom Village", [
            ("Help", self.show_help), ("Your bag", self.bag_menu),
            ("Hold a tool", self.tool_menu), ("Friends", self.show_friends),
            ("Diary", self.show_diary), ("Map", self.toggle_map),
            ("Wait...", self.wait_menu),
            ("Zoom in", lambda: self.zoom(1)),
            ("Zoom out", lambda: self.zoom(-1)),
            ("Bigger text", lambda: self.text_size(1)),
            ("Smaller text", lambda: self.text_size(-1)),
            ("Sound effects %s" % ("on" if self.sound.muted else "off"),
             self.toggle_mute),
            ("Music %s" % ("on" if self.sound.music_off else "off"),
             self.toggle_music),
            ("New game", self.ask_new_game), ("Quit", self.quit)])

    def wait_menu(self):
        if not self.ready():
            return
        rows = [("Ten minutes", lambda: self.wait_for(10)),
                ("An hour", lambda: self.wait_for(60))]
        h = self.hhmm()
        if h < 1800:
            rows.append(("Until evening", lambda: self.wait_for(
                18 * 60 - self.st["minute"])))
        if self.area.key == "cabin":
            rows.append(("Go to bed", self.sleep))
        rows.append(("Never mind", lambda: None))
        self.open_menu("Wait how long?", rows)

    def wait_for(self, minutes):
        self.say("You wait a while.", "info")
        self.pass_time(minutes)
        if minutes >= 30:
            self.settle_npcs()
        self.render()

    def ask_new_game(self):
        if self.busy:
            return
        self.open_menu("Start over? This farm will be lost.",
                       [("Yes, a new farmer", lambda: self.new_game()),
                        ("No", lambda: None)])

    # ── Taps and walking ──

    def on_tap(self, ev):
        self.walking = None
        if not self.cells:
            return
        if self.menu:
            for x0, y0, x1, y1, i in self.menu_rows:
                if x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
                    self.menu_pick(i)
                    return
            if self.scene:
                self.menu_pick(0) if len(self.menu["items"]) == 1 else None
                return
            if not self.talk:
                self.menu_cancel()
            return
        if self.busy or self.talk:
            return
        if self.overlay:
            self.close_overlay()
            return
        cols, rows, ox, oy, ts = self.view
        tx = self.cam[0] + (ev.x - ox) // ts
        ty = self.cam[1] + (ev.y - oy) // ts
        x, y = self.pos()
        dx, dy = tx - x, ty - y
        if getattr(self, "aim", False):
            if (dx, dy) == (0, 0):
                self.zap()
            elif abs(dx) >= abs(dy):
                self.zap(1 if dx > 0 else -1, 0)
            else:
                self.zap(0, 1 if dy > 0 else -1)
            return
        if self.held() == "magic wand" and (dx == 0) != (dy == 0) and \
                self.ready():
            d = (0 if dx == 0 else dx // abs(dx),
                 0 if dy == 0 else dy // abs(dy))
            n = self.wand_target(*d)
            if n and (n.x, n.y) == (tx, ty):
                self.start_aim(d)       # tapped someone in line: which spell?
                return
        if (dx, dy) == (0, 0):
            self.use_tool()
        elif abs(dx) + abs(dy) == 1:
            self.face(dx, dy)
            k = "%d,%d" % (tx, ty)
            if self.area.outdoor and k in self.st["droppings"] and \
                    self.npc_at(tx, ty) is None and self.ready():
                self.scoop(k)       # whatever you're holding
                return
            if self.tool_applies(tx, ty) and self.ready():
                self.use_tool_at(tx, ty)
            else:
                self.move(dx, dy)
        elif self.area.key == "loo" and self.area.inside(tx, ty) and \
                self.tile_at(tx, ty) == "loohole" and self.ready():
            self.use_hole(tx, ty)
        else:
            self.walk_to(tx, ty)

    def use_hole(self, tx, ty):
        """Tapped a hole along the bench: shuffle over and use it."""
        for _ in range(4):
            x, y = self.pos()
            if x == tx or self.area.key != "loo":
                break
            self.move(1 if tx > x else -1, 0)
            if self.pos() == (x, y) or list(self.pos()) == [x, y]:
                break
        if self.area.key == "loo" and tuple(self.pos()) == (tx, ty + 1):
            self.move(0, -1)

    def passable(self, x, y, goal):
        a = self.area
        if not a.inside(x, y):
            return False
        if (x, y) == goal:
            return True
        if self.npc_at(x, y):
            return False
        if not a.outdoor and a.grid[y][x] == "exit":
            return False
        return self.can_stand(x, y)

    def walk_to(self, tx, ty):
        start, goal = self.pos(), (tx, ty)
        prev = {start: None}
        q = deque([start])
        while q and goal not in prev:
            x, y = q.popleft()
            if abs(x - start[0]) + abs(y - start[1]) > 60:
                continue
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if n not in prev and self.passable(n[0], n[1], goal):
                    prev[n] = (x, y)
                    q.append(n)
        if goal not in prev:
            self.say("You can't find a way there.", "info")
            return
        path = []
        while goal != start:
            path.append(goal)
            goal = prev[goal]
        self.walking = path[::-1]
        self.walk_area = self.area
        self.walk_step()

    def walk_step(self):
        if (not self.walking or not self.ready()
                or self.area is not self.walk_area):
            self.walking = None
            return
        before = self.pos()
        x, y = self.walking.pop(0)
        self.move(x - before[0], y - before[1])
        if self.pos() != (x, y):
            self.walking = None
            return
        if self.walking:
            self.root.after(80, self.walk_step)

    # ── Drawing ──

    def layout(self):
        if not self.area or not self.p:
            return
        c = self.canvas
        scale = self.auto_scale()
        if scale != self.scale:
            self.scale = scale
            self.scale_images()
            self.portraits = {}
        c.delete("all")
        ts = 16 * self.scale
        W, H = max(c.winfo_width(), ts * 5), max(c.winfo_height(), ts * 5)
        cols, rows = -(-W // ts), -(-H // ts)
        cols += 1 - cols % 2
        rows += 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append(tuple(
                    c.create_image(x, y, anchor="nw", state="hidden")
                    for _ in range(3)))
        self.shown = [(None, None, None)] * len(self.cells)
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.cursor = c.create_rectangle(0, 0, 0, 0, outline=GOLD, width=2,
                                         state="hidden")
        self.render()

    def camera(self):
        cols, rows = self.view[0], self.view[1]
        a = self.area
        x, y = self.pos()

        def axis(p, n, size):
            if size <= n:
                return -((n - size) // 2)
            return max(0, min(size - n, p - n // 2))
        return axis(x, cols, a.w), axis(y, rows, a.h)

    def render(self):
        if not self.cells or not self.area or not self.p:
            return
        if self.season_drawn != self.season():
            self.load_images()
            self.layout()
            return
        c, a, st = self.canvas, self.area, self.st
        cols, rows, ox, oy, ts = self.view
        self.cam = cx, cy = self.camera()
        px, py = self.pos()
        lvl = self.light_level()
        people = {(n.x, n.y): self.npc_tile(n.vid)
                  for n in self.npcs.values()
                  if n.where == a.key and not n.hidden}
        if a.key == "coop":
            for hen in st["chickens"]:
                if not self.is_out(hen, "coop"):
                    people[(hen["x"], hen["y"])] = "hen_" + hen["colour"]
        if a.key == "barn":
            for cow in st["cows"]:
                if not self.is_out(cow, "barn"):
                    people[(cow["x"], cow["y"])] = self.barn_tile(cow)
        if a.outdoor:
            for b, pen in (("coop", "chickens"), ("barn", "cows")):
                for beast in st[pen] if self.grazing_now(b) else ():
                    if beast.get("ox") is not None:
                        people[(beast["ox"], beast["oy"])] = (
                            "hen_" + beast["colour"] if pen == "chickens"
                            else self.barn_tile(beast))
        if a.key == "mine" and self.mine:
            bright = self.mine["floor"] > TOWER
            near = lambda x, y: bright or (x - px) ** 2 + (y - py) ** 2 <= 30
            for k, e in self.floor_state(self.mine["floor"])[
                    "changed"].items():
                x, y = map(int, k.split(","))
                if near(x, y):
                    people[(x, y)] = self.changed_tile(e)
            for mob in self.mine["mobs"]:
                if near(mob.x, mob.y):
                    people[(mob.x, mob.y)] = mob.tile
        if a.outdoor and self.auriel_here():
            people[AURIEL_SPOT] = "mon_angel"
        f = st.get("mlead")
        if f and f["area"] == self.where_key():
            people[(f["x"], f["y"])] = self.mlead_tile(f)
        if a.key in ("cabin", "valley"):
            for m in self.mmaids():
                where, x, y = self.mmaid_where(m)
                if where == a.key:
                    people[(x, y)] = "mmaid_" + m["kind"]
            for k in self.kids():
                where, x, y = self.kid_where(k)
                if where == a.key:
                    people[(x, y)] = self.kid_tile(k)
        for pet in st.get("pets", ()):
            if pet["where"] == a.key:
                people[(pet["x"], pet["y"])] = "%s_%s" % (pet["kind"],
                                                         pet["colour"])
        bowl = self.bowl_at(a.key) if self.bowl_shown(a.key) else None
        lit = {}
        if lvl and a.outdoor:
            for lx, ly in self.lamps + [(px, py)]:
                if abs(lx - px) <= cols and abs(ly - py) <= rows:
                    for dy in range(-3, 4):
                        for dx in range(-3, 4):
                            d = dx * dx + dy * dy
                            if d <= 10:
                                k = (lx + dx, ly + dy)
                                b = 0 if d <= 2 else 1
                                lit[k] = min(b, lit.get(k, 2))
        soil, things = st["soil"], self.thing_at
        decor = st.get("decor", {})
        for j in range(rows):
            y = cy + j
            for i in range(cols):
                x = cx + i
                base = mid = top = None
                if a.inside(x, y):
                    t = a.grid[y][x]
                    k = "%d,%d" % (x, y)
                    if a.outdoor:
                        s = soil.get(k)
                        if s:
                            t = "soil_w" if s[0] else "soil"
                        th = things(x, y)
                        if th:
                            kind, what = th
                            mid = ("c_dead" if kind == "crop" and what[3]
                                   else self.stage(what) if kind == "crop"
                                   else "fg_" + what if kind == "forage"
                                   else "sprinkler" if kind == "sprinkler"
                                   else self.machine_tile(what)
                                   if kind == "machine"
                                   else self.fruit_tree_tile(what)
                                   if kind == "fruittree"
                                   else what)
                    base = t
                    if a.key == "coop" and [x, y] in st["eggs"]:
                        mid = "egg"
                    if a.key == "loo":
                        mid = self.loo_inside().get((x, y), mid)
                    if t == "gbed":
                        s = st.get("gh", {}).get(k)
                        if s and s[0]:
                            base = "gbed_w"
                        if s and s[1]:
                            mid = self.stage(s)
                    if a.key in ("coop", "barn") and t == "trough" and \
                            st["trough"].get(a.key):
                        mid = "haypile"
                    if a.outdoor and not mid and k in st["droppings"]:
                        mid = "drop_" + st["droppings"][k]
                    d = decor.get("%s:%d,%d" % (a.key, x, y))
                    if d:
                        mid = "smon_" + d["kind"]
                    if bowl == (x, y) and not mid:
                        mid = "bowl_full" if self.bowl_full(a.key) else \
                            "bowl"
                    top = people.get((x, y))
                    if (x, y) == (px, py):
                        top = "you"
                    if a.key == "mine" and self.mine and \
                            self.mine["floor"] < TOWER:   # your lantern
                        d2 = (x - px) ** 2 + (y - py) ** 2
                        l2 = 0 if d2 <= 12 else 1 if d2 <= 30 else 2
                        if l2:
                            base = "%d:%s" % (l2, base)
                    elif lvl:
                        l2 = min(lvl, lit.get((x, y), 2))
                        if l2:
                            base = "%d:%s" % (l2, base)
                            if mid:
                                mid = "%d:%s" % (l2, mid)
                names = (self.framed(base), self.framed(mid),
                         self.framed(top))
                idx = j * cols + i
                old = self.shown[idx]
                if old == names:
                    continue
                self.shown[idx] = names
                for item, o, n in zip(self.cells[idx], old, names):
                    if n == o:
                        continue
                    if n is None:
                        c.itemconfig(item, state="hidden")
                    else:
                        c.itemconfig(item, image=self.image(n),
                                     state="normal")
        # the square you're facing
        fx, fy = self.ahead()
        if (a.outdoor or a.key == "greenhouse" or
                self.held() == "magic wand") and not self.talk \
                and self.tool_applies(fx, fy):
            sx, sy = ox + (fx - cx) * ts, oy + (fy - cy) * ts
            c.coords(self.cursor, sx + 1, sy + 1, sx + ts - 1, sy + ts - 1)
            c.itemconfig(self.cursor, state="normal")
            c.tag_raise(self.cursor)
        else:
            c.itemconfig(self.cursor, state="hidden")
        c.delete("overlay")
        if getattr(self, "aim", False):
            self.draw_aim()
        self.draw_weather()
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay == "text":
            self.draw_text_box(self.overlay_text)
        if self.talk:
            self.draw_talk()
        if self.menu:
            self.draw_menu()
        self.render_chrome()

    def draw_aim(self):
        """While the wand is raised: an arrow each way, and a gold ring
        round anyone a spell that way would hit."""
        c = self.canvas
        cols, rows, ox, oy, ts = self.view
        cx, cy = self.cam
        px, py = self.pos()
        f = F("Helvetica", 18, "bold")
        for (dx, dy), arrow in zip(DIRS, ("\u25b2", "\u25bc", "\u25c0",
                                          "\u25b6")):
            sx = ox + (px + dx - cx) * ts + ts // 2
            sy = oy + (py + dy - cy) * ts + ts // 2
            c.create_text(sx + 1, sy + 1, text=arrow, font=f, fill="#000000",
                          tags="overlay")
            c.create_text(sx, sy, text=arrow, font=f, fill=GOLD,
                          tags="overlay")
            n = self.wand_target(dx, dy)
            if n:
                x0 = ox + (n.x - cx) * ts
                y0 = oy + (n.y - cy) * ts
                c.create_oval(x0 + 1, y0 + 1, x0 + ts - 1, y0 + ts - 1,
                              outline=GOLD, width=3, tags="overlay")

    def draw_weather(self):
        c = self.canvas
        c.delete("weather")
        if not self.area or not self.area.outdoor or self.overlay:
            return
        w = self.st["weather"]
        if w not in ("rain", "storm", "snow"):
            return
        W, H = c.winfo_width(), c.winfo_height()
        rng = random.Random(self.frame * 7 + self.st["minute"])
        n = 70 if w == "storm" else 45
        for _ in range(n):
            x, y = rng.uniform(0, W), rng.uniform(0, H)
            if w == "snow":
                r = rng.uniform(1.5, 3.5) * self.scale / 2
                c.create_oval(x, y, x + r, y + r, fill="#ffffff",
                              outline="", tags="weather")
            else:
                ln = 6 * self.scale
                c.create_line(x, y, x - ln / 3, y + ln, fill="#a8c8f0",
                              width=1, tags="weather")
        c.tag_raise("overlay")

    def draw_talk(self):
        """The conversation: their portrait large on the left, their name
        and hearts, and what they've just said."""
        c, t = self.canvas, self.talk
        W, H = c.winfo_width(), c.winfo_height()
        vid = t["v"]
        mm = t.get("mm")
        kid = t.get("kid")
        who = t.get("who")
        v = {"look": monster_maid_look(mm["kind"])} if mm else \
            {"look": kid["look"]} if kid else \
            {"look": who["look"]} if who else VILLAGERS[vid]
        pz = max(2, min(7, int(min(H * 0.3, W * 0.28) / PW)))
        psz = PW * pz
        pad = S(10)
        f = F("Helvetica", 14)
        bold = F("Helvetica", 14, "bold")
        lh = f.metrics("linespace")
        tx = pad * 2 + psz + pad
        tw = W - tx - pad * 2
        text = t.get("text", "")
        tid = c.create_text(0, 0, text=text, width=max(80, tw), font=f,
                            anchor="nw", tags="overlay")
        bb = c.bbox(tid)
        c.delete(tid)
        text_h = (bb[3] - bb[1]) if bb else lh
        bh = max(psz + pad * 2, text_h + lh * 3 + pad * 3)
        bh = min(bh, H - 20)
        y0 = H - bh - pad
        self.talk_box_top = y0
        c.create_rectangle(pad, y0, W - pad, y0 + bh, fill=PANEL,
                           outline=ACCENT, width=2, tags="overlay")
        expr = t.get("expr", "neutral")
        c.create_image(pad * 2, y0 + pad, anchor="nw", tags="overlay",
                       image=self.mmaid_portrait(mm["kind"], expr, pz) if mm
                       else self.look_portrait(
                           (kid["name"], kid["born"]), kid["look"], expr, pz)
                       if kid else self.look_portrait(who["name"], who["look"],
                                                      expr, pz)
                       if who else self.portrait_image(vid, expr, pz))
        c.create_rectangle(pad * 2, y0 + pad, pad * 2 + psz, y0 + pad + psz,
                           outline=shade(v["look"]["bg"], 0.6), width=2,
                           tags="overlay")
        if who:
            c.create_text(tx, y0 + pad, anchor="nw", tags="overlay",
                          text=who["name"], font=bold, fill=ACCENT)
            c.create_text(tx, y0 + pad + lh, anchor="nw", tags="overlay",
                          font=F("Helvetica", 13), fill=INK_DIM,
                          text=who["sub"])
            c.create_text(tx, y0 + pad + lh * 2 + S(6), anchor="nw",
                          width=tw, text=text, font=f, fill=INK,
                          tags="overlay")
            return
        if kid:
            h = min(10, kid["love"] // 100)
            age = self.kid_age(kid)
            c.create_text(tx, y0 + pad, anchor="nw", tags="overlay",
                          text=kid["name"], font=bold, fill=ACCENT)
            c.create_text(tx + bold.measure(kid["name"]) + S(12), y0 + pad,
                          anchor="nw", tags="overlay", font=F("Helvetica", 13),
                          fill=HEARTC, text="♥" * h + "♡" * (10 - h))
            c.create_text(tx, y0 + pad + lh, anchor="nw", tags="overlay",
                          font=F("Helvetica", 13), fill=INK_DIM,
                          text="(your %s, %d day%s old)" % (
                              "daughter" if kid["sex"] == "F" else "son",
                              age, "" if age == 1 else "s"))
            c.create_text(tx, y0 + pad + lh * 2 + S(6), anchor="nw",
                          width=tw, text=text, tags="overlay",
                          font=F("Helvetica", 14, "italic") if t.get("narr")
                          else f, fill=INK_DIM if t.get("narr") else INK)
            return
        if mm:
            c.create_text(tx, y0 + pad, anchor="nw", tags="overlay",
                          text=mm["name"], font=bold, fill=ACCENT)
            h = self.mm_hearts(mm)
            role = {"dating": "your sweetheart", "engaged": "your fiancée",
                    "married": "your wife"}.get(mm["status"], "your maid")
            hf = F("Helvetica", 13)
            hearts = "♥" * h + "♡" * (10 - h)
            hx = tx + bold.measure(mm["name"]) + S(12)
            c.create_text(hx, y0 + pad, anchor="nw", tags="overlay",
                          font=hf, fill=HEARTC, text=hearts)
            c.create_text(tx, y0 + pad + lh, anchor="nw", tags="overlay",
                          font=hf, fill=INK_DIM, text="(%s, once %s)" % (
                              role, an(MONSTERS[mm["kind"]].name)))
            c.create_text(tx, y0 + pad + lh * 2 + S(6), anchor="nw",
                          width=tw, text=text, tags="overlay",
                          font=F("Helvetica", 14, "italic") if t.get("narr")
                          else f, fill=INK_DIM if t.get("narr") else INK)
            return
        h = self.hearts(vid)
        f_ = self.friend(vid)
        status = {"dating": "  (sweetheart)", "engaged": "  (engaged)",
                  "married": "  (spouse)"}.get(f_["status"], "")
        if self.maid(vid):
            status += "  (your maid)"
        c.create_text(tx, y0 + pad, anchor="nw", tags="overlay",
                      text=self.display_name(vid), font=bold, fill=ACCENT)
        hf = F("Helvetica", 13)
        hearts = "♥" * h + "♡" * (10 - h) + status
        hx, hy = tx + bold.measure(self.display_name(vid)) + S(12), \
            y0 + pad
        if hx + hf.measure(hearts) > W - pad * 2:
            hx, hy = tx, y0 + pad + lh
        c.create_text(hx, hy, anchor="nw", tags="overlay", text=hearts,
                      font=hf, fill=HEARTC)
        c.create_text(tx, hy + lh + S(6), anchor="nw", width=tw,
                      text=text, font=F("Helvetica", 14, "italic") if
                      t.get("narr") else f,
                      fill=INK_DIM if t.get("narr") else INK,
                      tags="overlay")

    def flash(self, x, y, tile="sparkle"):
        cols, rows, ox, oy, ts = self.view
        cx, cy = self.cam
        i, j = x - cx, y - cy
        if not (0 <= i < cols and 0 <= j < rows) or tile not in self.img:
            return
        self.fx_token += 1
        token = self.fx_token
        self.canvas.coords(self.fx, ox + i * ts, oy + j * ts)
        self.canvas.itemconfig(self.fx, image=self.img[tile], state="normal")
        self.canvas.tag_raise(self.fx)

        def hide():
            if token == self.fx_token:
                self.canvas.itemconfig(self.fx, state="hidden")
        self.root.after(300, hide)

    def draw_text_box(self, text, color=INK):
        """Text in a box in the middle of the map, as big as will fit: in
        one column if it can, or two, split at a paragraph, if that lets
        it be bigger."""
        c = self.canvas
        W, H = c.winfo_width(), c.winfo_height()
        key = (text, W, H, font_px(12))     # fonts scale with the window
        cache = getattr(self, "box_fit", {})
        if key not in cache:
            cache[key] = self.fit_text_box(text, W, H)
            self.box_fit = cache
        cols, font = cache[key]
        ts, x = [], 0
        for col in cols:
            t = c.create_text(x, 0, text=col, fill=color, font=font,
                              justify="left", anchor="nw", tags="overlay")
            ts.append(t)
            x = c.bbox(t)[2] + 32
        x0, y0, x1, y1 = c.bbox(*ts)
        dx, dy = (W - (x1 - x0)) / 2 - x0, (H - (y1 - y0)) / 2 - y0
        for t in ts:
            c.move(t, dx, dy)
        x0, y0, x1, y1 = c.bbox(*ts)
        r = c.create_rectangle(x0 - 16, y0 - 12, x1 + 16, y1 + 12,
                               fill=PANEL, outline=ACCENT, width=2,
                               tags="overlay")
        for t in ts:
            c.tag_raise(t, r)

    def fit_text_box(self, text, W, H):
        """(columns, font) for a text box: the largest font at which it
        fits in one column, or else in two."""
        c = self.canvas
        paras = text.split("\n\n")
        two = [text]
        if len(paras) > 1:
            def tallest(i):
                return max("\n\n".join(paras[:i]).count("\n"),
                           "\n\n".join(paras[i:]).count("\n"))
            i = min(range(1, len(paras)), key=tallest)
            two = ["\n\n".join(paras[:i]), "\n\n".join(paras[i:])]

        def size_of(cols, font):
            ts, x = [], 0
            for col in cols:
                t = c.create_text(x, 0, text=col, font=font, anchor="nw")
                ts.append(t)
                x = c.bbox(t)[2] + 32
            x0, y0, x1, y1 = c.bbox(*ts)
            for t in ts:
                c.delete(t)
            return x1 - x0, y1 - y0
        best, room = None, -1
        for size in range(12, 4, -1):
            font = F(*MONO) if size == 12 else F("Menlo", size)
            for cols in ([text], two) if len(two) > 1 else ([text],):
                w, h = size_of(cols, font)
                if w <= W - 40 and h <= H - 30:
                    return cols, font
                fit = min((W - 40) / w, (H - 30) / h)
                if size == 5 and fit > room:        # least bad, at worst
                    best, room = (cols, font), fit
        return best

    def draw_map(self):
        c, a = self.canvas, self.areas["valley"]
        W, H = c.winfo_width(), c.winfo_height()
        rows = []
        for y in range(a.h):
            row = []
            for x in range(a.w):
                t = a.grid[y][x]
                k = "%d,%d" % (x, y)
                if k in self.st["soil"]:
                    t = "soil"
                row.append("#f0a050" if (x, y) in self.door_at else
                           self.avg.get(t, "#000000"))
            rows.append("{" + " ".join(row) + "}")
        img = tk.PhotoImage(width=a.w, height=a.h)
        img.put(" ".join(rows))
        z = max(1, min((W - 20) // a.w, (H - 50) // a.h))
        self.map_img = img.zoom(z)
        c.create_rectangle(0, 0, W, H, fill="black", tags="overlay")
        mx, my = (W - a.w * z) / 2, (H - a.h * z) / 2 + 10
        c.create_image(mx, my, image=self.map_img, anchor="nw",
                       tags="overlay")
        small = F("Helvetica", 9 if z < 9 else 11)
        for key in BUILDINGS:
            if key in ON_ORDER and key not in self.built():
                continue
            x, y = door_of(key)
            name = BUILDINGS[key][6].replace("the ", "", 1)
            c.create_text(mx + (x + 0.5) * z, my + (y - 4) * z,
                          text=cap(name), fill="#ffffff", font=small,
                          anchor="s", tags="overlay")
        for n in self.npcs.values():
            if n.where == "valley" and self.friend(n.vid)["met"]:
                c.create_oval(mx + n.x * z, my + n.y * z, mx + (n.x + 1) * z,
                              my + (n.y + 1) * z, fill=HEARTC, outline="",
                              tags="overlay")
        if self.area is a:
            px, py = self.pos()
        else:
            px, py = self.outside_door()
        c.create_rectangle(mx + px * z - 2, my + py * z - 2,
                           mx + (px + 1) * z + 2, my + (py + 1) * z + 2,
                           outline="#ffff00", width=2, tags="overlay")
        c.create_text(W / 2, my - 14, fill=ACCENT, font=F(*MONO),
                      tags="overlay",
                      text="Apple Blossom Village   (yellow: you; pink: "
                           "friends; any key closes)")

    def render_chrome(self):
        p, st = self.p, self.st
        a = self.area
        here = a.name if not a.outdoor else self.district()
        self.status.config(text=cap(here))
        self.clock_label.config(text="%s %d  %s  %s" % (
            SEASONS[self.season()], self.dom(), WEEKDAYS[self.weekday()],
            self.clock()))
        e = max(0, p["energy"])
        bar = int(10 * e / p["max_energy"] + 0.99) if e else 0
        lines = [p["name"], "%s Farm" % p["farm"], "",
                 "%s, Year %d" % (SEASONS[self.season()], self.year()),
                 "%s %d, %s" % (WEEKDAYS[self.weekday()], self.dom(),
                                self.clock()),
                 WEATHER_SHORT[st["weather"]], "",
                 "Gold    %dg" % p["gold"],
                 "Energy  %s%s %d" % ("█" * bar, "░" * (10 - bar),
                                      e),
                 "Magic   %s%s %d" % ("✦" * p["magic"], "✧" * (
                     p["max_magic"] - p["magic"]), p["magic"]), "",
                 "Holding:", "  " + self.hand_name(), ""]
        things = ["%s%s" % (n, " x%d" % v if v > 1 else "")
                  for n, v in sorted(p["items"].items()) if v]
        if things:
            lines += ["Bag:"] + ["  " + t for t in things[:14]]
            if len(things) > 14:
                lines.append("  ...and %d more" % (len(things) - 14))
        self.show_panel(lines)
        cond = []
        if any(not m["read"] for m in st["mail"]):
            cond.append("✉ New mail!")
        f = self.festival_today()
        if f:
            cond.append(f[0].upper())
        for vid, v in VILLAGERS.items():
            if v["birthday"] == (self.season(), self.dom()):
                cond.append("%s's birthday!" % v["short"])
        if st["wedding"] is not None:
            cond.append("Wedding: %s" % ("TODAY" if st["wedding"] ==
                                         st["day"] else "in %d days" % (
                                             st["wedding"] - st["day"])))
        if p["energy"] <= 0:
            cond.append("EXHAUSTED")
        if getattr(self, "aim", False):
            cond.append("WAND RAISED: pick a direction")
        self.condition.config(text="\n".join(cond))
        if self.festival_on():
            self.sound.tune = "festival"
        elif a.key == "mine":
            self.sound.tune = "tower" if self.mine and \
                self.mine["floor"] > TOWER else "mine"
        elif not a.outdoor:
            self.sound.tune = "inside"
        elif self.light_level() == 2:
            self.sound.tune = "night"
        else:
            self.sound.tune = SEASONS[self.season()].lower()

    def district(self):
        x, y = self.pos()
        if on_farm(x, y):
            return "%s Farm" % self.p["farm"]
        if y >= LAKE_Y - 6:
            return "the beach"
        if RIVER[0] - 1 <= x <= RIVER[1] + 1:
            return "the river"
        if y < 9:
            return "the woods"
        x0, y0, x1, y1 = SQUARE
        if x0 <= x <= x1 and y0 <= y <= y1:
            return "the village square"
        if x < RIVER[0]:
            return "the meadow"
        return "Apple Blossom Village"

