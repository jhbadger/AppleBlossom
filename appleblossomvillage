    # ── Gamepad ──

    def pad_poll(self):
        while True:
            try:
                kind, number, value = self.pad.events.get_nowait()
            except queue.Empty:
                break
            name = PAD_BUTTONS.get(number) if kind & 1 else None
            if name in ("left", "right", "up", "down"):
                self.pad_hold({"left": (-1, 0), "right": (1, 0),
                               "up": (0, -1), "down": (0, 1)}[name]
                              if value else None)
            elif name and value:
                self.pad_button(name)
            elif kind & 2 and number in PAD_STICK + PAD_HAT:
                self.pad_axes[number] = value
                held = None
                for ax, ay in (PAD_HAT, PAD_STICK):
                    vx, vy = self.pad_axes.get(ax, 0), self.pad_axes.get(ay, 0)
                    if max(abs(vx), abs(vy)) > PAD_DEADZONE:
                        held = ((1 if vx > 0 else -1, 0) if abs(vx) >= abs(vy)
                                else (0, 1 if vy > 0 else -1))
                        break
                if held != self.pad_dir:
                    self.pad_hold(held)
        self.root.after(30, self.pad_poll)

    def pad_hold(self, d):
        self.pad_dir = d
        if d:
            self.pad_direction(d)
            self.root.after(350, self.pad_repeat, d)

    def pad_repeat(self, d):
        if self.pad_dir == d:
            self.pad_direction(d)
            self.root.after(160, self.pad_repeat, d)

    def pad_direction(self, d):
        self.walking = None
        if self.menu:
            self.menu_move(-1 if d in ((0, -1), (-1, 0)) else 1)
        elif self.busy or self.talk:
            pass
        elif self.overlay:
            self.close_overlay()
        elif getattr(self, "aim", False):
            self.zap(*d)
        else:
            self.move(*d)

    def pad_button(self, name):
        self.walking = None
        if getattr(self, "aim", False):
            if name == "b":
                self.cancel_aim()
            elif name == "a":
                self.zap()
            return
        if self.busy:
            return
        if self.menu:
            if name == "a":
                self.menu_pick()
            elif name == "b":
                self.menu_cancel()
            return
        if self.talk:
            return
        if self.overlay:
            if name == "start":
                self.action_menu()
            else:
                self.close_overlay()
            return
        {"a": self.use_tool, "x": self.next_tool, "y": self.bag_menu,
         "lb": self.wait_menu, "rb": self.show_friends,
         "view": self.toggle_map, "start": self.action_menu}.get(
             name, lambda: None)()

    def animate(self):
        """Flip every animated square to its other frame, and let the rain
        fall."""
        self.frame ^= 1
        if self.cells and not self.overlay and self.area:
            c = self.canvas
            for idx, names in enumerate(self.shown):
                new = tuple(self.framed(n) for n in names)
                if new == names:
                    continue
                self.shown[idx] = new
                for item, old, n in zip(self.cells[idx], names, new):
                    if n != old and n:
                        c.itemconfig(item, image=self.image(n))
            self.draw_weather()
        self.root.after(500, self.animate)

    def framed(self, name):
        if not name:
            return name
        root = name[:-2] if name.endswith("@1") else name
        lvl = ""
        if root[:2] in ("1:", "2:"):
            lvl, root = root[:2], root[2:]
        return lvl + (root + "@1" if self.frame and root in self.animated
                      else root)

    def music_tick(self):
        self.sound.tick()
        self.root.after(100, self.music_tick)

    # ── Images ──
    #
    # Every tile is kept at three brightnesses, for day, dusk and night;
    # "1:grass" is grass at dusk.  People are always drawn at full light.

    def load_images(self):
        season = self.season() if self.p else 0
        self.season_drawn = season
        self.base = {}
        self.avg = {}
        for name, px in all_tiles(season).items():
            sprite = name.split("@")[0] in SPRITES
            for lvl, k in enumerate(SHADES):
                if lvl and name.startswith(("v_", "s_", "vx_", "sx_",
                                            "vm_", "sm_", "tv_", "lh_",
                                            "shen_", "cow_", "scow_",
                                            "hen_")):
                    continue
                img = tk.PhotoImage(width=16, height=16)
                if sprite:
                    for y, row in enumerate(px):
                        x = 0
                        while x < 16:
                            c = row[x]
                            x1 = x
                            while x1 < 16 and row[x1] == c:
                                x1 += 1
                            if c:
                                img.put(c if k == 1.0 else shade(c, k),
                                        to=(x, y, x1, y + 1))
                            x = x1
                else:
                    img.put(" ".join("{" + " ".join(
                        c if k == 1.0 else shade(c, k) for c in r) + "}"
                        for r in px))
                self.base[("%d:" % lvl if lvl else "") + name] = img
            if not sprite:
                tot = [0, 0, 0]
                for r in px:
                    for c in r:
                        for i in range(3):
                            tot[i] += int(c[1 + 2 * i:3 + 2 * i], 16)
                self.avg[name] = "#%02x%02x%02x" % tuple(v // 256
                                                        for v in tot)
        if self.p:
            self.paint_hero()
        self.scale_images()

    def paint_hero(self):
        pal, rows = person_art(self.p["look"])
        px = art_pixels(pal, rows)
        for n, frame in (("you", px), ("you@1", px[1:] + [[None] * 16])):
            img = tk.PhotoImage(width=16, height=16)
            for y, row in enumerate(frame):
                for x, c in enumerate(row):
                    if c:
                        img.put(c, to=(x, y, x + 1, y + 1))
            self.base[n] = img
        SPRITES.add("you")

    def scale_images(self):
        s = self.scale
        self.img = {n: i.zoom(s) for n, i in self.base.items()}
        self.animated = {n for n in self.base if n + "@1" in self.base}

    def image(self, name):
        img = self.img.get(name)
        if img is None:
            img = self.img.get(name[2:] if name[:2] in ("1:", "2:")
                               else name)
        return img

    def portrait_image(self, who, expr, z):
        """A portrait as a Tk image, zoomed z times; who is a villager's
        id, or "you"."""
        key = (who, expr, z, who != "you" and self.swapped(who),
               who != "you" and self.maid(who))
        img = self.portraits.get(key)
        if img is None:
            look = self.p["look"] if who == "you" else self.look_of(who)
            px = portrait(look, expr)
            base = tk.PhotoImage(width=PW, height=PW)
            base.put(" ".join("{" + " ".join(r) + "}" for r in px))
            img = self.portraits[key] = base.zoom(z)
        return img

