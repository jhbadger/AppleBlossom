        rect(g, 2, 5, 13, 5, "#4a4a4a")
        rect(g, 2, 11, 13, 11, "#4a4a4a")
        return g
    if name == "crates":
        g = planks(rng, "#c09060", "#9a7048")
        for (x0, y0) in ((1, 1), (8, 6)):
            rect(g, x0, y0, x0 + 6, y0 + 7, "#b08a5a")
            rect(g, x0, y0, x0 + 6, y0, "#7a5a30")
            for i in range(7):
