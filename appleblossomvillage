        rect(g, 2, 3, 13, 3, "#5a3a20")
        rect(g, 2, 5, 10, 5, "#5a3a20")
        return g
    if name == "flowerbed":
        g = draw_terrain("cobble", 0, s)
        rect(g, 1, 4, 14, 13, "#6a4a2a")
        if s != 3:
            for x in range(2, 14, 3):
                for y in (5, 9):
                    c = rng.choice(("#f080b0", "#f0e040", "#ffffff",
                                    "#e04050"))
                    rect(g, x, y, x + 1, y + 1, c)
                    g[y + 2][x] = "#2e7a2e"
        return g
    if name == "stall":                         # a festival stall
        g = draw_terrain("cobble", 0, s)
        rect(g, 1, 7, 14, 15, "#a07040")
        rect(g, 1, 7, 14, 8, "#d0a060")
        for x in range(0, 16, 4):
            rect(g, x, 1, x + 1, 5, "#e04060")
            rect(g, x + 2, 1, x + 3, 5, "#ffffff")
        return g
    # buildings: roof_<colour>, eave_<colour>, wall_/win_/door_<material>
    if name.startswith("roof_") or name.startswith("eave_"):
        col = ROOFS[name[5:]]
        g = thatch(rng, col) if name.endswith("thatch") else roof(rng, col)
        if s == 3:
            for y in range(16):
                for x in range(16):
                    if (y < 10 or name.startswith("roof_")) and \
                            rng.random() < 0.7:
                        g[y][x] = "#f4f8ff" if rng.random() < 0.8 else \
                            "#dde6f0"
        if name.startswith("eave_"):
            rect(g, 0, 13, 15, 15, shade(col, 0.55))
        return g
    if name.startswith(("wall_", "win_", "door_", "winl_")):
        kind, mat = name.split("_", 1)
        g = wall_face(rng, mat)
        if kind in ("win", "winl"):
            window(g, kind == "winl")
        elif kind == "door":
            door(g)
        return g
    if name == "chimney":
        return stone_blocks(rng, "#9a5040", "#5a2a20", 4, 3)
    # indoors
    if name == "floor":
        return planks(rng, "#c09060", "#9a7048")
    if name == "boards":
        return planks(rng, "#a07850", "#7a5838", vertical=True, width=5)
    if name == "logfloor":
        return planks(rng, "#b08050", "#805a34", width=5)
    if name == "stone_floor":
        return stone_blocks(rng, "#9a948a", "#7a7468", 8, 8)
    if name == "rug":
        g = grid_of("#a04a5a")
        speckle(g, rng, ["#b05468", "#904050"], 0.3)
        for i in range(16):
            g[i][i] = g[i][15 - i] = "#d08090"
        return g
    if name == "tile":
        g = grid_of("#f0f0ec")
        for y in range(16):
            for x in range(16):
                if (x // 4 + y // 4) % 2:
                    g[y][x] = "#a0d0b0"
        return g
    if name in ("straw", "nest"):
        g = grid_of("#d8b860")
        for _ in range(40):
            x, y = rng.randrange(16), rng.randrange(16)
            for k in range(rng.randrange(2, 5)):
                if x + k < 16:
                    g[y][x + k] = rng.choice(("#e8cc78", "#b8983e",
                                              "#f0dc90"))
        if name == "nest":
            rect(g, 0, 0, 15, 3, "#8a5a30")
            rect(g, 0, 12, 15, 15, "#8a5a30")
            rect(g, 0, 0, 1, 15, "#6a4020")
            rect(g, 14, 0, 15, 15, "#6a4020")
            disc(g, 7.5, 8, 4.5, "#c8a050")
            disc(g, 7.5, 8, 3, "#a88038")
        return g
    if name in ("loohole", "loobench"):
        g = planks(rng, "#a07446", "#86603a")
        rect(g, 0, 3, 15, 13, "#c49460")
        rect(g, 0, 3, 15, 4, "#d8aa74")
        rect(g, 0, 13, 15, 14, "#6a4626")
