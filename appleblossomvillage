def art_pixels(palette, rows):
    if len(rows) != 16 or any(len(r) != 16 for r in rows):
        raise ValueError("tile art must be 16 x 16")
    return [[None if ch == "." else palette[ch] for ch in r] for r in rows]


def shade(c, f):
    r, g, b = (int(c[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(v * f)))
                                    for v in (r, g, b))


def mix(a, b, t):
    ra, ga, ba = (int(a[i:i + 2], 16) for i in (1, 3, 5))
    rb, gb, bb = (int(b[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % (round(ra + (rb - ra) * t),
                              round(ga + (gb - ga) * t),
                              round(ba + (bb - ba) * t))


def grid_of(c):
    return [[c] * 16 for _ in range(16)]


def speckle(g, rng, colors, p):
    for y in range(16):
        for x in range(16):
            if rng.random() < p:
                g[y][x] = rng.choice(colors)


def rect(g, x0, y0, x1, y1, c):
    for y in range(max(0, y0), min(16, y1 + 1)):
        for x in range(max(0, x0), min(16, x1 + 1)):
            g[y][x] = c


def disc(g, cx, cy, r, c, rng=None, jitter=0.0):
    for y in range(16):
        for x in range(16):
            d = math.hypot(x - cx, y - cy)
            if d <= r + (rng.uniform(-jitter, jitter) if rng else 0):
                g[y][x] = c


def stone_blocks(rng, base, mortar, bw=6, bh=4):
    g = grid_of(mortar)
    for row in range(16 // bh):
        off = (row % 2) * (bw // 2)
        for x in range(-bw, 16, bw):
            c = shade(base, rng.uniform(0.88, 1.1))
            rect(g, x + off, row * bh, x + off + bw - 2, row * bh + bh - 2, c)
    return g


def planks(rng, base, seam, vertical=False, width=4):
    g = grid_of(base)
    for y in range(16):
        for x in range(16):
            a, b = (x, y) if vertical else (y, x)
            if a % width == width - 1:
                g[y][x] = seam
            elif rng.random() < 0.08:
                g[y][x] = shade(base, 0.9)
    for i in range(4):          # butt joints
        a = rng.randrange(16)
        b = i * width + rng.randrange(width - 1)
        if vertical:
            g[a][min(15, b)] = seam
        else:
            g[min(15, b)][a] = seam
    return g


def roof(rng, base):
    g = grid_of(base)
    dark = shade(base, 0.72)
    for y in range(16):
        if y % 4 == 3:
            for x in range(16):
                g[y][x] = dark
        else:
            for x in range((y // 4) * 2 % 4, 16, 4):
                g[y][x] = shade(base, 0.85)
    speckle(g, rng, [shade(base, 1.12)], 0.06)
    return g


def speckle_within(g, rng, inside, colours, p):
    for y in range(16):
        for x in range(16):
            if g[y][x] == inside and rng.random() < p:
                g[y][x] = rng.choice(colours)


def bookshelf(rng):
    g = grid_of("#4a3020")
    for shelf in (1, 6, 11):
        x = 1
        while x < 15:
            w = rng.choice((1, 1, 2))
            c = rng.choice(("#7a1e1e", "#1e3a6a", "#2e5a2e", "#6a5a1e",
                            "#3a2a4a", "#8a6a3a", "#1a1a1a"))
            top = shelf + rng.choice((0, 0, 1))
            rect(g, x, top, min(14, x + w - 1), shelf + 3, c)
            x += w
        rect(g, 0, shelf + 4, 15, shelf + 4, "#2e1c10")
    return g

# ── Seasonal ground ──────────────────────────────────────────────────────────
#
# Every outdoor tile is drawn four times, once a season: the grass greens,
# browns and goes under snow, and the trees blossom, fruit, turn and go bare.

GROUND = {   # season: base, two speckles, flower colours
    0: ("#5aae48", ("#66bc52", "#4e9e40"), ("#f8c8e0", "#ffffff", "#f0e060")),
    1: ("#4e9e3a", ("#5aae44", "#448a32"), ("#f0e040", "#f06040")),
    2: ("#a8983e", ("#b8a448", "#8e7e30"), ("#d86a2a", "#c04a20")),
    3: ("#e8eef4", ("#d8e0ec", "#f8fbff"), ()),
}


def ground(rng, season, flowers=0.012):
    base, specks, flw = GROUND[season]
    g = grid_of(base)
    speckle(g, rng, list(specks), 0.38)
    if flw:
        speckle(g, rng, list(flw), flowers)
    return g


def dirt(rng, season=0):
    g = grid_of("#c8a070" if season != 3 else "#d8d4d0")
    speckle(g, rng, ["#d4ae80", "#b89060"] if season != 3 else
            ["#e8e8ec", "#c0b8b0"], 0.3)
    return g


LEAVES = {0: ("#3c9a3c", "#2e7a2e", "#58b850"),
          1: ("#2e8a32", "#226a26", "#44a840"),
          2: ("#d07a2a", "#a8501e", "#e8a040"),
          3: None}


def tree(rng, season, fruit=None, blossom=None):
    g = ground(rng, season, 0)
    rect(g, 7, 10, 8, 15, "#7a5030")
    rect(g, 6, 14, 9, 15, "#6a4428")
    lv = LEAVES[season]
    if lv is None:                              # bare, with snow
        for (x, y) in ((7, 9), (6, 8), (5, 7), (4, 6), (8, 8), (9, 7),
                       (10, 6), (11, 5), (7, 7), (7, 6), (6, 5), (8, 5),
                       (8, 4), (3, 5), (12, 4)):
            g[y][x] = "#6a4428"
        for (x, y) in ((4, 5), (10, 5), (8, 3), (6, 4), (3, 4), (12, 3)):
            g[y][x] = "#ffffff"
        return g
    disc(g, 7.5, 6, 6, lv[1], rng, 0.6)
    disc(g, 6.5, 5, 4.2, lv[0], rng, 0.6)
    disc(g, 5.5, 4, 1.8, lv[2])
    dots = blossom if (season == 0 and blossom) else fruit
    if dots:
        for _ in range(9 if dots == blossom else 6):
            x, y = rng.randrange(3, 13), rng.randrange(1, 10)
            if g[y][x] in lv:
                g[y][x] = rng.choice(dots) if isinstance(dots, tuple) \
                    else dots
    return g


def thatch(rng, base):
    g = grid_of(base)
    for y in range(16):
        for x in range(16):
            if (x + (y // 3) * 2) % 3 == 0:
                g[y][x] = shade(base, 0.86)
            elif rng.random() < 0.1:
                g[y][x] = shade(base, 1.1)
        if y % 5 == 4:
            for x in range(16):
                g[y][x] = shade(base, 0.7)
    return g


ROOFS = {"red": "#c05a40", "blue": "#5a7ab0", "green": "#5a9a5a",
         "slate": "#6a6a80", "purple": "#8a5aa0", "thatch": "#d8b060",
         "pink": "#e08aa8"}
WALLS = {"wood": ("#a87850", "#7a5430"), "white": ("#f0e8d0", "#6a4428"),
         "brick": ("#b05a44", "#6a3424"), "stone": ("#a8a090", "#7a7468"),
         "log": ("#8a5a34", "#5a3a20")}


def wall_face(rng, mat):
    base, line = WALLS[mat]
    if mat == "wood":
        return planks(rng, base, line, vertical=True)
    if mat == "log":
        g = grid_of(base)
        for y in range(0, 16, 4):
            rect(g, 0, y + 3, 15, y + 3, line)
            g[y + 1][rng.randrange(16)] = shade(base, 1.2)
        return g
    if mat == "brick":
        return stone_blocks(rng, base, "#d8c8b0", 6, 4)
    if mat == "stone":
        return stone_blocks(rng, base, line, 5, 4)
    g = grid_of(base)                           # half-timbered
    speckle(g, rng, ["#e8e0c8"], 0.2)
    for x in (0, 15):
        rect(g, x, 0, x, 15, line)
    rect(g, 0, 0, 15, 0, line)
    return g


def window(g, lit=False):
    rect(g, 4, 3, 11, 10, "#5a3a20")
    rect(g, 5, 4, 10, 9, "#f8e8a0" if lit else "#a8d0f0")
    rect(g, 7, 4, 8, 9, "#5a3a20")
    rect(g, 5, 6, 10, 6, "#5a3a20")
    rect(g, 3, 11, 12, 11, "#e070a0")          # a window box of flowers
    for x in (4, 6, 9, 11):
        g[10][x] = "#f8c8e0"


def door(g):
    rect(g, 4, 3, 11, 15, "#5a3420")
    disc(g, 7.5, 4, 3.5, "#5a3420")
    rect(g, 5, 4, 10, 15, "#a06a3a")
    rect(g, 7, 4, 8, 15, "#7a4a28")
    g[10][9] = "#f0d040"


def draw_terrain(name, frame=0, season=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random("%s%d%d" % (name, frame, season))
    s = season
    if name == "grass":
        return ground(rng, s)
    if name == "tallgrass":
        g = ground(rng, s, 0)
        base = GROUND[s][1][1]
        for x in range(0, 16, 2):
            h = rng.randrange(3, 7)
            rect(g, x, 15 - h, x, 15 - h + 2, shade(base, 0.8))
        return g
    if name == "meadow":
        return ground(rng, s, 0.08)
    if name == "flowers":
        g = ground(rng, s, 0)
        if s == 3:
            return g
        cols = {0: ("#f04060", "#f0e040", "#f080d0", "#ffffff"),
                1: ("#f0c020", "#e04040", "#8060f0"),
                2: ("#d06020", "#a03040", "#e0a030")}[s]
        for y in range(1, 16, 4):
            for x in range(1 + (y // 4) % 2 * 2, 16, 4):
                rect(g, x, y, x + 1, y + 1, rng.choice(cols))
                g[min(15, y + 2)][x] = "#2e7a2e"
        return g
    if name in ("path", "snowpath"):
        return dirt(rng, s)
    if name == "cobble":
        g = stone_blocks(rng, "#b8b0a0", "#8a8478", 4, 4)
        if s == 3:
            speckle(g, rng, ["#f4f8ff"], 0.25)
        return g
    if name == "plaza":
        g = grid_of("#d8ccb4")
        speckle(g, rng, ["#e0d6c0", "#ccc0a8"], 0.3)
        for i in range(16):
            g[i][0] = g[0][i] = "#b0a48c"
        disc(g, 0, 0, 2.2, "#b8ac94")
        disc(g, 15, 15, 2.2, "#c8bca4")
        if s == 3:
            speckle(g, rng, ["#f4f8ff"], 0.25)
        return g
    if name == "sand":
        g = grid_of("#e8d8a0")
        speckle(g, rng, ["#f0e0b0", "#d8c890"], 0.3)
        return g
    if name in ("soil", "soil_w"):
        wet = name == "soil_w"
        base = "#6a4a2a" if wet else "#9a7448"
        g = grid_of(base)
        for y in range(2, 16, 4):
            rect(g, 0, y, 15, y, shade(base, 0.75))
            rect(g, 0, y + 1, 15, y + 1, shade(base, 1.15))
        speckle(g, rng, [shade(base, 0.9)], 0.15)
        if s == 3 and not wet:
            speckle(g, rng, ["#f0f4fa"], 0.2)
        return g
    if name in ("water", "river", "pond"):
        frozen = s == 3 and name == "pond"
        base = {"water": "#3a80c8", "river": "#4a90d0", "pond": "#4088c0"}[
            name]
        if frozen:
            g = grid_of("#c8e0f0")
            speckle(g, rng, ["#e0f0fa", "#b0d0e8"], 0.3)
            return g
        g = grid_of(base)
        speckle(g, rng, [shade(base, 0.92), shade(base, 1.08)], 0.3)
        flow = name == "river"
        for y in range(2, 16, 5):
            x0 = (y * 3 + frame * (4 if flow else 2)) % 16
            for k in range(4):
                g[(y + (k if flow else 0)) % 16][(x0 + k) % 16] = "#a0d0f0"
        if frame:
            g[rng.randrange(16)][rng.randrange(16)] = "#ffffff"
        return g
    if name in ("bridge", "dock"):
        g = planks(rng, "#b08050", "#7a5430", vertical=name == "bridge")
        if name == "bridge":
            rect(g, 0, 0, 0, 15, "#5a3a20")
            rect(g, 15, 0, 15, 15, "#5a3a20")
        return g
    if name == "tree":
        return tree(rng, s)
    if name == "appletree":
        return tree(rng, s, fruit="#e03030" if s == 2 else
                    ("#90c040" if s == 1 else None),
                    blossom=("#ffd0e0", "#ffffff", "#f8a8c8"))
    if name == "blossomtree":
        return tree(rng, s, blossom=("#ffd0e0", "#ffffff", "#f8a8c8",
                                     "#f8a8c8"))
    if name == "pine":
        g = ground(rng, s, 0)
        rect(g, 7, 12, 8, 15, "#6a4428")
        for y in range(1, 13):
            w = (y + 1) // 2
            rect(g, 8 - w, y, 7 + w, y, "#2a6a3a" if y % 3 else "#1e5a2e")
            if s == 3 and y % 3 == 1:
                rect(g, 8 - w, y, 7 + w, y, "#f4f8ff")
        return g
    if name == "forest":
        g = grid_of("#1e4a24" if s != 3 else "#c8d4dc")
        cols = {0: ("#2a6a30", "#2e7a36", "#1a4020"),
                1: ("#22602a", "#2a702e", "#183a1c"),
                2: ("#a8581e", "#7a5a20", "#3a5a24"),
                3: ("#4a6a50", "#f0f4f8", "#3a5a44")}[s]
        for _ in range(9):
            disc(g, rng.uniform(1, 14), rng.uniform(1, 14),
                 rng.uniform(2, 3.5), rng.choice(cols), rng, 0.6)
        return g
    if name == "bush":
        g = ground(rng, s, 0)
        disc(g, 7.5, 9, 6, "#2e7a30" if s != 2 else "#9a6a2a", rng, 0.5)
        disc(g, 6.5, 8, 3.5, "#3a9a3a" if s != 2 else "#b08030", rng, 0.5)
        if s == 1:
            speckle_within(g, rng, "#2e7a30", ["#3040a0"], 0.15)
        if s == 3:
            disc(g, 7.5, 5, 4, "#f4f8ff", rng, 0.4)
        return g
    if name == "hedge":
        g = ground(rng, s, 0)
        rect(g, 0, 3, 15, 13, "#2e7a30")
        speckle_within(g, rng, "#2e7a30", ["#3a9a3a", "#1e5a24",
                                            "#f8c8e0" if s == 0 else
                                            "#2e7a30"], 0.25)
        return g
    if name in ("fence", "fence_v"):
        g = ground(rng, s, 0)
        if name == "fence":
            rect(g, 0, 6, 15, 6, "#b08050")
            rect(g, 0, 10, 15, 10, "#b08050")
            for x in range(1, 16, 5):
                rect(g, x, 4, x + 1, 13, "#9a6a40")
        else:
            rect(g, 7, 0, 8, 15, "#9a6a40")
            rect(g, 6, 3, 9, 4, "#b08050")
            rect(g, 6, 11, 9, 12, "#b08050")
        return g
    if name == "rock":
        g = ground(rng, s, 0)
        disc(g, 7.5, 8.5, 6.5, "#8a8478", rng, 0.8)
        disc(g, 6, 7, 4, "#a8a294", rng, 0.6)
        disc(g, 5, 5.5, 1.5, "#c0bcb0")
        return g
    if name == "cliff":
        g = stone_blocks(rng, "#8a8070", "#6a6050", 7, 5)
        if s == 3:
            rect(g, 0, 0, 15, 2, "#f4f8ff")
        return g
    if name == "well":
        g = draw_terrain("cobble", 0, s)
        disc(g, 7.5, 8, 6, "#8a8478")
        disc(g, 7.5, 8, 4, "#2a4a7a")
        rect(g, 2, 1, 2, 9, "#7a5030")
        rect(g, 13, 1, 13, 9, "#7a5030")
        rect(g, 1, 1, 14, 2, "#a0302a")
        return g
    if name == "fountain":
        g = draw_terrain("cobble", 0, s)
        disc(g, 7.5, 7.5, 7, "#a0a098")
        disc(g, 7.5, 7.5, 5.5, "#3a80c8" if s != 3 else "#c8e0f0")
        disc(g, 7.5, 7.5, 1.5, "#d0d0c8")
        if s != 3:
            disc(g, 7.5, 4 if frame == 0 else 3, 1.5, "#c0e8ff")
        return g
    if name == "lamp":
        g = draw_terrain("cobble", 0, s)
        rect(g, 7, 5, 8, 15, "#3a3a3a")
        rect(g, 5, 1, 10, 5, "#3a3a3a")
        rect(g, 6, 2, 9, 4, "#fff0a0" if frame == 0 else "#f0c060")
        return g
    if name == "bin":                           # the shipping bin
        g = ground(rng, s, 0)
        rect(g, 1, 5, 14, 14, "#8a5a30")
        rect(g, 1, 5, 14, 6, "#b07a40")
        rect(g, 0, 3, 15, 5, "#6a4020")
        for x in (4, 8, 12):
            rect(g, x, 7, x, 14, "#6a4020")
        rect(g, 6, 9, 9, 11, "#e0c040")
        return g
    if name == "mailbox":
        g = ground(rng, s, 0)
        rect(g, 7, 8, 8, 15, "#6a4428")
        rect(g, 3, 3, 12, 8, "#3a6ac0")
        disc(g, 7.5, 3, 4.5, "#3a6ac0")
        rect(g, 3, 9, 12, 9, "#6a4428")
        rect(g, 12, 2, 13, 5, "#e03030")
        return g
    if name == "board":                         # the village notice board
        g = draw_terrain("cobble", 0, s)
        rect(g, 2, 9, 3, 15, "#6a4428")
        rect(g, 12, 9, 13, 15, "#6a4428")
        rect(g, 1, 2, 14, 10, "#8a5a30")
        rect(g, 2, 3, 13, 9, "#c8a070")
        for (x, y, c) in ((3, 4, "#ffffff"), (8, 4, "#f8e0a0"),
                          (5, 7, "#f0f0f0"), (10, 7, "#ffd0e0")):
            rect(g, x, y, x + 2, y + 1, c)
        return g
    if name == "bench":
        g = draw_terrain("cobble", 0, s)
        rect(g, 1, 6, 14, 7, "#a07040")
        rect(g, 1, 9, 14, 10, "#a07040")
        rect(g, 2, 11, 2, 14, "#5a3a20")
        rect(g, 13, 11, 13, 14, "#5a3a20")
        return g
    if name == "sign":
        g = ground(rng, s, 0)
