def crop_art(name, stage, season=0):
    """A crop's sprite: 0 a sprout, 1 growing, 2 nearly there, 3 ripe."""
    leaf = crop(name, "leaf")
    col = crop(name, "colour")
    shape = crop(name, "shape")
    g = [[None] * 16 for _ in range(16)]
    dark = shade(leaf, 0.7)
    if stage == 0:
        for (x, y) in ((7, 12), (7, 11), (8, 10), (6, 10), (9, 9), (5, 9)):
            g[y][x] = leaf
        return g
    tall = shape in ("tall", "flower")
    top = {1: 8, 2: 5, 3: 3}[stage] - (2 if tall and stage > 1 else 0)
    rect(g, 7, top, 8, 13, dark)
    for y in range(top + 1, 13, 2):
        w = 2 + (y - top) // 3
        rect(g, 7 - w, y, 6, y, leaf)
        rect(g, 9, y + 1 if y < 12 else y, 8 + w, y + 1 if y < 12 else y,
             leaf)
    if stage < 3:
        if stage == 2 and shape in ("berry", "pod"):
            for (x, y) in ((5, 8), (10, 9)):
                g[y][x] = mix(leaf, col, 0.3)
        return g
    hi = shade(col, 1.25)
    if shape == "root":
        disc(g, 7.5, 12, 3, col)
        g[11][6] = hi
        rect(g, 7, 6, 8, 9, leaf)
    elif shape == "berry":
        for (x, y) in ((4, 7), (10, 6), (6, 10), (11, 10), (8, 5), (3, 11)):
            rect(g, x, y, x + 1, y + 1, col)
            g[y][x] = hi
    elif shape == "head":
        disc(g, 7.5, 9, 4.5, col)
        disc(g, 6.5, 8, 1.5, hi)
        if name == "pumpkin":
            for y in range(6, 13):
                g[y][7] = shade(col, 0.8)
            rect(g, 7, 3, 8, 4, "#6a4a2a")
    elif shape == "pod":
        for (x, y) in ((4, 6), (11, 8), (5, 10)):
            rect(g, x, y, x, y + 3, col)
            rect(g, x + 1, y + 1, x + 1, y + 2, shade(col, 0.85))
    elif shape == "tall":
        for (x, y) in ((5, 6), (10, 8)):
            rect(g, x, y, x + 1, y + 4, col)
            g[y][x] = hi
            g[y - 1][x + 1] = "#c0e080"
    elif shape == "flower":
        disc(g, 7.5, 3.5, 3.2, col)
        disc(g, 7.5, 3.5, 1.4, "#6a3a1a")
    return g


