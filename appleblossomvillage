# ── Portraits ────────────────────────────────────────────────────────────────
#
# When you talk to someone their face is drawn large beside what they say:
# 32 by 32 squares, made like the tiles from how they look, in one of a few
# expressions: neutral, happy, laugh, blush, sad, surprised and cross.

PW = 32
EXPRESSIONS = ("neutral", "happy", "laugh", "blush", "sad", "surprised",
               "cross")


def pdisc(g, cx, cy, rx, ry, c, test=None):
    for y in range(PW):
        for x in range(PW):
            if ((x - cx) / rx) ** 2 + ((y - cy) / ry) ** 2 <= 1.0 and (
                    test is None or test(x, y)):
                g[y][x] = c


def prect(g, x0, y0, x1, y1, c):
    for y in range(max(0, y0), min(PW, y1 + 1)):
        for x in range(max(0, x0), min(PW, x1 + 1)):
            g[y][x] = c


def mirror(x):
    return PW - 1 - x


def portrait(look, expr="neutral"):
    """The rows of a 32 x 32 portrait (colours), from how someone looks."""
    rng = random.Random(repr(sorted(look.items())))
    bg = look.get("bg", "#c8b8d8")
    g = [[mix(shade(bg, 1.12), shade(bg, 0.82), y / PW)] * PW
         for y in range(PW)]
    for y in range(PW):
        g[y] = list(g[y])
    skin = SKIN[look.get("skin", 1) % len(SKIN)]
    skd = shade(skin, 0.86)
    skdd = shade(skin, 0.72)
    hair = look.get("hair", "#5a3a1e")
    hd, hl = shade(hair, 0.72), shade(hair, 1.25) if hair != "#eeeeee" \
        else "#ffffff"
    if hair in ("#1e1a1a",):
        hl = "#4a4048"
    style = look.get("style", "short")
    extras = set(look.get("extras", ()))
    shirt = look.get("shirt", "#4a7ac0")
    eyes = look.get("eyes", "#5a3a1e")
    age = look.get("age", "adult")
    fem = look.get("face", "M") == "F"
    child = age == "child"
    cx = 15.5
    fy = 15 if not child else 16                  # the face's middle
    frx, fry = (7.5, 9) if not child else (8.0, 8)

    # long hair falls behind the shoulders
    if style in ("long", "curly", "braid", "bob", "pigtails", "bangs"):
        bottom = {"long": 29, "curly": 26, "braid": 22, "bob": 21,
                  "pigtails": 20, "bangs": 29}[style]
        pdisc(g, cx, fy - 1, frx + 3, fry + 2, hd)
        prect(g, round(cx - frx - 3), fy, round(cx + frx + 3), bottom, hd)
        if style == "curly":
            for _ in range(40):
                x = rng.randrange(4, 28)
                y = rng.randrange(3, bottom)
                if g[y][x] == hd:
                    g[y][x] = hair
            for y in range(fy, bottom + 1, 2):
                g[y][round(cx - frx - 4)] = hd
                g[y][mirror(round(cx - frx - 4))] = hd
    if style == "bun":
        pdisc(g, cx, fy - fry - 1.5, 4, 3.5, hair)
        pdisc(g, cx - 1, fy - fry - 2.5, 1.5, 1.2, hl)
    if style == "ponytail":
        pdisc(g, cx + frx + 1.5, fy, 2.5, 6, hd)
    if style == "pigtails":
        for side in (-1, 1):
            pdisc(g, cx + side * (frx + 3), fy + 1, 3, 5, hair)

    # shoulders and neck
    for y in range(24, PW):
        half = 7 + (y - 24) * 1.6 if not child else 6 + (y - 24) * 1.4
        for x in range(PW):
            if abs(x - cx) <= half:
                g[y][x] = shirt if abs(x - cx) < half - 1.5 else \
                    shade(shirt, 0.8)
    prect(g, 13, fy + 6, 18, 25, skd)
    prect(g, 13, fy + 6, 18, fy + 7, skdd)
    collar = look.get("collar")
    if collar:
        for y in range(24, 28):
            g[y][round(cx - 3 - (y - 24) * 0.5)] = collar
            g[y][mirror(round(cx - 3 - (y - 24) * 0.5))] = collar
        prect(g, 12, 24, 12, 25, collar)
        prect(g, 19, 24, 19, 25, collar)
    if "apron" in extras:
        prect(g, 11, 27, 20, 31, "#f4f0e8")
        prect(g, 11, 26, 11, 27, "#f4f0e8")
        prect(g, 20, 26, 20, 27, "#f4f0e8")
    if "scarf" in extras:
        sc = look.get("scarfc", "#c04040")
        prect(g, 10, 23, 21, 25, sc)
        prect(g, 17, 25, 19, 29, shade(sc, 0.85))
    if "overalls" in extras:
        oc = look.get("pants", "#3a5a8a")
        prect(g, 10, 28, 21, 31, oc)
        prect(g, 11, 25, 12, 28, oc)
        prect(g, 19, 25, 20, 28, oc)
        g[27][11] = g[27][20] = "#e0c040"
    if "coat" in extras:
        cc = look.get("coatc", "#f4f4f4")
        for y in range(25, PW):
            for x in range(PW):
                if g[y][x] in (shirt, shade(shirt, 0.8)) and \
                        abs(x - cx) > 3.5:
                    g[y][x] = cc if abs(x - cx) < 14 else shade(cc, 0.85)
    if "necklace" in extras:
        for x in range(12, 20):
            g[25 + (1 if 13 < x < 18 else 0)][x] = "#f0d040"
        g[27][15] = g[27][16] = "#f080a0"

    # the face, with a narrower chin
    def face(x, y):
        if y > fy + 3:
            k = (y - fy - 3) / (fry - 3)
            return abs(x - cx) <= frx * (1 - 0.42 * k * k) + 0.2
        return True
    pdisc(g, cx, fy, frx, fry, skin, face)
    for y in range(fy - 2, fy + 2):            # ears
        g[y][round(cx - frx - 0.5)] = skd
        g[y][mirror(round(cx - frx - 0.5))] = skd
    for y in range(fy + 3, fy + 9):             # a shadow down the jaw
