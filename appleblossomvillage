def selftest():
    """Build everything and check the people, places and tunes fit
    together; then run a season of days without a window."""
    problems = []
    for season in range(4):
        tiles = all_tiles(season)
        for name, px in tiles.items():
            if len(px) != 16 or any(len(r) != 16 for r in px):
                problems.append("tile %s is not 16x16" % name)
    for vid, v in VILLAGERS.items():
        if vid not in SWAP_LINES or vid not in UNSTATUE or \
                vid not in CHICKEN_BACK or vid not in TREE_BACK or \
                vid not in TREE_CHOPPED or (
                    (vid not in MAID_LINES or vid not in LOO_BACK or
                     vid not in COW_BACK) and
                    v["look"].get("age") != "child"):
            problems.append("%s lacks spell reactions" % vid)
        for expr in EXPRESSIONS:
            px = portrait(swap_look(v["look"]), expr)
            if len(px) != PW or any(len(r) != PW for r in px):
                problems.append("swapped portrait %s/%s" % (vid, expr))
            px = portrait(v["look"], expr)
            if len(px) != PW or any(len(r) != PW for r in px):
                problems.append("portrait %s/%s" % (vid, expr))
    grid, labels = make_valley(1)
    if len(grid) != VH or any(len(r) != VW for r in grid):
        problems.append("valley size")
    for key, (x0, y0, w, h, *_) in BUILDINGS.items():
        if key in ON_ORDER:
            continue
        for y in range(y0, y0 + h):
            for x in range(x0, x0 + w):
                if not grid[y][x].startswith(("wall_", "win_", "roof_",
                                              "eave_", "door_", "chimney")):
                    problems.append("%s is built over at %d,%d" % (key, x,
                                                                  y))
    rooms = {}
    for key in EXTRA_ROOMS:
        g, spots, entry, ex = make_room(key)
        if g[entry[1]][entry[0]] not in WALKABLE or ex is None:
            problems.append("room %s has no way in and out" % key)
    for key, (floor, wall, rows) in ROOMS.items():
        if len({len(r) for r in rows}) != 1:
            problems.append("room %s rows differ" % key)
            continue
        g, spots, entry, ex = make_room(key)
        rooms[key] = (g, spots, entry)
        if g[entry[1]][entry[0]] not in WALKABLE:
            problems.append("room %s entry blocked" % key)
        # every spot reachable from the entry
        seen = {entry}
        q = deque([entry])
        while q:
            x, y = q.popleft()
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if 0 <= n[1] < len(g) and 0 <= n[0] < len(g[0]) and \
                        n not in seen and g[n[1]][n[0]] in WALKABLE:
                    seen.add(n)
                    q.append(n)
        for ch, pos in spots.items():
            if pos not in seen:
                problems.append("room %s spot %s unreachable" % (key, ch))
    grid, labels = make_valley(1, built=ON_ORDER)
    for key in BUILDINGS:
        dx, dy = door_of(key)
        if grid[dy + 1][dx] not in WALKABLE:
            problems.append("door of %s blocked" % key)
    for name, (x, y) in OUT_SPOTS.items():
        if grid[y][x] not in WALKABLE:
            problems.append("spot %s on %s" % (name, grid[y][x]))
    for vid, v in VILLAGERS.items():
        for kind in ("loves", "likes", "dislikes", "hates"):
            for item in v[kind]:
                if not item.startswith("kind:") and item not in ITEMS:
                    problems.append("%s %s unknown %s" % (vid, kind, item))
        for sname, sched in v["sched"].items():
            for t, spot in sched:
                area, mark = spot.split(".")
                if area == "out":
                    if mark not in OUT_SPOTS:
                        problems.append("%s: no out.%s" % (vid, mark))
                elif area not in rooms or mark not in rooms[area][1]:
                    problems.append("%s: no %s" % (vid, spot))
        for level, steps in v["scenes"].items():
            for s in steps:
                if isinstance(s, tuple) and (s[0] != "?" or
                                             len(s[2]) < 2):
                    problems.append("%s scene %d choice" % (vid, level))
        if v["romance"]:
            for k in ("date", "dating", "spouse"):
                if not v.get(k):
                    problems.append("%s has no %s" % (vid, k))
            if vid not in ACCEPT or vid not in PROPOSAL or vid not in VOWS:
                problems.append("%s lacks romance lines" % vid)
        if v["shop"] and v["shop"][1] not in SHOP_STOCK:
            problems.append("%s shop" % vid)
    for kind, stock in SHOP_STOCK.items():
        for entry in stock:
            if entry != "seeds" and entry[0] not in ITEMS and entry[0] not \
                    in ("checkup", "copper can", "cabin extension",
                        "chicken", "chicken coop", "leash", "barn",
                        "cow", "milk pail",
                        "fishing rod", "sprinkler"):
                problems.append("shop %s sells unknown %s" % (kind, entry))
    for name, tune in MUSIC.items():
        try:
            render_tune(tune)
        except (ValueError, KeyError) as e:
            problems.append("tune %s: %s" % (name, e))
    for line in problems:
        print("PROBLEM:", line)
    print("selftest: %d tiles a season, %d rooms, %d villagers, %d tunes; "
          "%s" % (len(tiles), len(rooms), len(VILLAGERS), len(MUSIC),
                  "all good" if not problems else "%d problems" %
                  len(problems)))
    return not problems


