def swap_look(look):
    """How someone looks after the genderswap spell: the other face and
    build, the hair done to match, beards and moustaches gone (and, for
    the old ladies, a fine white moustache)."""
    new = dict(look)
    fem = look.get("face", "M") == "F"
    child = look.get("age") == "child"
    new["face"] = "M" if fem else "F"
    if look.get("body") in ("M", "F"):
        new["body"] = "M" if fem else "F"
    style = look.get("style", "short")
    if child:
        new["style"] = "messy" if fem else "pigtails"
    else:
        new["style"] = (STYLE_TO_M if fem else STYLE_TO_F).get(style, style)
    extras = [e for e in look.get("extras", ())
              if e not in ("beard", "mustache")]
