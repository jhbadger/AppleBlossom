def make_room(key):
    """A room's grid, its spots, where you come in and the way out."""
    floor, wall, rows = ROOMS[key] if key in ROOMS else EXTRA_ROOMS[key]
    grid, spots, exit_ = [], {}, None
    for y, row in enumerate(rows):
        line = []
        for x, ch in enumerate(row):
            if ch in SPOT_CHARS:
                spots[ch] = (x, y)
                line.append(floor)
            elif ch == ".":
                line.append(floor)
            elif ch == "W" and wall == "l":
                line.append("logwall")
            elif ch == "w" and wall == "l":
                line.append("iwin")
            else:
                if ch == "x":
                    exit_ = (x, y)
                line.append(ROOM_TILES[ch])
        grid.append(line)
    return grid, spots, (exit_[0], exit_[1] - 1), exit_


