        self.mail("Granny Rose",
                  "Dear one, I was your grandmother's cousin. Come and see "
                  "me at my cottage by the orchard, and I'll tell you all "
                  "about her. There's always pie. Love, Rose.")
        self.load_images()
        self.area = a
        self.settle_npcs()
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        self.say("Among Grandmother's tools you find a magic wand. Hold "
                 "it and use it to aim a spell: it can turn people to gold, "
                 "and back again.", "quest")
        self.say("You wake in your grandmother's cabin at %s Farm. Spring "
                 "has come to Apple Blossom Village." % self.p["farm"],
                 "quest")
        self.say("The farm's overgrown, but the tools are good. There's "
                 "mail in the box outside. (Walk into things to use them; "
                 "press ? for help.)", "info")
        self.layout()
        self.fit(True)
        self.save()

    @staticmethod
    def default_hero():
        return {"name": "Lily", "farm": "Applewood", "pron": "they",
                "look": Game.random_look(random.Random(1), "F")}

    def restore(self, g):
        self.p = g["p"]
        self.st = st = g["st"]
        self.p.setdefault("built", [])
        st.setdefault("statues", [])
        st.setdefault("swapped", [])
        st.setdefault("chickens", [])
        st.setdefault("eggs", [])
        st.setdefault("chickenfied", [])
        st.setdefault("maids", {})
        st.setdefault("trees", [])
        st.setdefault("loos", [])
        st.setdefault("felled", {})
        st.setdefault("leashed", None)
        st.setdefault("cows", [])
        st.setdefault("cowified", [])
        for vid in VILLAGERS:
            st["friends"].setdefault(vid, {
                "pts": 0, "talked": -1, "week": 0, "gift_day": -1,
                "met": False, "scenes": [], "status": None, "dated": -1})
        st.setdefault("loo_in", None)
        if "magic wand" not in self.p["tools"]:
            self.p["tools"].append("magic wand")     # older saves
        self.build_world(st["seed"], self.p["built"])
        self.apply_felled()
        for vid, (area, x, y) in st["npcs"].items():
            n = self.npcs.get(vid)
            if n and area in self.areas:
                n.where, n.x, n.y = area, x, y
        for vid, n in self.npcs.items():          # hens and cows of yours
            if self.cooped(vid):
                n.where, n.hidden = "coop", True
            elif self.barned(vid):
                n.where, n.hidden = "barn", True
        self.area = self.areas[st["area"]]
        if self.area.key == "loo" and st["loo_in"] not in st["loos"]:
            self.area = self.areas["valley"]
            st["pos"] = list(door_of("cabin"))
            st["pos"][1] += 1
        self.load_images()
        for vid, n in self.npcs.items():
            if n.where is None:
                self.settle_npcs()
                break
        for line, tag in g.get("log", [])[-30:]:
            self.say(line, tag)
        self.say("Welcome back to %s Farm." % self.p["farm"], "quest")
        self.layout()

    def save(self):
        if not self.p:
            return
        st = self.st
        st["area"] = self.area.key
        st["npcs"] = {vid: [n.where, n.x, n.y] for vid, n in
                      self.npcs.items() if n.where}
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k,
                "game": {"p": self.p, "st": st,
                         "log": getattr(self, "logged", [])[-30:]}}
        try:
            tmp = SAVE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(data, f)
            os.replace(tmp, SAVE_FILE)
        except OSError:
            pass

    def quit(self):
        try:
            self.save()
        finally:
            self.sound.stop_music()
            self.root.destroy()

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        self.log.see("end")
        self.log.config(state="disabled")
        self.logged = getattr(self, "logged", [])[-60:] + [(text, tag)]

    # ── The calendar ──

    def season(self, day=None):
        return ((self.st["day"] if day is None else day) // SEASON_DAYS) % 4

    def dom(self, day=None):
        return (self.st["day"] if day is None else day) % SEASON_DAYS + 1

    def year(self):
        return self.st["day"] // (SEASON_DAYS * 4) + 1

    def weekday(self, day=None):
        return (self.st["day"] if day is None else day) % 7

    def hhmm(self):
        m = self.st["minute"]
        return (m // 60) * 100 + m % 60

    def clock(self, m=None):
        m = self.st["minute"] if m is None else m
        h, mm = (m // 60) % 24, m % 60
        return "%d:%02d %s" % (h % 12 or 12, mm, "am" if h < 12 else "pm")

    def date_text(self, day=None):
        day = self.st["day"] if day is None else day
        return "%s %d, Year %d (%s)" % (SEASONS[self.season(day)],
                                        self.dom(day), day // 112 + 1,
                                        WEEKDAYS[self.weekday(day)])

    def festival_today(self):
        return FESTIVALS.get((self.season(), self.dom()))

    def festival_on(self):
        """Today's festival, if it's going on right now."""
        f = self.festival_today()
        if f and f[1] <= self.hhmm() < f[2]:
            return f
        return None

    def light_level(self):
        if not self.area.outdoor:
            return 0
        h = self.hhmm()
        dusk = (1900, 2030) if self.season() in (1,) else \
            (1700, 1830) if self.season() == 3 else (1800, 1930)
        if h >= dusk[1] or h < 530:
            return 2
        if h >= dusk[0] or self.st["weather"] in ("rain", "storm"):
            return 1
        return 0

    # ── Passing time ──

    def pass_time(self, minutes, quiet=False):
        """Minutes go by: people go about their day, and at two in the
        morning you drop where you stand."""
        st = self.st
        for _ in range(minutes):
            st["minute"] += 1
            if st["minute"] % 10 == 0 or minutes < 30:
                self.npc_minute(minutes < 30)
            if st["minute"] == 24 * 60 and not quiet:
                self.say("It's midnight. You should get to bed.", "bad")
            if st["minute"] >= BEDTIME:
                self.collapse()
                return

    def flags_today(self):
        return self.st.setdefault("today", [])

    def end_turn(self, cost=WALK_COST):
        if self.area is None:
            return
        self.pass_time(cost)
        st = self.st
        if st["wedding"] == st["day"] and 1000 <= self.hhmm() < 1500 and \
                self.area.outdoor and not self.scene:
            x0, y0, x1, y1 = SQUARE
            x, y = self.pos()
            if x0 <= x <= x1 and y0 <= y <= y1:
                self.wedding()
                return
        if self.p["energy"] <= 0 and "tired" not in self.flags_today():
            self.flags_today().append("tired")
            self.say("You're exhausted. Eat something, or go to bed.", "bad")
        self.render()

    def ready(self):
        return bool(self.p) and self.area is not None and not (
            self.busy or self.menu or self.talk or self.overlay or
            self.scene or getattr(self, "aim", False) or
            getattr(self, "naming", None) is not None)

    def built(self):
        return self.p.get("built", ()) if self.p else ()

    # ── Moving ──

    def pos(self):
        return tuple(self.st["pos"])

    def tile_at(self, x, y, area=None):
        a = area or self.area
        if not a.inside(x, y):
            return None
        if a.outdoor:
            if "%d,%d" % (x, y) in self.st["soil"]:
                return "soil"
        return a.grid[y][x]

    def thing_at(self, x, y):
        """What lies on a square of the valley: debris, a crop, forage, a
        sprinkler."""
        k = "%d,%d" % (x, y)
        st = self.st
        if k in st["debris"]:
            return ("debris", st["debris"][k])
        if k in st["sprinklers"]:
            return ("sprinkler", None)
        s = st["soil"].get(k)
        if s and s[1]:
            return ("crop", s)
        if k in st["forage"]:
            return ("forage", st["forage"][k])
        return None

    def npc_at(self, x, y, area=None):
        a = (area or self.area).key
        for n in self.npcs.values():
            if n.where == a and n.x == x and n.y == y and not n.hidden:
                return n
        return None

    def can_stand(self, x, y, area=None):
        a = area or self.area
        if not a.inside(x, y):
            return False
        t = self.tile_at(x, y, a)
        if t not in WALKABLE:
            return False
        if a.outdoor:
            th = self.thing_at(x, y)
            if th and th[0] in ("debris", "sprinkler"):
                return False
        elif a.key == "coop" and self.chicken_at(x, y) is not None:
            return False
        return True

    def face(self, dx, dy):
        self.st["facing"] = [dx, dy]

    def ahead(self):
        x, y = self.pos()
        dx, dy = self.st["facing"]
        return x + dx, y + dy

    def move(self, dx, dy):
        before = (self.area.key, tuple(self.pos())) if self.area else None
        self.step(dx, dy)
        if before and self.st.get("leashed"):
            self.lead(before)

    def step(self, dx, dy):
        if not self.ready():
            return
        self.face(dx, dy)
        x, y = self.pos()
        nx, ny = x + dx, y + dy
        a = self.area
        n = self.npc_at(nx, ny)
        if n:
            self.walking = None
            self.start_talk(n)
            return
        if not a.inside(nx, ny):
            self.render()
            return
        t = self.tile_at(nx, ny)
        if self.bump(nx, ny, t):
            self.walking = None
            return
        if not self.can_stand(nx, ny):
            self.walking = None
            self.render()
            return
        self.st["pos"] = [nx, ny]
        if a.key == "coop" and [nx, ny] in self.st["eggs"]:
            self.st["eggs"].remove([nx, ny])
            self.give("egg")
            self.sound.play("pick")
            self.say("You pick up a fresh egg. Still warm.", "good")
        if a.outdoor:
            self.step_on(nx, ny)
        elif t == "exit":
            self.leave_room()
            return
        self.end_turn(WALK_COST)

    def bump(self, x, y, t):
        """Walking into something: True if that was all the move did."""
        a = self.area
        if a.outdoor:
            if (x, y) in self.door_at:
                self.enter_room(self.door_at[(x, y)])
                return True
            th = self.thing_at(x, y)
            if th and th[0] == "debris":
                self.clear_debris(x, y, th[1], auto=True)
                return True
            if t == "bin":
                self.ship_menu()
                return True
            if t == "mailbox":
                self.read_mail()
                return True
            if t == "board":
                self.read_board()
                return True
            if t == "appletree":
                self.pick_apples(x, y)
                return True
            if t in ("well", "fountain") or t in WATER:
                if self.p["hand"] == "watering can":
                    self.use_tool_at(x, y)
                    return True
                if t == "well":
                    self.say("Your grandmother's well. The water's cold "
                             "and sweet.", "info")
                    return True
                return False
            if t and t.startswith(("wall_", "win_", "roof_", "eave_",
                                   "chimney")):
                self.describe_building(x, y)
                return True
            return False
        if t == "counter":
            bx, by = x + (x - self.pos()[0]), y + (y - self.pos()[1])
            n = self.npc_at(bx, by)
            if n:
                self.start_talk(n)
                return True
            self.say("Nobody's behind the counter.", "info")
            return True
        if a.key == "barn":
            i = self.cow_at(x, y)
            if i is not None:
                self.cow_menu(i)
                return True
            if t == "hay":
                self.say("Bales of sweet hay. The cows eye them hopefully.",
                         "info")
                return True
            if t == "churn":
                self.say("A milk churn, scrubbed and shining.", "info")
                return True
            if t == "trough":
                self.say("The water trough. Somebody keeps it full.",
                         "info")
                return True
        if a.key == "coop":
            i = self.chicken_at(x, y)
            if i is not None:
                self.chicken_menu(i)
                return True
            if t == "nest":
                self.say("Nest boxes, lined with straw. The hens lay "
                         "wherever they please anyway.", "info")
                return True
            if t == "trough":
                self.say("The feed trough. Ivy fills it from a sack that "
                         "never seems to run out.", "info")
                return True
        if t == "loohole":
            self.do_business()
            return True
        if t == "loobench":
            self.say(random.choice(LOO_ALMANAC), "info")
            return True
        if t == "bed2" and a.key == "cabin":
            self.bed_menu()
            return True
        if t in ("bed", "bed2"):
            self.say("Somebody's bed. Better not.", "info")
            return True
        if t == "stove" and a.key == "cabin":
            self.say("Grandmother's stove. You could eat something from "
                     "your bag (I).", "info")
            return True
        if t in ("shelf",):
            self.say(random.choice(SHELF_BOOKS), "info")
            return True
        return False

    def describe_building(self, x, y):
        for key, (x0, y0, w, h, _, _, name) in BUILDINGS.items():
            if x0 <= x < x0 + w and y0 <= y < y0 + h:
                hours = OPEN_HOURS.get(key)
                self.say(cap(name) + "." + (" " + hours if hours else ""),
                         "info")
                return
        self.render()

    def step_on(self, x, y):
        k = "%d,%d" % (x, y)
        item = self.st["forage"].pop(k, None)
        if item:
            self.give(item)
            self.sound.play("pick")
            self.say("You find %s." % an(item), "good")

    def enter_room(self, key):
        a = self.areas[key]
        hours = OPEN_HOURS.get(key)
        if not self.open_now(key):
            self.say("%s is locked. %s" % (cap(BUILDINGS[key][6]),
                                            hours or ""), "info")
            self.render()
            return
        self.sound.play("door")
        self.area = a
        self.st["pos"] = list(a.entry)
        self.face(0, -1)
        self.say("You go into %s." % BUILDINGS[key][6], "info")
        self.walking = None
        self.layout()
        self.end_turn(WALK_COST)
        self.save()

    def open_now(self, key):
        """Homes are open while someone's home and awake; shops in their
        hours; your own cabin always."""
        h = self.hhmm()
        if key in ("cabin", "coop", "barn"):
            return True
        if self.festival_on() and key not in ("inn",):
            return False
        keeper = {"store": "mabel", "clinic": "felix", "smithy": "otto",
                  "carpentry": "ivy", "library": "juniper"}.get(key)
        if key in ("store", "clinic", "smithy", "carpentry", "library",
                   "inn") and not (keeper and self.weekday() ==
                                   VILLAGERS[keeper]["rest"]):
            lo, hi = {"store": (900, 2000), "clinic": (900, 2100),
                      "smithy": (800, 1800), "carpentry": (800, 1900),
                      "library": (800, 2000), "inn": (800, 2400)}[key]
            if lo <= h < hi or h < 200:
                return h >= lo
        return 700 <= h < 2100 and any(
            n.where == key for n in self.npcs.values())

    def leave_room(self):
        key = self.area.key
        self.area = self.areas["valley"]
        if key == "loo" and self.st["loo_in"] not in self.st["loos"]:
            key = "cabin"           # (an outhouse that's gone: home)
        if key == "loo":
            vid, self.st["loo_in"] = self.st["loo_in"], None
            x, y = self.loo_door(vid)
            taken = {(n.where, n.x, n.y) for n in self.npcs.values()}
            if ("valley", x, y) in taken:
                x, y = self.free_spot("valley", x, y, taken)
            self.st["pos"] = [x, y]
            self.say("You step out of the outhouse that is %s, feeling a "
                     "good deal lighter." % VILLAGERS[vid]["short"], "info")
            self.face(0, 1)
            self.sound.play("door")
            self.walking = None
            self.layout()
            self.end_turn(WALK_COST)
            self.save()
            return
        dx, dy = door_of(key)
        self.st["pos"] = [dx, dy + 1]
        self.face(0, 1)
        self.sound.play("door")
        self.walking = None
        self.layout()
        self.end_turn(WALK_COST)
        self.save()

    # ── Tools ──

    def held(self):
        h = self.p["hand"]
        if h in self.p["tools"] or self.p["items"].get(h):
            return h
        self.p["hand"] = "hoe" if "hoe" in self.p["tools"] else None
        return self.p["hand"]

    def hand_list(self):
        seeds = sorted(n for n, c in self.p["items"].items()
                       if c and (n.endswith(" seeds") or n == "sprinkler"))
        return [t for t in TOOLS if t in self.p["tools"]] + seeds

    def hand_name(self, h=None):
        h = h or self.held()
        if h == "watering can":
            return "watering can (%d/%d)" % (self.p["water"], self.p["can"])
        if h == "magic wand":
            return "magic wand (%s)" % self.p.get("spell", "petrify")
        if h and h in self.p["items"]:
            return "%s (%d)" % (h, self.p["items"][h])
        return h or "nothing"

    def next_tool(self, d=1):
        if not self.ready():
            return
        hs = self.hand_list()
        if not hs:
            return
        cur = self.held()
        i = hs.index(cur) if cur in hs else -1
        self.p["hand"] = hs[(i + d) % len(hs)]
        self.say("You hold the %s." % self.hand_name(), "info")
        self.render()

    def pick_tool(self, i):
        hs = self.hand_list()
        if 0 <= i < len(hs) and self.ready():
            self.p["hand"] = hs[i]
            self.say("You hold the %s." % self.hand_name(), "info")
            self.render()

    def tool_menu(self):
        if not self.ready():
            return
        self.open_menu("Hold what?", [
            ("%d. %s" % (i + 1, self.hand_name(h)) if i < 9 else
             self.hand_name(h),
             lambda h=h: (self.p.update(hand=h), self.render()))
            for i, h in enumerate(self.hand_list())] +
            [("Never mind", lambda: None)])

    def tool_applies(self, x, y, h=None):
        """Whether using what you hold on (x, y) would do something."""
        h = h or self.held()
        a = self.area
        if h == "magic wand":
            return self.wand_target(x - self.pos()[0],
                                    y - self.pos()[1]) is not None
        if h == "milk pail" and a.key == "barn":
            i = self.cow_at(x, y)
            return i is not None and \
                self.st["cows"][i].get("milked") != self.st["day"]
        n = self.npc_at(x, y)
        if n and self.tree(n.vid) and h in ("axe", "watering can"):
            return True
        if n and (self.leashed(n.vid) or (
                h == "leash" and self.leashable(n.vid))):
            return True
        if not a.outdoor or not a.inside(x, y) or n:
            return False
        t = self.tile_at(x, y)
        th = self.thing_at(x, y)
        if h == "axe" and t in CHOPPABLE:
            return True
        if th and th[0] == "crop" and self.ripe(th[1]):
            return True
        if th and th[0] == "forage":
            return True
        if th and th[0] == "debris":
            return DEBRIS[th[1]][0] == h
        if h == "watering can":
            return (t == "soil" and not self.st["soil"]["%d,%d" % (x, y)][0]
                    ) or t in WATER or t in ("well", "fountain")
        if h == "hoe":
            if th and th[0] == "crop" and th[1][3]:
                return True
            return on_farm(x, y) and t in TILLABLE and not th
        if h and h.endswith(" seeds"):
            return t == "soil" and not th
        if h == "sprinkler":
            return on_farm(x, y) and not th and (t == "soil" or
                                                 t in TILLABLE)
        if h == "fishing rod":
            return t in WATER
        return False

    def use_tool(self):
        if not self.ready():
            return
        self.use_tool_at(*self.ahead())

    # ── The magic wand ──

    def statue(self, vid):
        return vid in self.st["statues"]

    def tree(self, vid):
        return vid in self.st.setdefault("trees", [])

    def loo(self, vid):
        return vid in self.st.setdefault("loos", [])

    def rooted(self, vid):
        """Statues, trees and outhouses stay where they are."""
        return self.statue(vid) or self.tree(vid) or self.loo(vid)

    def wand_target(self, dx, dy):
        """The first person a spell cast that way would hit, or None.
        Spells fly in a straight line until they hit someone or something
        solid."""
        if (dx, dy) not in DIRS:
            return None
        x, y = self.pos()
        for _ in range(WAND_RANGE):
            x, y = x + dx, y + dy
            if not self.area.inside(x, y):
                return None
            n = self.npc_at(x, y)
            if n:
                return n
            for key, at, pen in (("coop", self.chicken_at, "chickens"),
                                 ("barn", self.cow_at, "cows")):
                if self.area.key == key:
                    i = at(x, y)
                    vid = i is not None and self.st[pen][i].get("vid")
                    if vid:
                        n = self.npcs[vid]
                        n.where, n.x, n.y = key, x, y
                        return n
            t = self.tile_at(x, y)
            if t not in WALKABLE and t not in WATER:
                return None
        return None

    def start_aim(self, at=None):
        """Raise the wand: choose a spell, then the next direction you
        press (or tap) is the way it flies. With `at` (a direction, from
        tapping someone in line) it flies that way at once."""
        cur = self.p.get("spell", "petrify")
        names = list(SPELLS)
        self.open_menu("Cast which spell?", [
            ("%s: %s" % (cap(n), SPELLS[n]),
             lambda n=n: self.aim_spell(n, at))
            for n in names] + [("Lower the wand", lambda: None)])
        self.menu["sel"] = names.index(cur) if cur in names else 0
        self.render()

    def aim_spell(self, spell, at=None):
        self.p["spell"] = spell
        if at:
            self.zap(*at)
            return
        self.aim = True
        self.walking = None
        self.say(cap(spell) + "! Zap which way? Press an arrow key, or "
                 "tap that way. "
                 "(Space zaps the way you're facing; Esc lowers the "
                 "wand.)", "quest")
        self.render()

    def cancel_aim(self):
        self.aim = False
        self.say("You lower the wand.", "info")
        self.render()

    def zap(self, dx=None, dy=None):
        """Cast the spell in hand that way."""
        self.aim = False
        if dx is None:
            dx, dy = self.st["facing"]
        self.face(dx, dy)
        n = self.wand_target(dx, dy)
        if not self.spend("magic wand"):
            return
        self.sound.play("spell")
        if n is None:
            self.say("You wave the wand. A spark of gold flies off and "
                     "fizzles out.", "info")
            self.flash(*self.ahead())
            self.end_turn(TOOL_COST)
            return
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        self.flash(n.x, n.y, "sparkle")
        spell = self.p.get("spell")
        if spell == "looify":
            self.looify(n)
            return
        if self.cooped(vid) and spell != "chickenfy":
            self.say("The spell fizzles in the straw. The hens squawk, and "
                     "%s the hen glares at you." % name, "info")
            self.end_turn(TOOL_COST)
            return
        if self.barned(vid) and spell != "cowify":
            self.say("The spell fizzles in the straw. The cows shuffle, "
                     "and %s the cow gives you a long look." % name, "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "cowify":
            self.cowify(n)
            return
        if self.is_cow(vid) and spell != "petrify":
            self.say("The spell bounces off the cow's hide. Cows are cows.",
                     "info")
            self.end_turn(TOOL_COST)
            return
        if self.loo(vid):
            self.say("The spell splinters harmlessly against the outhouse "
                     "door. It takes more than that to undo an outhouse.",
                     "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "treeify":
            self.treeify(n)
            return
        if self.tree(vid):
            self.say("The spell sinks into %s's bark and is gone. Trees "
                     "don't hold with that sort of magic." % name, "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "maidify":
            self.maidify(n)
            return
        if spell in ("genderswap", "chickenfy") and self.maid(vid):
            self.say("The spell glances off %s's starched apron. A maid "
                     "stays a maid until the spell that made her is "
                     "undone." % name, "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "genderswap":
            if self.chicken(vid) and not self.statue(vid):
                self.say("The spell bounces off the chicken's feathers. "
                         "Chickens are chickens.", "info")
                self.end_turn(TOOL_COST)
                return
            self.genderswap(n)
            return
        if spell == "chickenfy":
            self.chickenfy(n)
            return
        if self.statue(vid) and self.chicken(vid):
            self.st["statues"].remove(vid)
            n.goal, n.path, n.stuck = None, [], 0
            self.say("Gold flakes away like falling leaves, and the hen "
                     "that is %s shakes out her feathers and clucks." % name,
                     "quest")
            self.end_turn(TOOL_COST)
        elif self.statue(vid):
            self.st["statues"].remove(vid)
            n.goal, n.path, n.stuck = None, [], 0
            self.say("Gold flakes away like falling leaves, and %s blinks "
                     "back to life." % name, "quest")
            self.talk = {"v": vid, "mode": "kw", "expr": "surprised",
                         "text": ""}
            self.talkbar.pack(side="bottom", fill="x", before=self.log)
            self.friend(vid)["met"] = True
            self.speak(vid, UNSTATUE.get(vid, "(surprised)What... what "
                                               "just happened?"))
            self.talk_menu()
        else:
            if self.talk:
                self.end_talk()
            self.st["statues"].append(vid)
            self.say("Your spell strikes %s, who turns to solid, gleaming "
                     "gold." % name, "gold")
            self.end_turn(TOOL_COST)

    def npc_tile(self, vid):
        """Somebody's sprite: as they are, swapped, turned to a hen, and
        any of those in gold."""
        gold = self.statue(vid)
        if self.loo(vid):
            return "lh_" + vid
        if self.tree(vid):
            return "tv_" + vid
        if self.chicken(vid):
            return ("shen_" if gold else "hen_") + self.hen_colour(vid)
        if self.is_cow(vid):
            return ("scow_" if gold else "cow_") + self.cow_colour(vid)
        if self.maid(vid):
            return ("s" if gold else "v") + "m_" + vid
        return ("s" if gold else "v") + ("x" if self.swapped(vid) else
                                         "") + "_" + vid

    def swapped(self, vid):
        return vid in self.st.setdefault("swapped", [])

    def likes_change(self, vid, spell="genderswap"):
        """Some people like what a spell did. Some really don't.  Who is
        which is dealt anew each game, spell by spell."""
        key = "%s:%s:likes" if spell == "genderswap" else \
            "%s:%s:" + spell
        return random.Random(key % (self.st["seed"], vid)).random() < 0.5

    def chicken(self, vid):
        return vid in self.st.setdefault("chickenfied", [])

    def chickenfy(self, n):
        """The chickenfy spell: a hen like the ones Mabel sells, going
        about the villager's day; cast again, and back they come.  As with
        genderswap, some like it and some don't, and you'll hear about it
        (in clucks, and then in words)."""
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        st = self.st
        flags = st["flags"]
        likes = self.likes_change(vid, "chickenfy")
        if self.statue(vid):
            if self.chicken(vid):
                st["chickenfied"].remove(vid)
            else:
                st["chickenfied"].append(vid)
            self.say("The golden statue of %s ripples and shifts shape. "
                     "It doesn't seem to mind. It's a statue." % name,
                     "gold")
            self.end_turn(TOOL_COST)
            return
        if self.talk:
            self.end_talk()
        if not self.chicken(vid):
            st["chickenfied"].append(vid)
            self.say("Feathers burst out everywhere, and where %s stood "
                     "there's a %s hen, %s." % (
                         name, self.hen_colour(vid),
                         "clucking happily" if likes else
                         "clucking furiously"), "quest")
            if likes:
                pts = 0 if "chickliked:" + vid in flags else 150
                flags.append("chickliked:" + vid)
            else:
                pts = -200
            if pts:
                self.befriend(vid, pts, quiet=True)
                self.say("(%s %s.)" % (name, "seems to enjoy being a "
                                       "chicken" if pts > 0 else
                                       "is upset with you"),
                         "heart" if pts > 0 else "bad")
            self.end_turn(TOOL_COST)
            return
        st["chickenfied"].remove(vid)
        n.goal, n.path, n.stuck = None, [], 0
        if self.leashed(vid):
            st["leashed"] = None
        self.uncoop(vid)
        self.say("A puff of feathers, and %s is back on two feet, without "
                 "a beak." % name, "quest")
        if likes:
            pts = -80
        else:
            pts = 0 if "chickfixed:" + vid in flags else 120
            flags.append("chickfixed:" + vid)
        self.talk = {"v": vid, "mode": "kw", "expr": "surprised",
                     "text": ""}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.friend(vid)["met"] = True
        self.speak(vid, CHICKEN_BACK[vid][0 if likes else 1])
        if pts:
            self.befriend(vid, pts)
            self.say("(%s %s.)" % (name, "likes you more for it" if pts > 0
                                   else "is upset with you"),
                     "heart" if pts > 0 else "bad")
        self.pass_time(TOOL_COST)
        self.talk_menu()

    def maid(self, vid):
        return vid in self.st.setdefault("maids", {})

    def maidify(self, n):
