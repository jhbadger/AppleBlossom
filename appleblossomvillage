        st.setdefault("eggs", [])
        st.setdefault("chickenfied", [])
        st.setdefault("maids", {})
        st.setdefault("trees", [])
        st.setdefault("loos", [])
        st.setdefault("felled", {})
        st.setdefault("leashed", None)
        st.setdefault("cows", [])
        st.setdefault("cowified", [])
        st.setdefault("sheepified", [])
        st.setdefault("catified", [])
        st.setdefault("dogified", [])
        st.setdefault("pets", [])
        st.setdefault("machines", {})
        st.setdefault("bikinis", {})
        st.setdefault("wear", {})
        st.setdefault("uniform", {})
        st.setdefault("orchard", {})
        st.setdefault("fruitful", {})
        st.setdefault("loo_state", {})
        st.setdefault("bowls", {})
        for k, v in (("hay", 0), ("trough", {}), ("grazing", {}),
                     ("large_eggs", []), ("droppings", {})):
            st.setdefault(k, v)
        st.setdefault("fertilized", {})
        for vid in VILLAGERS:
            st["friends"].setdefault(vid, {
                "pts": 0, "talked": -1, "week": 0, "gift_day": -1,
                "met": False, "scenes": [], "status": None, "dated": -1})
        st.setdefault("loo_in", None)
        if "magic wand" not in self.p["tools"]:
            self.p["tools"].append("magic wand")     # older saves
        self.build_world(st["seed"], self.p["built"])
        self.apply_felled()
        self.museum_cases()
        self.clear_cabin_furniture()
        for vid, (area, x, y) in st["npcs"].items():
            n = self.npcs.get(vid)
            if n and (area in self.areas or area == "carried"):
                n.where, n.x, n.y = area, x, y
        for vid, n in self.npcs.items():          # hens and cows of yours
            if self.cooped(vid):
                n.where, n.hidden = "coop", True
            elif self.barned(vid):
                n.where, n.hidden = "barn", True
            elif self.homed(vid):
                n.hidden = True
                for c in st["pets"]:
                    if c.get("vid") == vid:
                        n.where, n.x, n.y = c["where"], c["x"], c["y"]
        self.mine = None
        if st["area"] == "loo" and st.get("mine_loo"):  # a mine outhouse
            ml, st["mine_loo"] = st["mine_loo"], None
            st["area"], st["pos"] = "mine", ml["pos"]
            self.mine_state()["at"] = ml["floor"]
        if st["area"] == "mine":            # saved underground
            self.load_floor(self.mine_state().get("at", 1))
            x, y = st["pos"]
            if not self.area.inside(x, y) or not self.area.grid[y][
                    x].startswith("mfloor_") or self.mob_at(x, y):
                up = self.mine["up"]
                st["pos"] = [up[0], up[1] + 1]
        else:
            self.area = self.areas[st["area"]]
        if self.area.key == "loo" and st["loo_in"] not in st["loos"]:
            self.area = self.areas["valley"]
            st["pos"] = list(door_of("cabin"))
            st["pos"][1] += 1
        self.load_images()
        for vid, n in self.npcs.items():
            if n.where is None:
                self.settle_npcs()
                break
        for line, tag in g.get("log", [])[-30:]:
            self.say(line, tag)
        self.say("Welcome back to %s Farm." % self.p["farm"], "quest")
        self.layout()

    def save(self):
        if not self.p:
            return
        st = self.st
        st["area"] = self.area.key
        if self.mine:
            self.stash_floor()
            self.mine_state()["at"] = self.mine["floor"]
        st["npcs"] = {vid: [n.where, n.x, n.y] for vid, n in
                      self.npcs.items() if n.where}
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k,
                "game": {"p": self.p, "st": st,
                         "log": getattr(self, "logged", [])[-30:]}}
        try:
            tmp = SAVE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(data, f)
            os.replace(tmp, SAVE_FILE)
        except OSError:
            pass

    def quit(self):
        try:
            self.save()
        finally:
            self.sound.stop_music()
            self.root.destroy()

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        self.log.see("end")
        self.log.config(state="disabled")
        self.logged = getattr(self, "logged", [])[-60:] + [(text, tag)]

    # ── The calendar ──

    def season(self, day=None):
        return ((self.st["day"] if day is None else day) // SEASON_DAYS) % 4

    def dom(self, day=None):
        return (self.st["day"] if day is None else day) % SEASON_DAYS + 1

    def year(self):
        return self.st["day"] // (SEASON_DAYS * 4) + 1

    def weekday(self, day=None):
        return (self.st["day"] if day is None else day) % 7

    def hhmm(self):
        m = self.st["minute"]
        return (m // 60) * 100 + m % 60

    def clock(self, m=None):
        m = self.st["minute"] if m is None else m
        h, mm = (m // 60) % 24, m % 60
        return "%d:%02d %s" % (h % 12 or 12, mm, "am" if h < 12 else "pm")

    def date_text(self, day=None):
        day = self.st["day"] if day is None else day
        return "%s %d, Year %d (%s)" % (SEASONS[self.season(day)],
                                        self.dom(day), day // 112 + 1,
                                        WEEKDAYS[self.weekday(day)])

    def festival_today(self):
        return FESTIVALS.get((self.season(), self.dom()))

    def festival_on(self):
        """Today's festival, if it's going on right now."""
        f = self.festival_today()
        if f and f[1] <= self.hhmm() < f[2]:
            return f
        return None

    def light_level(self):
        if not self.area.outdoor:
            return 0
        h = self.hhmm()
        dusk = (1900, 2030) if self.season() in (1,) else \
            (1700, 1830) if self.season() == 3 else (1800, 1930)
        if h >= dusk[1] or h < 530:
            return 2
        if h >= dusk[0] or self.st["weather"] in ("rain", "storm"):
            return 1
        return 0

    # ── Passing time ──

    def pass_time(self, minutes, quiet=False):
        """Minutes go by: people go about their day, and at two in the
        morning you drop where you stand."""
        st = self.st
        for _ in range(minutes):
            st["minute"] += 1
            if st["minute"] % 10 == 0 or minutes < 30:
                self.npc_minute(minutes < 30)
            if st["minute"] == 24 * 60 and not quiet:
                self.say("It's midnight. You should get to bed.", "bad")
            if st["minute"] >= BEDTIME:
                self.collapse()
                return

    def flags_today(self):
        return self.st.setdefault("today", [])

    def end_turn(self, cost=WALK_COST):
        if self.area is None:
            return
        self.pass_time(cost)
        if self.mine and self.area.key == "mine":
            self.mine_turn()
        st = self.st
        if st["wedding"] == st["day"] and 1000 <= self.hhmm() < 1500 and \
                self.area.outdoor and not self.scene:
            x0, y0, x1, y1 = SQUARE
            x, y = self.pos()
            if x0 <= x <= x1 and y0 <= y <= y1:
                self.wedding()
                return
        if self.p["energy"] <= 0 and "tired" not in self.flags_today():
            self.flags_today().append("tired")
            self.say("You're exhausted. Eat something, or go to bed.", "bad")
        self.render()

    def ready(self):
        return bool(self.p) and self.area is not None and not (
            self.busy or self.menu or self.talk or self.overlay or
            self.scene or getattr(self, "aim", False) or
            getattr(self, "naming", None) is not None)

    def built(self):
        return self.p.get("built", ()) if self.p else ()

    # ── Moving ──

    def pos(self):
        return tuple(self.st["pos"])

    def tile_at(self, x, y, area=None):
        a = area or self.area
        if not a.inside(x, y):
            return None
        if a.outdoor:
            if "%d,%d" % (x, y) in self.st["soil"]:
                return "soil"
        return a.grid[y][x]

    def thing_at(self, x, y):
        """What lies on a square of the valley: debris, a crop, forage, a
        sprinkler."""
        k = "%d,%d" % (x, y)
        st = self.st
        if k in st["debris"]:
            return ("debris", st["debris"][k])
        if k in st["sprinklers"]:
            return ("sprinkler", None)
        if k in st.get("machines", ()):
            return ("machine", st["machines"][k])
        if k in st.get("orchard", ()):
            return ("fruittree", st["orchard"][k])
        s = st["soil"].get(k)
        if s and s[1]:
            return ("crop", s)
        if k in st["forage"]:
            return ("forage", st["forage"][k])
        return None

    def npc_at(self, x, y, area=None):
        a = (area or self.area).key
        for n in self.npcs.values():
            if n.where == a and n.x == x and n.y == y and not n.hidden:
                return n
        return None

    def can_stand(self, x, y, area=None):
        a = area or self.area
        if not a.inside(x, y):
            return False
        if self.decor_at(x, y, a) or self.mmaid_at(x, y, a) or \
                self.kid_at(x, y, a) or self.auriel_at(x, y, a):
            return False
        t = self.tile_at(x, y, a)
        if t not in WALKABLE:
            return False
        if a.outdoor:
            th = self.thing_at(x, y)
            if th and th[0] in ("debris", "sprinkler", "machine",
                                "fruittree"):
                return False
        elif a.key == "coop" and self.chicken_at(x, y) is not None:
            return False
        return True

    def face(self, dx, dy):
        self.st["facing"] = [dx, dy]

    def ahead(self):
        x, y = self.pos()
        dx, dy = self.st["facing"]
        return x + dx, y + dy

    def move(self, dx, dy):
        before = (self.area.key, tuple(self.pos())) if self.area else None
        mbefore = (self.where_key(), tuple(self.pos())) if self.area \
            else None
        self.step(dx, dy)
        if before and self.st.get("leashed"):
            self.lead(before)
        if mbefore and self.st.get("mlead"):
            self.mlead_follow(mbefore)

    def step(self, dx, dy):
        if not self.ready():
            return
        self.face(dx, dy)
        x, y = self.pos()
        nx, ny = x + dx, y + dy
        a = self.area
        n = self.npc_at(nx, ny)
        if n:
            self.walking = None
            self.start_talk(n)
            return
        if not a.inside(nx, ny):
            self.render()
            return
        t = self.tile_at(nx, ny)
        if self.bump(nx, ny, t):
            self.walking = None
            return
        if not self.can_stand(nx, ny):
            self.walking = None
            self.render()
            return
        self.st["pos"] = [nx, ny]
        if a.key == "coop" and [nx, ny] in self.st["eggs"]:
            self.pick_egg(nx, ny)
        if a.outdoor:
            self.step_on(nx, ny)
        elif t == "exit":
            self.leave_room()
            return
        self.end_turn(WALK_COST)

    def bump(self, x, y, t):
        """Walking into something: True if that was all the move did."""
        a = self.area
        f = self.mlead_at(x, y)
        if f:
            self.mlead_swap(f)
            return True
        if a.key == "mine":
            return self.mine_bump(x, y, t)
        if self.decor_at(x, y):
            self.walking = None
            self.decor_bump(x, y)
            return True
        m = self.mmaid_at(x, y)
        if m:
            self.walking = None
            self.mmaid_menu(m)
            return True
        k = self.kid_at(x, y)
        if k:
            self.walking = None
            self.kid_menu(k)
            return True
        if self.auriel_at(x, y):
            self.walking = None
            self.auriel_menu()
            return True
        i = self.pet_at(a.key, x, y)
        if i is not None:
            self.walking = None
            self.pet_menu(i)
            return True
        hit = self.grazer_at(x, y) if a.outdoor else None
        if hit:
            self.walking = None
            (self.chicken_menu if hit[0] == "chickens" else
             self.cow_menu)(hit[1])
            return True
        if a.outdoor:
            if (x, y) in self.door_at:
                self.enter_room(self.door_at[(x, y)])
                return True
            th = self.thing_at(x, y)
            if th and th[0] == "debris":
                self.clear_debris(x, y, th[1], auto=True)
                return True
            if th and th[0] == "machine":
                self.machine_menu("%d,%d" % (x, y))
                return True
            if th and th[0] == "fruittree":
                self.fruit_tree_bump("%d,%d" % (x, y))
                return True
            if t == "bin":
                self.ship_menu()
                return True
            if t == "cave":
                self.mine_menu()
                return True
            if t == "towerdoor":
                self.tower_door()
                return True
            if t in ("towerwall", "towertop", "towerwin"):
                self.say("A tower of white stone, taller than it has any "
                         "right to be. The top is lost in cloud.", "info")
                self.render()
                return True
            if t == "mailbox":
                self.read_mail()
                return True
            if t == "board":
                self.read_board()
                return True
            if t == "appletree":
                self.pick_apples(x, y)
                return True
            if t in ("well", "fountain") or t in WATER:
                if self.p["hand"] == "watering can":
                    self.use_tool_at(x, y)
                    return True
                if t == "well":
                    self.say("Your grandmother's well. The water's cold "
                             "and sweet.", "info")
                    return True
                return False
            if t and t.startswith(("wall_", "win_", "roof_", "eave_",
                                   "chimney")):
                self.describe_building(x, y)
                return True
            return False
        if t == "counter":
            bx, by = x + (x - self.pos()[0]), y + (y - self.pos()[1])
            n = self.npc_at(bx, by)
            if n:
                self.start_talk(n)
                return True
            self.say("Nobody's behind the counter.", "info")
            return True
        if a.key == "barn":
            i = self.cow_at(x, y)
            if i is not None:
                self.cow_menu(i)
                return True
            if t == "hay":
                self.say("Bales of sweet hay. The cows eye them hopefully.",
                         "info")
                return True
            if t == "churn":
                self.say("A milk churn, scrubbed and shining.", "info")
                return True
            if t == "trough":
                self.trough_menu("barn")
                return True
        if a.key == "coop":
            i = self.chicken_at(x, y)
            if i is not None:
                self.chicken_menu(i)
                return True
            if t == "nest":
                self.say("Nest boxes, lined with straw. The hens lay "
                         "wherever they please anyway.", "info")
                return True
            if t == "trough":
                self.trough_menu("coop")
                return True
        if t == "loohole":
            self.do_business()
            return True
        if t == "loobench":
            self.read_almanac()
            return True
        if t == "loopaper":
            self.gazette()
            return True
        if t == "loobend":
            ls = self.loo_state(self.st["loo_in"]) if self.st.get(
                "loo_in") else None
            self.say("A jar of flowers brightens the bench." if ls and
                     "flowers" in ls["decor"] else
                     "The end of the bench. A good spot for a jar of "
                     "flowers, if anybody brought some.", "info")
            return True
        if a.key == "loo" and t in ("logwall", "moonwin"):
            self.carving()
            return True
        if t == "bed2" and a.key == "cabin":
            self.bed_menu()
            return True
        if t in ("bed", "bed2"):
            self.say("Somebody's bed. Better not.", "info")
            return True
        if t == "stove" and a.key == "cabin":
            self.stove_menu()
            return True
        if t == "pantry" and a.key == "cabin":
            self.pantry_menu()
            return True
        if t in ("shelf",):
            self.say(random.choice(SHELF_BOOKS), "info")
            return True
        if t in ("case", "case_full"):
            self.museum_menu()
            return True
        return False

    def describe_building(self, x, y):
        for key, (x0, y0, w, h, _, _, name) in BUILDINGS.items():
            if x0 <= x < x0 + w and y0 <= y < y0 + h:
                hours = OPEN_HOURS.get(key)
                self.say(cap(name) + "." + (" " + hours if hours else ""),
                         "info")
                return
        self.render()

    def step_on(self, x, y):
        k = "%d,%d" % (x, y)
        if k in self.st.get("droppings", ()):
            self.walking = None
            self.say(random.choice(STEP_IN[self.st["droppings"][k]]),
                     "bad")
        item = self.st["forage"].pop(k, None)
        if item:
            self.give(item)
            self.sound.play("pick")
            self.say("You find %s." % an(item), "good")

    def enter_room(self, key):
        a = self.areas[key]
        hours = OPEN_HOURS.get(key)
        if not self.open_now(key):
            self.say("%s is locked. %s" % (cap(BUILDINGS[key][6]),
                                            hours or ""), "info")
            self.render()
            return
        self.sound.play("door")
        self.area = a
        self.st["pos"] = list(a.entry)
        self.face(0, -1)
        self.say("You go into %s." % BUILDINGS[key][6], "info")
        self.walking = None
        self.layout()
        self.end_turn(WALK_COST)
        self.save()

    def open_now(self, key):
        """Homes are open while someone's home and awake; shops in their
        hours; your own cabin always."""
        h = self.hhmm()
        if key in ("cabin", "coop", "barn", "greenhouse"):
            return True
        if self.festival_on() and key not in ("inn",):
            return False
        keeper = {"store": "mabel", "clinic": "felix", "smithy": "otto",
                  "carpentry": "ivy", "library": "juniper"}.get(key)
        if key in ("store", "clinic", "smithy", "carpentry", "library",
                   "inn") and not (keeper and self.weekday() ==
                                   VILLAGERS[keeper]["rest"]):
            lo, hi = {"store": (900, 2000), "clinic": (900, 2100),
                      "smithy": (800, 1800), "carpentry": (800, 1900),
                      "library": (800, 2000), "inn": (800, 2400)}[key]
            if lo <= h < hi or h < 200:
                return h >= lo
        return 700 <= h < 2100 and any(
            n.where == key for n in self.npcs.values())

    def leave_room(self):
        key = self.area.key
        if key == "loo" and self.st.get("mine_loo"):
            self.leave_mine_loo()
            return
        self.area = self.areas["valley"]
        if key == "loo" and self.st["loo_in"] not in self.st["loos"]:
            key = "cabin"           # (an outhouse that's gone: home)
        if key == "loo":
            vid, self.st["loo_in"] = self.st["loo_in"], None
            x, y = self.loo_door(vid)
            taken = {(n.where, n.x, n.y) for n in self.npcs.values()}
            if ("valley", x, y) in taken:
                x, y = self.free_spot("valley", x, y, taken)
            self.st["pos"] = [x, y]
            self.say("You step out of the outhouse that is %s, feeling a "
                     "good deal lighter." % VILLAGERS[vid]["short"], "info")
            self.face(0, 1)
            self.sound.play("door")
            self.walking = None
            self.layout()
            self.end_turn(WALK_COST)
            self.save()
            return
        dx, dy = door_of(key)
        self.st["pos"] = [dx, dy + 1]
        self.face(0, 1)
        self.sound.play("door")
        self.walking = None
        self.layout()
        self.end_turn(WALK_COST)
        self.save()

    # ── The old mine ──
    #
    # The mine is always there: each floor keeps its monsters where they
    # stand (beaten ones come back after a few days), its chests (they
    # fill again) and its veins (they grow back), and whatever your wand
    # made of a monster stays on its floor for good.

    def mine_state(self):
        """The deepest floor (a rope hangs to every fifth), the king, and
        each floor's state."""
        m = self.st.setdefault("mine", {"deepest": 0, "king": False})
        m.setdefault("floors", {})
        for k in ("archangel", "key", "tower"):  # the winged key, and what
            m.setdefault(k, False)              # it opens
        return m

    def floor_state(self, floor):
        """What a floor's like now: its monsters [kind, x, y, hp, stun],
        days when beaten ones come back, opened chests [day, times], dug
        veins [tile, day], and the monsters your wand changed."""
        fs = self.mine_state()["floors"].get(str(floor))
        if fs is None:
            g, up, down, mobs, chests = make_mine_floor(self.st["seed"],
                                                        floor)
            fs = self.mine_state()["floors"][str(floor)] = {
                "mobs": [[k, x, y, MONSTERS[k].hp, 0] for k, x, y in mobs
                         if not ("boss" in MONSTERS[k].traits and
                                 self.mine_state()[k])],
                "due": [], "chests": {}, "veins": {}, "changed": {}}
        return fs

    def stash_floor(self):
        """Write the monsters on the floor you're on back into the save."""
        if self.mine:
            self.floor_state(self.mine["floor"])["mobs"] = [
                [m.kind, m.x, m.y, m.hp, m.stun] for m in self.mine["mobs"]]

    def load_floor(self, floor):
        """Make the floor's map as it now stands, bringing back what's had
        time to come back."""
        day = self.st["day"]
        fs = self.floor_state(floor)
        g, up, down, mobs, chests = make_mine_floor(self.st["seed"], floor)
        th = mine_theme(floor)
        for k, (opened, times) in list(fs["chests"].items()):
            if day >= opened + CHEST_DAYS:
                del fs["chests"][k]
            else:
                x, y = map(int, k.split(","))
                g[y][x] = "chest_open_%d" % th
        for k, (tile, dug) in list(fs["veins"].items()):
            if day >= dug + VEIN_DAYS:
                del fs["veins"][k]
            else:
                x, y = map(int, k.split(","))
                g[y][x] = "mwall_%d" % th
        if floor == MINE_FLOORS and self.mine_state()["key"]:
            x, y = [(x, y) for y, r in enumerate(g) for x, t in enumerate(r)
                    if t == "pedestal_key"][0]
            g[y][x] = "pedestal"
        self.area = Area("mine", g, "the Sky Tower, floor %d" % (
            floor - TOWER) if floor > TOWER else
            "the old mine, floor %d" % floor)
        self.mine = {"floor": floor, "turn": 0, "up": up, "down": down,
                     "mobs": [Mob(0, k, x, y) for k, x, y, hp, stun in
                              fs["mobs"]]}
        for mob, (_, _, _, hp, stun) in zip(self.mine["mobs"], fs["mobs"]):
            mob.hp, mob.stun = hp, stun
            if not g[mob.y][mob.x].startswith("mfloor_"):   # (older saves)
                mob.x, mob.y = up[0], up[1] + 1
        back = [d for d in fs["due"] if d <= day]
        fs["due"] = [d for d in fs["due"] if d > day]
        kinds = [k for k, m in MONSTERS.items() if "boss" not in m.traits
                 and m.floors[0] <= floor <= m.floors[1]]
        keep = {up, (up[0], up[1] + 1)} | ({down, (down[0], down[1] + 1)}
                                           if down else set())
        spots = [(x, y) for y in range(len(g)) for x in range(len(g[0]))
                 if g[y][x].startswith("mfloor_") and (x, y) not in keep
                 and "%d,%d" % (x, y) not in fs["changed"]
                 and abs(x - up[0]) + abs(y - up[1]) >= 6]
        for _ in back:
            spots = [p for p in spots if not self.mob_at(*p)]
            if spots:
                x, y = random.choice(spots)
                self.mine["mobs"].append(Mob(0, random.choice(kinds), x, y))
        self.stash_floor()

    def mine_menu(self):
        if self.st.get("leashed"):
            self.say("Not with %s on a leash. Take her home first." %
                     self.display_name(self.st["leashed"]), "info")
            self.render()
            return
        if self.p["energy"] <= 0:
            self.say("You're far too tired to go poking about in a mine.",
                     "bad")
            self.render()
            return
        m = self.mine_state()
        rows = [("Climb down to floor 1", lambda: self.enter_mine(1))]
        for f in range(MINE_ROPE, m["deepest"] + 1, MINE_ROPE):
            rows.append(("Take your rope down to floor %d" % f,
                         lambda f=f: self.enter_mine(f)))
        rows.append(("Not now", lambda: None))
        self.open_menu("The old mine. A cold draught breathes out of the "
                       "dark.%s" % (" (Deepest: floor %d.)" % m["deepest"]
                                    if m["deepest"] else ""), rows)

    def enter_mine(self, floor, from_below=False):
        m = self.mine_state()
        self.stash_floor()
        self.load_floor(floor)
        x, y = self.mine["down"] if from_below else self.mine["up"]
        self.st["pos"] = [x, y + 1]
        self.face(0, 1)
        self.sound.play("stairs")
        self.walking = None
        self.say("%s." % cap(self.area.name), "info")
        if floor < TOWER and floor > m["deepest"]:
            m["deepest"] = floor
            if floor % MINE_ROPE == 0:
                self.say("You tie a rope to the ladder here: next time you "
                         "can climb straight down to floor %d." % floor,
                         "good")
        if any(mob.kind == "king" for mob in self.mine["mobs"]):
            self.say("A voice like grinding stone echoes out of the dark: "
                     "\"WHO COMES DOWN TO MY HALL?\"", "bad")
        if any(mob.kind == "archangel" for mob in self.mine["mobs"]):
            self.say("A voice like a choir of trumpets fills the hall: "
                     "\"ANOTHER HUMAN, CLIMBING WHERE HUMANS DO NOT "
                     "BELONG. YOUR KIND IS CRUEL. I WILL NOT LET YOU "
                     "PASS.\"", "bad")
        self.layout()
        self.end_turn(WALK_COST)

    def tower_door(self):
        m = self.mine_state()
        if not m["tower"]:
            if not self.p["items"].get(WINGED_KEY):
                self.say("A great golden door, with a keyhole shaped like a "
                         "pair of wings. It doesn't budge. Somewhere, they "
                         "say, there's a key.", "info")
                self.render()
                return
            self.take(WINGED_KEY)
            m["tower"] = True
            self.sound.play("quest")
            self.say("The winged key flutters out of your hand and into the "
                     "keyhole. It turns by itself, with a sound like a "
                     "bell, and the door swings open on a stair of white "
                     "marble, climbing up into light.", "quest")
        if self.st.get("leashed") or self.st.get("mlead"):
            self.say("Not with an animal on the leash. Take her home "
                     "first.", "info")
            self.render()
            return
        if self.p["energy"] <= 0:
            self.say("You're far too tired to climb a tower.", "bad")
            self.render()
            return
        self.enter_mine(TOWER + 1)

    def leave_mine(self):
        tower = self.mine and self.mine["floor"] > TOWER
        self.stash_floor()
        self.mine = None
        self.area = self.areas["valley"]
        x, y = TOWER_DOOR if tower else MINE_DOOR
        self.st["pos"] = [x, y + 1]
        self.face(0, 1)
        self.sound.play("stairs")
        self.walking = None
        self.say("You step out of the Sky Tower, down into the woods."
                 if tower else "You climb out of the old mine, blinking.",
                 "info")
        self.layout()
        self.end_turn(WALK_COST)
        self.save()

    def mine_bump(self, x, y, t):
        mob = self.mob_at(x, y)
        if mob:
            self.attack(mob)
            return True
        if self.changed_at(x, y):
            self.visit_changed(x, y)
            return True
        floor = self.mine["floor"]
        if t.startswith("ladder_up"):
            if floor in (1, TOWER + 1):
                self.leave_mine()
            else:
                self.enter_mine(floor - 1, from_below=True)
            return True
        if t.startswith("ladder_down"):
            if floor == KING_FLOOR and not self.mine_state()["king"]:
                self.say("A stair winds down beneath the Mine King's throne, "
                         "into a dark deeper than the mine. While he holds "
                         "this hall, you'll not get past.", "info")
                self.render()
                return True
            self.enter_mine(floor + 1)
            return True
        if t == "pedestal_key":
            m = self.mine_state()
            m["key"] = True
            self.area.grid[y][x] = "pedestal"
            self.give(WINGED_KEY)
            self.sound.play("quest")
            self.say("On a black stone pedestal at the very bottom of the "
                     "world lies a golden key, with a pair of white wings "
                     "where its bow should be. They flutter in your hand. "
                     "Far above, something calls to it.", "quest")
            self.say("(The winged key opens a door somewhere in the valley. "
                     "Look for a tower.)", "info")
            self.end_turn(1)
            return True
        if t == "pedestal":
            self.say("An empty pedestal. You have the key it held.", "info")
            self.render()
            return True
        if t.startswith("ore_"):
            self.dig_vein(x, y, t)
            return True
        if t.startswith("chest_open"):
            fs = self.floor_state(floor)
            left = fs["chests"]["%d,%d" % (x, y)][0] + CHEST_DAYS - \
                self.st["day"]
            self.say("An empty chest. Things have a way of turning up in "
                     "this mine: look again in %d day%s." % (
                         left, "s" if left > 1 else ""), "info")
            self.render()
            return True
        if t.startswith("chest"):
            self.open_chest(x, y)
            return True
        return False

    def dig_vein(self, x, y, t):
        metal = t.split("_")[1]
        floor = self.mine["floor"]
        dug = [t, self.st["day"]]
        if metal == "crystal":
            self.give(CRYSTAL)
            self.area.grid[y][x] = "mwall_%d" % mine_theme(floor)
            self.floor_state(floor)["veins"]["%d,%d" % (x, y)] = dug
            self.sound.play("potion")
            self.say("You snap a magic crystal off the rock. It hums in "
                     "your hand. (Crush it for %d magic.)" % CRYSTAL_MAGIC,
                     "good")
            self.end_turn(WALK_COST)
            return
        if "pickaxe" not in self.p["tools"]:
            self.say("A vein of %s. You'd need a pickaxe." % metal, "info")
            self.render()
            return
        need, have = ORES[metal][1], self.lv("pickaxe")
        if have < need:
            self.say("A vein of %s, but it's too hard for your %s. Otto "
                     "could make it %s." % (metal, self.hand_name("pickaxe"),
                                            METALS[need - 1]), "info")
            self.render()
            return
        if not self.spend("pickaxe"):
            self.render()
            return
        n = 1 + random.randint(0, 1) + have // 2
        self.give(metal + " ore", n)
        self.area.grid[y][x] = "mwall_%d" % mine_theme(floor)
        self.floor_state(floor)["veins"]["%d,%d" % (x, y)] = dug
        self.sound.play("chop")
        self.say("You chip %d lump%s of %s ore out of the rock. (Otto "
                 "smelts %d into a bar.)" % (n, "s" if n > 1 else "", metal,
                                             SMELT), "good")
        self.end_turn(TOOL_COST)

    def mob_at(self, x, y):
        for mob in self.mine["mobs"] if self.mine else ():
            if (mob.x, mob.y) == (x, y):
                return mob
        return None

    def changed_at(self, x, y):
        """A monster your wand changed, standing at (x, y), or None."""
        if not self.mine:
            return None
        return self.floor_state(self.mine["floor"])["changed"].get(
            "%d,%d" % (x, y))

    def mob_can(self, x, y):
        a = self.area
        return a.inside(x, y) and a.grid[y][x].startswith("mfloor_") and \
            (x, y) != self.pos() and self.mob_at(x, y) is None and \
            not self.changed_at(x, y) and not self.mlead_at(x, y)

    @staticmethod
    def the_mob(mob):
        n = mob.m.name
        return n if n.startswith("the ") else "the " + n

    def weapon(self):
        """The best thing you carry to hit with, and how hard it hits."""
        have = [w for w in WEAPONS if w in self.p["tools"]]
        if not have:
            return "fists", 1
        w = max(have, key=lambda w: WEAPONS[w] + self.lv(w))
        return w, WEAPONS[w] + self.lv(w)

    def lv(self, tool):
        """0 for a plain tool; 1, 2 or 3 once Otto's made it copper, iron
        or gold."""
        return self.p.get("tool_lv", {}).get(tool, 0)

    def mine_swing(self):
        x, y = self.ahead()
        mob = self.mob_at(x, y)
        if mob:
            self.attack(mob)
        elif self.changed_at(x, y):
            self.visit_changed(x, y)
        elif self.area.inside(x, y) and \
                self.area.grid[y][x].startswith("ore_"):
            self.dig_vein(x, y, self.area.grid[y][x])
        else:
            self.say("You swing at the dark. The dark doesn't mind.",
                     "info")
            self.end_turn(WALK_COST)

    def attack(self, mob):
        w, power = self.weapon()
        the = self.the_mob(mob)
        mob.aware = True
        verb = {"fists": "punch", "broadsword": "slash", "short sword":
                "slash", "axe": "hack at", "scythe": "slash"}.get(w, "whack")
        if random.random() < 0.15:
            self.sound.play("miss")
            self.say("You swing at %s and miss." % the, "info")
        else:
            crit = random.random() < 0.1
            n = (power + random.randint(0, 1)) * (2 if crit else 1)
            if "armour" in mob.m.traits and not crit and \
                    random.random() < 0.5:
                self.sound.play("miss")
                self.say("CLANG! Your blow glances off %s." % the, "info")
            else:
                mob.hp -= n
                self.flash(mob.x, mob.y, "hit")
                if mob.hp <= 0:
                    self.slay(mob)
                else:
                    self.sound.play("hit")
                    self.say("You %s %s%s." % (
                        verb, the, ", hard" if crit else ""), "good")
        self.end_turn(WALK_COST)

    @staticmethod
    def depth(floor):
        """How deep a floor counts as: the tower is beyond the mine."""
        return MINE_FLOORS + floor - TOWER if floor > TOWER else floor

    def dig_artifact(self, floor, rng=random):
        found = [n for n, v, f in ARTIFACTS if f <= floor]
        return rng.choice(found[-4:] if rng.random() < 0.6 else found)

    def gone(self, mob):
        """A monster off the floor: another will wander in, in a few
        days (but there's only ever one Mine King)."""
        self.mine["mobs"].remove(mob)
        if "boss" not in mob.m.traits:
            self.floor_state(self.mine["floor"])["due"].append(
                self.st["day"] + RESPAWN_DAYS)
        self.stash_floor()

    def slay(self, mob):
        self.gone(mob)
        m = self.mine_state()
        floor = self.mine["floor"]
        gold = random.randint(*mob.m.gold)
        self.p["gold"] += gold
        self.sound.play("kill")
        self.say("%s is beaten! %dg lies where %s stood." % (
            cap(self.the_mob(mob)), gold, "they" if "boss" in mob.m.traits
            else "it"), "gold")
        if mob.kind == "king":
            m["king"] = True
            self.give(KING_PRIZE)
            self.sound.play("quest")
            self.say("The Mine King crumbles into a heap of old bones and "
                     "gravel. On top of the heap sits his crown, cold "
                     "and heavy and glittering: the Crown of the Deep!",
                     "quest")
        elif mob.kind == "poop":
            n = random.randint(1, 2)
            self.give("fertilizer", n)
            self.say("...and leaves %s behind, too. Well. It would." % (
                "a sack of fertilizer" if n == 1 else "two sacks of "
                "fertilizer"), "good")
        elif mob.kind == "archangel":
            m["archangel"] = True
            self.st["auriel"] = self.st["day"] + 1
            self.give("archangel's halo")
            self.sound.play("quest")
            self.say("The Archangel sinks to one knee, wings folding. \"We "
                     "watched your kind from this tower for a thousand years, "
                     "and we saw only cruelty. And yet you came up here, "
                     "and you did not finish me.\" A golden halo slips from "
                     "the Archangel's brow into your hands. \"Go home, "
                     "human. Perhaps we were wrong about you.\"", "quest")
            if any(mm["kind"] == "angel" for mm in self.mmaids()):
                self.say("\"And tell the one who keeps your house,\" the "
                         "Archangel adds, very quietly, \"that she was "
                         "right.\"", "quest")
        elif self.mine["floor"] > TOWER and random.random() < 0.15:
            self.give("angel feather")
            self.say("...and a white feather drifts down after it.", "gold")
        elif random.random() < 0.06:
            n = self.dig_artifact(self.depth(floor))
            self.give(n)
            self.say("...and something else glints in the dust: %s!" %
                     an(n), "gold")

    def zap_mob(self, mob, spell):
        """The wand on a monster: it stays changed, for good, on its floor,
        and you can call on it once a day. The Mine King shrugs the change
        off, but it burns."""
        the = self.the_mob(mob)
        self.flash(mob.x, mob.y, "sparkle")
        mob.aware = True
        if "boss" in mob.m.traits:
            mob.hp -= 8
            self.say("The spell crackles over the Mine King. He's too old "
                     "and too wicked to change, but it burns: he roars."
                     if mob.kind == "king" else "The spell breaks like light "
                     "on glass against the Archangel. Nothing changes it, "
                     "but it stings: the hall rings with a single, furious "
                     "note.", "good")
            if mob.hp <= 0:
                self.slay(mob)
            self.end_turn(TOOL_COST)
            return
        if spell == "genderswap":
            mob.stun = 3
            self.say("%s looks down at itself, deeply confused, and forgets "
                     "all about you for a bit." % cap(the), "good")
            self.end_turn(TOOL_COST)
            return
        colours = {"chickenfy": HEN_COLOURS, "cowify": COW_COLOURS,
                   "sheepify": SHEEP_COLOURS, "catify": CAT_COLOURS,
                   "dogify": DOG_COLOURS}.get(spell, (None,))
        self.floor_state(self.mine["floor"])["changed"][
            "%d,%d" % (mob.x, mob.y)] = {
                "spell": spell, "kind": mob.kind, "day": -1, "pit": 0,
                "colour": random.choice(colours)}
        self.gone(mob)
        self.say("%s %s" % (cap(the), CHANGED[spell][1]), "gold")
        self.end_turn(TOOL_COST)

    def changed_name(self, e):
        return "the %s that was %s" % (CHANGED[e["spell"]][0],
                                       an(MONSTERS[e["kind"]].name))

    def changed_tile(self, e):
        spell, kind, c = e["spell"], e["kind"], e["colour"]
        if spell == "sheepify":
            ready = self.st["day"] - e["day"] >= SHEAR_DAYS
            return ("sheepf_" if ready else "sheep_") + c
        return {"petrify": "smon_" + kind, "maidify": "mmaid_" + kind,
                "treeify": "mtree_" + kind, "looify": "mloo_" + kind,
                "chickenfy": "hen_%s" % c, "cowify": "cow_%s" % c,
                "catify": "cat_%s" % c, "dogify": "dog_%s" % c}[spell]

    def visit_changed(self, x, y):
        """Walking into a monster you changed: what it gives you today,
        or squeeze past it."""
        e = self.changed_at(x, y)
        spell = e["spell"]
        name = self.changed_name(e)
        squeeze = ("Squeeze past", lambda: self.squeeze_by(x, y))
        if spell == "looify":
            rows = [("Go in", lambda: self.enter_mine_loo(x, y))]
            if e["pit"] >= PIT_PER_FERT:
                rows.append(("Empty the pit (%d fertilizer)" % (
                    e["pit"] // PIT_PER_FERT), lambda: self.empty_mine_pit(
                        e)))
            self.open_menu(cap(name), rows + [squeeze,
                                              ("Leave it", lambda: None)])
            return
        ready = self.st["day"] - e["day"] >= (
            SHEAR_DAYS if spell == "sheepify" else 1)
        if spell == "petrify":
            rows = [("Chip off a little gold", lambda: self.tend_changed(
                e, name))] if ready else []
            self.open_menu(cap(name), rows + [
                ("Pick it up (%d energy)" % STATUE_HEFT,
                 lambda: self.lift_mine_statue(x, y)),
                squeeze, ("Leave it", lambda: None)])
            return
        invite = [("Invite her to your cabin", lambda: self.invite_maid(
            x, y))] if spell == "maidify" and MAID_OF.get(
                e["kind"], e["kind"]) in MONSTER_MAIDS else []
        if spell in LEADS_TO and "leash" in self.p["tools"]:
            invite = [("Lead her home", lambda: self.mlead_start(x, y))]
        if not ready and not invite:
            self.squeeze_by(x, y, "You've had what %s has to give today. "
                                  "You squeeze past." % name)
            return
        self.open_menu(cap(name), ([
            (CHANGED[spell][2], lambda: self.tend_changed(e, name))]
            if ready else []) + invite + [squeeze,
                                          ("Leave it", lambda: None)])

    def tend_changed(self, e, name):
        spell, p, m = e["spell"], self.p, MONSTERS[e["kind"]]
        need = {"cowify": "milk pail", "sheepify": "shears"}.get(spell)
        if need and need not in p["tools"]:
            self.say("You'd need %s for that. Mabel sells them." % an(need),
                     "info")
            self.render()
            return
        e["day"] = self.st["day"]
        gold = 0
        if spell == "petrify":
            gold = max(1, random.randint(*m.gold) // 2)
        elif spell == "maidify":
            gold = random.randint(*m.gold)
        p["gold"] += gold
        loot = {"chickenfy": ("egg", 1), "treeify": ("wood",
                                                     3 + self.lv("axe")),
                "cowify": ("milk", 1), "sheepify": ("wool", 1)}.get(spell)
        if loot:
            self.give(*loot)
        if spell == "catify":
            p["magic"] = min(p["max_magic"], p["magic"] + 1)
        if spell == "dogify":
            p["energy"] = min(p["max_energy"], p["energy"] + 20)
        self.sound.play("gold" if gold else "pick")
        text = CHANGED[spell][3]
        self.say(cap(text.replace("{who}", name).replace("{g}", str(gold))),
                 "gold" if gold else "good")
        self.end_turn(TOOL_COST)

    def squeeze_by(self, x, y, text=None):
        self.st["pos"] = [x, y]
        self.say(text or "You squeeze past.", "info")
        self.end_turn(WALK_COST)

    def enter_mine_loo(self, x, y):
        """In through the door of the outhouse that was a monster."""
        self.stash_floor()
        self.st["mine_loo"] = {"floor": self.mine["floor"],
                               "at": "%d,%d" % (x, y),
                               "pos": list(self.pos())}
        self.st["loo_in"] = None
        self.mine = None
        a = self.areas["loo"]
        self.sound.play("door")
        self.area = a
        self.st["pos"] = list(a.entry)
        self.face(0, -1)
        self.say("You step into the outhouse and latch the door. The walls "
                 "creak, grumpily, the way only a monster's can.", "info")
        self.walking = None
        self.layout()
        self.end_turn(WALK_COST)

    def leave_mine_loo(self):
        ml, self.st["mine_loo"] = self.st["mine_loo"], None
        self.load_floor(ml["floor"])
        self.st["pos"] = list(ml["pos"])
        self.face(0, 1)
        self.sound.play("door")
        self.walking = None
        self.say("You step out of the outhouse, back into the dark of the "
                 "mine.", "info")
        self.layout()
        self.end_turn(WALK_COST)

    def empty_mine_pit(self, e):
        sacks = e["pit"] // PIT_PER_FERT
        if not sacks or not self.spend("hoe"):
            return
        e["pit"] -= sacks * PIT_PER_FERT
        self.give("fertilizer", sacks)
        self.sound.play("chop")
        self.say("Holding your breath, you dig out the pit behind the "
                 "outhouse and bag it up. (+%d fertilizer)" % sacks, "good")
        self.end_turn(TOOL_COST)

    def open_chest(self, x, y):
        f = self.mine["floor"]
        st = self.st
        k = "%d,%d" % (x, y)
        fs = self.floor_state(f)
        times = fs.setdefault("opens", {}).get(k, 0)
        fs["opens"][k] = times + 1
        fs["chests"][k] = [st["day"], times + 1]
        rng = random.Random("chest:%s:%d:%d:%d:%d" % (st["seed"], f, x, y,
                                                      times))
        self.area.grid[y][x] = "chest_open_%d" % mine_theme(f)
        f = self.depth(f)
        r, art = rng.random(), 0.2 + 0.04 * min(f, 10)
        if self.mine["floor"] > TOWER and r < 0.3:
            n = rng.randint(1, 3)
            self.give("angel feather", n)
            self.sound.play("quest")
            self.say("You open the chest. Inside, light as nothing: %s." % (
                "an angel feather" if n == 1 else "%d angel feathers" % n),
                "gold")
        elif r < art:
            n = self.dig_artifact(f, rng)
            self.give(n)
            self.sound.play("quest")
            self.say("You prise the chest open. Inside, wrapped in rotten "
                     "sacking: %s! Juniper would love to see that." % an(n),
                     "gold")
        elif r < art + 0.45:
            gold = rng.randint(8, 20) * f
            self.p["gold"] += gold
            self.sound.play("gold")
            self.say("You prise the chest open: old coins, %dg of them." %
                     gold, "gold")
        else:
            item, lo, hi = rng.choice(CHEST_ITEMS)
            n = rng.randint(lo, hi)
            self.give(item, n)
            self.sound.play("pick")
            self.say("You prise the chest open. Inside: %s." % (
                an(item) if n == 1 else "%d %s" % (n, plural(item, n))),
                "good")
        self.end_turn(WALK_COST)

    def mine_turn(self):
        """The monsters' turn: each that's seen you comes for you."""
        mine = self.mine
        mine["turn"] += 1
        for mob in list(mine["mobs"]):
            t = mob.m.traits
            if "slow" in t and mine["turn"] % 2:
                continue
            for _ in range(2 if "fast" in t else 1):
                if self.mine is not mine or self.mob_act(mob):
                    return

    def mob_act(self, mob):
        """One monster's move. True if it knocked you out."""
        if mob.stun:
            mob.stun -= 1
            return False
        px, py = self.pos()
        d = abs(mob.x - px) + abs(mob.y - py)
        if d == 1:
            mob.aware = True
            return self.mob_strike(mob)
        if d <= 7:
            mob.aware = True
        dirs = list(DIRS)
        random.shuffle(dirs)
        if mob.aware and not ("erratic" in mob.m.traits and
                              random.random() < 0.4):
            dirs.sort(key=lambda dd: abs(mob.x + dd[0] - px) +
                      abs(mob.y + dd[1] - py))
        elif random.random() < 0.5:
            return False
        for dx, dy in dirs:
            if self.mob_can(mob.x + dx, mob.y + dy):
                mob.x += dx
                mob.y += dy
                break
        return False

    def mob_strike(self, mob):
        the = cap(self.the_mob(mob))
        if random.random() > (0.5 if "erratic" in mob.m.traits else 0.65):
            self.say("%s lunges at you and misses." % the, "info")
            return False
        p = self.p
        n = max(1, mob.m.dmg + random.randint(-1, 1))
        p["energy"] -= n
        self.sound.play("hurt")
        self.flash(*self.pos(), tile="ouch")
        self.say("%s %s you! (-%d energy)" % (the, mob.m.verb, n), "bad")
        if p["energy"] <= 0:
            self.mine_rescue()
            return True
        return False

    def mine_rescue(self):
        """Knocked out down the mine: carried to the Clinic, without your
        gold and some of what was in your bag."""
        p = self.p
        self.rescued_from = self.mine["floor"] if self.mine else 0
        self.stash_floor()
        self.mlead_return()
        self.mine = None
        self.walking = None
        self.sound.play("death")
        purse, p["gold"] = p["gold"], 0
        stacks = sorted(n for n, c in p["items"].items()
                        if c and n not in STATUE_OF and
                        ITEMS.get(n, (0, 0, ""))[2] != "key")
        lost = [n for n in stacks if random.random() < 0.4]
        if stacks and not lost:
            lost = [random.choice(stacks)]
        for n in lost:
            del p["items"][n]
        for line in (TOWER_RESCUE if self.st["pos"] and self.area.key ==
                     "mine" and getattr(self, "rescued_from", 0) > TOWER
                     else MINE_RESCUE):
            self.say(line, "bad")
        self.say("Your purse is empty (%dg gone)%s." % (
            purse, ", and so are your %s" % and_list(lost) if lost else ""),
            "bad")
        clinic = self.areas["clinic"]
        self.area = clinic
        self.st["pos"] = list(clinic.entry)
        self.face(0, -1)
        p["energy"] = p["max_energy"] // 4
        self.layout()
        self.pass_time(120, quiet=True)
        self.save()

    # ── Statues you carry home ──
    #
    # A golden statue, of a monster or of a villager, can be picked up,
    # carried in your bag and set down on your farm or in your cabin.
    # Monster statues there are decorations ("decor": "area:x,y" -> kind
    # and the day you last chipped it); a villager is simply moved, and
    # is "carried" while in your bag.

    def heave(self):
        if self.p["energy"] < STATUE_HEFT:
            self.say("You strain and heave, but it's far too heavy for you "
                     "just now. Eat something first.", "bad")
            self.render()
            return False
        self.p["energy"] -= STATUE_HEFT
        self.sound.play("chop")
        return True

    def lift_mine_statue(self, x, y):
        e = self.changed_at(x, y)
        if not e or not self.heave():
            return
        del self.floor_state(self.mine["floor"])["changed"]["%d,%d" % (x, y)]
        n = "golden " + MONSTERS[e["kind"]].name
        self.give(n)
        self.say("You heave the %s onto your back. Oof. (Hold it and set it "
                 "down on your farm, or in your cabin.)" % n, "good")
        self.end_turn(TOOL_COST)

    def lift_statue(self, n):
        """Pick up a villager who's been turned to gold."""
        vid = n.vid
        if not self.heave():
            return
        n.where, n.goal, n.path = "carried", None, []
        name = "statue of " + VILLAGERS[vid]["short"]
        self.give(name)
        self.say("You heave the %s onto your back. Oof. Golden people are "
                 "heavier than they look." % name, "good")
        self.end_turn(TOOL_COST)

    def decor(self):
        return self.st.setdefault("decor", {})

    def decor_at(self, x, y, area=None):
        return self.decor().get("%s:%d,%d" % ((area or self.area).key, x, y))

    def statue_spot(self, x, y):
        """Can a statue go down here: open ground on your farm, or floor in
        your cabin?"""
        a = self.area
        if a.key not in ("valley", "cabin") or not a.inside(x, y) or (
                a.outdoor and not on_farm(x, y)):
            return False
        if (x, y) == self.pos() or self.npc_at(x, y) or \
                self.decor_at(x, y) or self.pet_at(a.key, x, y) is not None:
            return False
        if a.outdoor and (self.grazer_at(x, y) or "%d,%d" % (x, y) in
                          self.st["soil"]):
            return False
        if a.key == "cabin" and (x, y) in [tuple(v) for v in
                                           a.spots.values()]:
            return False
        return self.can_stand(x, y)

    def place_statue(self, x, y, item):
        if not self.statue_spot(x, y):
            self.say("Set a statue down on open ground on your farm, or on "
                     "the floor of your cabin.", "info")
            self.render()
            return
        what, who = STATUE_OF[item]
        self.take(item)
        if what == "mon":
            self.decor()["%s:%d,%d" % (self.area.key, x, y)] = {
                "kind": who, "day": -1}
        else:
            n = self.npcs[who]
            n.where, n.x, n.y = self.area.key, x, y
            n.goal, n.path, n.stuck = None, [], 0
        self.sound.play("chop")
        self.flash(x, y, "sparkle")
        self.say("You set the %s down with a thump. It looks rather fine "
                 "there." % item, "good")
        self.end_turn(TOOL_COST)

    def decor_bump(self, x, y):
        d = self.decor_at(x, y)
        name = "golden " + MONSTERS[d["kind"]].name
        rows = []
        if d["day"] != self.st["day"]:
            rows.append(("Chip off a little gold",
                         lambda: self.chip_decor(d, name)))
        self.open_menu("The %s" % name, rows + [
            ("Pick it up (%d energy)" % STATUE_HEFT,
             lambda: self.lift_decor(x, y)),
            ("Leave it", lambda: None)])

    def chip_decor(self, d, name):
        d["day"] = self.st["day"]
        gold = max(1, random.randint(*MONSTERS[d["kind"]].gold) // 2)
        self.p["gold"] += gold
        self.sound.play("gold")
        self.say("You chip a little gold off the toe of the %s: %dg." % (
            name, gold), "gold")
        self.end_turn(TOOL_COST)

    def lift_decor(self, x, y):
        if not self.heave():
            return
        d = self.decor().pop("%s:%d,%d" % (self.area.key, x, y))
        n = "golden " + MONSTERS[d["kind"]].name
        self.give(n)
        self.say("You heave the %s onto your back." % n, "good")
        self.end_turn(TOOL_COST)

    # ── Maids who were monsters ──
    #
    # A monster you maidified can come and live in your cabin and do a
    # chore every morning, like any maid.  There's no turning her back,
    # so you can dismiss her instead.  "mmaids": [{kind, name, chore, x,
    # y}].

    def mmaids(self):
        ms = self.st.setdefault("mmaids", [])
        for m in ms:
            if "id" not in m:                    # an older save
                m["id"] = max([o.get("id", 0) for o in ms] + [0]) + 1
            for k, v in (("pts", 0), ("status", None), ("gift_day", -1),
                         ("week", 0), ("talked", -1), ("kissed", None)):
                m.setdefault(k, v)
        return ms

    def mm_hearts(self, m):
        return m["pts"] // HEART

    def mm_befriend(self, m, pts, quiet=False):
        """Hearts for a monster maid: eight at most until she's your
        sweetheart, ten after."""
        before = self.mm_hearts(m)
        top = (8 if m["status"] is None else 10) * HEART
        m["pts"] = max(0, min(top, m["pts"] + pts))
        if pts > 0 and self.area.key == "cabin":
            self.flash(m["x"], m["y"], "heart")
        after = self.mm_hearts(m)
        if after >= 4:
            self.mm_teach(m)
        story = MONSTER_ROMANCE[m["kind"]].get("story", {})
        for level in sorted(story):
            if before < level <= after and level > m.get("told", 0):
                m["tell"] = level
        if after > before and not quiet:
            self.sound.play("heart")
            self.say("%s: %s" % (m["name"], "♥" * after + "♡" * (
                10 - after)), "heart")

    def mm_partner(self):
        """The monster maid you're courting, engaged or married to."""
        for m in self.mmaids():
            if m["status"] in ("dating", "engaged", "married"):
                return m
        return None

    def partner_name(self):
        vid = self.partner()
        if vid:
            return VILLAGERS[vid]["short"]
        m = self.mm_partner()
        return m["name"] if m else None

    def mmaid_where(self, m):
        """Where a monster maid is now: (area, x, y). On a dry morning a
        maid with a chore out on the farm stands in the farmyard from six
        till nine, like the villager maids; otherwise she's in the cabin."""
        st = self.st
        if m["chore"] in ("water", "harvest", "weed") and \
                st["weather"] not in ("rain", "storm", "snow") and \
                600 <= self.hhmm() < 900:
            if m.get("out") != st["day"]:
                if getattr(self, "placing_maids", False):
                    return "nowhere", -1, -1    # (being found a spot)
                self.placing_maids = True
                try:
                    taken = {(n.where, n.x, n.y) for n in self.npcs.values()}
                    taken |= {("valley", o["ox"], o["oy"])
                              for o in self.mmaids() if o is not m and
                              o.get("out") == st["day"]}
                    x, y = OUT_SPOTS["farmyard"]
                    m["ox"], m["oy"] = self.free_spot("valley", x, y + 1,
                                                      taken)
                    m["out"] = st["day"]
                finally:
                    self.placing_maids = False
            return "valley", m["ox"], m["oy"]
        return "cabin", m["x"], m["y"]

    def mmaid_at(self, x, y, area=None):
        key = (area or self.area).key
        if key not in ("cabin", "valley"):
            return None
        for m in self.mmaids():
            if self.mmaid_where(m) == (key, x, y):
                return m
        return None

    def mmaid_spot(self):
        """A free square of cabin floor for another maid, out of
        everybody's way, or None."""
        a = self.areas["cabin"]
        spots = {tuple(v) for v in a.spots.values()}
        ex, ey = a.exit
        free = [(x, y) for y in range(a.h) for x in range(a.w)
                if a.grid[y][x] in WALKABLE and a.grid[y][x] != "exit"
                and (x, y) not in spots and abs(x - ex) + abs(y - ey) > 1
                and not self.npc_at(x, y, a) and not self.decor_at(x, y, a)
                and not any((m["x"], m["y"]) == (x, y)
                            for m in self.mmaids() + self.kids())
                and self.pet_at("cabin", x, y) is None
                and not (self.area is a and (x, y) == self.pos())]
        if not free:
            return None
        sx, sy = a.spots[MAID_SPOTS[0]]
        return min(free, key=lambda p: abs(p[0] - sx) + abs(p[1] - sy))

    def invite_maid(self, x, y):
        e = self.changed_at(x, y)
        spot = self.mmaid_spot()
        if spot is None:
            self.say("There's no room left in your cabin for another maid. "
                     "Not even a broom cupboard.", "info")
            self.render()
            return
        kind = MAID_OF.get(e["kind"], e["kind"])
        name, lines = MONSTER_MAIDS[kind]
        same = sum(1 for m in self.mmaids() if m["kind"] == kind)
        if same:
            name += " " + ("the Second", "the Third", "the Fourth")[
                min(same, 3) - 1] if same < 4 else " %d" % (same + 1)
        del self.floor_state(self.mine["floor"])["changed"]["%d,%d" % (x, y)]
        self.mmaids().append({"kind": kind, "name": name,
                              "chore": None, "x": spot[0], "y": spot[1],
                              "id": max([o["id"] for o in self.mmaids()] +
                                        [0]) + 1})
        self.mmaids()
        self.sound.play("heart")
        if kind in MM_INVITE:
            self.say(MM_INVITE[kind] % name, "heart")
        else:
            self.say("\"Your cabin? With a proper broom cupboard?\" The "
                     "little maid that was %s claps her hands. \"I'm %s! "
                     "I'll be there before you are!\" She bobs a curtsy and "
                     "scurries off up the ladder." % (
                         an(MONSTERS[e["kind"]].name), name), "heart")
        self.end_turn(1)

    def mmaid_says(self, m, line, expr="happy"):
        """Her line in the talk window, portrait and all."""
        self.talk = {"mm": m, "v": None, "expr": expr, "text": line,
                     "mode": "kw"}
        self.say("%s: %s" % (m["name"], line), "talk")

    def mmaid_menu(self, m):
        if not self.talk or self.talk.get("mm") is not m:
            r = MONSTER_ROMANCE[m["kind"]]
            if m["status"] == "married":
                hello = random.choice(r["wife"])
            elif m["status"]:
                hello = random.choice((
                    "(blush)Oh, it's you! Hello, sweetheart.",
                    "(happy)There you are! I was hoping you'd come by."))
            else:
                hello = random.choice((
                    "(happy)Yes, %s? Is there something you need?" %
                    self.p["name"],
                    "(surprised)Oh! You startled me. What can I do for you?",
                    "(happy)Everything's spick and span. What is it?"))
            self.mm_line(m, hello)
        due = [lv for lv in sorted(MM_SCENES.get(m["kind"], {}))
               if self.mm_hearts(m) >= lv and lv not in m.setdefault(
                   "scenes", [])]
        if due:                         # a heart scene
            m["scenes"].append(due[0])
            self.sound.play("heart")
            self.mm_scene(m, MM_SCENES[m["kind"]][due[0]],
                          lambda: (self.say("(A moment with %s, at %d "
                                            "hearts.)" % (m["name"], due[0]),
                                            "heart"), self.mmaid_menu(m)))
            return
        level = m.pop("tell", None)
        if level:                       # something she's come to understand
            m["told"] = level
            self.mm_line(m, MONSTER_ROMANCE[m["kind"]]["story"][level])
            self.say("(%s shares something with you, at %d hearts.)" % (
                m["name"], level), "heart")
        now = m["chore"]
        self.open_menu("Each morning she'll %s." % MAID_CHORES[now][1]
                       if now else "She has no chore yet.", [
                           ("Chat", lambda: self.mmaid_chat(m)),
                           ("Kiss her", lambda: self.mm_kiss(m)),
                           ("Give her a gift", lambda: self.mm_gift_menu(m)),
                           ("Give her a chore", lambda: self.mmaid_chores(m)),
                           ("Squeeze past", lambda: self.squeeze_mmaid(m)),
                           ("Dismiss her", lambda: self.mmaid_dismiss(m)),
                           ("Goodbye", self.end_talk)],
                       cancel=self.end_talk)

    def mm_line(self, m, line):
        """Say one of her lines, written '(expr)text'."""
        expr, text = parse_line(fill_in(line, self))
        narr = text.startswith("*")
        self.mmaid_says(m, text.lstrip("*"), expr)
        self.talk["narr"] = narr

    def mmaid_chat(self, m):
        lines = MONSTER_MAIDS[m["kind"]][1]
        self.mmaid_says(m, random.choice(lines + (
            "Is there anything else, %s?" % self.p["name"],
            "I do like it here. It's ever so much brighter than the mine."
            if m["chore"] else "What would you like me to do each "
            "morning?")), random.choice(("happy", "laugh", "blush")))
        if m["talked"] != self.st["day"]:
            m["talked"] = self.st["day"]
            self.mm_befriend(m, CHAT_POINTS)
        self.pass_time(1)
        self.mmaid_menu(m)

    def mm_kiss(self, m):
        """A kiss for her, twice a day, each as good as a gift she likes."""
        day, n = m["kissed"] or (None, 0)
        if day != self.st["day"]:
            n = 0
        if n >= 2:
            self.mm_line(m, random.choice(MAID_KISS_ENOUGH))
            self.mmaid_menu(m)
            return
        m["kissed"] = [self.st["day"], n + 1]
        self.say("> (you kiss %s on the cheek)" % m["name"], "you")
        self.mm_line(m, random.choice(MONSTER_ROMANCE[m["kind"]]["kiss"] +
                                      MAID_KISS_LIKE[:2]))
        self.mm_befriend(m, GIFT_POINTS["like"])
        self.sound.play("heart")
        self.pass_time(1)
        self.mmaid_menu(m)

    def mm_taste(self, m, item):
        r = MONSTER_ROMANCE[m["kind"]]
        item = base_item(item)
        for taste, key in (("love", "loves"), ("hate", "hates"),
                           ("like", "likes")):
            if item in r[key]:
                return taste
        kind = ITEMS.get(item, (0, 0, "?"))[2]
        return "like" if kind in ("food", "fruit") else \
            "dislike" if kind == "material" else "neutral"

    def mm_gift_menu(self, m):
        items = sorted(n for n, c in self.p["items"].items()
                       if c and not n.endswith(" seeds") and n not in
                       ("sprinkler", "fertilizer") and n not in STATUE_OF
                       and n not in MACHINES and not n.endswith(" sapling"))
        if not items:
            self.mm_line(m, "(happy)You've nothing to give? That's all "
                            "right. You being here is enough.")
            self.mmaid_menu(m)
            return
        self.open_menu("Give %s what?" % m["name"], [
            (n, lambda n=n: self.mm_give(m, n)) for n in items],
            cancel=lambda: self.mmaid_menu(m))

    def mm_give(self, m, item):
        self.say("> (you give %s %s)" % (m["name"], an(item)), "you")
        if item == "blossom bouquet":
            self.mm_bouquet(m)
        elif item == "blossom pendant":
            self.mm_pendant(m)
        elif m["gift_day"] == self.st["day"]:
            self.mm_line(m, "(blush)You've already given me something "
                            "today. That's plenty!")
        elif m["week"] >= 2 and m["status"] != "married":
            self.mm_line(m, "(happy)You've been so generous this week! "
                            "Save it for later.")
        else:
            self.take(item)
            taste = self.mm_taste(m, item)
            m["gift_day"] = self.st["day"]
            m["week"] += 1
            self.mm_line(m, random.choice(MM_GIFT[taste]))
            self.mm_befriend(m, GIFT_POINTS[taste])
            self.pass_time(1)
        self.mmaid_menu(m)

    def mm_bouquet(self, m):
        r = MONSTER_ROMANCE[m["kind"]]
        other = self.partner_name()
        if m["status"]:
            self.mm_line(m, "(blush)We're already together, silly. But "
                            "thank you.")
        elif other:
            self.mm_line(m, "(sad)Aren't you with %s?" % other)
        elif self.mm_hearts(m) < 8:
            self.mm_line(m, r["notyet"])
        else:
            self.take("blossom bouquet")
            m["status"] = "dating"
            self.sound.play("quest")
            self.mm_line(m, r["accept"])
            self.say("You and %s are going steady!" % m["name"], "heart")
            if self.area.key == "cabin":
                self.flash(m["x"], m["y"], "heart")

    def mm_pendant(self, m):
        if m["status"] != "dating" or self.mm_hearts(m) < 10:
            self.mm_line(m, "(blush)You already asked. I already said yes!"
                         if m["status"] in ("engaged", "married") else
                         "(blush)Oh! It's beautiful. I... I'm not ready for "
                         "that yet. Give it time." if m["status"] else
                         "(surprised)A pendant?! We're not even courting!")
            return
        self.take("blossom pendant")
        m["status"] = "engaged"
        self.st["wedding"] = self.st["day"] + 3
        self.sound.play("quest")
        self.mm_line(m, MONSTER_ROMANCE[m["kind"]]["proposal"])
        self.say("You're engaged to %s! The wedding will be in three days, "
                 "in the square, at ten in the morning." % m["name"],
                 "heart")

    def mm_wedding(self, m):
        """Your wedding to a maid who was a monster, in the square."""
        drift = ("Apple blossom petals drift", "Summer sunlight dances",
                 "Golden leaves drift", "Snowflakes drift")[self.season()]
        was = an(MONSTERS[m["kind"]].name)
        steps = ["*The whole village gathers in the square. %s over the "
                 "fountain." % drift,
                 "*Mayor Pell clears his throat, and looks twice at the "
                 "bride. Bernard is already crying. Wren plays something "
                 "soft on her fiddle.",
                 "*%s comes up the aisle in her maid's dress, the frilled "
                 "cap traded for a veil. Nobody in the valley has ever seen "
                 "a bride who used to be %s. Agnes Whitlock says it's the "
                 "loveliest wedding she's ever been to." % (m["name"], was),
                 MONSTER_ROMANCE[m["kind"]]["vows"],
                 "*Everyone cheers. Pip throws far too much confetti.",
                 "(happy)Let's go home, {name}. Our home."]

        def after():
            m["status"] = "married"
            self.st["spouse"] = "mm:%d" % m["id"]
            self.st["married_day"] = self.st["day"]
            self.st["wedding"] = None
            self.say("You and %s are married!" % m["name"], "heart")
            self.end_talk()
            self.save()
        self.sound.play("heart")
        self.mm_scene(m, steps, after)

    def mm_scene(self, m, steps, after):
        if not steps:
            after()
            return
        step = steps[0]
        if isinstance(step, tuple):     # a choice: what do you do?
            _, prompt, answers = step

            def answer(text, pts, reply):
                self.say("> " + text, "you")
                if pts:
                    self.mm_befriend(m, pts, quiet=True)
                self.mm_line(m, reply.replace("{maid}", m["name"]))
                self.open_menu("", [("▶", lambda: self.mm_scene(
                    m, steps[1:], after))],
                    lambda: self.mm_scene(m, steps[1:], after))
            self.mm_line(m, "*" + prompt.replace("{maid}", m["name"]))
            self.open_menu("", [(a[0], lambda a=a: answer(*a))
                                for a in answers])
            return
        self.mm_line(m, step.replace("{maid}", m["name"]))
        self.open_menu("", [("▶", lambda: self.mm_scene(m, steps[1:],
                                                        after))],
                       lambda: self.mm_scene(m, steps[1:], after))

    def mmaid_chores(self, m):
        self.open_menu("What should %s do each morning?" % m["name"], [
            (label, lambda c=c: self.mmaid_chore(m, c))
            for c, (label, _) in MAID_CHORES.items()],
            cancel=lambda: self.mmaid_menu(m))

    def mmaid_chore(self, m, chore):
        m["chore"] = chore
        self.mmaid_says(m, "Of course! I'll %s, every morning." %
                        MAID_CHORES[chore][1])
        self.mmaid_menu(m)

    def squeeze_mmaid(self, m):
        self.end_talk()
        x, y = self.pos()
        out = self.mmaid_where(m)[0] == "valley"
        kx, ky = ("ox", "oy") if out else ("x", "y")
        m[kx], m[ky], self.st["pos"] = x, y, [m[kx], m[ky]]
        self.say("You squeeze past %s, who flattens herself against the "
                 "wall." % m["name"], "info")
        self.end_turn(1)

    def mmaid_dismiss(self, m):
        self.mmaid_says(m, "You... you want me to go?", "sad")
        bond = {"dating": " She's your sweetheart!", "engaged":
                " You're engaged to her!", "married":
                " She's your wife!"}.get(m["status"], "")
        self.open_menu("Dismiss %s?%s She'll go for good, and there's no "
                       "getting her back." % (m["name"], bond), [
                           ("Yes, dismiss her", lambda: self.mmaid_gone(m)),
                           ("No, keep her", lambda: (
                               self.mmaid_says(m, "Oh, thank goodness. I'll "
                                               "get back to it, then!"),
                               self.mmaid_menu(m)))],
                       cancel=lambda: self.mmaid_menu(m))

    def mmaid_gone(self, m):
        self.end_talk()
        if m in self.mmaids():
            self.mmaids().remove(m)
        if m["status"] == "engaged":
            self.st["wedding"] = None
        if self.st.get("spouse") == "mm:%d" % m["id"]:
            self.st["spouse"] = None
        self.say("%s unties her apron, folds it neatly, curtsies one last "
                 "time, and is gone. You never see her again." % m["name"],
                 "info")
        self.end_turn(1)

    # ── Leading a monster's animal home ──
    #
    # A hen, cow, sheep, cat or dog that was a monster can be put on Mabel's
    # leash and walked out of the mine, a step behind you, all the way to
    # your coop, barn or cabin, where she's one of your animals.  "mlead":
    # the changed monster, plus where she is ("area": "mine:3", "valley",
    # ...) and the square she came from.

    def where_key(self):
        return "mine:%d" % self.mine["floor"] if self.area.key == "mine" \
            and self.mine else self.area.key

    def mlead_at(self, x, y):
        f = self.st.get("mlead")
        if f and f["area"] == self.where_key() and (f["x"], f["y"]) == (x, y):
            return f
        return None

    def mlead_tile(self, f):
        if f["spell"] == "sheepify":
            return "sheepf_" + f["colour"]
        return "%s_%s" % (LEADS_TO[f["spell"]][0], f["colour"])

    def mlead_start(self, x, y):
        st = self.st
        if st.get("leashed") or st.get("mlead"):
            self.say("You've only the one leash, and it's in use.", "info")
            self.render()
            return
        floor = self.mine["floor"]
        e = self.floor_state(floor)["changed"].pop("%d,%d" % (x, y))
        st["mlead"] = dict(e, area=self.where_key(), x=x, y=y,
                           home=[floor, x, y])
        animal, room = LEADS_TO[e["spell"]]
        self.say("You clip the leash on. The %s that was %s %s along "
                 "behind you. (Lead her into your %s.)" % (
                     animal, an(MONSTERS[e["kind"]].name), {
                         "hen": "clucks and trots", "cow": "moos and plods",
                         "sheep": "bleats and skips", "cat": "mews and "
                         "pads", "dog": "wags and bounds"}[animal],
                     {"coop": "coop", "barn": "barn",
                      "cabin": "cabin"}[room]), "good")
        self.end_turn(1)

    def mlead_return(self):
        """Lost hold of the leash: she wanders back to where she was."""
        f = self.st.get("mlead")
        if not f:
            return
        floor, x, y = f["home"]
        e = {k: v for k, v in f.items() if k not in ("area", "x", "y",
                                                     "home")}
        self.floor_state(floor)["changed"]["%d,%d" % (x, y)] = e
        self.st["mlead"] = None
        self.say("The %s on your leash slipped away, back down into the "
                 "mine." % LEADS_TO[e["spell"]][0], "info")

    def mlead_follow(self, before):
        """After you move she comes too: into your old square, or beside
        you when you've changed places. Into the right room and she's
        yours."""
        f = self.st["mlead"]
        area, pos = before
        here = self.where_key()
        animal, room = LEADS_TO[f["spell"]]
        if here == room and area != room:
            if self.mlead_home(f):
                return
        if here != "valley" and here not in BUILDINGS and \
                not here.startswith("mine:"):
            return                      # she waits outside the outhouse
        if f["area"] != here or area != here:
            x, y = self.pos()
            spots = [(x + dx, y + dy) for dx, dy in DIRS]
            spots = [p for p in spots if self.can_stand(*p) and
                     not self.npc_at(*p) and not self.mob_at(*p) and
                     not self.changed_at(*p) and (self.area.key != "mine" or
                                                  self.area.grid[p[1]][
                                                      p[0]].startswith(
                                                      "mfloor_"))]
            if spots:
                f["area"] = here
                f["x"], f["y"] = spots[0]
        elif self.pos() != tuple(pos) and f["area"] == here:
            f["x"], f["y"] = pos

    def mlead_home(self, f):
        """Into the coop, barn or cabin: one of your animals now, if
        there's room. True if she's in."""
        st = self.st
        animal, room = LEADS_TO[f["spell"]]
        full = (len(st["chickens"]) >= COOP_ROOM if animal == "hen" else
                len(st["cows"]) >= BARN_ROOM if room == "barn" else
                len(st["pets"]) >= PET_ROOM)
        if full:
            self.say("There's no room for another %s. She waits by the "
                     "door with you." % animal, "info")
            return False
        c = (self.add_chicken() if animal == "hen" else self.add_cow()
             if animal == "cow" else self.add_sheep() if animal == "sheep"
             else self.add_pet(animal))
        c["colour"] = f["colour"]
        name = MONSTER_PET_NAMES.get(f["kind"], "Shadow")
        used = {o["name"] for o in st["chickens"] + st["cows"] + st["pets"]}
        for i, roman in enumerate(("", " II", " III", " IV", " V")):
            if name + roman not in used:
                break
        c["name"] = name + roman
        c["was"] = f["kind"]
        st["mlead"] = None
        self.sound.play({"cat": "meow", "dog": "bark", "sheep": "baa"}.get(
            animal, "pick"))
        self.say("You unclip the leash. The %s that was %s is yours now: "
                 "you call her %s.%s" % (
                     animal, an(MONSTERS[f["kind"]].name), c["name"],
                     " She trots out to the farmyard." if animal == "dog"
                     else ""), "quest")
        self.render()
        return True

    def mlead_bump(self, f):
        self.open_menu("The %s on your leash" % LEADS_TO[f["spell"]][0], [
            ("Let her go (back to the mine)", lambda: (
                self.mlead_return(), self.render())),
            ("Never mind", lambda: None)])

    def mlead_swap(self, f):
        x, y = self.pos()
        f["x"], f["y"], self.st["pos"] = x, y, [f["x"], f["y"]]
        self.end_turn(1)

    # ── The greenhouse ──
    #
    # Ivy's glasshouse on your farm: beds ("gh": "x,y" -> the same
    # [watered, crop, days grown, dead] as the fields) where any crop grows
    # in any season, out of the weather.  Water them from the butt.

    def gh_tool(self, x, y, h):
        st, p = self.st, self.p
        a = self.area
        t = a.grid[y][x] if a.inside(x, y) else None
        k = "%d,%d" % (x, y)
        if t == "butt":
            if h == "watering can":
                p["water"] = p["can"]
                self.sound.play("water")
                self.say("You fill the watering can from the butt.", "info")
                self.end_turn(1)
            else:
                self.say("A water butt, full of rainwater off the glass.",
                         "info")
                self.render()
            return
        if t != "gbed":
            self.say("Not in here.", "info")
            self.render()
            return
        beds = st.setdefault("gh", {})
        s = beds.setdefault(k, [0, None, 0, 0])
        if s[1] and self.ripe(s):
            self.harvest(x, y, beds, "gh:")
            return
        if h and h.endswith(" seeds"):
            if s[1]:
                self.say("Something's already growing there.", "info")
                self.render()
                return
            s[1], s[2], s[3] = h[:-6], 0, 0
            st.setdefault("care", {})["gh:" + k] = [0, 0, 0]
            self.take(h)
            self.sound.play("pick")
            self.end_turn(1)
            return
        if h == "watering can":
            if not s[1]:
                self.say("Nothing's planted there yet.", "info")
            elif s[0]:
                self.say("That's already damp.", "info")
            elif p["water"] <= 0:
                self.say("The can's empty. Fill it at the water butt.", "bad")
            elif self.spend(h):
                for kk in [k] + ["%d,%d" % q for q in self.row_ahead(x, y, h)]:
                    b = beds.get(kk)
                    if b and b[1] and not b[0] and p["water"] > 0:
                        b[0] = 1
                        p["water"] -= 1
                self.sound.play("water")
                self.end_turn(TOOL_COST - 1)
                return
            self.render()
            return
        if h == "fertilizer" and s[1]:
            if st["fertilized"].get("gh:" + k) == st["day"]:
                self.say("You've already fed that one today.", "info")
                self.render()
                return
            st["fertilized"]["gh:" + k] = st["day"]
            st.setdefault("care", {}).setdefault("gh:" + k, [0, 0, 0])[2] += 1
            s[2] += 1
            self.take("fertilizer")
            self.sound.play("pick")
            self.say("You work fertilizer in round the %s. A day's growth "
                     "overnight." % s[1], "good")
            self.end_turn(1)
            return
        self.say("A bed of good dark soil. Plant seeds here: anything grows "
                 "in the greenhouse, whatever the season." if not s[1] else
                 "The %s is coming along nicely." % s[1], "info")
        self.render()

    # ── Cooking ──
    #
    # Grandmother's stove cooks the recipes you know ("recipes") from
    # what's in the pantry beside it ("pantry": item -> how many) and, if
    # that's not enough, your bag.

    def pantry(self):
        return self.st.setdefault("pantry", {})

    @staticmethod
    def fits(spec, item):
        """Is this item one of what a recipe asks for?"""
        plain = base_item(item)
        if plain.startswith("large "):         # a large egg is an egg
            plain = plain[6:]
        kind = ITEMS.get(plain, (0, 0, ""))[2]
        if spec == "any fish":
            return kind == "fish"
        if spec == "any fruit":
            return kind == "fruit" or plain in JAM_FRUIT
        if spec == "any vegetable":
            return plain in PICKLE_VEG
        if spec == "any jam":
            return plain.endswith(" jam")
        return plain == spec

    def stock(self, spec, pantry_only=False):
        """(store, item, how many) you could use for an ingredient: the
        pantry first, plain before silver and gold."""
        out = []
        for store in (self.pantry(),) + (() if pantry_only else
                                         (self.p["items"],)):
            for item in sorted(store, key=lambda n: (base_item(n) != n, n)):
                if store[item] and self.fits(spec, item):
                    out.append((store, item, store[item]))
        return out

    def can_cook(self, dish, pantry_only=False):
        return all(sum(c for _, _, c in self.stock(spec, pantry_only)) >= n
                   for spec, n in RECIPES[dish][0].items())

    def use_ingredients(self, dish, pantry_only=False):
        for spec, n in RECIPES[dish][0].items():
            for store, item, have in self.stock(spec, pantry_only):
                k = min(n, have)
                store[item] -= k
                if not store[item]:
                    del store[item]
                n -= k
                if not n:
                    break

    def stove_menu(self):
        known = [d for d in RECIPES if d in self.st.setdefault(
            "recipes", [d for d, (_, who) in RECIPES.items() if not who])]
        rows = []
        for d in known:
            need = ", ".join(ingredient(spec, n)
                             for spec, n in RECIPES[d][0].items())
            ok = self.can_cook(d)
            rows.append(("%s%s (%s)" % ("" if ok else "· ", cap(d),
                                        need),
                         lambda d=d: self.cook(d)))
        self.open_menu("Grandmother's stove. Cook what? (%d of %d recipes; "
                       "the pantry's used first)" % (len(known),
                                                     len(RECIPES)),
                       rows + [("Open the pantry", self.pantry_menu),
                               ("Nothing", lambda: None)])

    def cook(self, dish):
        if not self.can_cook(dish):
            missing = [ingredient(spec).replace("any ", "")
                       for spec, n in RECIPES[dish][0].items()
                       if sum(c for _, _, c in self.stock(spec)) < n]
            self.say("You haven't got what you need for %s: no %s in your "
                     "pantry or bag." % (dish, and_list(missing)), "info")
            self.render()
            return
        self.use_ingredients(dish)
        self.give(dish)
        self.sound.play("potion")
        self.say("You cook %s. Smells wonderful. (%d energy, in your "
                 "bag)" % (an(dish), ITEMS[dish][1]), "good")
        self.end_turn(20)

    def pantry_menu(self):
        pan = self.pantry()
        bag = [n for n, c in sorted(self.p["items"].items()) if c and
               ITEMS.get(n, (0, 0, ""))[2] in PANTRY_KINDS]
        raw = [n for n in bag if ITEMS[n][2] != "food"]
        rows = []
        if raw:
            rows.append(("Put away all your ingredients (%d)" % sum(
                self.p["items"][n] for n in raw), self.pantry_all))
        if bag:
            rows.append(("Put away...", self.pantry_put_menu))
        if pan:
            rows.append(("Take out...", self.pantry_take_menu))
        self.open_menu("The pantry: %s." % (and_list(
            ["%d %s" % (c, plural(n, c)) for n, c in sorted(pan.items())])
            if pan else "empty shelves"), rows + [("Close", lambda: None)])

    def pantry_all(self):
        n = 0
        for item in [i for i, c in self.p["items"].items() if c and
                     ITEMS.get(i, (0, 0, ""))[2] in PANTRY_KINDS and
                     ITEMS[i][2] != "food"]:      # meals stay in your bag
            c = self.p["items"].pop(item)
            self.pantry()[item] = self.pantry().get(item, 0) + c
            n += c
        self.sound.play("pick")
        self.say("You put %d things away in the pantry. (Your cooked "
                 "food stays in your bag.)" % n, "info")
        self.end_turn(1)

    def pantry_put_menu(self):
        self.open_menu("Put what away?", [
            ("%s x%d" % (n, c), lambda n=n: self.pantry_move(n, True))
            for n, c in sorted(self.p["items"].items())
            if c and ITEMS.get(n, (0, 0, ""))[2] in PANTRY_KINDS] +
            [("Back", self.pantry_menu)])

    def pantry_take_menu(self):
        self.open_menu("Take what out?", [
            ("%s x%d" % (n, c), lambda n=n: self.pantry_move(n, False))
            for n, c in sorted(self.pantry().items())] +
            [("Back", self.pantry_menu)])

    def pantry_move(self, item, put):
        src, dst = (self.p["items"], self.pantry()) if put else \
            (self.pantry(), self.p["items"])
        c = src.pop(item, 0)
        if c:
            dst[item] = dst.get(item, 0) + c
            self.sound.play("pick")
            self.say("You %s %d %s." % ("put away" if put else "take out",
                                        c, plural(item, c)), "info")
        (self.pantry_put_menu if put else self.pantry_take_menu)()

    def mm_teach(self, m):
        """A monster maid at 4 hearts shows you her own dish."""
        dish, need, _, _, words = MM_RECIPES[m["kind"]]
        known = self.st.setdefault(
            "recipes", [d for d, (_, who) in RECIPES.items() if not who])
        if dish in known:
            return
        known.append(dish)
        self.say("\"%s\" says %s." % (words, m["name"]), "talk")
        self.say("%s taught you a recipe: %s (%s)! Cook it at your stove." % (
            m["name"], dish, and_list([ingredient(sp, n) for sp, n in
                                       need.items()])), "quest")

    def clear_cabin_furniture(self):
        """Anything an older save left where furniture now stands in the
        cabin (the pantry, say) is moved off it."""
        a = self.areas["cabin"]
        solid = lambda x, y: a.grid[y][x] not in WALKABLE
        for m in self.st.get("mmaids", ()):
            if solid(m["x"], m["y"]):
                spot = self.mmaid_spot()
                if spot:
                    m["x"], m["y"] = spot
        for k in [k for k in self.st.get("decor", {})
                  if k.startswith("cabin:")]:
            x, y = map(int, k[6:].split(","))
            if solid(x, y):
                d = self.st["decor"].pop(k)
                self.give("golden " + MONSTERS[d["kind"]].name)
        for c in self.st.get("pets", ()):
            if c["where"] == "cabin" and solid(c["x"], c["y"]):
                spot = self.free_pet_square("cabin")
                if spot:
                    c["x"], c["y"] = spot

    def teach_recipes(self):
        """A friend at 3 hearts sends you their recipe."""
        known = self.st.setdefault(
            "recipes", [d for d, (_, who) in RECIPES.items() if not who])
        for dish, (need, who) in RECIPES.items():
            if who and who in VILLAGERS and dish not in known and \
                    self.hearts(who) >= 3:
                known.append(dish)
                self.mail(VILLAGERS[who]["short"], "%s\n\nRECIPE: %s. %s." % (
                    RECIPE_LETTERS[who], cap(dish), cap(and_list([
                        ingredient(spec, n) for spec, n in need.items()]))))
                self.say("%s has sent you a recipe: %s! (Cook it at your "
                         "stove.)" % (VILLAGERS[who]["short"], dish), "quest")

    # ── Children ──
    #
    # Married a week or more, you can try for a baby at bedtime; a fortnight
    # later there's a crib in the cabin.  A baby grows into a child at two
    # weeks, and plays in the farmyard on fine days from four.  "kids":
    # [{name, sex, born, look, kind (their mother's monster, or None), x,
    # y, love, seen}].  A monster maid's child takes after her.

    def kids(self):
        return self.st.setdefault("kids", [])

    def spouse_info(self):
        """Your spouse: (name, look, the monster she was or None), or
        None."""
        sp = self.st.get("spouse")
        if not sp:
            return None
        if sp.startswith("mm:"):
            m = next((m for m in self.mmaids() if "mm:%d" % m["id"] == sp),
                     None)
            return m and (m["name"], monster_maid_look(m["kind"]),
                          m["kind"])
        return VILLAGERS[sp]["short"], self.look_of(sp), None

    def kid_age(self, k):
        return self.st["day"] - k["born"]

    def can_try_baby(self):
        st = self.st
        ks = self.kids()
        return bool(self.spouse_info()) and len(ks) < KID_MAX and \
            st.get("baby_due") is None and not st.get("baby_try") and \
            st["day"] - st.get("married_day", -99) >= 7 and \
            all(self.kid_age(k) >= KID_OUT for k in ks)

    def try_baby(self):
        self.st["baby_try"] = True
        self.say("You and %s talk late into the night about a baby." %
                 self.spouse_info()[0], "heart")
        self.sleep()

    def kid_mornings(self):
        """A baby on the way, a baby born, and what the children get up
        to."""
        st = self.st
        if st.get("auriel") == st["day"] and not st.get("auriel_came"):
            st["auriel_came"] = True    # the epilogue: an angel comes down
            self.mail("the Archangel", ARCHANGEL_LETTER)
            self.say("There's a letter in your mailbox, sealed with gold, "
                     "with a white feather for a stamp.", "quest")
        if st.pop("baby_try", None):
            st["baby_due"] = st["day"] + KID_DUE
            self.say("Good news: a baby is on the way! %s is over the "
                     "moon. (Due in %d days.)" % (self.spouse_info()[0],
                                                  KID_DUE), "heart")
        if st.get("baby_due") is not None and st["day"] >= st["baby_due"]:
            st["baby_due"] = None
            if self.spouse_info():
                self.kid_born()
        for k in self.kids():
            if self.kid_age(k) < KID_GROWS:
                continue
            he = "She" if k["sex"] == "F" else "He"
            r = random.random()
            if k["kind"] and r < 0.35:
                t = KID_TRAITS[k["kind"]]
                text = "%s %s." % (k["name"], t[2])
                gift = t[3]
                if gift and gift[0] == "gold":
                    self.p["gold"] += gift[1]
                    text += " (+%dg)" % gift[1]
                elif gift and gift[0] == "energy":
                    self.p["energy"] = min(self.p["max_energy"],
                                           self.p["energy"] + gift[1])
                    text += " (+%d energy)" % gift[1]
                elif gift and gift[0] == "magic":
                    self.p["magic"] = min(self.p["max_magic"],
                                          self.p["magic"] + gift[1])
                    text += " (+1 magic)"
                elif gift:
                    self.give(*gift)
                    text += " (+%s)" % gift[0]
                self.say(text, "heart")
            elif r < 0.12:
                self.say("%s drew you a picture before breakfast. %s's "
                         "very proud of it." % (k["name"], he), "heart")

    def kid_born(self):
        name, look, kind = self.spouse_info()
        me = self.p["look"]
        sex = random.choice("FM")
        used = {k["name"] for k in self.kids()}
        kid_name = random.choice([n for n in KID_NAMES[sex] if n not in used]
                                 or KID_NAMES[sex])
        hair_from = random.choice(("you", "them"))
        hair = list(ART["mon_" + kind][0].values())[0] if kind else (
            me["hair"] if hair_from == "you" else look["hair"])
        k = {"name": kid_name, "sex": sex, "born": self.st["day"],
             "kind": kind, "love": 0, "seen": -1, "parent": name,
             "look": {"face": sex, "body": "C", "age": "child",
                      "skin": random.choice((me["skin"], look["skin"])),
                      "hair": hair, "eyes": KID_TRAITS[kind][0] if kind else
                      random.choice((me["eyes"], look["eyes"])),
                      "style": random.choice(
                          ("bob", "pigtails", "bangs", "ponytail") if
                          sex == "F" else ("short", "messy", "spiky")),
                      "shirt": random.choice(SHIRTS),
                      "pants": random.choice(PANTS), "bg": "#f0e0e8"}}
        k["x"], k["y"] = self.mmaid_spot() or self.areas["cabin"].entry
        self.kids().append(k)
        if hasattr(self, "base"):
            self.paint_specials(scale=True)
        self.sound.play("quest")
        she, her = ("She", "her") if sex == "F" else ("He", "him")
        self.say("Your baby is here: a little %s! You call %s %s." % (
            "girl" if sex == "F" else "boy", her, kid_name), "quest")
        if kind:
            self.say("%s has %s's hair, the colour of %s, %s." % (
                she, name, an(MONSTERS[kind].name), KID_TRAITS[kind][1]),
                "heart")
        else:
            self.say("%s has %s hair." % (
                she, "your" if hair_from == "you" else name + "'s"), "heart")
        self.say("(There's a crib in your cabin now. Walk into it to cuddle "
                 "%s, or give %s another name.)" % (her, her), "info")

    def kid_where(self, k):
        """In the cabin, or out in the farmyard on a fine day once they're
        old enough."""
        st = self.st
        if self.kid_age(k) >= KID_OUT and 1000 <= self.hhmm() < 1600 and \
                st["weather"] not in ("rain", "storm", "snow"):
            if k.get("out") != st["day"]:
                if getattr(self, "placing_maids", False):
                    return "nowhere", -1, -1
                self.placing_maids = True
                try:
                    taken = {(n.where, n.x, n.y) for n in self.npcs.values()}
                    taken |= {("valley", o["ox"], o["oy"])
                              for o in self.kids() if o is not k and
                              o.get("out") == st["day"]}
                    x, y = OUT_SPOTS["farmyard"]
                    k["ox"], k["oy"] = self.free_spot("valley", x + 2, y,
                                                      taken)
                    k["out"] = st["day"]
                finally:
                    self.placing_maids = False
            return "valley", k["ox"], k["oy"]
        return "cabin", k["x"], k["y"]

    def kid_at(self, x, y, area=None):
        key = (area or self.area).key
        if key not in ("cabin", "valley"):
            return None
        for k in self.kids():
            if self.kid_where(k) == (key, x, y):
                return k
        return None

    def kid_tile(self, k):
        i = self.kids().index(k)
        return ("kidb_%d" if self.kid_age(k) < KID_GROWS else "kid_%d") % i

    def kid_line(self, k, line):
        expr, text = parse_line(fill_in(line, self))
        self.talk = {"kid": k, "v": None, "mode": "kw", "expr": expr,
                     "text": text.lstrip("*"), "narr": text.startswith("*")}
        if not text.startswith("*"):
            self.say("%s: %s" % (k["name"], text), "talk")

    def kid_menu(self, k):
        baby = self.kid_age(k) < KID_GROWS
        him = "her" if k["sex"] == "F" else "him"
        if not self.talk or self.talk.get("kid") is not k:
            self.kid_line(k, random.choice(KID_BABY) if baby else
                          self.kid_chatter(k))
        rows = [("Cuddle %s" % him if baby else "Play with %s" % him,
                 lambda: self.kid_love(k))]
        if not baby:
            rows += [("Chat", lambda: (self.kid_line(
                k, self.kid_chatter(k)), self.kid_menu(k))),
                ("Squeeze past", lambda: self.squeeze_kid(k))]
        rows += [("Give %s a new name" % him, lambda: (
            self.end_talk(), self.start_naming(self.kids().index(k),
                                               "kids"))),
                 ("Goodbye", self.end_talk)]
        self.open_menu("", rows, cancel=self.end_talk)

    def kid_chatter(self, k):
        lines = list(KID_CHILD)
        if k["kind"]:
            lines += KID_TRAITS[k["kind"]][4] * 2
        return random.choice(lines)

    def kid_love(self, k):
        baby = self.kid_age(k) < KID_GROWS
        if k["seen"] == self.st["day"]:
            self.kid_line(k, "*Sound asleep, a smile on that little face."
                          if baby else "(happy)Again tomorrow? Promise?")
        else:
            k["seen"] = self.st["day"]
            k["love"] = min(1000, k["love"] + 40)
            self.sound.play("heart")
            where = self.kid_where(k)
            if self.area.key == where[0]:
                self.flash(where[1], where[2], "heart")
            if baby:
                self.kid_line(k, "*You rock the baby gently. A tiny hand "
                                 "holds on to your collar.")
            else:
                self.p["energy"] = min(self.p["max_energy"],
                                       self.p["energy"] + 10)
                self.kid_line(k, random.choice((
                    "(laugh)Again! Again! Spin me again!",
                    "(happy)You're it! No, YOU'RE it!",
                    "(laugh)I win! I always win at hide-and-seek!")))
                self.say("You play with %s for a while. You feel better for "
                         "it. (+10 energy)" % k["name"], "heart")
            self.pass_time(10)
        self.kid_menu(k)

    def squeeze_kid(self, k):
        self.end_talk()
        x, y = self.pos()
        out = self.kid_where(k)[0] == "valley"
        kx, ky = ("ox", "oy") if out else ("x", "y")
        k[kx], k[ky], self.st["pos"] = x, y, [k[kx], k[ky]]
        self.say("You squeeze past %s, who giggles." % k["name"], "info")
        self.end_turn(1)

    def look_portrait(self, key, look, expr, z):
        key = ("look", key, expr, z)
        img = self.portraits.get(key)
        if img is None:
            px = portrait(look, expr)
            base = tk.PhotoImage(width=PW, height=PW)
            base.put(" ".join("{" + " ".join(r) + "}" for r in px))
            img = self.portraits[key] = base.zoom(z)
        return img

    # ── Auriel, after the Archangel ──
    #
    # With the Archangel beaten, an angel comes down to live in the valley
    # and learn about humans.  She stands by the square by day, talks, and
    # sells what she brought down from the tower.

    def auriel_here(self):
        return bool(self.st.get("auriel_came")) and \
            900 <= self.hhmm() < 1800

    def auriel_at(self, x, y, area=None):
        return (area or self.area).key == "valley" and \
            (x, y) == AURIEL_SPOT and self.auriel_here()

    def auriel_says(self, line):
        expr, text = parse_line(fill_in(line, self))
        self.talk = {"who": {"name": "Auriel", "look": AURIEL_LOOK,
                             "sub": "(an angel, come to learn about "
                                    "humans)"},
                     "v": None, "mode": "kw", "expr": expr, "text": text}
        self.say("Auriel: %s" % text, "talk")

    def auriel_menu(self, hello=True):
        if hello:
            self.auriel_says(random.choice((
                "(happy)Hello, {name}. I'm still learning. Teach me "
                "something?",
                "(neutral)Ah. The human who climbed the tower.",
                "(happy)Good day! That's what you say, isn't it? Good day!")))
        self.open_menu("", [("Chat", self.auriel_chat),
                            ("See what she's brought down from the tower",
                             self.auriel_shop),
                            ("Goodbye", self.end_talk)],
                       cancel=self.end_talk)

    def auriel_chat(self):
        lines = list(AURIEL_LINES)
        for m in self.mmaids():
            if m["kind"] == "angel":
                lines += [AURIEL_SEES_ANGEL.replace("{maid}", m["name"])] * 2
        self.auriel_says(random.choice(lines))
        self.pass_time(1)
        self.auriel_menu(hello=False)

    def auriel_shop(self):
        p = self.p
        rows = []
        for item, (gold, feathers, what) in AURIEL_WARES.items():
            if (item == "feather bed" and p.get("feather_bed")) or \
                    item in p["tools"]:
                continue
            rows.append(("%s  %dg + %d angel feathers" % (
                cap(item), gold, feathers),
                lambda i=item: self.auriel_buy(i)))
        if not rows:
            self.auriel_says("(happy)That's all I brought down. You have "
                             "everything!")
            self.auriel_menu(hello=False)
            return
        self.auriel_says("(neutral)We make these in the tower. Gold for the "
                         "journey, and feathers, because we always need "
                         "feathers.")
        self.open_menu("Buy what? (%dg, %d feathers)" % (
            p["gold"], p["items"].get("angel feather", 0)), rows +
            [("Nothing, thanks", lambda: self.auriel_menu(hello=False))],
            cancel=lambda: self.auriel_menu(hello=False))

    def auriel_buy(self, item):
        p = self.p
        gold, feathers, what = AURIEL_WARES[item]
        if p["gold"] < gold or p["items"].get("angel feather", 0) < feathers:
            self.auriel_says("(sad)Not enough, I'm afraid. %dg, and %d "
                             "feathers. Angels fall out of the tower's "
                             "chests, you know. Feathers, I mean." % (
                                 gold, feathers))
            self.auriel_menu(hello=False)
            return
        p["gold"] -= gold
        self.take("angel feather", feathers)
        self.sound.play("quest")
        if item == "feather bed":
            p["feather_bed"] = True
            p["max_magic"] += 1
            self.auriel_says("(happy)I'll have it carried up to your cabin. "
                             "Sleep well. Truly well. %s" % what)
        else:
            p["tools"].append(item)
            p["hand"] = item
            self.auriel_says("(happy)Mind the trees when you land. %s" % what)
        self.auriel_menu(hello=False)

    def fly_home(self):
        """The angel wings: up, over the valley, down at your cabin door."""
        if self.st.get("leashed") or self.st.get("mlead"):
            self.say("You can't fly with an animal on the leash.", "info")
            self.render()
            return
        if self.area.key not in ("valley", "mine"):
            self.say("Not indoors. You'd hit the ceiling.", "info")
            self.render()
            return
        if self.p["magic"] < 1:
            self.say("The wings twitch, but there's no magic left in you "
                     "today to lift them.", "bad")
            self.render()
            return
        self.p["magic"] -= 1
        if self.area.key == "mine":
            self.stash_floor()
            self.mine = None
        self.area = self.areas["valley"]
        x, y = door_of("cabin")
        self.st["pos"] = [x, y + 1]
        self.face(0, 1)
        self.sound.play("spell")
        self.say("You spread the angel wings. They lift you up, out over the "
                 "valley, the roofs and the river small below, and set you "
                 "down at your own front door.", "good")
        self.walking = None
        self.layout()
        self.end_turn(5)
        self.save()

    # ── Juniper's museum ──

    def museum_cases(self):
        """Fill the library's cases as the collection grows."""
        a = self.areas["library"]
        cases = [(x, y) for y in range(a.h) for x in range(a.w)
                 if a.grid[y][x] in ("case", "case_full")]
        n, total = len(self.st.get("museum", ())), len(ARTIFACTS) + 1
        for i, (x, y) in enumerate(cases):
            a.grid[y][x] = "case_full" if n > i * total / len(cases) \
                else "case"

    def museum_menu(self):
        given = self.st.setdefault("museum", [])
        have = sorted(n for n, c in self.p["items"].items()
                      if c and ITEMS.get(n, (0, 0, ""))[2] == "artifact"
                      and n not in given)
        rows = [("Donate %s" % an(n), lambda n=n: self.donate(n))
                for n in have]
        rows += [("Look at the collection", self.show_museum),
                 ("Leave it", lambda: None)]
        self.open_menu("Juniper's museum: %d of %d artifacts, each with a "
                       "neat little card." % (len(given),
                                              len(ARTIFACTS) + 1), rows)

    def show_museum(self):
        given = self.st.get("museum", [])
        lines = ["JUNIPER'S MUSEUM", ""]
        for n, v, f in ARTIFACTS + [(KING_PRIZE, 0, KING_FLOOR)]:
            lines.append("  %-20s %s" % (
                cap(n) if n in given else "?" * len(n),
                "" if n in given else "(floor %d or deeper)" % f
                if n != KING_PRIZE else "(the Mine King's)"))
        nxt = [k for k in sorted(MUSEUM_REWARDS) if k > len(given)]
        if nxt:
            lines += ["", "Juniper has something for you at %d." % nxt[0]]
        self.show_text("\n".join(lines + ["", "Press any key to close."]))

    def donate(self, n):
        given = self.st.setdefault("museum", [])
        if not self.take(n):
            return
        given.append(n)
        self.befriend("juniper", 40, quiet=True)
        self.sound.play("pick")
        self.museum_cases()
        self.say("You give %s to the museum. Juniper writes its card in her "
                 "tidiest hand: where you found it, and when, and by "
                 "whom." % an(n), "good")
        prize = MUSEUM_REWARDS.get(len(given))
        if prize:
            what, k = prize
            self.sound.play("quest")
            if what == "gold":
                self.p["gold"] += k
                got = "%dg" % k
            else:
                self.give(what, k)
                got = "%d %s" % (k, plural(what, k))
            if len(given) == len(ARTIFACTS) + 1:
                self.befriend("juniper", HEART, quiet=True)
                self.say("The collection is complete! Juniper hangs a brass "
                         "plaque over the cases: 'Gathered from the Old Mine "
                         "by %s.' She hugs you, then goes very red. (%s from "
                         "the valley's historical society.)" % (
                             self.p["name"], got), "quest")
            else:
                self.say("%d artifacts! Juniper presses a parcel on you, "
                         "\"for the next ones\": %s." % (len(given), got),
                         "gold")
        self.end_turn(1)

    # ── Tools ──

    def held(self):
        h = self.p["hand"]
        if h in self.p["tools"] or self.p["items"].get(h):
            return h
        self.p["hand"] = "hoe" if "hoe" in self.p["tools"] else None
        return self.p["hand"]

    def hand_list(self):
        seeds = sorted(n for n, c in self.p["items"].items()
                       if c and (n.endswith(" seeds") or n == "sprinkler" or
                                 n in MACHINES or n.endswith(" sapling") or
                                 n == "fertilizer" or n in STATUE_OF))
        return [t for t in TOOLS if t in self.p["tools"]] + seeds

    def hand_name(self, h=None):
        h = h or self.held()
        metal = METALS[self.lv(h) - 1] + " " if h and self.lv(h) else ""
        if h == "watering can":
            return "%swatering can (%d/%d)" % (metal, self.p["water"],
                                               self.p["can"])
        if metal:
            return metal + h
        if h == "magic wand":
            return "magic wand (%s)" % self.p.get("spell", "petrify")
        if h and h in self.p["items"]:
            return "%s (%d)" % (h, self.p["items"][h])
        return h or "nothing"

    def next_tool(self, d=1):
        if not self.ready():
            return
        hs = self.hand_list()
        if not hs:
            return
        cur = self.held()
        i = hs.index(cur) if cur in hs else -1
        self.p["hand"] = hs[(i + d) % len(hs)]
        self.say("You hold the %s." % self.hand_name(), "info")
        self.render()

    def pick_tool(self, i):
        hs = self.hand_list()
        if 0 <= i < len(hs) and self.ready():
            self.p["hand"] = hs[i]
            self.say("You hold the %s." % self.hand_name(), "info")
            self.render()

    def tool_menu(self):
        if not self.ready():
            return
        self.open_menu("Hold what?", [
            ("%d. %s" % (i + 1, self.hand_name(h)) if i < 9 else
             self.hand_name(h),
             lambda h=h: (self.p.update(hand=h), self.render()))
            for i, h in enumerate(self.hand_list())] +
            [("Never mind", lambda: None)])

    def tool_applies(self, x, y, h=None):
        """Whether using what you hold on (x, y) would do something."""
        h = h or self.held()
        a = self.area
        if h == "magic wand":
            return self.wand_target(x - self.pos()[0],
                                    y - self.pos()[1]) is not None
        if h in STATUE_OF:
            return self.statue_spot(x, y)
        if a.key == "greenhouse" and a.inside(x, y):
            t = a.grid[y][x]
            s = self.st.get("gh", {}).get("%d,%d" % (x, y))
            if t == "butt":
                return h == "watering can"
            return t == "gbed" and bool(
                (s and self.ripe(s)) or (h and h.endswith(" seeds") and not
                                          (s and s[1])) or
                (h == "watering can" and s and s[1] and not s[0]) or
                (h == "fertilizer" and s and s[1] and not self.ripe(s)))
        if h == "milk pail" and a.key == "barn":
            i = self.cow_at(x, y)
            return i is not None and self.milk_ready(self.st["cows"][i])
        if h == "shears" and a.key == "barn":
            i = self.cow_at(x, y)
            return i is not None and self.shear_ready(self.st["cows"][i])
        n = self.npc_at(x, y)
        if n and self.tree(n.vid) and h in ("axe", "watering can"):
            return True
        if h == "watering can" and self.bowl_shown(a.key) and \
                (x, y) == self.bowl_at(a.key) and not self.bowl_full(a.key):
            return True
        if n and (self.leashed(n.vid) or (
                h == "leash" and self.leashable(n.vid))):
            return True
        if a.outdoor and "%d,%d" % (x, y) in self.st.get("droppings", ()) \
                and not n:
            return True
        if not a.outdoor or not a.inside(x, y) or n:
            return False
        t = self.tile_at(x, y)
        th = self.thing_at(x, y)
        if h == "axe" and t in CHOPPABLE:
            return True
        if th and th[0] == "crop" and self.ripe(th[1]):
            return True
        if th and th[0] == "forage":
            return True
        if th and th[0] == "debris":
            return DEBRIS[th[1]][0] == h
        if h == "watering can":
            return (t == "soil" and not self.st["soil"]["%d,%d" % (x, y)][0]
                    ) or t in WATER or t in ("well", "fountain")
        if h == "hoe":
            if th and th[0] == "crop" and th[1][3]:
                return True
            return on_farm(x, y) and t in TILLABLE and not th
        if h and h.endswith(" seeds"):
            return t == "soil" and not th
        if h == "fertilizer":
            return bool(th and th[0] == "crop" and not th[1][3] and
                        not self.ripe(th[1]) and self.st["fertilized"].get(
                            "%d,%d" % (x, y)) != self.st["day"])
        if h == "sprinkler" or h in MACHINES or (h and h.endswith(
                " sapling")):
            return on_farm(x, y) and not th and (t == "soil" or
                                                 t in TILLABLE)
        if th and th[0] == "fruittree" and (h == "axe" or self.fruit_left(
                th[1])):
            return True
        if h == "fishing rod":
            return t in WATER
        return False

    def use_tool(self):
        if not self.ready():
            return
        if self.held() == "angel wings":
            self.fly_home()
            return
        f = self.mlead_at(*self.ahead())
        if f:
            self.mlead_bump(f)
            return
        if self.area.key == "mine" and self.held() != "magic wand":
            self.mine_swing()
            return
        self.use_tool_at(*self.ahead())

    # ── The magic wand ──

    def statue(self, vid):
        return vid in self.st["statues"]

    def tree(self, vid):
        return vid in self.st.setdefault("trees", [])

    def loo(self, vid):
        return vid in self.st.setdefault("loos", [])

    def rooted(self, vid):
        """Statues, trees and outhouses stay where they are."""
        return self.statue(vid) or self.tree(vid) or self.loo(vid)

    def wand_target(self, dx, dy):
        """The first person a spell cast that way would hit, or None.
        Spells fly in a straight line until they hit someone or something
        solid."""
        if (dx, dy) not in DIRS:
            return None
        x, y = self.pos()
        for _ in range(WAND_RANGE):
            x, y = x + dx, y + dy
            if not self.area.inside(x, y):
                return None
            mob = self.mob_at(x, y) if self.area.key == "mine" else None
            if mob:
                return mob
            if self.area.key == "mine" and self.changed_at(x, y):
                return None
            n = self.npc_at(x, y)
            if n:
                return n
            i = self.pet_at(self.area.key, x, y)
            vid = i is not None and self.st["pets"][i].get("vid")
            if vid:
                n = self.npcs[vid]
                n.where, n.x, n.y = self.area.key, x, y
                return n
            for key, at, pen in (("coop", self.chicken_at, "chickens"),
                                 ("barn", self.cow_at, "cows")):
                if self.area.key == key:
                    i = at(x, y)
                    vid = i is not None and self.st[pen][i].get("vid")
                    if vid:
                        n = self.npcs[vid]
                        n.where, n.x, n.y = key, x, y
                        return n
            t = self.tile_at(x, y)
            if t not in WALKABLE and t not in WATER:
                return None
        return None

    def start_aim(self, at=None):
        """Raise the wand: choose a spell, then the next direction you
        press (or tap) is the way it flies. With `at` (a direction, from
        tapping someone in line) it flies that way at once."""
        if self.p["magic"] <= 0:
            self.say("The wand gives a sad little sputter: you've no magic "
                     "left today. It comes back while you sleep, or crush a "
                     "magic crystal.", "bad")
            self.render()
            return
        cur = self.p.get("spell", "petrify")
        names = list(SPELLS)
        self.open_menu("Cast which spell? (%d magic left)" %
                       self.p["magic"], [
            ("%s: %s" % (cap(n), SPELLS[n]),
             lambda n=n: self.aim_spell(n, at))
            for n in names] + [("Lower the wand", lambda: None)])
        self.menu["sel"] = names.index(cur) if cur in names else 0
        self.render()

    def aim_spell(self, spell, at=None):
        self.p["spell"] = spell
        if at:
            self.zap(*at)
            return
        self.aim = True
        self.walking = None
        self.say(cap(spell) + "! Zap which way? Press an arrow key, or "
                 "tap that way. "
                 "(Space zaps the way you're facing; Esc lowers the "
                 "wand.)", "quest")
        self.render()

    def cancel_aim(self):
        self.aim = False
        self.say("You lower the wand.", "info")
        self.render()

    def zap(self, dx=None, dy=None):
        """Cast the spell in hand that way."""
        self.aim = False
        if dx is None:
            dx, dy = self.st["facing"]
        self.face(dx, dy)
        n = self.wand_target(dx, dy)
        if self.p["magic"] <= 0:
            self.say("The wand sputters. You've no magic left today.", "bad")
            self.render()
            return
        self.p["magic"] -= 1
        self.sound.play("spell")
        if isinstance(n, Mob):
            self.zap_mob(n, self.p.get("spell"))
            return
        if n is None:
            self.say("You wave the wand. A spark of gold flies off and "
                     "fizzles out.", "info")
            self.flash(*self.ahead())
            self.end_turn(TOOL_COST)
            return
        vid = n.vid
        name = VILLAGERS[vid]["short"]
        self.flash(n.x, n.y, "sparkle")
        spell = self.p.get("spell")
        if spell == "looify":
            self.looify(n)
            return
        if self.cooped(vid) and spell != "chickenfy":
            self.say("The spell fizzles in the straw. The hens squawk, and "
                     "%s the hen glares at you." % name, "info")
            self.end_turn(TOOL_COST)
            return
        if (self.barned(vid) or self.homed(vid)) and \
                spell != BEASTS[self.beast(vid)]["spell"]:
            self.say("The spell fizzles out, and %s the %s gives you a "
                     "long look." % (name, self.beast(vid)), "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "cowify":
            self.beastify(n, "cow")
            return
        if spell == "sheepify":
            self.beastify(n, "sheep")
            return
        if spell in ("catify", "dogify"):
            self.beastify(n, spell[:3])
            return
        if self.hoofed(vid) and spell != "petrify":
            self.say(BEASTS[self.beast(vid)]["bounce"], "info")
            self.end_turn(TOOL_COST)
            return
        if self.loo(vid):
            self.say("The spell splinters harmlessly against the outhouse "
                     "door. It takes more than that to undo an outhouse.",
                     "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "treeify":
            self.treeify(n)
            return
        if self.tree(vid):
            self.say("The spell sinks into %s's bark and is gone. Trees "
                     "don't hold with that sort of magic." % name, "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "maidify":
            self.maidify(n)
            return
        if spell in ("genderswap", "chickenfy") and self.maid(vid):
            self.say("The spell glances off %s's starched apron. A maid "
                     "stays a maid until the spell that made her is "
                     "undone." % name, "info")
            self.end_turn(TOOL_COST)
            return
        if spell == "genderswap":
            if self.chicken(vid) and not self.statue(vid):
                self.say("The spell bounces off the chicken's feathers. "
                         "Chickens are chickens.", "info")
                self.end_turn(TOOL_COST)
                return
            self.genderswap(n)
            return
        if spell == "chickenfy":
            self.chickenfy(n)
            return
        if self.statue(vid) and (self.chicken(vid) or self.hoofed(vid)):
            self.st["statues"].remove(vid)
            n.goal, n.path, n.stuck = None, [], 0
            self.say("Gold flakes away like falling leaves, and the %s "
                     "that is %s %s." % (
                         self.beast(vid) or "hen", name, {
                             "cow": "blinks and gives a long, slow moo",
                             "sheep": "shakes out her fleece and bleats",
                             "cat": "stretches, yawns, and washes a paw",
                             "dog": "shakes herself and barks"}.get(
                             self.beast(vid), "shakes out her feathers and "
                             "clucks")), "quest")
            self.end_turn(TOOL_COST)
        elif self.statue(vid):
            self.st["statues"].remove(vid)
            n.goal, n.path, n.stuck = None, [], 0
            self.say("Gold flakes away like falling leaves, and %s blinks "
                     "back to life." % name, "quest")
            self.talk = {"v": vid, "mode": "kw", "expr": "surprised",
                         "text": ""}
            self.talkbar.pack(side="bottom", fill="x", before=self.log)
            self.friend(vid)["met"] = True
            self.speak(vid, UNSTATUE.get(vid, "(surprised)What... what "
                                               "just happened?"))
            self.talk_menu()
        else:
            if self.talk:
                self.end_talk()
            self.st["statues"].append(vid)
            self.say("Your spell strikes %s, who turns to solid, gleaming "
                     "gold." % name, "gold")
            self.end_turn(TOOL_COST)

    def npc_tile(self, vid):
        """Somebody's sprite: as they are, swapped, turned to a hen, and
        any of those in gold."""
        gold = self.statue(vid)
        if self.loo(vid):
            return self.loo_tile(vid)
        if self.tree(vid):
            t = self.st.get("fruitful", {}).get(vid)
            if t and t.get("fruit"):
                if "tvf_" + vid not in self.base:
                    self.paint_specials(scale=True)
                return "tvf_" + vid
            return "tv_" + vid
        if self.chicken(vid):
            return ("shen_" if gold else "hen_") + self.hen_colour(vid)
        if self.is_cow(vid):
            return ("scow_" if gold else "cow_") + self.cow_colour(vid)
        if self.is_sheep(vid):
            return ("ssheep_" if gold else "sheepf_") + \
                self.sheep_colour(vid)
        if self.pet_kind(vid):
            kind = self.beast(vid)
            return ("s" if gold else "") + kind + "_" + \
                self.beast_colour(vid, kind)
        if self.maid(vid):
            if vid in self.st.get("bikinis", {}):
                return ("s" if gold else "v") + "b_" + vid
            sig = (tuple(self.st.get("wear", {}).get(vid) or ()),
                   self.st.get("uniform", {}).get(vid))
            if sig != ((), None) and hasattr(self, "base"):
                painted = getattr(self, "maid_painted", None)
                if painted is None:
                    painted = self.maid_painted = {}
                if painted.get(vid) != sig:
                    px = art_pixels(*person_art(self.look_of(vid)))
                    self.paint_sprite("vw_" + vid, px)
                    self.paint_sprite("vw_" + vid + "@1",
                                      px[1:] + [[None] * 16])
                    self.paint_sprite("sw_" + vid, golden(px))
                    painted[vid] = sig
                return ("s" if gold else "v") + "w_" + vid
            return ("s" if gold else "v") + "m_" + vid
        return ("s" if gold else "v") + ("x" if self.swapped(vid) else
                                         "") + "_" + vid

    def swapped(self, vid):
        return vid in self.st.setdefault("swapped", [])

    def likes_change(self, vid, spell="genderswap"):
        """Some people like what a spell did. Some really don't.  Who is
        which is dealt anew each game, spell by spell."""
        key = "%s:%s:likes" if spell == "genderswap" else \
            "%s:%s:" + spell
        return random.Random(key % (self.st["seed"], vid)).random() < 0.5

    def chicken(self, vid):
