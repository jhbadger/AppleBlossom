def parse_line(line):
    """'(happy)Hello' -> ('happy', 'Hello')."""
    m = re.match(r"\((\w+)\)", line)
    if m and m.group(1) in EXPRESSIONS:
        return m.group(1), line[m.end():]
    return "neutral", line


def gift_taste(vid, item):
    v = VILLAGERS[vid]
    kind = "kind:" + ITEMS.get(item, (0, 0, "?"))[2]
    for taste in ("loves", "hates", "dislikes", "likes"):
        if item in v[taste] or kind in v[taste]:
            return {"loves": "love", "likes": "like", "dislikes": "dislike",
                    "hates": "hate"}[taste]
    k = ITEMS.get(item, (0, 0, "?"))[2]
    if k in ("food", "fruit"):
        return "like"
    if k == "material":
        return "dislike"
    return "neutral"


